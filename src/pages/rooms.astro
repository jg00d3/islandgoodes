---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Rooms & Suites";
const description = "Four private oceanview and garden rooms at Island Goodes near Hilo, Hawaii. Adults-only accommodation with private entrance, bathroom, lanai, and Sleep Number bed. No children under 18.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="hero-content">
      <h1>Our Rooms</h1>
      <p>Four uniquely decorated rooms, each with private entrance, bath, and lanai</p>
    </div>
  </section>

  <section class="rooms-intro">
    <div class="container">
      <p class="lead">
        Each of our four rooms offers complete privacy with your own entrance, bathroom, and outdoor space.
        All rooms feature luxurious Sleep Number adjustable beds, premium linens, free WiFi, and
        your own private outdoor space. This is an adults-only property - no children under 18.
      </p>
    </div>
  </section>

  <section class="room-detail" id="hilo-bay">
    <div class="container">
      <div class="room-layout">
        <div class="room-images">
          <a href="/rooms/hilo-bay">
            <img src="/images/rooms/hilo-bay/bed.jpg" alt="Sleep Number bed in Hilo Bay Room" class="room-main-image" />
          </a>
        </div>
        <div class="room-info">
          <h2>Hilo Bay Room</h2>
          <p class="room-tagline">Our premier oceanview suite</p>
          <p>
            At 488 square feet, the Hilo Bay Room is our largest accommodation. Located on the ground floor
            with no steps to climb, this suite offers stunning panoramic views of Hilo Bay from your private lanai.
            Watch whales breach during winter months or simply enjoy your morning coffee as the sun rises over the Pacific.
          </p>
          <ul class="amenities-list">
            <li>488 sq ft</li>
            <li>Ocean view</li>
            <li>Ground floor (no steps)</li>
            <li>Private entrance</li>
            <li>Private bathroom with ocean view</li>
            <li>Private lanai</li>
            <li>Sleep Number king bed</li>
          </ul>
          <div class="room-actions">
            <a href="/rooms/hilo-bay" class="btn btn-outline">View Room Details</a>
            <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary" target="_blank" rel="noopener">Check Availability</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="room-detail alt" id="mauna-kea">
    <div class="container">
      <div class="room-layout reverse">
        <div class="room-images">
          <a href="/rooms/mauna-kea">
            <img src="/images/rooms/mauna-kea/bed.jpg" alt="Sleep Number bed in Mauna Kea Room" class="room-main-image" />
          </a>
        </div>
        <div class="room-info">
          <h2>Mauna Kea Room</h2>
          <p class="room-tagline">Mountain views toward Hawaii's highest peak</p>
          <p>
            Named for the majestic mountain visible in the distance, the Mauna Kea Room offers a peaceful
            retreat with views toward Hawaii's tallest peak. Perfect for stargazing enthusiasts planning
            a trip to the Mauna Kea observatories. The room features a comfortable Sleep Number bed and
            all the amenities you need for a relaxing stay.
          </p>
          <ul class="amenities-list">
            <li>Mountain view</li>
            <li>Private entrance</li>
            <li>Private bathroom</li>
            <li>Private lanai</li>
            <li>Sleep Number bed</li>
          </ul>
          <div class="room-actions">
            <a href="/rooms/mauna-kea" class="btn btn-outline">View Room Details</a>
            <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary" target="_blank" rel="noopener">Check Availability</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="room-detail" id="ginger">
    <div class="container">
      <div class="room-layout">
        <div class="room-images">
          <a href="/rooms/ginger">
            <img src="/images/rooms/ginger/room.jpg" alt="Ginger Room bed" class="room-main-image" />
          </a>
        </div>
        <div class="room-info">
          <h2>Ginger Room</h2>
          <p class="room-tagline">A peaceful garden retreat</p>
          <p>
            The Ginger Room offers 400 square feet of comfort surrounded by our lush tropical gardens.
            Located on the ground floor with no steps to climb, this room is named for the fragrant
            ginger plants that bloom just outside your private lanai. Wake up to birdsong and the
            scent of tropical flowers.
          </p>
          <ul class="amenities-list">
            <li>400 sq ft</li>
            <li>Garden view</li>
            <li>Ground floor (no steps)</li>
            <li>Private entrance</li>
            <li>Sleep Number bed</li>
          </ul>
          <div class="room-actions">
            <a href="/rooms/ginger" class="btn btn-outline">View Room Details</a>
            <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary" target="_blank" rel="noopener">Check Availability</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="room-detail alt" id="orchid">
    <div class="container">
      <div class="room-layout reverse">
        <div class="room-images">
          <a href="/rooms/orchid">
            <img src="/images/rooms/orchid/bed.jpg" alt="Sleep Number bed in Orchid Room" class="room-main-image" />
          </a>
        </div>
        <div class="room-info">
          <h2>Orchid Room</h2>
          <p class="room-tagline">Elegant oceanview suite with kitchen</p>
          <p>
            Named for the beautiful orchids that bloom throughout our property, the Orchid Room
            combines elegant decor with stunning ocean views and a full kitchen. Perfect for
            extended stays or guests who prefer to prepare their own meals with fresh local ingredients.
          </p>
          <ul class="amenities-list">
            <li>Ocean view</li>
            <li>Full kitchen</li>
            <li>Private entrance</li>
            <li>Private lanai</li>
            <li>Sleep Number bed</li>
          </ul>
          <div class="room-actions">
            <a href="/rooms/orchid" class="btn btn-outline">View Room Details</a>
            <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary" target="_blank" rel="noopener">Check Availability</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="policies">
    <div class="container">
      <h2>Rates & Policies</h2>
      <div class="policies-grid">
        <div class="policy-card">
          <h3>Rates</h3>
          <p>Starting from <strong>$195/night</strong> plus tax (17.97%)</p>
          <p>Seasonal discounts up to 55% available</p>
          <p><a href="https://v2.reservationkey.com/3655/reserve/c" target="_blank" rel="noopener">View current rates</a></p>
        </div>
        <div class="policy-card">
          <h3>Minimum Stay</h3>
          <p>2-night minimum stay required</p>
          <p>Extended stay discounts available</p>
        </div>
        <div class="policy-card">
          <h3>Adults Only</h3>
          <p>Island Goodes is an adult-only property</p>
          <p>All guests must be 18 years or older</p>
        </div>
        <div class="policy-card">
          <h3>Check-in/Check-out</h3>
          <p>Check-in: 3:00 PM</p>
          <p>Check-out: 11:00 AM</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Ready to Book Your Stay?</h2>
      <p>Book direct for the best rates and personal service</p>
      <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary btn-large" target="_blank" rel="noopener">Check Availability</a>
      <p class="cta-phone">Or call us: <a href="tel:+18089642291">808-964-2291</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/rooms/hilo-bay/lanai.jpg') center/cover no-repeat;
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 8rem 2rem 4rem;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .lead {
    font-size: 1.15rem;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    color: var(--color-text-light);
  }

  .rooms-intro {
    padding: 4rem 0 2rem;
  }

  .room-detail {
    padding: 4rem 0;
  }

  .room-detail.alt {
    background: var(--color-bg-alt);
  }

  .room-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .room-layout.reverse {
    direction: rtl;
  }

  .room-layout.reverse > * {
    direction: ltr;
  }

  .room-main-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }

  .room-info h2 {
    color: var(--color-primary-dark);
    margin-bottom: 0.25rem;
  }

  .room-tagline {
    color: var(--color-secondary);
    font-style: italic;
    margin-bottom: 1rem;
  }

  .amenities-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.5rem 0;
  }

  .amenities-list li {
    background: var(--color-bg-alt);
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .room-detail.alt .amenities-list li {
    background: #fff;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-primary {
    background: var(--color-secondary);
    color: #fff;
  }

  .btn-primary:hover {
    background: #c49943;
    color: #fff;
  }

  .btn-outline {
    background: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }

  .btn-outline:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .room-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .btn-large {
    padding: 1rem 3rem;
    font-size: 1.1rem;
  }

  .policies {
    padding: 4rem 0;
    background: #fff;
  }

  .policies h2 {
    text-align: center;
    color: var(--color-primary-dark);
    margin-bottom: 2rem;
  }

  .policies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .policy-card {
    background: var(--color-bg-alt);
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
  }

  .policy-card h3 {
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .cta-section {
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
    padding: 4rem 2rem;
  }

  .cta-section h2 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .cta-section p {
    margin-bottom: 1.5rem;
  }

  .cta-phone {
    margin-top: 1rem;
  }

  .cta-phone a {
    color: var(--color-secondary);
    font-size: 1.25rem;
  }

  @media (max-width: 768px) {
    .room-layout {
      grid-template-columns: 1fr;
    }

    .room-layout.reverse {
      direction: ltr;
    }
  }
</style>
