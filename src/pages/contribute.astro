---
import PreviewLayout from '../layouts/PreviewLayout.astro';

const title = "Contribute | Island Goodes";
const description = "Share your Big Island photos or write a guest blog post. Get featured with credit and a link to your social media.";
---

<PreviewLayout title={title} description={description}>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img src="/images/blog/waterfalls.webp" alt="Hawaii waterfall" />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
      <h1>Contribute to Island Goodes</h1>
      <p class="tagline">Share your Hawaii story with travelers from around the world</p>
    </div>
  </section>

  <section class="intro-section">
    <div class="container">
      <p class="lead">
        We're building a community-driven guide to the Big Island. Whether you have stunning photos
        or local knowledge to share, we'd love to feature your work and help travelers discover the real Hawaii.
      </p>
      <div class="benefits-row">
        <div class="benefit">
          <span class="benefit-icon">🌟</span>
          <h3>Get Featured</h3>
          <p>Your work displayed to thousands of visitors</p>
        </div>
        <div class="benefit">
          <span class="benefit-icon">🔗</span>
          <h3>Earn a Backlink</h3>
          <p>Link to your website or social media</p>
        </div>
        <div class="benefit">
          <span class="benefit-icon">🤝</span>
          <h3>Mutual Promotion</h3>
          <p>We promote each other's content</p>
        </div>
      </div>
    </div>
  </section>

  <section class="contribute-section" id="photos">
    <div class="container">
      <div class="contribute-card">
        <div class="contribute-header">
          <span class="contribute-icon">📷</span>
          <h2>Photo Contributions</h2>
        </div>

        <div class="contribute-content">
          <div class="contribute-info">
            <h3>What We're Looking For</h3>
            <ul>
              <li>Beaches (especially Richardson, Carlsmith, Kehena, Pololu Valley)</li>
              <li>Waterfalls and swimming holes</li>
              <li>Local food and restaurants</li>
              <li>Activities (snorkeling, hiking, stargazing)</li>
              <li>Wildlife (sea turtles, dolphins, whales)</li>
              <li>Scenic views and landscapes</li>
            </ul>

            <h3>Photo Guidelines</h3>
            <ul>
              <li>High resolution (minimum 1200px wide)</li>
              <li>Your own original photos (no stock images)</li>
              <li>Horizontal orientation preferred</li>
              <li>Good lighting and composition</li>
              <li>No watermarks (we'll add your credit)</li>
            </ul>

            <h3>What You Get</h3>
            <ul class="perks-list">
              <li>Your name displayed with the photo</li>
              <li>Link to your Instagram, website, or social media</li>
              <li>Featured on our destination guides and blog</li>
            </ul>

            <div class="backlink-request">
              <h4>Our Request</h4>
              <p>When you share that your photo was featured on Island Goodes, we'd appreciate a link back to the page where it appears. This helps other travelers discover our guide and supports our community-driven mission!</p>
            </div>
          </div>

          <div class="contribute-form">
            <h3>Submit Your Photos</h3>
            <form id="photoForm" class="submission-form">
              <div class="form-group">
                <label for="photoName">Your Name *</label>
                <input type="text" id="photoName" name="name" required />
              </div>
              <div class="form-group">
                <label for="photoEmail">Email *</label>
                <input type="email" id="photoEmail" name="email" required />
              </div>
              <div class="form-group">
                <label for="photoSocial">Instagram or Website URL</label>
                <input type="url" id="photoSocial" name="social" placeholder="https://instagram.com/yourusername" />
              </div>
              <div class="form-group">
                <label for="photoLocation">Photo Location(s) *</label>
                <input type="text" id="photoLocation" name="location" placeholder="e.g., Richardson Beach, Akaka Falls" required />
              </div>
              <div class="form-group">
                <label for="photoLink">Link to Photos *</label>
                <input type="url" id="photoLink" name="photoLink" placeholder="Google Drive, Dropbox, or similar" required />
                <span class="form-hint">Upload to Google Drive, Dropbox, or similar and share the link</span>
              </div>
              <div class="form-group">
                <label for="photoNotes">Additional Notes</label>
                <textarea id="photoNotes" name="notes" rows="3" placeholder="Any details about the photos, best time of day taken, etc."></textarea>
              </div>
              <div class="form-group checkbox-group">
                <label>
                  <input type="checkbox" name="photoRights" required />
                  I confirm these are my original photos and I grant Island Goodes permission to use them with credit
                </label>
              </div>
              <button type="submit" class="btn btn-primary">Submit Photos</button>
            </form>
            <p id="photoMessage" class="form-message"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contribute-section alt-bg" id="blog">
    <div class="container">
      <div class="contribute-card">
        <div class="contribute-header">
          <span class="contribute-icon">✍️</span>
          <h2>Blog Contributions</h2>
        </div>

        <div class="contribute-content">
          <div class="contribute-info">
            <h3>Topics We're Looking For</h3>
            <ul>
              <li>Hidden gems and local secrets</li>
              <li>Restaurant and food reviews</li>
              <li>Activity guides and tips</li>
              <li>Cultural experiences and traditions</li>
              <li>Day trip itineraries</li>
              <li>Seasonal events and festivals</li>
            </ul>

            <h3>Writing Guidelines</h3>
            <ul>
              <li>800-1500 words (quality over quantity)</li>
              <li>Original content not published elsewhere</li>
              <li>First-hand experience preferred</li>
              <li>Practical tips travelers can use</li>
              <li>Include your own photos if possible</li>
            </ul>

            <h3>What You Get</h3>
            <ul class="perks-list">
              <li>Full byline with your name</li>
              <li>Author bio section with your photo</li>
              <li>Link to your website, blog, or social media</li>
              <li>Shared on our social media channels</li>
            </ul>

            <div class="backlink-request">
              <h4>Our Request</h4>
              <p>When you share your guest post or add it to your portfolio, we'd appreciate a link back to the article on Island Goodes. This mutual promotion helps both of us reach more travelers!</p>
            </div>
          </div>

          <div class="contribute-form">
            <h3>Pitch Your Article</h3>
            <form id="blogForm" class="submission-form">
              <div class="form-group">
                <label for="blogName">Your Name *</label>
                <input type="text" id="blogName" name="name" required />
              </div>
              <div class="form-group">
                <label for="blogEmail">Email *</label>
                <input type="email" id="blogEmail" name="email" required />
              </div>
              <div class="form-group">
                <label for="blogWebsite">Your Website or Social Media</label>
                <input type="url" id="blogWebsite" name="website" placeholder="https://yourblog.com" />
              </div>
              <div class="form-group">
                <label for="blogTopic">Proposed Topic *</label>
                <input type="text" id="blogTopic" name="topic" placeholder="e.g., Best Swimming Holes Near Hilo" required />
              </div>
              <div class="form-group">
                <label for="blogOutline">Brief Outline *</label>
                <textarea id="blogOutline" name="outline" rows="4" placeholder="What will you cover? What's your unique angle or experience?" required></textarea>
              </div>
              <div class="form-group">
                <label for="blogExperience">Your Connection to Hawaii</label>
                <textarea id="blogExperience" name="experience" rows="2" placeholder="Local resident, frequent visitor, etc."></textarea>
              </div>
              <div class="form-group checkbox-group">
                <label>
                  <input type="checkbox" name="blogRights" required />
                  I confirm this will be original content and I grant Island Goodes permission to publish it with credit
                </label>
              </div>
              <button type="submit" class="btn btn-primary">Submit Pitch</button>
            </form>
            <p id="blogMessage" class="form-message"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-grid">
        <div class="faq-item">
          <h3>How long until I hear back?</h3>
          <p>We review submissions within 3-5 business days and will email you either way.</p>
        </div>
        <div class="faq-item">
          <h3>Can I submit multiple photos?</h3>
          <p>Yes! The more the better. Just include them all in your shared link.</p>
        </div>
        <div class="faq-item">
          <h3>Do I get paid for contributions?</h3>
          <p>We don't offer payment, but you get full credit, a quality backlink, and exposure to our audience.</p>
        </div>
        <div class="faq-item">
          <h3>Can I use my photos/article elsewhere?</h3>
          <p>Yes! You retain rights to your work. We just ask for permission to use it on our site.</p>
        </div>
      </div>
    </div>
  </section>
</PreviewLayout>

<style>
  .page-hero {
    position: relative;
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 8rem 2rem 4rem;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.7));
    z-index: 1;
  }

  .page-hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .page-hero h1 {
    font-size: 2.75rem;
    margin-bottom: 0.75rem;
  }

  .tagline {
    font-size: 1.25rem;
    opacity: 0.9;
  }

  .intro-section {
    padding: 4rem 2rem;
    background: #fff;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .lead {
    font-size: 1.2rem;
    color: var(--color-text-light);
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem;
    line-height: 1.8;
  }

  .benefits-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .benefit {
    padding: 1.5rem;
  }

  .benefit-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }

  .benefit h3 {
    color: var(--color-text);
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .benefit p {
    color: var(--color-text-light);
    font-size: 0.95rem;
  }

  .contribute-section {
    padding: 4rem 2rem;
  }

  .contribute-section.alt-bg {
    background: var(--color-bg-alt);
  }

  .contribute-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .contribute-header {
    background: var(--gradient-primary);
    color: #fff;
    padding: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .contribute-icon {
    font-size: 2.5rem;
  }

  .contribute-header h2 {
    margin: 0;
    font-size: 1.75rem;
  }

  .contribute-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding: 2.5rem;
  }

  .contribute-info h3 {
    color: var(--color-primary);
    font-size: 1.1rem;
    margin: 1.5rem 0 0.75rem;
  }

  .contribute-info h3:first-child {
    margin-top: 0;
  }

  .contribute-info ul {
    list-style: none;
    padding: 0;
  }

  .contribute-info li {
    padding: 0.4rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--color-text-light);
  }

  .contribute-info li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-secondary);
  }

  .perks-list li::before {
    content: '✓';
    color: var(--color-primary);
    font-weight: bold;
  }

  .backlink-request {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, rgba(27, 107, 90, 0.1) 100%);
    padding: 1.25rem;
    border-radius: 12px;
    margin-top: 1.5rem;
    border-left: 4px solid var(--color-primary);
  }

  .backlink-request h4 {
    color: var(--color-primary);
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .backlink-request p {
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.6;
  }

  .contribute-form h3 {
    color: var(--color-text);
    margin-bottom: 1.5rem;
    font-size: 1.25rem;
  }

  .submission-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 500;
    color: var(--color-text);
    font-size: 0.9rem;
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(27, 107, 90, 0.1);
  }

  .form-hint {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .checkbox-group label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-weight: normal;
    cursor: pointer;
  }

  .checkbox-group input {
    margin-top: 0.25rem;
    width: auto;
  }

  .form-message {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 8px;
    display: none;
  }

  .form-message.success {
    display: block;
    background: rgba(27, 107, 90, 0.1);
    color: var(--color-primary);
  }

  .form-message.error {
    display: block;
    background: rgba(180, 60, 60, 0.1);
    color: #b43c3c;
  }

  .faq-section {
    padding: 4rem 2rem;
    background: #fff;
  }

  .faq-section h2 {
    text-align: center;
    color: var(--color-text);
    margin-bottom: 2.5rem;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .faq-item {
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
  }

  .faq-item h3 {
    color: var(--color-text);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .faq-item p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .contribute-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .benefits-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .page-hero h1 {
      font-size: 2rem;
    }

    .contribute-header {
      flex-direction: column;
      text-align: center;
    }

    .contribute-content {
      padding: 1.5rem;
    }
  }
</style>

<script>
  // Photo form submission
  document.getElementById('photoForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const message = document.getElementById('photoMessage');
    const btn = form.querySelector('button');

    if (btn) btn.textContent = 'Submitting...';

    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      social: formData.get('social') || '',
      location: formData.get('location'),
      photoLink: formData.get('photoLink'),
      notes: formData.get('notes') || ''
    };

    try {
      const response = await fetch('/.netlify/functions/photo-contributor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (response.ok && result.success) {
        if (message) {
          message.textContent = result.message || 'Thank you! We\'ll review your photos and get back to you within 3-5 days.';
          message.className = 'form-message success';
        }
        form.reset();
      } else {
        throw new Error(result.error || 'Submission failed');
      }
    } catch (err) {
      if (message) {
        message.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again or email us directly.';
        message.className = 'form-message error';
      }
    }

    if (btn) btn.textContent = 'Submit Photos';
  });

  // Blog form submission
  document.getElementById('blogForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const message = document.getElementById('blogMessage');
    const btn = form.querySelector('button');

    if (btn) btn.textContent = 'Submitting...';

    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      website: formData.get('website') || '',
      topic: formData.get('topic'),
      outline: formData.get('outline'),
      experience: formData.get('experience') || ''
    };

    try {
      const response = await fetch('/.netlify/functions/blog-contributor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (response.ok && result.success) {
        if (message) {
          message.textContent = result.message || 'Thank you! We\'ll review your pitch and get back to you within 3-5 days.';
          message.className = 'form-message success';
        }
        form.reset();
      } else {
        throw new Error(result.error || 'Submission failed');
      }
    } catch (err) {
      if (message) {
        message.textContent = err instanceof Error ? err.message : 'Something went wrong. Please try again or email us directly.';
        message.className = 'form-message error';
      }
    }

    if (btn) btn.textContent = 'Submit Pitch';
  });
</script>
