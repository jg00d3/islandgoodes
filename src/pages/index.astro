---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Adults-Only Oceanview Accommodation in Hilo, Hawaii";
const description = "Island Goodes is an adults-only accommodation near Hilo with stunning ocean views and private rooms. No children under 18. Easy access to Volcanoes National Park. Book direct for best rates.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1>Island Goodes: Adults-Only Oceanview Accommodation in Hilo, Hawaii</h1>
      <p class="hero-tagline">Wake up to stunning views of Hilo Bay and Mauna Kea</p>
      <p class="hero-description">Your peaceful retreat for exploring the Big Island's east side. <strong>Adults only—no children under 18.</strong></p>
      <div class="hero-cta">
        <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary" target="_blank" rel="noopener">Book Your Stay</a>
        <a href="/rooms" class="btn btn-secondary">View Rooms</a>
      </div>
    </div>
  </section>

  <!-- Introduction -->
  <section class="intro">
    <div class="container">
      <h2>Your Home Base for Big Island Adventures</h2>
      <p class="lead">
        Nestled on a hillside just 5 minutes from downtown Hilo and 12 minutes from Hilo Airport,
        Island Goodes offers the perfect blend of tranquility and convenience. Our <strong>adults-only
        accommodation (no children under 18)</strong> provides a peaceful escape with breathtaking ocean views and easy
        access to Hawaii Volcanoes National Park, Rainbow Falls, and the scenic Hamakua Coast.
      </p>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </div>
          <h3>Private Rooms</h3>
          <p>Each room has its own private entrance, bathroom, and lanai. No shared spaces means maximum privacy and relaxation.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3>Ocean Views</h3>
          <p>Wake up to panoramic views of Hilo Bay and watch whales breach from your private lanai during winter months.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <h3>Adults Only (18+)</h3>
          <p>A peaceful, quiet environment for adults. No children under 18 permitted, ensuring a relaxing atmosphere for all guests.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <h3>Perfect Location</h3>
          <p>5 min to Hilo town, 45 min to Hawaii Volcanoes National Park, and surrounded by waterfalls and rainforest.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Rooms Preview -->
  <section class="rooms-preview">
    <div class="container">
      <h2>Our Rooms</h2>
      <p class="section-intro">Four uniquely decorated rooms, each with private entrance, bath, and lanai.</p>
      <div class="rooms-grid">
        <article class="room-card">
          <a href="/rooms/hilo-bay" class="room-image">
            <img src="/images/rooms/hilo-bay/bed.jpg" alt="Sleep Number bed in Hilo Bay Room at Island Goodes" loading="lazy" />
          </a>
          <div class="room-content">
            <h3>Hilo Bay Room</h3>
            <p>488 sq ft oceanview suite on the ground floor. Stunning views of Hilo Bay from your private lanai.</p>
            <ul class="room-features">
              <li>Ocean View</li>
              <li>Sleep Number Bed</li>
              <li>Private Lanai</li>
            </ul>
            <a href="/rooms/hilo-bay" class="btn btn-outline">View Details</a>
          </div>
        </article>
        <article class="room-card">
          <a href="/rooms/mauna-kea" class="room-image">
            <img src="/images/rooms/mauna-kea/bed.jpg" alt="Sleep Number bed in Mauna Kea Room at Island Goodes" loading="lazy" />
          </a>
          <div class="room-content">
            <h3>Mauna Kea Room</h3>
            <p>Spacious room with views toward Hawaii's tallest mountain. Perfect for stargazing enthusiasts.</p>
            <ul class="room-features">
              <li>Mountain View</li>
              <li>Sleep Number Bed</li>
              <li>Private Bath</li>
            </ul>
            <a href="/rooms/mauna-kea" class="btn btn-outline">View Details</a>
          </div>
        </article>
        <article class="room-card">
          <a href="/rooms/ginger" class="room-image">
            <img src="/images/rooms/ginger/room.jpg" alt="Bed in Ginger Room at Island Goodes" loading="lazy" />
          </a>
          <div class="room-content">
            <h3>Ginger Room</h3>
            <p>400 sq ft ground floor room surrounded by tropical gardens. A peaceful garden retreat.</p>
            <ul class="room-features">
              <li>Garden View</li>
              <li>Ground Floor</li>
              <li>Private Entry</li>
            </ul>
            <a href="/rooms/ginger" class="btn btn-outline">View Details</a>
          </div>
        </article>
        <article class="room-card">
          <a href="/rooms/orchid" class="room-image">
            <img src="/images/rooms/orchid/bed.jpg" alt="Sleep Number bed in Orchid Room at Island Goodes" loading="lazy" />
          </a>
          <div class="room-content">
            <h3>Orchid Room</h3>
            <p>Elegant oceanview suite with full kitchen. Perfect for extended stays with fresh local ingredients.</p>
            <ul class="room-features">
              <li>Ocean View</li>
              <li>Full Kitchen</li>
              <li>Private Lanai</li>
            </ul>
            <a href="/rooms/orchid" class="btn btn-outline">View Details</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Location Highlights -->
  <section class="location-highlights">
    <div class="container">
      <h2>Explore the Big Island's East Side</h2>
      <p class="section-intro">Island Goodes is perfectly positioned for exploring Hawaii's most spectacular attractions.</p>
      <div class="attractions-grid">
        <div class="attraction">
          <h3>Hawaii Volcanoes National Park</h3>
          <p><strong>45 minutes away</strong> - Witness active volcanic activity, hike through lava tubes, and see the glow of Kilauea crater.</p>
        </div>
        <div class="attraction">
          <h3>Rainbow Falls & Waterfalls</h3>
          <p><strong>10 minutes away</strong> - The famous 80-foot waterfall and dozens more along the scenic Hamakua Coast.</p>
        </div>
        <div class="attraction">
          <h3>Downtown Hilo</h3>
          <p><strong>5 minutes away</strong> - Historic town with farmers markets, local restaurants, shops, and the Pacific Tsunami Museum.</p>
        </div>
        <div class="attraction">
          <h3>Mauna Kea Summit</h3>
          <p><strong>1 hour away</strong> - World-class stargazing at 13,800 feet, above the clouds at the world's premier observatory site.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews Teaser -->
  <section class="reviews">
    <div class="container">
      <h2>What Our Guests Say</h2>
      <div class="reviews-grid">
        <blockquote class="review">
          <p>"Laura went above and beyond as a host. I will never stay anywhere else when visiting Hilo."</p>
          <cite>— TripAdvisor Guest</cite>
        </blockquote>
        <blockquote class="review">
          <p>"The rooms are tastefully decorated, very clean with comfortable beds. A perfect peaceful retreat."</p>
          <cite>— TripAdvisor Guest</cite>
        </blockquote>
        <blockquote class="review">
          <p>"A perfect base for exploring Mauna Kea and Volcanoes National Park. Beautiful property with sustainable farm."</p>
          <cite>— TripAdvisor Guest</cite>
        </blockquote>
      </div>
      <p class="reviews-cta">
        <a href="https://www.tripadvisor.com/Hotel_Review-g60605-d635399-Reviews-Island_Goode_s-Papaikou_Island_of_Hawaii_Hawaii.html" target="_blank" rel="noopener">Read more reviews on TripAdvisor</a>
      </p>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Experience Island Goodes?</h2>
      <p>Book direct for the best rates. Save up to 55% with our seasonal specials.</p>
      <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary btn-large" target="_blank" rel="noopener">Check Availability</a>
      <p class="cta-phone">Or call us: <a href="tel:+18089642291">808-964-2291</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 90vh;
    background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/images/hero.jpg') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 6rem 2rem 4rem;
  }

  .hero-content {
    max-width: 800px;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 1rem;
    text-shadow: 2px 2px 8px rgba(0,0,0,0.3);
  }

  .hero-tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .hero-description {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    opacity: 0.95;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-primary {
    background: var(--color-secondary);
    color: #fff;
  }

  .btn-primary:hover {
    background: #c49943;
    color: #fff;
  }

  .btn-secondary {
    background: transparent;
    color: #fff;
    border: 2px solid #fff;
  }

  .btn-secondary:hover {
    background: #fff;
    color: var(--color-primary);
  }

  .btn-outline {
    background: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }

  .btn-outline:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-large {
    padding: 1rem 3rem;
    font-size: 1.1rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  section {
    padding: 5rem 0;
  }

  section h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    text-align: center;
    margin-bottom: 1rem;
    color: var(--color-primary-dark);
  }

  .section-intro, .lead {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem;
    font-size: 1.1rem;
    color: var(--color-text-light);
  }

  .intro {
    background: var(--color-bg-alt);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature {
    text-align: center;
    padding: 2rem;
  }

  .feature-icon {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .feature h3 {
    margin-bottom: 0.75rem;
    color: var(--color-primary-dark);
  }

  .rooms-preview {
    background: var(--color-bg-alt);
  }

  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .room-card {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    transition: transform 0.3s;
  }

  .room-card:hover {
    transform: translateY(-5px);
  }

  .room-image {
    background: var(--color-bg-alt);
  }

  .room-image img {
    width: 100%;
    height: auto;
  }

  .room-content {
    padding: 1.5rem;
  }

  .room-content h3 {
    margin-bottom: 0.5rem;
    color: var(--color-primary-dark);
  }

  .room-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0;
  }

  .room-features li {
    background: var(--color-bg-alt);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .attractions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .attraction {
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border-radius: 8px;
    border-left: 4px solid var(--color-secondary);
  }

  .attraction h3 {
    color: var(--color-primary-dark);
    margin-bottom: 0.5rem;
  }

  .reviews {
    background: var(--color-primary-dark);
    color: #fff;
  }

  .reviews h2 {
    color: #fff;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .review {
    background: rgba(255,255,255,0.1);
    padding: 2rem;
    border-radius: 8px;
    border: none;
  }

  .review p {
    font-style: italic;
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .review cite {
    color: var(--color-secondary);
    font-style: normal;
  }

  .reviews-cta {
    text-align: center;
  }

  .reviews-cta a {
    color: var(--color-secondary);
  }

  .cta-section {
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
  }

  .cta-section h2 {
    color: #fff;
  }

  .cta-section p {
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .cta-phone {
    margin-top: 1.5rem;
  }

  .cta-phone a {
    color: var(--color-secondary);
    font-size: 1.25rem;
  }

  @media (max-width: 768px) {
    section {
      padding: 3rem 0;
    }

    .hero {
      min-height: 80vh;
    }
  }
</style>
