---
import PreviewLayout from '../layouts/PreviewLayout.astro';

const title = "Island Goodes";
const description = "Island Goodes is an adults-only accommodation near Hilo with stunning ocean views and private rooms. No children under 18. Easy access to Volcanoes National Park. Book direct for best rates.";
---

<PreviewLayout title={title} description={description}>
  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-background">
      <img src="/images/hero.jpg" alt="Ocean view from Island Goodes" />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-badge">Adults-Only Retreat</span>
      <h1>Island <span>Goodes</span></h1>
      <p class="hero-tagline">Oceanview accommodation on Hawaii's Big Island. Wake up to paradise every morning.</p>
      <div class="discount-banner">
        <span class="discount-tag">Special Offer</span>
        <span class="discount-text">Save 20% to 55% with seasonal discounts</span>
      </div>
      <div class="hero-cta">
        <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary btn-large" target="_blank" rel="noopener">Book Your Stay</a>
        <a href="/rooms" class="btn btn-secondary btn-large">Explore Rooms</a>
      </div>
      <p class="hero-phone"><a href="tel:+18089642291">808-964-2291</a></p>
    </div>
    <div class="hero-scroll-indicator">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- FEATURES SECTION -->
  <section class="features">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Why Choose Us</span>
        <h2>Experience Island Living</h2>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3>Ocean Views</h3>
          <p>Wake up to stunning views of Hilo Bay from your private lanai</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <h3>Adults Only</h3>
          <p>Peaceful retreat exclusively for guests 18 and older</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3>Private Rooms</h3>
          <p>Each room has its own entrance, bathroom, and lanai</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3>Prime Location</h3>
          <p>Minutes to Hilo, close to volcanoes and waterfalls</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROOMS PREVIEW -->
  <section class="rooms-preview">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Accommodations</span>
        <h2>Our Rooms</h2>
      </div>
      <div class="rooms-grid">
        <a href="/rooms/hilo-bay" class="room-card">
          <div class="room-card-image">
            <img src="/images/rooms/hilo-bay/bed.jpg" alt="Hilo Bay Room" loading="lazy" />
            <span class="room-price">From $225/night</span>
          </div>
          <div class="room-card-content">
            <h3>Hilo Bay Room</h3>
            <p>Our largest suite with panoramic ocean views</p>
            <div class="room-tags">
              <span class="tag">488 sq ft</span>
              <span class="tag">Ocean View</span>
              <span class="tag">King Bed</span>
            </div>
          </div>
        </a>
        <a href="/rooms/orchid" class="room-card">
          <div class="room-card-image">
            <img src="/images/rooms/orchid/bed.jpg" alt="Orchid Room" loading="lazy" />
            <span class="room-price">From $225/night</span>
          </div>
          <div class="room-card-content">
            <h3>Orchid Room</h3>
            <p>Oceanview suite with full kitchen</p>
            <div class="room-tags">
              <span class="tag">645 sq ft</span>
              <span class="tag">Full Kitchen</span>
              <span class="tag">Ocean View</span>
            </div>
          </div>
        </a>
        <a href="/rooms/mauna-kea" class="room-card">
          <div class="room-card-image">
            <img src="/images/rooms/mauna-kea/bed.jpg" alt="Mauna Kea Room" loading="lazy" />
            <span class="room-price">From $195/night</span>
          </div>
          <div class="room-card-content">
            <h3>Mauna Kea Room</h3>
            <p>Mountain views toward Hawaii's tallest peak</p>
            <div class="room-tags">
              <span class="tag">Mountain View</span>
              <span class="tag">Stargazing</span>
            </div>
          </div>
        </a>
        <a href="/rooms/ginger" class="room-card">
          <div class="room-card-image">
            <img src="/images/rooms/ginger/room.jpg" alt="Ginger Room" loading="lazy" />
            <span class="room-price">From $195/night</span>
          </div>
          <div class="room-card-content">
            <h3>Ginger Room</h3>
            <p>Ground floor garden retreat</p>
            <div class="room-tags">
              <span class="tag">400 sq ft</span>
              <span class="tag">Garden View</span>
              <span class="tag">Accessible</span>
            </div>
          </div>
        </a>
      </div>
      <div class="section-cta">
        <a href="/rooms" class="btn btn-outline">View All Rooms</a>
      </div>
    </div>
  </section>

  <!-- AMENITIES SECTION -->
  <section class="amenities-section">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Property Features</span>
        <h2>Relax & Unwind</h2>
      </div>
      <div class="amenities-grid">
        <div class="amenity-card amenity-large">
          <img src="/images/property/pool.jpg" alt="Swimming pool" loading="lazy" />
          <div class="amenity-content">
            <h3>Swimming Pool</h3>
            <p>Refreshing pool with ocean views</p>
          </div>
        </div>
        <div class="amenity-card">
          <img src="/images/property/hot-tub.jpg" alt="Hot tub" loading="lazy" />
          <div class="amenity-content">
            <h3>Hot Tub</h3>
            <p>Relax under the stars</p>
          </div>
        </div>
        <div class="amenity-card">
          <img src="/images/rooms/hilo-bay/lanai.jpg" alt="Ocean view lanai" loading="lazy" />
          <div class="amenity-content">
            <h3>Private Lanais</h3>
            <p>Your own outdoor retreat</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Guest Reviews</span>
        <h2>What Our Guests Say</h2>
      </div>
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote class="testimonial-quote">
            "The views are absolutely incredible. We watched whales from our lanai every morning. Garvin and Laura are wonderful hosts!"
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar">JM</div>
            <div class="author-info">
              <span class="author-name">Jennifer M.</span>
              <span class="author-location">California</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote class="testimonial-quote">
            "Perfect location for exploring the Big Island. The room was spotless and the bed was the most comfortable we've ever slept in."
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar">RS</div>
            <div class="author-info">
              <span class="author-name">Robert S.</span>
              <span class="author-location">Texas</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote class="testimonial-quote">
            "This place is a hidden gem. Peaceful, beautiful, and exactly what we needed for our anniversary trip."
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar">KL</div>
            <div class="author-info">
              <span class="author-name">Karen L.</span>
              <span class="author-location">Oregon</span>
            </div>
          </div>
        </div>
      </div>
      <div class="section-cta">
        <a href="/reviews" class="btn btn-outline">Read More Reviews</a>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="cta-section">
    <div class="cta-background">
      <img src="/images/hero-ocean-view.jpg" alt="Ocean view" />
    </div>
    <div class="cta-overlay"></div>
    <div class="cta-content">
      <h2>Ready for Paradise?</h2>
      <p>Book direct for the best rates and personal service</p>
      <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary btn-large" target="_blank" rel="noopener">Check Availability</a>
    </div>
  </section>
</PreviewLayout>

<style>
  /* HERO */
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: heroZoom 20s ease-in-out infinite alternate;
  }

  @keyframes heroZoom {
    from { transform: scale(1); }
    to { transform: scale(1.05); }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.5) 70%, rgba(0,0,0,0.7) 100%),
      radial-gradient(ellipse at center bottom, rgba(27,107,90,0.2) 0%, transparent 60%);
  }

  .hero-content {
    text-align: center;
    color: #fff;
    max-width: 900px;
    padding: 2rem;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(10px);
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255,255,255,0.2);
  }

  .hero h1 {
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 400;
    margin-bottom: 1rem;
    text-shadow: 0 4px 30px rgba(0,0,0,0.3);
  }

  .hero h1 span {
    color: var(--color-secondary-light);
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 400;
    opacity: 0.95;
    margin-bottom: 1.5rem;
    max-width: 550px;
    margin-inline: auto;
    line-height: 1.6;
  }

  .discount-banner {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(197, 165, 114, 0.2);
    backdrop-filter: blur(10px);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    margin-bottom: 2rem;
    border: 1px solid rgba(197, 165, 114, 0.3);
  }

  .discount-tag {
    background: var(--color-secondary);
    color: #1a1a1a;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .discount-text {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hero-phone {
    font-size: 1.125rem;
    opacity: 0.9;
  }

  .hero-phone a {
    color: #fff;
  }

  .hero-phone a:hover {
    color: var(--color-secondary-light);
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.7);
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }

  /* FEATURES */
  .features {
    padding: var(--section-padding) 0;
    background: var(--color-bg-warm);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    text-align: center;
    padding: 2rem;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    transition: var(--transition-base);
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
  }

  .feature-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-subtle);
    border-radius: 16px;
    color: var(--color-primary);
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .feature-card p {
    color: var(--color-text-light);
    font-size: 0.9375rem;
  }

  /* ROOMS */
  .rooms-preview {
    padding: var(--section-padding) 0;
  }

  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .room-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    transition: var(--transition-base);
    border: 1px solid rgba(0,0,0,0.04);
  }

  .room-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.1);
  }

  .room-card-image {
    position: relative;
    aspect-ratio: 16/11;
    overflow: hidden;
  }

  .room-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-slow);
  }

  .room-card:hover .room-card-image img {
    transform: scale(1.08);
  }

  .room-price {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(10px);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .room-card-content {
    padding: 1.5rem;
  }

  .room-card-content h3 {
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .room-card-content p {
    color: var(--color-text-light);
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }

  .room-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: var(--color-bg-alt);
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-light);
  }

  /* AMENITIES */
  .amenities-section {
    padding: var(--section-padding) 0;
    background: var(--color-bg-alt);
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 1.5rem;
  }

  .amenity-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16/10;
  }

  .amenity-card.amenity-large {
    grid-row: span 2;
    aspect-ratio: auto;
  }

  .amenity-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-slow);
  }

  .amenity-card:hover img {
    transform: scale(1.05);
  }

  .amenity-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    background: linear-gradient(transparent, rgba(0,0,0,0.8));
    color: #fff;
  }

  .amenity-content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .amenity-content p {
    font-size: 0.875rem;
    opacity: 0.9;
  }

  /* TESTIMONIALS */
  .testimonials {
    padding: var(--section-padding) 0;
    background: var(--color-bg-warm);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .testimonial-card {
    background: #fff;
    padding: 2rem;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }

  .testimonial-stars {
    color: var(--color-secondary);
    font-size: 1.25rem;
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }

  .testimonial-quote {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 1.5rem;
    position: relative;
    padding-left: 1.5rem;
    border-left: 3px solid var(--color-secondary);
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--gradient-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 600;
    color: var(--color-text);
  }

  .author-location {
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  /* CTA */
  .cta-section {
    position: relative;
    padding: var(--section-padding) 2rem;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cta-background {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .cta-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gradient-primary);
    opacity: 0.9;
  }

  .cta-content {
    text-align: center;
    color: #fff;
  }

  .cta-content h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .cta-content p {
    font-size: 1.125rem;
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .amenities-grid {
      grid-template-columns: 1fr;
    }

    .amenity-card.amenity-large {
      grid-row: span 1;
      aspect-ratio: 16/10;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

    .discount-banner {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
