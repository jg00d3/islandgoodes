---
import PreviewLayout from '../layouts/PreviewLayout.astro';

const title = "Island Goodes";
const description = "Island Goodes is an adults-only accommodation near Hilo with stunning ocean views and private rooms. No children under 18. Easy access to Volcanoes National Park. Book direct for best rates.";
---

<PreviewLayout title={title} description={description}>
  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-background">
      <img src="/images/hero.jpg" alt="Ocean view from Island Goodes" fetchpriority="high" decoding="async" />
    </div>
    <div class="hero-overlay"></div>

    <!-- Weather & Time Widget -->
    <div class="weather-widget" id="weatherWidget">
      <div class="weather-time" id="localTime">--:--</div>
      <div class="weather-location">Hilo, Hawaii</div>
      <div class="weather-info">
        <span class="weather-temp" id="weatherTemp">--°F</span>
        <span class="weather-desc" id="weatherDesc">Loading...</span>
      </div>
    </div>

    <div class="hero-content">
      <span class="hero-badge">Adults-Only Retreat</span>
      <h1>Island <span>Goodes</span></h1>
      <p class="hero-tagline">Oceanview accommodation on Hawaii's Big Island. Wake up to paradise every morning.</p>
      <div class="discount-banner">
        <span class="discount-tag">Special Offer</span>
        <span class="discount-text">Save up to 55% with seasonal discounts</span>
      </div>
      <div class="hero-cta">
        <a href="/book" class="btn btn-primary btn-large">Book Your Stay</a>
        <a href="/rooms" class="btn btn-secondary btn-large">Explore Rooms</a>
      </div>
      <p class="hero-phone"><a href="tel:+18089642291">808-964-2291</a></p>
    </div>
    <div class="hero-scroll-indicator">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- FEATURES SECTION -->
  <section class="features">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Why Choose Us</span>
        <h2>Experience Island Living</h2>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3>Ocean Views</h3>
          <p>Wake up to stunning views of Hilo Bay from your private lanai</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <h3>Adults Only</h3>
          <p>18+ only. Traditional accommodation, not clothing-optional</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3>Private Rooms</h3>
          <p>Each room has its own entrance, bathroom, and lanai</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3>Prime Location</h3>
          <p>Minutes to Hilo, close to volcanoes and waterfalls</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROOMS PREVIEW -->
  <section class="rooms-preview">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Accommodations</span>
        <h2>Our Rooms</h2>
      </div>
      <div class="rooms-grid">
        <a href="/rooms/hilo-bay" class="room-card">
          <div class="room-card-image">
            <img src="/images/rooms/hilo-bay/bed.jpg" alt="Hilo Bay Room" loading="lazy" />
            <span class="room-price">From $225/night</span>
          </div>
          <div class="room-card-content">
            <h3>Hilo Bay Room</h3>
            <p>Panoramic ocean views, very popular with guests</p>
            <div class="room-tags">
              <span class="tag">488 sq ft</span>
              <span class="tag">Ocean View</span>
              <span class="tag">Sleep Number King Bed</span>
            </div>
          </div>
        </a>
        <a href="/rooms/orchid" class="room-card">
          <div class="room-card-image">
            <img src="/images/rooms/orchid/bed.jpg" alt="Orchid Room" loading="lazy" />
            <span class="room-price">From $225/night</span>
          </div>
          <div class="room-card-content">
            <h3>Orchid Room</h3>
            <p>Oceanview suite with kitchenette</p>
            <div class="room-tags">
              <span class="tag">645 sq ft</span>
              <span class="tag">Kitchenette</span>
              <span class="tag">Ocean View</span>
            </div>
          </div>
        </a>
        <a href="/rooms/mauna-kea" class="room-card">
          <div class="room-card-image">
            <img src="/images/rooms/mauna-kea/bed.jpg" alt="Mauna Kea Room" loading="lazy" />
            <span class="room-price">From $195/night</span>
          </div>
          <div class="room-card-content">
            <h3>Mauna Kea Room</h3>
            <p>Mountain views toward Hawaii's tallest peak</p>
            <div class="room-tags">
              <span class="tag">527 sq ft</span>
              <span class="tag">Mountain View</span>
              <span class="tag">Stargazing</span>
            </div>
          </div>
        </a>
        <a href="/rooms/ginger" class="room-card">
          <div class="room-card-image">
            <img src="/images/rooms/ginger/room.jpg" alt="Ginger Room" loading="lazy" />
            <span class="room-price">From $195/night</span>
          </div>
          <div class="room-card-content">
            <h3>Ginger Room</h3>
            <p>Ground floor garden retreat</p>
            <div class="room-tags">
              <span class="tag">400 sq ft</span>
              <span class="tag">Garden View</span>
              <span class="tag">Easy Access</span>
            </div>
          </div>
        </a>
      </div>
      <div class="section-cta">
        <a href="/rooms" class="btn btn-outline">View All Rooms</a>
      </div>
    </div>
  </section>

  <!-- AMENITIES SECTION -->
  <section class="amenities-section">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Property Features</span>
        <h2>Relax & Unwind</h2>
      </div>
      <div class="amenities-grid">
        <div class="amenity-card amenity-large">
          <img src="/images/site/pool.jpg" alt="Swimming pool" loading="lazy" />
          <div class="amenity-content">
            <h3>Swimming Pool</h3>
            <p>Refreshing pool with ocean views</p>
          </div>
        </div>
        <div class="amenity-card">
          <img src="/images/site/hot-tub.jpg" alt="Hot tub" loading="lazy" />
          <div class="amenity-content">
            <h3>Hot Tub</h3>
            <p>Relax under the stars</p>
          </div>
        </div>
        <div class="amenity-card">
          <img src="/images/scenery/island-goodes-view.jpg" alt="Island Goodes property with tropical palms" loading="lazy" />
          <div class="amenity-content">
            <h3>Tropical Setting</h3>
            <p>Surrounded by palm trees and gardens</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Guest Reviews</span>
        <h2>What Our Guests Say</h2>
      </div>
      <div class="tripadvisor-mini-badge">
        <a href="https://www.tripadvisor.com/Hotel_Review-g60605-d635399-Reviews-Island_Goode_s-Papaikou_Island_of_Hawaii_Hawaii.html" target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#34E0A1">
            <circle cx="6.5" cy="14" r="3" fill="none" stroke="#34E0A1" stroke-width="1.5"/>
            <circle cx="17.5" cy="14" r="3" fill="none" stroke="#34E0A1" stroke-width="1.5"/>
            <circle cx="6.5" cy="14" r="1"/>
            <circle cx="17.5" cy="14" r="1"/>
            <path d="M12 5 C7 5 5 8 5 10 M12 5 C17 5 19 8 19 10" fill="none" stroke="#34E0A1" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="ta-mini-rating">4.9</span>
          <span class="ta-mini-stars">★★★★★</span>
          <span class="ta-mini-text">on TripAdvisor</span>
        </a>
      </div>
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote class="testimonial-quote">
            "The views are absolutely incredible. We watched whales from our lanai every morning. Garvin and Laura are wonderful hosts!"
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar">JM</div>
            <div class="author-info">
              <span class="author-name">Jennifer M.</span>
              <span class="author-location">California</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote class="testimonial-quote">
            "Perfect location for exploring the Big Island. The room was spotless and the bed was the most comfortable we've ever slept in."
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar">RS</div>
            <div class="author-info">
              <span class="author-name">Robert S.</span>
              <span class="author-location">Texas</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <blockquote class="testimonial-quote">
            "This place is a hidden gem. Peaceful, beautiful, and exactly what we needed for our anniversary trip."
          </blockquote>
          <div class="testimonial-author">
            <div class="author-avatar">KL</div>
            <div class="author-info">
              <span class="author-name">Karen L.</span>
              <span class="author-location">Oregon</span>
            </div>
          </div>
        </div>
      </div>
      <div class="section-cta">
        <a href="/reviews" class="btn btn-outline">Read More Reviews</a>
      </div>
    </div>
  </section>

  <!-- LIVE CAMERAS SECTION -->
  <section class="live-cameras">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">See Hawaii Right Now</span>
        <h2>Live Island Views</h2>
      </div>
      <p class="cameras-intro">Get a glimpse of what awaits you on the Big Island with these live webcams from nearby attractions.</p>
      <div class="cameras-grid">
        <div class="camera-card">
          <div class="camera-embed">
            <iframe
              src="https://www.youtube.com/embed/tk0tfYDxrUA?autoplay=0&mute=1"
              title="USGS Kilauea Volcano V1cam Live"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="camera-info">
            <h3>Kilauea V1cam (West)</h3>
            <p>USGS view from northwest rim of Halema'uma'u</p>
          </div>
        </div>
        <div class="camera-card">
          <div class="camera-embed">
            <iframe
              src="https://www.youtube.com/embed/fiyttmA7YkA?autoplay=0&mute=1"
              title="USGS Kilauea Volcano V2cam Live"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="camera-info">
            <h3>Kilauea V2cam (East)</h3>
            <p>USGS view from northeast rim of the caldera</p>
          </div>
        </div>
        <div class="camera-card">
          <div class="camera-embed">
            <iframe
              src="https://www.youtube.com/embed/gXKuUyKt8mc?autoplay=0&mute=1"
              title="USGS Kilauea Volcano V3cam Live"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="camera-info">
            <h3>Kilauea V3cam (South)</h3>
            <p>USGS view from south rim of Halema'uma'u</p>
          </div>
        </div>
        <div class="camera-card">
          <div class="camera-embed">
            <iframe
              src="https://www.youtube.com/embed/6g4Fh8K-MhY?autoplay=0&mute=1"
              title="Subaru-Asahi StarCam Maunakea Live"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="camera-info">
            <h3>Mauna Kea Summit</h3>
            <p>Subaru Telescope StarCam - best at night for stargazing</p>
          </div>
        </div>
      </div>
      <p class="cameras-note">Cameras may be offline during maintenance or inclement weather</p>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="cta-section">
    <div class="cta-content">
      <h2>Ready for Paradise?</h2>
      <p>Book direct for the best rates and personal service</p>
      <a href="/book" class="btn btn-primary btn-large">Check Availability</a>
    </div>
  </section>
</PreviewLayout>

<style>
  /* HERO */
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: heroZoom 20s ease-in-out infinite alternate;
  }

  @keyframes heroZoom {
    from { transform: scale(1); }
    to { transform: scale(1.05); }
  }

  /* Image loading optimization */
  .hero-background img,
  .cta-background img,
  .room-card-image img,
  .amenity-card img {
    content-visibility: auto;
  }

  /* Lazy sections for better performance */
  .amenities-section,
  .testimonials,
  .live-cameras,
  .cta-section {
    content-visibility: auto;
    contain-intrinsic-size: 0 500px;
  }

  /* Weather Widget */
  .weather-widget {
    position: absolute;
    top: 6rem;
    right: 2rem;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    padding: 1rem 1.25rem;
    border-radius: 12px;
    color: #fff;
    text-align: center;
    z-index: 10;
    border: 1px solid rgba(255,255,255,0.15);
  }

  .weather-time {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .weather-location {
    font-size: 0.75rem;
    opacity: 0.8;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .weather-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .weather-temp {
    font-weight: 600;
  }

  .weather-icon {
    font-size: 1.25rem;
  }

  @media (max-width: 768px) {
    .weather-widget {
      top: 5rem;
      right: 1rem;
      padding: 0.75rem 1rem;
    }
    .weather-time {
      font-size: 1.5rem;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.5) 70%, rgba(0,0,0,0.7) 100%),
      radial-gradient(ellipse at center bottom, rgba(27,107,90,0.2) 0%, transparent 60%);
  }

  .hero-content {
    text-align: center;
    color: #fff;
    max-width: 900px;
    padding: 2rem;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(10px);
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255,255,255,0.2);
  }

  .hero h1 {
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 400;
    margin-bottom: 1rem;
    text-shadow: 0 4px 30px rgba(0,0,0,0.3);
  }

  .hero h1 span {
    color: var(--color-secondary-light);
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 400;
    opacity: 0.95;
    margin-bottom: 1.5rem;
    max-width: 550px;
    margin-inline: auto;
    line-height: 1.6;
  }

  .discount-banner {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(197, 165, 114, 0.2);
    backdrop-filter: blur(10px);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    margin-bottom: 2rem;
    border: 1px solid rgba(197, 165, 114, 0.3);
  }

  .discount-tag {
    background: var(--color-secondary);
    color: #1a1a1a;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .discount-text {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hero-phone {
    font-size: 1.125rem;
    opacity: 0.9;
  }

  .hero-phone a {
    color: #fff;
  }

  .hero-phone a:hover {
    color: var(--color-secondary-light);
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.7);
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }

  /* FEATURES */
  .features {
    padding: var(--section-padding) 0;
    background: var(--color-bg-warm);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    text-align: center;
    padding: 2rem;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    transition: var(--transition-base);
  }

  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
  }

  .feature-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-subtle);
    border-radius: 16px;
    color: var(--color-primary);
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .feature-card p {
    color: var(--color-text-light);
    font-size: 0.9375rem;
  }

  /* ROOMS */
  .rooms-preview {
    padding: var(--section-padding) 0;
  }

  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .room-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    transition: var(--transition-base);
    border: 1px solid rgba(0,0,0,0.04);
  }

  .room-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.1);
  }

  .room-card-image {
    position: relative;
    aspect-ratio: 16/11;
    overflow: hidden;
  }

  .room-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-slow);
  }

  .room-card:hover .room-card-image img {
    transform: scale(1.08);
  }

  .room-price {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(10px);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .room-card-content {
    padding: 1.5rem;
  }

  .room-card-content h3 {
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .room-card-content p {
    color: var(--color-text-light);
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }

  .room-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: var(--color-bg-alt);
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-light);
  }

  /* AMENITIES */
  .amenities-section {
    padding: var(--section-padding) 0;
    background: var(--color-bg-alt);
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 1.5rem;
  }

  .amenity-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16/10;
  }

  .amenity-card.amenity-large {
    grid-row: span 2;
    aspect-ratio: auto;
  }

