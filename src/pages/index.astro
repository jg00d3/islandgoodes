<script>
  // Check admin settings for homepage widgets (uses shared storage)
  (async function() {
    try {
      if (typeof SharedData === 'undefined') return;
      const settings = await SharedData.getSettings() || {};

      // Hide weather widget if disabled
      if (settings.weatherWidgetEnabled === false) {
        document.getElementById('weatherWidget')?.remove();
      }

      // Hide cameras section if disabled
      if (settings.camerasEnabled === false) {
        document.querySelector('.live-cameras')?.remove();
      }
    } catch(e) {}
  })();

  // Weather Widget - Hawaii Time and Weather
  function updateTime() {
    const now = new Date();
    const hawaiiTime = new Date(now.toLocaleString('en-US', { timeZone: 'Pacific/Honolulu' }));
    const hours = hawaiiTime.getHours();
    const minutes = hawaiiTime.getMinutes();
    const ampm = hours >= 12 ? 'PM' : 'AM';
    const displayHours = hours % 12 || 12;
    const displayMinutes = minutes.toString().padStart(2, '0');
    const timeEl = document.getElementById('localTime');
    if (timeEl) {
      timeEl.textContent = `${displayHours}:${displayMinutes} ${ampm}`;
    }
  }

  async function fetchWeather() {
    // Hilo, Hawaii coordinates
    const lat = 19.7297;
    const lon = -155.0900;

    try {
      // Using Open-Meteo API (free, no API key required)
      const response = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&temperature_unit=fahrenheit&timezone=Pacific%2FHonolulu`
      );
      const data = await response.json();

      if (data.current) {
        const temp = Math.round(data.current.temperature_2m);
        const code = data.current.weather_code;

        // Weather code to description
        const weatherMap = {
          0: { desc: 'Clear', icon: '☀️' },
          1: { desc: 'Mostly Clear', icon: '🌤️' },
          2: { desc: 'Partly Cloudy', icon: '⛅' },
          3: { desc: 'Overcast', icon: '☁️' },
          45: { desc: 'Foggy', icon: '🌫️' },
          48: { desc: 'Fog', icon: '🌫️' },
          51: { desc: 'Light Drizzle', icon: '🌦️' },
          53: { desc: 'Drizzle', icon: '🌦️' },
          55: { desc: 'Heavy Drizzle', icon: '🌧️' },
          61: { desc: 'Light Rain', icon: '🌦️' },
          63: { desc: 'Rain', icon: '🌧️' },
          65: { desc: 'Heavy Rain', icon: '🌧️' },
          80: { desc: 'Light Showers', icon: '🌦️' },
          81: { desc: 'Showers', icon: '🌧️' },
          82: { desc: 'Heavy Showers', icon: '🌧️' },
          95: { desc: 'Thunderstorm', icon: '⛈️' }
        };

        const weather = weatherMap[code] || { desc: 'Tropical', icon: '🌴' };

        const tempEl = document.getElementById('weatherTemp');
        const descEl = document.getElementById('weatherDesc');

        if (tempEl) tempEl.textContent = `${temp}°F`;
        if (descEl) descEl.innerHTML = `<span class="weather-icon">${weather.icon}</span> ${weather.desc}`;
      }
    } catch (error) {
      console.log('Weather fetch error:', error);
      const descEl = document.getElementById('weatherDesc');
      if (descEl) descEl.textContent = 'Tropical Paradise';
    }
  }

  // Initialize
  updateTime();
  fetchWeather();

  // Update time every minute
  setInterval(updateTime, 60000);

  // Update weather every 30 minutes
  setInterval(fetchWeather, 1800000);
</script>
