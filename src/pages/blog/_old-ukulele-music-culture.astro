    padding: 10rem 2rem 4rem;
    text-align: center;
  }

  .post-header .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .category {
    background: var(--color-secondary);
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }

