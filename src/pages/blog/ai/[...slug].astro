---
import PreviewLayout from '../../../layouts/PreviewLayout.astro';
import blogDrafts from '../../../data/blog-drafts-data.json';

export function getStaticPaths() {
  return blogDrafts.map(draft => ({
    params: { slug: draft.slug },
    props: { draft }
  }));
}

const { draft } = Astro.props;

const title = draft.title;
const description = draft.metaDescription || draft.excerpt || '';
const publishDate = draft.date.split('T')[0];
const formattedDate = new Date(draft.date).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});

const blogPostSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": publishDate,
  "dateModified": publishDate,
  "author": {
    "@type": "Organization",
    "name": "Island Goodes"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Island Goodes",
    "logo": {
      "@type": "ImageObject",
      "url": "https://islandgoodes.com/images/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://islandgoodes.com/blog/ai/${draft.slug}`
  }
};

// Parse body into sections for rendering
function parseBody(body) {
  return body.split('\n\n').map(block => {
    block = block.trim();
    if (!block) return null;
    if (block.startsWith('## ')) return { type: 'h2', text: block.replace('## ', '') };
    if (block.startsWith('### ')) return { type: 'h3', text: block.replace('### ', '') };
    return { type: 'p', text: block };
  }).filter(Boolean);
}

const sections = parseBody(draft.body || '');
---

<PreviewLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostSchema)} />
  <article class="blog-post">
    <header class="post-header">
      <div class="post-header-bg">
        <div class="post-header-gradient"></div>
      </div>
      <div class="post-header-overlay"></div>
      <div class="post-header-content">
        <nav class="breadcrumb">
          <a href="/">Home</a> / <a href="/blog">Blog</a> / {title}
        </nav>
        <span class="category">{draft.category}</span>
        <h1>{title}</h1>
        {draft.excerpt && <p class="excerpt">{draft.excerpt}</p>}
        <time datetime={publishDate}>{formattedDate}</time>
      </div>
    </header>

    <div class="post-content">
      <div class="container">
        {sections.map((section, i) => {
          if (section.type === 'h2') return <h2>{section.text}</h2>;
          if (section.type === 'h3') return <h3>{section.text}</h3>;
          if (i === 0) return <p class="lead">{section.text}</p>;
          return <p>{section.text}</p>;
        })}

        <div class="cta-box">
          <h3>Plan Your Big Island Adventure</h3>
          <p>Island Goodes is the perfect home base for exploring everything the Big Island has to offer. Located in Papaikou with stunning ocean views, just minutes from Hilo.</p>
          <a href="/book" class="btn btn-primary">Check Availability</a>
        </div>
      </div>
    </div>

    <div class="post-footer">
      <div class="container">
        <a href="/blog" class="back-link">Back to Blog</a>
      </div>
    </div>
  </article>
</PreviewLayout>

<style>
  .blog-post { padding-bottom: 4rem; }

  .post-header {
    position: relative;
    min-height: 45vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 10rem 2rem 4rem;
  }

  .post-header-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .post-header-gradient {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 50%, #0a3d32 100%);
  }

  .post-header-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.4) 100%);
  }

  .post-header-content {
    max-width: 800px;
  }

  .breadcrumb {
    font-size: 0.875rem;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .breadcrumb a { color: #fff; text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  .category {
    display: inline-block;
    background: var(--color-secondary);
    color: #1a1a1a;
    padding: 0.375rem 0.875rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 1rem;
  }

  .post-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .excerpt {
    font-size: 1.125rem;
    opacity: 0.9;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  time {
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .post-content {
    padding: 3rem 0;
  }

  .post-content .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .post-content .lead {
    font-size: 1.1875rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: 2rem;
  }

  .post-content h2 {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin: 2.5rem 0 1rem;
    line-height: 1.3;
  }

  .post-content h3 {
    font-size: 1.25rem;
    color: var(--color-text);
    margin: 2rem 0 0.75rem;
  }

  .post-content p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .cta-box {
    background: var(--color-bg-alt);
    border-radius: 16px;
    padding: 2.5rem;
    text-align: center;
    margin-top: 3rem;
  }

  .cta-box h3 {
    color: var(--color-text);
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }

  .cta-box p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 0.875rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s;
  }

  .btn-primary:hover { background: var(--color-primary-dark); }

  .post-footer {
    border-top: 1px solid #eee;
    padding: 2rem 0;
  }

  .post-footer .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .back-link:hover { color: var(--color-primary-dark); }

  @media (max-width: 640px) {
    .post-header { padding: 8rem 1.5rem 3rem; min-height: 35vh; }
    .cta-box { padding: 2rem 1.5rem; }
  }
</style>
