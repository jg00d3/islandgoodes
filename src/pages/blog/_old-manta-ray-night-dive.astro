    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .post-content ul, .post-content ol {
    margin: 1rem 0 1rem 1.5rem;
    line-height: 1.8;
  }

  .post-content li {
    margin-bottom: 0.5rem;
  }

  .cta-box {
    background: var(--color-bg-alt);
    padding: 2rem;
    border-radius: 8px;
    margin-top: 3rem;
    text-align: center;
  }

  .cta-box h3 {
    color: var(--color-primary-dark);
    margin-top: 0;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    margin-top: 1rem;
