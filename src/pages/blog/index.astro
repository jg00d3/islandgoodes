---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Big Island Travel Blog";
const description = "Travel tips, guides, and insider knowledge for visiting Hilo and the Big Island of Hawaii. Discover volcanoes, waterfalls, beaches, and local favorites.";

// Blog posts - 12 posts
const allPosts = [
  {
    slug: "hawaii-volcanoes-national-park",
    title: "Hawaii Volcanoes National Park: Complete Visitor's Guide",
    excerpt: "Everything you need to know about visiting one of the world's most unique national parks, just 45 minutes from Island Goodes.",
    date: "2026-01-01",
    category: "Attractions",
    image: "/images/blog/volcanoes.jpg"
  },
  {
    slug: "best-poke-hilo",
    title: "Best Poke in Hilo: A Local's Guide to Fresh Fish",
    excerpt: "Discover where locals go for the freshest poke bowls in Hilo. From historic fish markets to hidden gems.",
    date: "2025-12-15",
    category: "Food & Dining",
    image: "/images/blog/poke-bowl.jpg"
  },
  {
    slug: "whale-watching-hawaii",
    title: "Whale Watching Season in Hawaii: Your Complete Guide",
    excerpt: "Humpback whales visit Hawaii from December through April. Learn the best spots, tours, and tips for whale watching on the Big Island.",
    date: "2025-12-01",
    category: "Nature",
    image: "/images/blog/whale-watching.jpg"
  },
  {
    slug: "uncle-roberts-night-market",
    title: "Uncle Robert's Wednesday Night Market: The Real Puna Experience",
    excerpt: "Experience authentic Hawaiian culture at Kalapana's famous night market. Live music, awa bar, local food, and genuine aloha.",
    date: "2025-11-20",
    category: "Events & Culture",
    image: "/images/blog/uncle-roberts.jpg"
  },
  {
    slug: "mauna-kea-stargazing",
    title: "Stargazing on Mauna Kea: What to Know Before You Go",
    excerpt: "Tips for experiencing world-class stargazing at 13,800 feet, from the best times to visit to what to bring.",
    date: "2025-11-01",
    category: "Activities",
    image: "/images/blog/mauna-kea.jpg"
  },
  {
    slug: "swimming-holes-hilo",
    title: "Hidden Swimming Holes Near Hilo: A Local's Guide",
    excerpt: "Discover secret swimming holes and freshwater pools near Hilo. Cool off in waterfalls, rivers, and natural pools along the Hamakua Coast.",
    date: "2025-10-25",
    category: "Nature",
    image: "/images/blog/swimming-hole.jpg"
  },
  {
    slug: "kona-coffee-tours",
    title: "Kona Coffee Farm Tours: Experience Hawaii's Famous Brew",
    excerpt: "Visit Kona coffee farms and learn about Hawaii's world-famous coffee. Tours, tastings, and history behind the Big Island's beloved crop.",
    date: "2025-10-01",
    category: "Activities",
    image: "/images/blog/coffee-farm.jpg"
  },
  {
    slug: "black-sand-beaches",
    title: "Black Sand Beaches: A Guide to Hawaii's Unique Shorelines",
    excerpt: "Discover the Big Island's stunning black sand beaches formed from volcanic lava. Visit Punalu'u, Kehena, and other unique beaches.",
    date: "2025-09-01",
    category: "Nature",
    image: "/images/blog/black-sand-beach.jpg"
  },
  {
    slug: "snorkeling-big-island",
    title: "Best Snorkeling Spots on the Big Island",
    excerpt: "Discover the Big Island's top snorkeling locations from Richardson Beach to Kealakekua Bay. Crystal-clear waters and colorful marine life await.",
    date: "2025-08-01",
    category: "Activities",
    image: "/images/blog/snorkeling.jpg"
  },
  {
    slug: "hilo-farmers-market",
    title: "Hilo Farmers Market: Your Complete Guide",
    excerpt: "Everything you need to know about visiting Hawaii's best farmers market. Fresh tropical fruits, local crafts, and authentic Hawaiian culture.",
    date: "2025-07-01",
    category: "Local Guide",
    image: "/images/blog/night-market.jpg"
  },
  {
    slug: "hamakua-coast-waterfalls",
    title: "The Best Waterfalls on the Hamakua Coast",
    excerpt: "From Rainbow Falls to Akaka Falls, discover the stunning waterfalls along one of Hawaii's most scenic drives.",
    date: "2025-06-01",
    category: "Nature",
    image: "/images/blog/waterfalls.jpg"
  },
  {
    slug: "downtown-hilo-guide",
    title: "A Local's Guide to Downtown Hilo",
    excerpt: "Farmers markets, historic buildings, local restaurants, and hidden gems in Hawaii's most authentic town.",
    date: "2025-05-01",
    category: "Local Guide",
    image: "/images/blog/hilo-town.jpg"
  }
];

// Filter to only show posts where the date has passed (auto-publish system)
const today = new Date();
today.setHours(23, 59, 59, 999); // Include posts from today

const posts = allPosts
  .filter(post => new Date(post.date) <= today)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const categories = [...new Set(posts.map(p => p.category))];
---

<PreviewLayout title={title} description={description}>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img src="/images/blog-hero.jpg" alt="Big Island Hawaii landscape" />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
      <nav class="breadcrumb">
        <a href="/">Home</a> / Blog
      </nav>
      <h1>Big Island Travel Blog</h1>
      <p class="tagline">Insider tips and guides from your hosts at Island Goodes</p>
    </div>
  </section>

  <section class="blog-section">
    <div class="container">
      <p class="blog-intro">
        We've lived on the Big Island for years and love sharing our knowledge with guests.
        Browse our guides below to help plan your perfect Hawaiian adventure.
      </p>

      <div class="blog-grid">
        {posts.map(post => (
          <article class="blog-card">
            <a href={`/blog/${post.slug}`} class="blog-image">
              <img src={post.image} alt={post.title} loading="lazy" />
              <span class="category">{post.category}</span>
            </a>
            <div class="blog-content">
              <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
              <h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
              <p>{post.excerpt}</p>
              <a href={`/blog/${post.slug}`} class="read-more">Read More →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="topics">
    <div class="container">
      <div class="section-header center">
        <span class="section-subtitle">Filter by Category</span>
        <h2>Explore by Topic</h2>
      </div>
      <div class="topics-grid">
        <button type="button" class="topic-card active" data-category="all">
          <div class="topic-icon">📚</div>
          <h3>All Posts</h3>
          <p>View all articles</p>
        </button>
        <button type="button" class="topic-card" data-category="attractions">
          <div class="topic-icon">🌋</div>
          <h3>Attractions</h3>
          <p>Volcanoes, gardens, museums</p>
        </button>
        <button type="button" class="topic-card" data-category="nature">
          <div class="topic-icon">🌊</div>
          <h3>Nature</h3>
          <p>Waterfalls, beaches, hiking</p>
        </button>
        <button type="button" class="topic-card" data-category="activities">
          <div class="topic-icon">🤿</div>
          <h3>Activities</h3>
          <p>Stargazing, snorkeling, tours</p>
        </button>
        <button type="button" class="topic-card" data-category="local-guide">
          <div class="topic-icon">🍍</div>
          <h3>Local Guide</h3>
          <p>Food, markets, culture</p>
        </button>
        <button type="button" class="topic-card" data-category="food">
          <div class="topic-icon">🍴</div>
          <h3>Food & Dining</h3>
          <p>Restaurants, poke, local eats</p>
        </button>
        <button type="button" class="topic-card" data-category="events">
          <div class="topic-icon">🎉</div>
          <h3>Events & Culture</h3>
          <p>Markets, festivals, traditions</p>
        </button>
      </div>
      <p class="filter-status" id="filterStatus"></p>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Plan Your Stay</h2>
        <p>Book your room at Island Goodes and let us help you plan the perfect Big Island adventure</p>
        <a href="/book" class="btn btn-secondary btn-large">Check Availability</a>
      </div>
    </div>
  </section>
</PreviewLayout>

<style>
  .page-hero {
    position: relative;
    min-height: 45vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 10rem 2rem 4rem;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .page-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.6) 100%);
  }

  .page-hero-content {
    max-width: 800px;
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.25rem;
    opacity: 0.9;
  }

  .blog-section {
    padding: var(--section-padding) 0;
  }

  .blog-intro {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem;
    font-size: 1.125rem;
    color: var(--color-text-light);
    line-height: 1.8;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .blog-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 25px rgba(0,0,0,0.08);
    transition: var(--transition-base);
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 35px rgba(0,0,0,0.12);
  }

  .blog-image {
    display: block;
    height: 200px;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  }

  .blog-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card:hover .blog-image img {
    transform: scale(1.08);
  }

  .blog-image img[src=""], .blog-image img:not([src]) {
    display: none;
  }

  .category {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: var(--color-secondary);
    color: #1a1a1a;
    padding: 0.375rem 0.875rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .blog-content {
    padding: 1.5rem;
  }

  .blog-content time {
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  .blog-content h2 {
    font-size: 1.125rem;
    margin: 0.5rem 0;
    line-height: 1.4;
  }

  .blog-content h2 a {
    color: var(--color-text);
    text-decoration: none;
    transition: var(--transition-base);
  }

  .blog-content h2 a:hover {
    color: var(--color-primary);
  }

  .blog-content p {
    font-size: 0.9375rem;
    color: var(--color-text-light);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .read-more {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.9375rem;
    transition: var(--transition-base);
  }

  .read-more:hover {
    color: var(--color-primary-dark);
  }

  .topics {
    background: var(--color-bg-alt);
    padding: var(--section-padding) 0;
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .section-header.center {
    text-align: center;
  }

  .section-subtitle {
    display: inline-block;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    font-size: 2rem;
    color: var(--color-text);
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .topic-card {
    background: #fff;
    padding: 2rem 1.5rem;
    border-radius: 16px;
    text-align: center;
    text-decoration: none;
    transition: var(--transition-base);
    border: 1px solid transparent;
  }

  .topic-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    border-color: var(--color-primary);
  }

  .topic-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .topic-card h3 {
    color: var(--color-text);
    margin-bottom: 0.25rem;
    font-size: 1.125rem;
  }

  .topic-card p {
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  .cta-section {
    background: var(--gradient-primary);
    padding: 5rem 2rem;
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-section h2 {
    color: #fff;
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .cta-section p {
    color: rgba(255,255,255,0.9);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .topics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .topics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .topic-card {
    cursor: pointer;
    border: 2px solid transparent;
    font-family: inherit;
  }

  .topic-card.active {
    border-color: var(--color-primary);
    background: var(--color-primary-subtle);
  }

  .topic-card.active h3 {
    color: var(--color-primary);
  }

  .filter-status {
    text-align: center;
    margin-top: 1.5rem;
    color: var(--color-text-light);
    font-size: 0.9375rem;
  }

  .blog-card.hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const topicCards = document.querySelectorAll('.topic-card');
    const blogCards = document.querySelectorAll('.blog-card');
    const filterStatus = document.getElementById('filterStatus');

    // Category mapping for matching
    const categoryMap = {
      'all': null,
      'attractions': 'Attractions',
      'nature': 'Nature',
      'activities': 'Activities',
      'local-guide': 'Local Guide',
      'food': 'Food & Dining',
      'events': 'Events & Culture'
    };

    function filterPosts(category) {
      let visibleCount = 0;

      blogCards.forEach(card => {
        const cardCategory = card.querySelector('.category')?.textContent.trim();

        if (category === 'all' || cardCategory === categoryMap[category]) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update filter status
      if (category === 'all') {
        filterStatus.textContent = '';
      } else {
        const categoryName = categoryMap[category] || category;
        filterStatus.textContent = visibleCount > 0
          ? `Showing ${visibleCount} post${visibleCount !== 1 ? 's' : ''} in "${categoryName}"`
          : `No posts found in "${categoryName}"`;
      }

      // Update active state on buttons
      topicCards.forEach(card => {
        card.classList.toggle('active', card.dataset.category === category);
      });

      // Scroll to blog section
      document.querySelector('.blog-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Add click handlers to topic cards
    topicCards.forEach(card => {
      card.addEventListener('click', () => {
        filterPosts(card.dataset.category);
      });
    });

    // Check URL for initial filter
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('category');
    if (initialCategory && categoryMap[initialCategory]) {
      filterPosts(initialCategory);
    }
  });
</script>
