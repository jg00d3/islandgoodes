    background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/images/blog/sea-turtles.jpg') center/cover no-repeat;
    color: #fff;
    padding: 10rem 2rem 4rem;
    text-align: center;
  }

  .post-header .container {
    max-width: 800px;
    margin: 0 auto;
  }

