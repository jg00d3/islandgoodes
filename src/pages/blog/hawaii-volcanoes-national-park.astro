    background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/images/blog/volcanoes.jpg') center/cover no-repeat;
    color: #fff;
    padding: 10rem 2rem 4rem;
    text-align: center;
  }

  .post-header .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .category {
    background: var(--color-secondary);
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .post-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 1rem 0;
    line-height: 1.2;
  }

  .excerpt {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 1rem;
  }

  .post-header time {
    opacity: 0.8;
  }

  .post-content {
    padding: 4rem 2rem;
  }

  .post-content .container {
    max-width: 750px;
    margin: 0 auto;
  }

  .post-content .lead {
    font-size: 1.2rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .post-content h2 {
    color: var(--color-primary-dark);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .post-content h3 {
    color: var(--color-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

