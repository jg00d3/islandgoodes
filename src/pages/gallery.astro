  { src: "/images/rooms/orchid/bathroom2.webp", alt: "Orchid Room vanity", category: "Orchid Room" },
  { src: "/images/rooms/orchid/bathroom3.webp", alt: "Orchid Room shower", category: "Orchid Room" },
  { src: "/images/rooms/orchid/bathroom4.webp", alt: "Orchid Room bathroom detail", category: "Orchid Room" },
  { src: "/images/rooms/orchid/kitchen.webp", alt: "Orchid Room kitchenette", category: "Orchid Room" },
