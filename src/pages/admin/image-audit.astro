---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Copyright Audit - Images & Text";
const description = "Review all images and text content for copyright compliance";

// TEXT CONTENT AUDIT
const textContentSafe = [
  {
    category: "Room Descriptions",
    pages: ["/rooms/hilo-bay", "/rooms/orchid", "/rooms/mauna-kea", "/rooms/ginger"],
    status: "Original",
    note: "Written specifically for Island Goodes describing your own property"
  },
  {
    category: "Property Information",
    pages: ["/property", "/amenities", "/pets"],
    status: "Original",
    note: "Describes your own property, amenities, and pets - 100% original"
  },
  {
    category: "Policies & Booking",
    pages: ["/policies", "/book", "/contact"],
    status: "Original",
    note: "Your own business policies and contact information"
  },
  {
    category: "Attraction Facts",
    pages: ["/guide/attractions"],
    status: "Factual (Not Copyrightable)",
    note: "Facts like 'Rainbow Falls is 80 feet tall' or 'Akaka Falls is 442 feet' are public information"
  },
  {
    category: "Location Distances",
    pages: ["/guide/attractions", "/guide/beaches", "/guide/food"],
    status: "Factual (Not Copyrightable)",
    note: "Distances like '10 min from Island Goodes' are factual measurements"
  },
  {
    category: "Restaurant Names & Info",
    pages: ["/guide/food"],
    status: "Factual (Not Copyrightable)",
    note: "Restaurant names, cuisines, and general descriptions are factual information"
  },
  {
    category: "Beach Descriptions",
    pages: ["/guide/beaches"],
    status: "Original + Factual",
    note: "Combines factual info (location, features) with original travel tips"
  },
  {
    category: "Activity Descriptions",
    pages: ["/guide/activities"],
    status: "Original + Factual",
    note: "Original recommendations combined with factual activity information"
  }
];

const textContentBlog = [
  {
    title: "Best Poke in Hilo",
    page: "/blog/best-poke-hilo",
    status: "Original",
    note: "Original article with local recommendations"
  },
  {
    title: "Uncle Robert's Night Market",
    page: "/blog/uncle-roberts-night-market",
    status: "Original",
    note: "Original guide based on local knowledge"
  },
  {
    title: "Hilo Farmers Market Guide",
    page: "/blog/hilo-farmers-market",
    status: "Original",
    note: "Original visitor guide with tips"
  },
  {
    title: "Swimming Holes Near Hilo",
    page: "/blog/swimming-holes-hilo",
    status: "Original",
    note: "Original article with local swimming spots"
  },
  {
    title: "Hawaii Volcanoes National Park",
    page: "/blog/hawaii-volcanoes-national-park",
    status: "Original + Factual",
    note: "Original tips combined with factual park information"
  },
  {
    title: "Hamakua Coast Waterfalls",
    page: "/blog/hamakua-coast-waterfalls",
    status: "Original + Factual",
    note: "Original driving guide with factual waterfall info"
  },
  {
    title: "Manta Ray Night Dive",
    page: "/blog/manta-ray-night-dive",
    status: "Original",
    note: "Original activity guide"
  },
  {
    title: "Kona Coffee Farm Tours",
    page: "/blog/kona-coffee-tours",
    status: "Original",
    note: "Original tour recommendations"
  }
];

const textGuidelines = [
  "Factual information (heights, distances, hours, prices) is NOT copyrightable",
  "Restaurant/business names and basic info are factual - safe to use",
  "General travel advice ('go early to avoid crowds') is common knowledge",
  "DO NOT copy word-for-word from Lonely Planet, Fodor's, TripAdvisor, etc.",
  "Unique creative phrasing from other sites IS protected - avoid copying",
  "When in doubt, rewrite in your own words"
];

// Images provided by owner (from CLAUDES PICTURES folder) - SAFE
const ownerImages = [
  // Blog - User provided
  { path: "/images/blog/poke-bowl.jpg", name: "Poke Bowl", source: "Owner Photo" },
  { path: "/images/blog/uncle-roberts.jpg", name: "Uncle Roberts", source: "Owner Photo" },
  { path: "/images/blog/swimming-hole.jpg", name: "Swimming Hole", source: "Owner Photo" },
  { path: "/images/blog/night-market.jpg", name: "Hilo Farmers Market (Pineapples)", source: "Owner Photo" },
  { path: "/images/blog/manta-rays.jpg", name: "Manta Rays", source: "Owner Photo" },
  { path: "/images/blog/coffee-farm.jpg", name: "Coffee Farm", source: "Owner Photo" },

  // Attractions - From Toupdate folder
  { path: "/images/attractions/akaka-falls.jpg", name: "Akaka Falls", source: "Owner Photo" },
  { path: "/images/attractions/rainbow-falls.jpg", name: "Rainbow Falls", source: "Owner Photo" },
  { path: "/images/attractions/liliuokalani-gardens.jpg", name: "Liliuokalani Gardens", source: "Owner Photo" },
  { path: "/images/attractions/waipio-valley.jpg", name: "Waipio Valley", source: "Owner Photo" },
  { path: "/images/attractions/tsunami-museum.jpg", name: "Tsunami Museum", source: "Owner Photo" },
  { path: "/images/attractions/panaewa-zoo.jpg", name: "Panaewa Zoo", source: "Owner Photo" },
  { path: "/images/attractions/lyman-museum.jpg", name: "Lyman Museum", source: "Owner Photo" },
  { path: "/images/attractions/helicopter.jpg", name: "Helicopter Tours", source: "Owner Photo" },
  { path: "/images/attractions/kayaking.jpg", name: "Kayaking", source: "Owner Photo" },
  { path: "/images/attractions/zipline.jpg", name: "Zipline", source: "Owner Photo" },
  { path: "/images/beaches/carlsmith.jpg", name: "Carlsmith Beach", source: "Owner Photo" },

  // Property photos - All owner's
  { path: "/images/property/pool.jpg", name: "Pool", source: "Owner Photo" },
  { path: "/images/property/pool2.jpg", name: "Pool 2", source: "Owner Photo" },
  { path: "/images/property/pool3.jpg", name: "Pool 3", source: "Owner Photo" },
  { path: "/images/property/hot-tub.jpg", name: "Hot Tub", source: "Owner Photo" },
  { path: "/images/property/hot-tub2.jpg", name: "Hot Tub 2", source: "Owner Photo" },
  { path: "/images/property/garden.jpg", name: "Garden", source: "Owner Photo" },
  { path: "/images/property/garden2.jpg", name: "Garden 2", source: "Owner Photo" },
  { path: "/images/property/coconut-jake.jpg", name: "Coconut Jake", source: "Owner Photo" },
  { path: "/images/property/miss-kitty.jpg", name: "Miss Kitty", source: "Owner Photo" },
  { path: "/images/property/prudy-jasper.jpg", name: "Prudy & Jasper", source: "Owner Photo" },
  { path: "/images/property/prudy.jpg", name: "Prudy", source: "Owner Photo" },
  { path: "/images/property/laundry.jpg", name: "Laundry", source: "Owner Photo" },
  { path: "/images/property/tropical-plants.jpg", name: "Tropical Plants", source: "Owner Photo" },
  { path: "/images/hero.jpg", name: "Hero (Property View)", source: "Owner Photo" },

  // Room photos - All owner's
  { path: "/images/rooms/hilo-bay/bed.jpg", name: "Hilo Bay Bed", source: "Owner Photo" },
  { path: "/images/rooms/orchid/bed.jpg", name: "Orchid Bed", source: "Owner Photo" },
  { path: "/images/rooms/mauna-kea/bed.jpg", name: "Mauna Kea Bed", source: "Owner Photo" },
  { path: "/images/rooms/ginger/room.jpg", name: "Ginger Room", source: "Owner Photo" },
];

// Images of unknown origin - NEED REVIEW
const unknownImages = [
  { path: "/images/blog/black-sand-beach.jpg", name: "Black Sand Beach", note: "Pre-existing - verify source" },
  { path: "/images/blog/farmers-market.jpg", name: "Farmers Market (Oranges)", note: "Pre-existing - NOT USED, can delete" },
  { path: "/images/blog/hawaiian-food.jpg", name: "Hawaiian Food (Korean Bibimbap)", note: "WRONG IMAGE - Replace with Hawaiian food" },
  { path: "/images/blog/hidden-beaches.jpg", name: "Hidden Beaches", note: "Pre-existing - verify source" },
  { path: "/images/blog/hiking-trails.jpg", name: "Hiking Trails", note: "Pre-existing - verify source" },
  { path: "/images/blog/hilo-farmers-market.jpg", name: "Hilo Farmers Market", note: "Downloaded - may be Unsplash (free)" },
  { path: "/images/blog/hilo-town.jpg", name: "Hilo Town", note: "Pre-existing - verify source" },
  { path: "/images/blog/holiday-hawaii.jpg", name: "Holiday Hawaii", note: "Pre-existing - verify source" },
  { path: "/images/blog/lava-viewing.jpg", name: "Lava Viewing", note: "Pre-existing - verify source" },
  { path: "/images/blog/mauna-kea.jpg", name: "Mauna Kea", note: "Pre-existing - verify source" },
  { path: "/images/blog/new-year-sunrise.jpg", name: "New Year Sunrise", note: "Pre-existing - verify source" },
  { path: "/images/blog/rainforest.jpg", name: "Rainforest", note: "Pre-existing - verify source" },
  { path: "/images/blog/romantic-getaway.jpg", name: "Romantic Getaway", note: "Pre-existing - verify source" },
  { path: "/images/blog/sea-turtles.jpg", name: "Sea Turtles", note: "Pre-existing - verify source" },
  { path: "/images/blog/snorkeling.jpg", name: "Snorkeling", note: "Pre-existing - verify source" },
  { path: "/images/blog/tropical-flowers.jpg", name: "Tropical Flowers", note: "Pre-existing - verify source" },
  { path: "/images/blog/ukulele-music.jpg", name: "Ukulele Music", note: "Pre-existing - verify source" },
  { path: "/images/blog/volcanoes.jpg", name: "Volcanoes", note: "Pre-existing - verify source" },
  { path: "/images/blog/waterfalls.jpg", name: "Waterfalls", note: "Pre-existing - verify source" },
  { path: "/images/blog/whale-watching.jpg", name: "Whale Watching", note: "Pre-existing - verify source" },
  { path: "/images/hero-ocean-view.jpg", name: "Hero Ocean View", note: "Pre-existing - verify source" },
  { path: "/images/beaches/richardsons.jpg", name: "Richardsons Beach", note: "Pre-existing - verify source" },
];

// Recommendations
const recommendations = [
  "Replace unknown source images with your own photos when possible",
  "Unsplash.com images are FREE for commercial use - no attribution required",
  "Pexels.com images are also FREE for commercial use",
  "When in doubt, take your own photo or use a verified free stock source",
  "Keep this audit page updated as you replace images"
];
---

<PreviewLayout title={title} description={description}>
  <section class="audit-header">
    <div class="container">
      <h1>Copyright Audit</h1>
      <p class="subtitle">Review all images and text content for copyright compliance</p>
      <div class="summary-cards">
        <div class="summary-card safe">
          <span class="count">{ownerImages.length}</span>
          <span class="label">Owner Photos</span>
        </div>
        <div class="summary-card warning">
          <span class="count">{unknownImages.length}</span>
          <span class="label">Images to Review</span>
        </div>
        <div class="summary-card safe">
          <span class="count">{textContentSafe.length + textContentBlog.length}</span>
          <span class="label">Text Sections (Safe)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TEXT CONTENT AUDIT -->
  <section class="text-audit">
    <div class="container">
      <h2>Text Content Audit</h2>
      <div class="text-guidelines">
        <h3>Text Copyright Guidelines</h3>
        <ul>
          {textGuidelines.map(g => <li>{g}</li>)}
        </ul>
      </div>

      <h3>Page Content - All Safe</h3>
      <div class="text-grid">
        {textContentSafe.map(item => (
          <div class="text-card safe">
            <h4>{item.category}</h4>
            <span class={`status-badge ${item.status.includes('Original') ? 'original' : 'factual'}`}>
              {item.status}
            </span>
            <p class="text-note">{item.note}</p>
            <div class="text-pages">
              {item.pages.map(p => <code>{p}</code>)}
            </div>
          </div>
        ))}
      </div>

      <h3>Blog Articles - All Original</h3>
      <div class="text-grid">
        {textContentBlog.map(item => (
          <div class="text-card safe">
            <h4>{item.title}</h4>
            <span class={`status-badge ${item.status.includes('Original') ? 'original' : 'factual'}`}>
              {item.status}
            </span>
            <p class="text-note">{item.note}</p>
            <code>{item.page}</code>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- IMAGE AUDIT HEADER -->
  <section class="image-audit-header">
    <div class="container">
      <h2>Image Audit</h2>
    </div>
  </section>

  <section class="recommendations">
    <div class="container">
      <h3>Image Recommendations</h3>
      <ul>
        {recommendations.map(rec => <li>{rec}</li>)}
      </ul>
    </div>
  </section>

  <section class="image-section safe-section">
    <div class="container">
      <h2>Owner Photos - Safe to Use</h2>
      <p class="section-note">These are your own photos from the CLAUDES PICTURES folder. No copyright concerns.</p>
      <div class="image-grid">
        {ownerImages.map(img => (
          <div class="image-card safe">
            <img src={img.path} alt={img.name} loading="lazy" />
            <div class="image-info">
              <strong>{img.name}</strong>
              <span class="source">{img.source}</span>
              <code>{img.path}</code>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="image-section warning-section">
    <div class="container">
      <h2>Unknown Source - Needs Review</h2>
      <p class="section-note">These images were pre-existing or downloaded. Verify their source or replace with your own photos.</p>
      <div class="image-grid">
        {unknownImages.map(img => (
          <div class="image-card warning">
            <img src={img.path} alt={img.name} loading="lazy" />
            <div class="image-info">
              <strong>{img.name}</strong>
              <span class="note">{img.note}</span>
              <code>{img.path}</code>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</PreviewLayout>

<style>
  .audit-header {
    background: var(--gradient-primary);
    color: #fff;
    padding: 6rem 2rem 3rem;
    text-align: center;
  }

  .audit-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .summary-cards {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .summary-card {
    background: rgba(255,255,255,0.15);
    padding: 1.5rem 2.5rem;
    border-radius: 12px;
    text-align: center;
  }

  .summary-card .count {
    display: block;
    font-size: 3rem;
    font-weight: 700;
  }

  .summary-card .label {
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .recommendations {
    background: #fffbeb;
    padding: 2rem;
    border-bottom: 3px solid #f59e0b;
  }

  .recommendations h2 {
    color: #92400e;
    margin-bottom: 1rem;
  }

  .recommendations ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .recommendations li {
    color: #78350f;
    margin-bottom: 0.5rem;
  }

  .image-section {
    padding: 3rem 0;
  }

  .safe-section {
    background: #f0fdf4;
  }

  .warning-section {
    background: #fefce8;
  }

  .section-note {
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }

  .image-section h2 {
    margin-bottom: 0.5rem;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .image-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .image-card.safe {
    border: 2px solid #22c55e;
  }

  .image-card.warning {
    border: 2px solid #f59e0b;
  }

  .image-card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }

  .image-info {
    padding: 1rem;
  }

  .image-info strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .image-info .source {
    display: block;
    color: #22c55e;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .image-info .note {
    display: block;
    color: #f59e0b;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .image-info code {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: #666;
    word-break: break-all;
  }

  /* Text Audit Styles */
  .text-audit {
    padding: 3rem 0;
    background: #f8fafc;
  }

  .text-audit h2 {
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .text-audit h3 {
    margin: 2rem 0 1rem;
    color: var(--color-text);
    font-size: 1.25rem;
  }

  .text-guidelines {
    background: #e0f2fe;
    border: 2px solid #0ea5e9;
    border-radius: 12px;
    padding: 1.5rem 2rem;
    margin-bottom: 2rem;
  }

  .text-guidelines h3 {
    margin: 0 0 1rem;
    color: #0369a1;
  }

  .text-guidelines ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .text-guidelines li {
    color: #0c4a6e;
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .text-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .text-card {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .text-card.safe {
    border-left: 4px solid #22c55e;
  }

  .text-card h4 {
    margin: 0 0 0.75rem;
    color: var(--color-text);
    font-size: 1.1rem;
  }

  .status-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .status-badge.original {
    background: #dcfce7;
    color: #166534;
  }

  .status-badge.factual {
    background: #e0f2fe;
    color: #0369a1;
  }

  .text-note {
    color: var(--color-text-light);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .text-pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .text-pages code,
  .text-card > code {
    background: #f1f5f9;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: #475569;
  }

  .image-audit-header {
    background: #f1f5f9;
    padding: 2rem;
    border-bottom: 2px solid #e2e8f0;
  }

  .image-audit-header h2 {
    margin: 0;
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .summary-cards {
      flex-direction: column;
      align-items: center;
    }
    .text-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
