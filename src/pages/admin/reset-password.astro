---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "Reset Password";
const description = "Set a new Island Goodes admin password";
const pageTitle = "Reset Password";
const pageTip = "Choose a new admin password";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <div class="activate-page">
    <div class="activate-card">
      <div id="invalidToken" class="activate-step" style="display: none;">
        <div class="activate-icon error">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
        </div>
        <h1>Link Not Valid</h1>
        <p id="invalidMessage">This reset link is invalid, expired, or has already been used.</p>
        <a href="/admin" class="btn btn-primary">Go to Admin Login</a>
      </div>

      <div id="setupForm" class="activate-step">
        <div class="activate-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h1>Set a New Password</h1>
        <p>Choose a new password for your admin account</p>

        <form id="activateForm">
          <div class="form-group">
            <label for="loginEmail">Login Email</label>
            <input type="email" id="loginEmail" autocomplete="username" readonly />
          </div>

          <div class="form-group">
            <label for="password">New Password</label>
            <input type="password" id="password" placeholder="Min 8 characters" autocomplete="new-password" required minlength="8" />
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" placeholder="Confirm your new password" autocomplete="new-password" required />
          </div>

          <button type="submit" class="btn btn-primary btn-large">Save New Password</button>
        </form>
        <p id="formError" class="error-message"></p>
      </div>

      <div id="successStep" class="activate-step" style="display: none;">
        <div class="activate-icon success">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22,4 12,14.01 9,11.01"/>
          </svg>
        </div>
        <h1>Password Updated</h1>
        <p>You can now log in with your new password.</p>
        <a href="/admin" class="btn btn-primary btn-large">Go to Admin Login</a>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .activate-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1B6B5A 0%, #0F4A3E 100%);
    padding: 2rem;
  }

  .activate-card {
    background: #fff;
    padding: 3rem;
    border-radius: 20px;
    max-width: 480px;
    width: 100%;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }

  .activate-step {
    text-align: center;
  }

  .activate-icon {
    width: 80px;
    height: 80px;
    background: var(--color-bg-alt);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: var(--color-primary);
  }

  .activate-icon.success {
    background: #ECFDF5;
    color: #059669;
  }

  .activate-icon.error {
    background: #FEE2E2;
    color: #DC2626;
  }

  .activate-card h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .activate-card > .activate-step > p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  #activateForm {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .form-group input {
    padding: 0.875rem 1rem;
    border: 2px solid var(--color-bg-alt);
    border-radius: 10px;
    font-size: 1rem;
    transition: border-color 0.2s;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .form-group input[readonly] {
    background: var(--color-bg-alt);
    color: var(--color-text-light);
  }

  .field-note {
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  .btn-large {
    padding: 1rem 2rem;
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  .error-message {
    color: #EF4444;
    font-size: 0.875rem;
    margin-top: 0.5rem;
    text-align: center;
  }

  @media (max-width: 480px) {
    .activate-card {
      padding: 2rem;
    }
  }
</style>

<script>
  const RESET_URL = '/.netlify/functions/admin-reset-password';
  const token = new URLSearchParams(window.location.search).get('token');

  const invalidToken = document.getElementById('invalidToken');
  const invalidMessage = document.getElementById('invalidMessage');
  const setupForm = document.getElementById('setupForm');
  const successStep = document.getElementById('successStep');
  const formError = document.getElementById('formError');

  function showInvalid(message?: string) {
    if (setupForm) setupForm.style.display = 'none';
    if (invalidToken) invalidToken.style.display = 'block';
    if (message && invalidMessage) invalidMessage.textContent = message;
  }

  async function sendReset(body: object) {
    const response = await fetch(RESET_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token, ...body })
    });
    return { ok: response.ok, data: await response.json() };
  }

  (async function initReset() {
    if (!token) {
      showInvalid();
      return;
    }
    try {
      const { ok, data } = await sendReset({ checkOnly: true });
      if (!ok) {
        showInvalid(data.error);
        return;
      }
      (document.getElementById('loginEmail') as HTMLInputElement).value = data.email;
    } catch {
      showInvalid('Could not check this link. Please try again.');
    }
  })();

  document.getElementById('activateForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (formError) formError.textContent = '';

    const password = (document.getElementById('password') as HTMLInputElement).value;
    const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement).value;
    if (password !== confirmPassword) {
      if (formError) formError.textContent = 'Passwords do not match';
      return;
    }

    try {
      const { ok, data } = await sendReset({ password });
      if (!ok) {
        if (formError) formError.textContent = data.error;
        return;
      }
      if (setupForm) setupForm.style.display = 'none';
      if (successStep) successStep.style.display = 'block';
    } catch {
      if (formError) formError.textContent = 'Could not reset the password. Please try again.';
    }
  });
</script>
