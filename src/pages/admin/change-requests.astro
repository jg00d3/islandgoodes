---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "Change Requests";
const description = "Track content changes and fixes needed";
const pageTitle = "Change Requests";
const pageTip = "Track content updates, bug fixes, and feature requests";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <section class="requests-section">
    <div class="container">
      <!-- Add New Request -->
      <div class="add-request-card">
        <h2>Add New Request</h2>
        <form id="addRequestForm">
          <div class="form-row">
            <div class="form-group">
              <label for="requestType">Type</label>
              <select id="requestType" required>
                <option value="">Select type...</option>
                <option value="image">Image Change</option>
                <option value="text">Text/Content Change</option>
                <option value="bug">Bug/Error Fix</option>
                <option value="feature">New Feature</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-group">
              <label for="requestPage">Page/Location</label>
              <input type="text" id="requestPage" placeholder="e.g. Home page, Hilo Bay Room, Gallery" />
            </div>
          </div>
          <div class="form-group">
            <label for="requestDescription">Description *</label>
            <textarea id="requestDescription" rows="3" placeholder="Describe what needs to be changed or fixed..." required></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="requestPriority">Priority</label>
              <select id="requestPriority">
                <option value="low">Low</option>
                <option value="medium" selected>Medium</option>
                <option value="high">High</option>
                <option value="urgent">Urgent</option>
              </select>
            </div>
            <div class="form-group">
              <label for="requestedBy">Requested By</label>
              <input type="text" id="requestedBy" placeholder="Your name" />
            </div>
          </div>
          <button type="submit" class="btn btn-primary">Add Request</button>
        </form>
      </div>

      <!-- Filter Controls -->
      <div class="filter-controls">
        <div class="filter-group">
          <label>Show:</label>
          <select id="statusFilter">
            <option value="pending">Pending Only</option>
            <option value="all">All Requests</option>
            <option value="completed">Completed Only</option>
          </select>
        </div>
        <div class="filter-group">
          <label>Sort by:</label>
          <select id="sortBy">
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
            <option value="priority">Priority</option>
          </select>
        </div>
        <button id="clearCompleted" class="btn btn-outline btn-small">Clear Completed</button>
      </div>

      <!-- Request List -->
      <div id="requestList" class="request-list">
        <div class="empty-state">No change requests yet. Add one above!</div>
      </div>
    </div>
  </section>
</AdminLayout>

<style is:global>
  /* ========== MAIN SECTION ========== */
  .requests-section {
    padding: 32px 24px;
    background: #f8fafc;
    min-height: 60vh;
  }

  .requests-section .container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* ========== ADD REQUEST FORM ========== */
  .add-request-card {
    background: #fff;
    padding: 24px;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    margin-bottom: 24px;
    border: 1px solid #e5e7eb;
  }

  .add-request-card h2 {
    margin: 0 0 20px;
    font-size: 18px;
    font-weight: 600;
    color: #1f2937;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .add-request-card h2::before {
    content: '+';
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
    color: #fff;
    border-radius: 8px;
    font-size: 18px;
    font-weight: 700;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    margin-bottom: 16px;
  }

  .form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 6px;
    font-size: 13px;
    color: #4b5563;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    font-size: 14px;
    font-family: inherit;
    background: #fafbfc;
    color: #1f2937;
    transition: all 0.2s;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #dc2626;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #9ca3af;
  }

  .add-request-card .btn-primary {
    background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
    color: #fff;
    border: none;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .add-request-card .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(220, 38, 38, 0.3);
  }

  /* ========== FILTER CONTROLS ========== */
  .filter-controls {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
    padding: 16px 20px;
    background: #fff;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .filter-group label {
    font-size: 13px;
    font-weight: 600;
    color: #6b7280;
  }

  .filter-group select {
    padding: 8px 12px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-size: 13px;
    background: #fafbfc;
    color: #374151;
    cursor: pointer;
  }

  .filter-group select:focus {
    outline: none;
    border-color: #dc2626;
  }

  .btn-outline {
    background: #fff;
    color: #6b7280;
    border: 1px solid #e5e7eb;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    margin-left: auto;
  }

  .btn-outline:hover {
    border-color: #dc2626;
    color: #dc2626;
    background: #fef2f2;
  }

  .btn-small {
    padding: 8px 16px;
    font-size: 13px;
  }

  /* ========== REQUEST LIST ========== */
  .request-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .empty-state {
    text-align: center;
    padding: 60px 24px;
    color: #9ca3af;
    background: #fff;
    border-radius: 16px;
    border: 2px dashed #e5e7eb;
  }

  .empty-state::before {
    content: '📋';
    display: block;
    font-size: 48px;
    margin-bottom: 16px;
  }

  /* ========== REQUEST ITEM CARDS ========== */
  .request-item {
    background: #fff;
    border-radius: 14px;
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    border: 1px solid #e5e7eb;
    transition: all 0.2s;
  }

  .request-item:hover {
    border-color: #d1d5db;
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }

  .request-item.completed {
    background: #f9fafb;
    border-color: #e5e7eb;
  }

  .request-item.completed:hover {
    transform: none;
    box-shadow: none;
  }

  .request-item.completed .request-description {
    text-decoration: line-through;
    color: #9ca3af;
  }

  .request-checkbox {
    width: 22px;
    height: 22px;
    cursor: pointer;
    accent-color: #10b981;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .request-content {
    flex: 1;
    min-width: 0;
  }

  .request-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  /* ========== TYPE BADGES ========== */
  .request-type {
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .request-type.image {
    background: #dbeafe;
    color: #1d4ed8;
    border: 1px solid #93c5fd;
  }

  .request-type.text {
    background: #f3e8ff;
    color: #7c3aed;
    border: 1px solid #c4b5fd;
  }

  .request-type.bug {
    background: #fee2e2;
    color: #dc2626;
    border: 1px solid #fca5a5;
  }

  .request-type.feature {
    background: #d1fae5;
    color: #059669;
    border: 1px solid #6ee7b7;
  }

  .request-type.other {
    background: #f3f4f6;
    color: #4b5563;
    border: 1px solid #d1d5db;
  }

  /* ========== PRIORITY BADGES ========== */
  .request-priority {
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .request-priority.low {
    background: #f3f4f6;
    color: #6b7280;
    border: 1px solid #e5e7eb;
  }

  .request-priority.medium {
    background: #fef3c7;
    color: #b45309;
    border: 1px solid #fcd34d;
  }

  .request-priority.high {
    background: #ffedd5;
    color: #c2410c;
    border: 1px solid #fdba74;
  }

  .request-priority.urgent {
    background: #fee2e2;
    color: #dc2626;
    border: 1px solid #fca5a5;
    animation: pulse-urgent 2s ease-in-out infinite;
  }

  @keyframes pulse-urgent {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }

  /* ========== PAGE LABEL ========== */
  .request-page {
    font-size: 12px;
    color: #6b7280;
    background: #f3f4f6;
    padding: 4px 10px;
    border-radius: 6px;
  }

  /* ========== DESCRIPTION ========== */
  .request-description {
    color: #374151;
    line-height: 1.6;
    margin-bottom: 12px;
    font-size: 15px;
  }

  /* ========== META INFO ========== */
  .request-meta {
    display: flex;
    gap: 16px;
    font-size: 12px;
    color: #9ca3af;
    flex-wrap: wrap;
  }

  .request-meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* ========== ACTION BUTTONS ========== */
  .request-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .request-item:hover .request-actions {
    opacity: 1;
  }

  .action-btn {
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 10px;
    background: #f3f4f6;
    color: #9ca3af;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .action-btn:hover {
    background: #e5e7eb;
    color: #374151;
  }

  .action-btn.delete:hover {
    background: #fee2e2;
    color: #dc2626;
  }

  /* ========== RESPONSIVE ========== */
  @media (max-width: 768px) {
    .requests-hero {
      padding: 70px 16px 32px;
    }

    .requests-hero h1 {
      font-size: 28px;
    }

    .requests-section {
      padding: 20px 16px;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .filter-controls {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    .btn-outline {
      margin-left: 0;
    }

    .request-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }

    .request-item {
      padding: 16px;
    }

    .request-actions {
      opacity: 1;
    }
  }

  /* Dark mode */
  [data-theme="dark"] .requests-section {
    background: var(--color-bg);
  }

  [data-theme="dark"] .add-request-card {
    background: var(--color-bg-alt);
    border-color: var(--color-border);
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  [data-theme="dark"] .add-request-card h2 {
    color: var(--color-text);
  }

  [data-theme="dark"] .form-group label {
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .form-group input,
  [data-theme="dark"] .form-group select,
  [data-theme="dark"] .form-group textarea {
    background: var(--color-bg);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  [data-theme="dark"] .form-group input:focus,
  [data-theme="dark"] .form-group select:focus,
  [data-theme="dark"] .form-group textarea:focus {
    background: var(--color-bg);
    border-color: #dc2626;
  }

  [data-theme="dark"] .form-group input::placeholder,
  [data-theme="dark"] .form-group textarea::placeholder {
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .filter-controls {
    background: var(--color-bg-alt);
    border-color: var(--color-border);
  }

  [data-theme="dark"] .filter-group label {
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .filter-group select {
    background: var(--color-bg);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  [data-theme="dark"] .btn-outline {
    background: var(--color-bg);
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .btn-outline:hover {
    background: rgba(220, 38, 38, 0.1);
    border-color: #dc2626;
    color: #dc2626;
  }

  [data-theme="dark"] .empty-state {
    background: var(--color-bg-alt);
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .request-item {
    background: var(--color-bg-alt);
    border-color: var(--color-border);
  }

  [data-theme="dark"] .request-item:hover {
    border-color: #555;
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
  }

  [data-theme="dark"] .request-item.completed {
    background: var(--color-bg);
    border-color: var(--color-border);
  }

  [data-theme="dark"] .request-description {
    color: var(--color-text);
  }

  [data-theme="dark"] .request-item.completed .request-description {
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .request-page {
    background: var(--color-bg);
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .request-meta {
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .action-btn {
    background: var(--color-bg);
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .action-btn:hover {
    background: #444;
    color: var(--color-text);
  }

  [data-theme="dark"] .action-btn.delete:hover {
    background: rgba(220, 38, 38, 0.2);
    color: #f87171;
  }
</style>

<script is:inline src="/js/shared-data.js"></script>
<script>
  const SESSION_KEY = 'islandgoodes_admin_session';

  // Check session
  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  }

  // DEV: Bypass auth for local testing
  // if (!getSession()) {
  //   window.location.href = '/admin';
  // }

  async function logActivity(type: string, action: string, details?: string) {
    try {
      await window.SharedData.logActivity(type, action, details);
    } catch (e) { console.error('Failed to log activity:', e); }
  }

  interface ChangeRequest {
    id: number;
    type: string;
    page: string;
    description: string;
    priority: string;
    requestedBy: string;
    status: 'pending' | 'completed';
    created: string;
    completedAt?: string;
  }

  // Sample data for local testing
  const sampleRequests: ChangeRequest[] = [
    { id: 1, type: 'image', page: 'Home Page', description: 'Update hero image with new sunset photo', priority: 'high', requestedBy: 'Dad', status: 'pending', created: '2026-01-15T10:30:00Z' },
    { id: 2, type: 'text', page: 'About Page', description: 'Fix typo in welcome message - "recieve" should be "receive"', priority: 'low', requestedBy: 'Jeremiah', status: 'completed', created: '2026-01-14T14:00:00Z', completedAt: '2026-01-15T09:00:00Z' },
    { id: 3, type: 'bug', page: 'Contact Form', description: 'Form not submitting on mobile Safari', priority: 'urgent', requestedBy: 'Guest', status: 'pending', created: '2026-01-16T08:00:00Z' },
    { id: 4, type: 'feature', page: 'Rooms', description: 'Add virtual tour link to each room page', priority: 'medium', requestedBy: 'Dad', status: 'pending', created: '2026-01-13T16:00:00Z' },
  ];

  async function getRequests(): Promise<ChangeRequest[]> {
    try {
      const data = await window.SharedData.getChangeRequests();
      return data && data.length > 0 ? data : sampleRequests;
    } catch { return sampleRequests; }
  }

  async function saveRequests(requests: ChangeRequest[]) {
    await window.SharedData.saveChangeRequests(requests);
  }

  function formatDate(dateStr: string): string {
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  async function renderRequests() {
    const container = document.getElementById('requestList');
    if (!container) return;

    const statusFilter = (document.getElementById('statusFilter') as HTMLSelectElement).value;
    const sortBy = (document.getElementById('sortBy') as HTMLSelectElement).value;

    let requests = await getRequests();

    // Filter
    if (statusFilter === 'pending') {
      requests = requests.filter(r => r.status === 'pending');
    } else if (statusFilter === 'completed') {
      requests = requests.filter(r => r.status === 'completed');
    }

    // Sort
    if (sortBy === 'newest') {
      requests.sort((a, b) => new Date(b.created).getTime() - new Date(a.created).getTime());
    } else if (sortBy === 'oldest') {
      requests.sort((a, b) => new Date(a.created).getTime() - new Date(b.created).getTime());
    } else if (sortBy === 'priority') {
      const priorityOrder = { urgent: 0, high: 1, medium: 2, low: 3 };
      requests.sort((a, b) => (priorityOrder[a.priority as keyof typeof priorityOrder] || 3) - (priorityOrder[b.priority as keyof typeof priorityOrder] || 3));
    }

    if (requests.length === 0) {
      container.innerHTML = '<div class="empty-state">No change requests found.</div>';
      return;
    }

    container.innerHTML = requests.map(req => `
      <div class="request-item ${req.status}" data-id="${req.id}">
        <input type="checkbox" class="request-checkbox" ${req.status === 'completed' ? 'checked' : ''} />
        <div class="request-content">
          <div class="request-header">
            <span class="request-type ${req.type}">${req.type}</span>
            <span class="request-priority ${req.priority}">${req.priority}</span>
            ${req.page ? `<span class="request-page">${req.page}</span>` : ''}
          </div>
          <div class="request-description">${req.description}</div>
          <div class="request-meta">
            <span>Added ${formatDate(req.created)}</span>
            ${req.requestedBy ? `<span>by ${req.requestedBy}</span>` : ''}
            ${req.completedAt ? `<span>Completed ${formatDate(req.completedAt)}</span>` : ''}
          </div>
        </div>
        <div class="request-actions">
          <button class="action-btn delete" title="Delete" data-id="${req.id}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3,6 5,6 21,6"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          </button>
        </div>
      </div>
    `).join('');

    // Attach event handlers
    container.querySelectorAll('.request-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const item = (e.target as HTMLElement).closest('.request-item');
        const id = parseInt(item?.getAttribute('data-id') || '0');
        toggleComplete(id, (e.target as HTMLInputElement).checked);
      });
    });

    container.querySelectorAll('.action-btn.delete').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = parseInt((e.currentTarget as HTMLElement).getAttribute('data-id') || '0');
        deleteRequest(id);
      });
    });
  }

  async function toggleComplete(id: number, completed: boolean) {
    const requests = await getRequests();
    const request = requests.find(r => r.id === id);
    if (request) {
      request.status = completed ? 'completed' : 'pending';
      request.completedAt = completed ? new Date().toISOString() : undefined;
      await saveRequests(requests);
      await logActivity('roadmap', completed ? 'Completed change request' : 'Reopened change request', request.description);
      await renderRequests();
    }
  }

  async function deleteRequest(id: number) {
    if (!confirm('Delete this request?')) return;
    const requests = (await getRequests()).filter(r => r.id !== id);
    await saveRequests(requests);
    await logActivity('roadmap', 'Deleted change request');
    await renderRequests();
  }

  // Get current admin's email for notifications
  async function getAdminEmail(): Promise<string | null> {
    try {
      const session = getSession();
      if (!session) return null;
      const admins = await window.SharedData.getAdmins();
      const admin = admins.find((a: any) =>
        a.id === session.id ||
        a.username === session.username ||
        a.fullName === session.fullName
      );
      return admin?.email || null;
    } catch { return null; }
  }

  // Send email notification for new request
  async function sendNewRequestNotification(request: ChangeRequest, requesterEmail: string | null) {
    try {
      await fetch('/.netlify/functions/change-request-notify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ request, requesterEmail })
      });
    } catch (err) {
      console.error('Failed to send notification:', err);
    }
  }

  // Add new request
  document.getElementById('addRequestForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const type = (document.getElementById('requestType') as HTMLSelectElement).value;
    const page = (document.getElementById('requestPage') as HTMLInputElement).value;
    const description = (document.getElementById('requestDescription') as HTMLTextAreaElement).value;
    const priority = (document.getElementById('requestPriority') as HTMLSelectElement).value;
    const requestedBy = (document.getElementById('requestedBy') as HTMLInputElement).value || getSession()?.fullName || 'Unknown';

    if (!type || !description) {
      alert('Please fill in the required fields');
      return;
    }

    const submitBtn = document.querySelector('#addRequestForm button[type="submit"]') as HTMLButtonElement;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
    }

    const requests = await getRequests();
    const newRequest: ChangeRequest = {
      id: Date.now(),
      type,
      page,
      description,
      priority,
      requestedBy,
      status: 'pending',
      created: new Date().toISOString()
    };

    requests.push(newRequest);
    await saveRequests(requests);
    await logActivity('roadmap', 'Added change request', `${type}: ${description.substring(0, 50)}...`);

    // Send email notification
    const requesterEmail = await getAdminEmail();
    await sendNewRequestNotification(newRequest, requesterEmail);

    // Reset form
    (document.getElementById('addRequestForm') as HTMLFormElement).reset();
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Add Request';
    }
    await renderRequests();
    alert('Request added! Email notifications sent.');
  });

  // Filter/sort change handlers
  document.getElementById('statusFilter')?.addEventListener('change', renderRequests);
  document.getElementById('sortBy')?.addEventListener('change', renderRequests);

  // Clear completed
  document.getElementById('clearCompleted')?.addEventListener('click', async () => {
    if (!confirm('Delete all completed requests?')) return;
    const requests = (await getRequests()).filter(r => r.status !== 'completed');
    await saveRequests(requests);
    await logActivity('roadmap', 'Cleared completed requests');
    await renderRequests();
  });

  // Initial render
  renderRequests();
</script>
