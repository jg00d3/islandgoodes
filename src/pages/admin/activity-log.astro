---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "Activity Log";
const description = "Admin activity and change history";
const pageTitle = "Activity Log";
const pageTip = "Track all admin changes and activities";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>

  <section class="log-section">
    <div class="container">
      <div class="log-controls">
        <div class="filter-group">
          <label>Filter by Type:</label>
          <select id="typeFilter" class="select-input">
            <option value="all">All Activities</option>
            <option value="user">User Management</option>
            <option value="settings">Settings</option>
            <option value="roadmap">Roadmap</option>
            <option value="image">Image Changes</option>
            <option value="login">Logins</option>
          </select>
        </div>
        <button id="clearLog" class="btn btn-outline">Clear Log</button>
      </div>

      <div class="log-card">
        <div id="logEntries" class="log-entries">
          <div class="log-empty">No activity recorded yet.</div>
        </div>
      </div>

      <div class="log-info">
        <p>Activity is shared across all admins and stored on the server.</p>
      </div>
    </div>
  </section>
</AdminLayout>

<style is:global>
  .log-section {
    padding: 2rem;
    background: var(--color-bg-alt);
    min-height: 60vh;
  }

  .log-section .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .log-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding: 1rem 1.5rem;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .filter-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #6b7280;
  }

  .select-input {
    padding: 0.625rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 500;
    background: #fafbfc;
    cursor: pointer;
    min-width: 180px;
    color: #374151;
    transition: all 0.2s;
  }

  .select-input:focus {
    outline: none;
    border-color: var(--color-primary);
    background: #fff;
  }

  .btn-outline {
    padding: 0.625rem 1.25rem;
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    background: #fff;
    color: #6b7280;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-outline:hover {
    border-color: #ef4444;
    color: #ef4444;
    background: #fef2f2;
  }

  .log-card {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    overflow: hidden;
  }

  .log-entries {
    max-height: 650px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
  }

  .log-empty {
    padding: 4rem 2rem;
    text-align: center;
    color: #9ca3af;
  }

  .log-empty::before {
    content: '📋';
    display: block;
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .log-entry {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: #f9fafb;
    border-radius: 12px;
    align-items: flex-start;
    transition: all 0.15s;
    border: 1px solid #e5e7eb;
  }

  .log-entry:hover {
    background: #f3f4f6;
    border-color: #d1d5db;
  }

  .log-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .log-icon.user { background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); color: #1d4ed8; }
  .log-icon.settings { background: linear-gradient(135deg, #f3e8ff 0%, #e9d5ff 100%); color: #7c3aed; }
  .log-icon.roadmap { background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%); color: #059669; }
  .log-icon.image { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); color: #b45309; }
  .log-icon.login { background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%); color: #047857; }

  .log-content {
    flex: 1;
    min-width: 0;
  }

  .log-action {
    font-weight: 600;
    font-size: 0.9375rem;
    color: #1f2937;
    margin-bottom: 0.375rem;
  }

  .log-details {
    font-size: 0.8125rem;
    color: #6b7280;
    margin-bottom: 0.625rem;
    padding: 0.5rem 0.75rem;
    background: #f9fafb;
    border-radius: 8px;
    border-left: 3px solid #e5e7eb;
    font-family: ui-monospace, monospace;
    word-break: break-word;
  }

  .log-meta {
    display: flex;
    gap: 1.25rem;
    font-size: 0.75rem;
    color: #9ca3af;
  }

  .log-user {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 500;
    color: #6b7280;
  }

  .log-user svg {
    opacity: 0.6;
  }

  .log-time {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .log-info {
    margin-top: 1.5rem;
    text-align: center;
  }

  .log-info p {
    font-size: 0.8125rem;
    color: #9ca3af;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .log-info p::before {
    content: '🔒';
  }

  @media (max-width: 768px) {
    .log-controls {
      flex-direction: column;
      align-items: stretch;
    }
    .filter-group {
      flex-direction: column;
      align-items: stretch;
    }
    .log-entry {
      padding: 1rem;
    }
  }

  /* Dark mode */
  [data-theme="dark"] .log-section {
    background: var(--color-bg);
  }

  [data-theme="dark"] .log-controls {
    background: var(--color-bg-alt);
    box-shadow: 0 2px 12px rgba(0,0,0,0.2);
  }

  [data-theme="dark"] .filter-group label {
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .select-input {
    background: var(--color-bg);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  [data-theme="dark"] .btn-outline {
    background: var(--color-bg);
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .btn-outline:hover {
    border-color: #ef4444;
    color: #f87171;
    background: rgba(239, 68, 68, 0.1);
  }

  [data-theme="dark"] .log-card {
    background: #1e1e1e;
    box-shadow: 0 4px 24px rgba(0,0,0,0.3);
  }

  [data-theme="dark"] .log-empty {
    color: var(--color-text-muted);
  }

  [data-theme="dark"] .log-entry {
    background: #252525;
    border-color: #333;
  }

  [data-theme="dark"] .log-entry:hover {
    background: #2a2a2a;
    border-color: #444;
  }

  [data-theme="dark"] .log-action {
    color: #e5e5e5;
  }

  [data-theme="dark"] .log-details {
    color: #aaa;
    background: #252525;
    border-left-color: #444;
  }

  [data-theme="dark"] .log-meta {
    color: #888;
  }

  [data-theme="dark"] .log-user {
    color: #999;
  }

  [data-theme="dark"] .log-icon.user { background: rgba(29, 78, 216, 0.2); color: #60a5fa; }
  [data-theme="dark"] .log-icon.settings { background: rgba(124, 58, 237, 0.2); color: #a78bfa; }
  [data-theme="dark"] .log-icon.roadmap { background: rgba(5, 150, 105, 0.2); color: #34d399; }
  [data-theme="dark"] .log-icon.image { background: rgba(180, 83, 9, 0.2); color: #fbbf24; }
  [data-theme="dark"] .log-icon.login { background: rgba(4, 120, 87, 0.2); color: #4ade80; }

  [data-theme="dark"] .log-info p {
    color: var(--color-text-muted);
  }
</style>

<script is:inline src="/js/shared-data.js"></script>
<script>
  // Sample activity data for testing
  const sampleActivity = [
    { type: 'login', action: 'Admin logged in', details: null, admin: 'Dad', timestamp: new Date(Date.now() - 1000 * 60 * 5).toISOString() },
    { type: 'image', action: 'Deleted unused image', details: 'Sleep Number Bed (/images/property/sleep-number.webp)', admin: 'Jeremiah', timestamp: new Date(Date.now() - 1000 * 60 * 30).toISOString() },
    { type: 'settings', action: 'Updated site settings', details: 'Changed contact email', admin: 'Dad', timestamp: new Date(Date.now() - 1000 * 60 * 60 * 2).toISOString() },
    { type: 'roadmap', action: 'Added change request', details: 'bug: Form not submitting on mobile Safari...', admin: 'Guest', timestamp: new Date(Date.now() - 1000 * 60 * 60 * 5).toISOString() },
    { type: 'user', action: 'Created new admin account', details: 'mom@islandgoodes.com', admin: 'Dad', timestamp: new Date(Date.now() - 1000 * 60 * 60 * 24).toISOString() },
    { type: 'image', action: 'Requested image use', details: 'Kilauea Volcano → Add to Volcanoes blog post...', admin: 'Jeremiah', timestamp: new Date(Date.now() - 1000 * 60 * 60 * 48).toISOString() },
  ];

  async function getActivityLog() {
    try {
      const data = await window.SharedData.getActivityLog();
      return data && data.length > 0 ? data : sampleActivity;
    } catch {
      return sampleActivity;
    }
  }

  function formatDate(timestamp: string) {
    const date = new Date(timestamp);
    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }

  function getIcon(type: string) {
    const icons: Record<string, string> = {
      user: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
      </svg>`,
      settings: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>`,
      roadmap: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="12,2 2,7 12,12 22,7 12,2"/>
        <polyline points="2,17 12,22 22,17"/>
        <polyline points="2,12 12,17 22,12"/>
      </svg>`,
      image: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
        <circle cx="8.5" cy="8.5" r="1.5"/>
        <polyline points="21,15 16,10 5,21"/>
      </svg>`,
      login: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
        <polyline points="10,17 15,12 10,7"/>
        <line x1="15" y1="12" x2="3" y2="12"/>
      </svg>`
    };
    return icons[type] || icons.settings;
  }

  async function renderLog(filter = 'all') {
    const container = document.getElementById('logEntries');
    if (!container) return;

    const log = await getActivityLog();
    const filtered = filter === 'all' ? log : log.filter((e: any) => e.type === filter);

    if (filtered.length === 0) {
      container.innerHTML = '<div class="log-empty">No activity recorded yet.</div>';
      return;
    }

    container.innerHTML = filtered.reverse().map((entry: any) => `
      <div class="log-entry">
        <div class="log-icon ${entry.type}">
          ${getIcon(entry.type)}
        </div>
        <div class="log-content">
          <div class="log-action">${entry.action}</div>
          ${entry.details ? `<div class="log-details">${entry.details}</div>` : ''}
          <div class="log-meta">
            <span class="log-user">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
              ${entry.admin || 'Unknown'}
            </span>
            <span>${formatDate(entry.timestamp)}</span>
          </div>
        </div>
      </div>
    `).join('');
  }

  // Filter change
  document.getElementById('typeFilter')?.addEventListener('change', async (e) => {
    const filter = (e.target as HTMLSelectElement).value;
    await renderLog(filter);
  });

  // Clear log
  document.getElementById('clearLog')?.addEventListener('click', async () => {
    if (confirm('Are you sure you want to clear all activity logs?')) {
      await window.SharedData.clearActivityLog();
      await renderLog();
    }
  });

  // Initial render
  renderLog();
</script>
