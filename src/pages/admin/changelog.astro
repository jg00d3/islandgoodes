---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Changelog | Island Goodes Admin";
const description = "Version history and release notes";

const CURRENT_VERSION = "2.8.1";
const RELEASE_DATE = "January 15, 2026";

const changelog = [
  {
    version: "2.8.1",
    date: "January 15, 2026",
    type: "Enhancement",
    changes: [
      { type: "added", text: "Rooms dropdown menu in navigation with links to all rooms + Compare" },
      { type: "added", text: "Mobile sub-menu under Rooms with quick links to each room" },
      { type: "added", text: "Compare All Rooms button on all 4 individual room pages" },
      { type: "improved", text: "Better room discovery and comparison access across site" },
    ]
  },
  {
    version: "2.8.0",
    date: "January 15, 2026",
    type: "Feature & Performance",
    changes: [
      { type: "added", text: "WebP image conversion (161 images, 58% smaller file sizes)" },
      { type: "added", text: "Room comparison page with all amenities at a glance" },
      { type: "added", text: "Accessibility improvements: skip-to-content link, ARIA labels" },
      { type: "added", text: "Navigation active states (gold underline)" },
      { type: "added", text: "Internal cross-linking: Related Posts on all 12 blog articles" },
      { type: "added", text: "Internal cross-linking: Explore the Area section on all 4 room pages" },
      { type: "added", text: "Internal cross-linking: Recommended Rooms section on all 7 guide pages" },
      { type: "fixed", text: "Image rotation issues from WebP conversion" },
      { type: "improved", text: "Room comparison: All rooms marked as ground floor" },
      { type: "improved", text: "Room comparison: Added lanai cooking area info for 3 rooms" },
      { type: "added", text: "Bot/spam protection on all public forms" },
      { type: "improved", text: "Secure admin authentication with bcrypt hashing" },
      { type: "added", text: "XSS protection on admin pages displaying user data" },
    ]
  },
  {
    version: "2.7.0",
    date: "January 12, 2026",
    type: "Bug Fix & Cleanup",
    changes: [
      { type: "fixed", text: "Empty breadcrumb hrefs now link to homepage (18 pages fixed)" },
      { type: "added", text: "Created logo.png (512x512) for structured data/SEO" },
      { type: "added", text: "Created island-goodes-ocean-view.jpg for Open Graph images" },
      { type: "removed", text: "Removed 33 obsolete _old-* backup files from src/pages" },
      { type: "improved", text: "Website review page now tracks completed fixes" },
    ]
