---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "Unused Images";
const description = "Review unused images and decide where to use them";
const pageTitle = "Unused Images";
const pageTip = "Review and decide where to use unused images";

// Images not currently used on the website (verified to exist)
const unusedImages = [
  {
    path: "/images/property/sleep-number.webp",
    name: "Sleep Number Bed",
    category: "Property",
    suggestion: "Could highlight the premium beds in room descriptions"
  },
  {
    path: "/images/property/kitchenette.webp",
    name: "Kitchenette",
    category: "Property",
    suggestion: "Could be added to room pages or amenities section"
  },
  {
    path: "/images/birds/nene-goose.webp",
    name: "Nene Goose",
    category: "Wildlife",
    suggestion: "Hawaii state bird - could add to blog or guide"
  },
  {
    path: "/images/birds/myna-bird.webp",
    name: "Myna Bird",
    category: "Wildlife",
    suggestion: "Common Hawaii bird - could add to blog or guide"
  },
  {
    path: "/images/scenery/hilo-bay2.webp",
    name: "Hilo Bay View 2",
    category: "Scenery",
    suggestion: "Another Hilo Bay view for homepage or guide"
  },
  {
    path: "/images/kilauea-volcano.webp",
    name: "Kilauea Volcano",
    category: "Attractions",
    suggestion: "Great for the Volcanoes blog post or guide"
  },
  {
    path: "/images/attractions/akaka-falls3.webp",
    name: "Akaka Falls 3",
    category: "Attractions",
    suggestion: "Additional Akaka Falls photo for waterfall content"
  },
  {
    path: "/images/activities/manta-ray.webp",
    name: "Manta Ray",
    category: "Activities",
    suggestion: "Could add to activities page or night snorkeling blog"
  }
];

const categories = [...new Set(unusedImages.map(img => img.category))];
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <section class="review-hero">
    <div class="container">
      <h1>Unused Images</h1>
      <p id="imageCount">Loading...</p>
    </div>
  </section>

  <section class="review-section">
    <div class="container">
      <div class="review-intro">
        <p><strong>Delete</strong> moves the image to the deleted folder.<br>
        <strong>Use This</strong> requires you to specify WHERE to use it - an email will be sent so you can tell Claude to process it.</p>
      </div>

      <div id="imageContainer">
        {categories.map(category => (
          <div class="category-section" data-category={category}>
            <h2 class="category-title">{category}</h2>
            <div class="image-grid">
              {unusedImages.filter(img => img.category === category).map(image => (
                <div class="image-card" data-path={image.path} data-name={image.name}>
                  <div class="image-preview">
                    <img src={image.path} alt={image.name} loading="lazy" />
                  </div>
                  <div class="image-info">
                    <h4>{image.name}</h4>
                    <p class="suggestion">{image.suggestion}</p>
                    <code class="image-path">{image.path}</code>
                  </div>
                  <div class="image-actions">
                    <button class="action-btn use-btn" data-action="use">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 5v14M5 12h14"/>
                      </svg>
                      Use This
                    </button>
                    <button class="action-btn delete-btn" data-action="delete">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3,6 5,6 21,6"/>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                      </svg>
                      Delete
                    </button>
                  </div>
                  <div class="use-form" style="display: none;">
                    <label>
                      <strong>Where should this image go?</strong>
                      <textarea placeholder="e.g., Add to the Hilo Bay Room page gallery, or use as hero image on the Activities page..." rows="3" required></textarea>
                    </label>
                    <div class="use-form-actions">
                      <button class="btn btn-primary submit-use-btn">Submit Request</button>
                      <button class="btn btn-outline cancel-use-btn">Cancel</button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div id="emptyState" class="empty-state" style="display: none;">
        <div class="empty-icon">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <h2>All Done!</h2>
        <p>You've reviewed all unused images. Check back later when new images are added.</p>
      </div>
    </div>
  </section>
</AdminLayout>

<script is:inline src="/js/shared-data.js"></script>
<script>
  const SESSION_KEY = 'islandgoodes_admin_session';

  // Check session
  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  }

  // Redirect if not logged in
  const session = getSession();
  if (!session) {
    window.location.href = '/admin';
  }

  // Track processed images
  async function getProcessedImages(): Promise<string[]> {
    try {
      const result = await fetch('/.netlify/functions/data-store', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ store: 'processedUnusedImages', action: 'get', key: 'data' })
      }).then(r => r.json());
      return Array.isArray(result) ? result : [];
    } catch { return []; }
  }

  async function markAsProcessed(path: string) {
    const processed = await getProcessedImages();
    if (!processed.includes(path)) {
      processed.push(path);
      await fetch('/.netlify/functions/data-store', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ store: 'processedUnusedImages', action: 'set', key: 'data', data: processed })
      });
    }
  }

  // Hide already processed images on load
  async function filterProcessedImages() {
    const processed = await getProcessedImages();
    const deleted = await window.SharedData.getDeletedImages() || [];
    const allHidden = [...processed, ...deleted];

    let visibleCount = 0;
    document.querySelectorAll('.image-card').forEach(card => {
      const path = (card as HTMLElement).dataset.path;
      if (path && allHidden.includes(path)) {
        card.remove();
      } else {
        visibleCount++;
      }
    });

    // Remove empty categories
    document.querySelectorAll('.category-section').forEach(section => {
      const cards = section.querySelectorAll('.image-card');
      if (cards.length === 0) {
        section.remove();
      }
    });

    // Update count
    document.getElementById('imageCount')!.textContent =
      visibleCount === 0
        ? 'All images have been reviewed!'
        : `${visibleCount} image${visibleCount !== 1 ? 's' : ''} to review`;

    // Show empty state if no images left
    if (visibleCount === 0) {
      document.getElementById('imageContainer')!.style.display = 'none';
      document.getElementById('emptyState')!.style.display = 'block';
    }
  }

  // Delete button handler
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const card = (btn as HTMLElement).closest('.image-card') as HTMLElement;
      const path = card.dataset.path;
      const name = card.dataset.name;

      if (!confirm(`Delete "${name}"?\n\nThis will move the image to the deleted folder.`)) {
        return;
      }

      try {
        // Add to deleted images (hides from site)
        const deleted = await window.SharedData.getDeletedImages() || [];
        if (!deleted.includes(path)) {
          deleted.push(path);
          await window.SharedData.saveDeletedImages(deleted);
        }

        // Mark as processed
        await markAsProcessed(path);

        // Log activity
        await window.SharedData.logActivity('image', 'Deleted unused image', `${name} (${path})`);

        // Remove from page with animation
        card.style.transition = 'all 0.3s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.9)';
        setTimeout(() => {
          card.remove();
          updateCounts();
        }, 300);

      } catch (err) {
        console.error('Delete error:', err);
        alert('Failed to delete image. Please try again.');
      }
    });
  });

  // Use button handler - show the form
  document.querySelectorAll('.use-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = (btn as HTMLElement).closest('.image-card') as HTMLElement;
      const form = card.querySelector('.use-form') as HTMLElement;
      const actions = card.querySelector('.image-actions') as HTMLElement;

      actions.style.display = 'none';
      form.style.display = 'block';
      form.querySelector('textarea')?.focus();
    });
  });

  // Cancel use form
  document.querySelectorAll('.cancel-use-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = (btn as HTMLElement).closest('.image-card') as HTMLElement;
      const form = card.querySelector('.use-form') as HTMLElement;
      const actions = card.querySelector('.image-actions') as HTMLElement;
      const textarea = form.querySelector('textarea') as HTMLTextAreaElement;

      textarea.value = '';
      form.style.display = 'none';
      actions.style.display = 'flex';
    });
  });

  // Submit use request
  document.querySelectorAll('.submit-use-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const card = (btn as HTMLElement).closest('.image-card') as HTMLElement;
      const path = card.dataset.path;
      const name = card.dataset.name;
      const textarea = card.querySelector('.use-form textarea') as HTMLTextAreaElement;
      const location = textarea.value.trim();

      if (!location) {
        alert('Please specify where this image should be used.');
        textarea.focus();
        return;
      }

      (btn as HTMLButtonElement).disabled = true;
      (btn as HTMLButtonElement).textContent = 'Submitting...';

      try {
        const adminName = session?.fullName || session?.username || 'Admin';

        // Create change request
        const request = {
          id: `img-use-${Date.now()}`,
          type: 'image',
          priority: 'medium',
          page: path,
          description: `📸 USE IMAGE: ${name}\n\nImage path: ${path}\n\nWhere to use it:\n${location}`,
          status: 'pending',
          requestedBy: adminName,
          created: new Date().toISOString()
        };

        // Save to change requests
        const requests = await window.SharedData.getChangeRequests() || [];
        requests.push(request);
        await window.SharedData.saveChangeRequests(requests);

        // Send email notification
        await fetch('/.netlify/functions/change-request-notify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ request })
        });

        // Mark as processed
        await markAsProcessed(path);

        // Log activity
        await window.SharedData.logActivity('image', 'Requested image use', `${name} → ${location.substring(0, 50)}...`);

        // Remove from page with animation
        card.style.transition = 'all 0.3s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.9)';
        setTimeout(() => {
          card.remove();
          updateCounts();
        }, 300);

        alert('Request submitted! You\'ll receive an email confirmation. Tell Claude to process the change request when ready.');

      } catch (err) {
        console.error('Submit error:', err);
        alert('Failed to submit request. Please try again.');
        (btn as HTMLButtonElement).disabled = false;
        (btn as HTMLButtonElement).textContent = 'Submit Request';
      }
    });
  });

  // Update counts after removal
  function updateCounts() {
    const visibleCards = document.querySelectorAll('.image-card').length;

    document.getElementById('imageCount')!.textContent =
      visibleCards === 0
        ? 'All images have been reviewed!'
        : `${visibleCards} image${visibleCards !== 1 ? 's' : ''} to review`;

    // Remove empty categories
    document.querySelectorAll('.category-section').forEach(section => {
      if (section.querySelectorAll('.image-card').length === 0) {
        section.remove();
      }
    });

    // Show empty state if no images left
    if (visibleCards === 0) {
      document.getElementById('imageContainer')!.style.display = 'none';
      document.getElementById('emptyState')!.style.display = 'block';
    }
  }

  // Initialize
  filterProcessedImages();
</script>

<style>
  .review-hero {
    background: var(--gradient-primary);
    color: #fff;
    padding: 8rem 2rem 3rem;
  }

  .review-hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .review-hero p {
    opacity: 0.9;
  }

  .review-section {
    padding: 3rem 2rem;
    background: var(--color-bg-alt);
    min-height: 50vh;
  }

  .review-intro {
    max-width: 700px;
    margin: 0 auto 2rem;
    text-align: center;
    background: #fff;
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  .review-intro p {
    color: var(--color-text-light);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  .category-section {
    margin-bottom: 3rem;
  }

  .category-title {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-accent);
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .image-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }

  .image-preview {
    height: 200px;
    overflow: hidden;
    background: #f0f0f0;
  }

  .image-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-info {
    padding: 1rem 1.25rem;
  }

  .image-info h4 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    color: var(--color-text);
  }

  .suggestion {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-light);
    line-height: 1.5;
  }

  .image-path {
    display: block;
    font-size: 0.75rem;
    color: #888;
    background: #f5f5f5;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .image-actions {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid #eee;
  }

  .action-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    border: 2px solid;
  }

  .use-btn {
    background: #10B981;
    border-color: #10B981;
    color: #fff;
  }

  .use-btn:hover {
    background: #059669;
    border-color: #059669;
  }

  .delete-btn {
    background: #fff;
    border-color: #EF4444;
    color: #EF4444;
  }

  .delete-btn:hover {
    background: #EF4444;
    color: #fff;
  }

  .use-form {
    padding: 1rem 1.25rem;
    border-top: 1px solid #eee;
    background: #f9fafb;
  }

  .use-form label {
    display: block;
    margin-bottom: 1rem;
  }

  .use-form label strong {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .use-form textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.875rem;
    resize: vertical;
    box-sizing: border-box;
  }

  .use-form textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .use-form-actions {
    display: flex;
    gap: 0.75rem;
  }

  .use-form-actions .btn {
    flex: 1;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: #fff;
    border-radius: 16px;
    max-width: 500px;
    margin: 0 auto;
  }

  .empty-icon {
    color: #10B981;
    margin-bottom: 1.5rem;
  }

  .empty-state h2 {
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .empty-state p {
    color: var(--color-text-light);
  }

  /* Dark mode */
  :global([data-theme="dark"]) .review-intro {
    background: var(--color-bg-alt);
  }

  :global([data-theme="dark"]) .review-intro p {
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .image-card {
    background: var(--color-bg-alt);
  }

  :global([data-theme="dark"]) .image-preview {
    background: var(--color-bg);
  }

  :global([data-theme="dark"]) .image-info h4 {
    color: var(--color-text);
  }

  :global([data-theme="dark"]) .suggestion {
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .image-path {
    background: var(--color-bg);
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .image-actions {
    border-top-color: var(--color-border);
  }

  :global([data-theme="dark"]) .delete-btn {
    background: var(--color-bg);
  }

  :global([data-theme="dark"]) .use-form {
    background: var(--color-bg);
    border-top-color: var(--color-border);
  }

  :global([data-theme="dark"]) .use-form label strong {
    color: var(--color-text);
  }

  :global([data-theme="dark"]) .use-form textarea {
    background: var(--color-bg-alt);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  :global([data-theme="dark"]) .empty-state {
    background: var(--color-bg-alt);
  }

  :global([data-theme="dark"]) .empty-state h2 {
    color: var(--color-text);
  }

  :global([data-theme="dark"]) .empty-state p {
    color: var(--color-text-muted);
  }

  @media (max-width: 600px) {
    .image-grid {
      grid-template-columns: 1fr;
    }

    .review-hero {
      padding: 6rem 1.5rem 2rem;
    }

    .image-actions {
      flex-direction: column;
    }
  }
</style>
