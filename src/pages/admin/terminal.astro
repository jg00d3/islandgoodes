---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Secure Terminal | Island Goodes Admin";
const description = "Web-based terminal access";

// Terminal server - proxied through nginx with SSL
const TERMINAL_URL = "https://terminal.islandgoodes.com";
---

<PreviewLayout title={title} description={description}>
  <div id="authCheck"></div>

  <div id="terminal-page" style="display: none;">
    <section class="terminal-hero">
      <div class="container">
        <div class="hero-header">
          <div>
            <h1>Secure Terminal</h1>
            <p>Web-based access to development server</p>
          </div>
          <div class="hero-actions">
            <a href="/admin/session-notes" class="btn btn-outline">Notes</a>
            <a href="/admin" class="btn btn-outline">Dashboard</a>
          </div>
        </div>
      </div>
    </section>

    <section class="terminal-section">
      <div class="container">
        <div class="security-notice">
          <div class="notice-icon">🔒</div>
          <div class="notice-content">
            <strong>Ultra Secure Access</strong>
            <p>You'll be prompted for terminal credentials. These are separate from your admin login for extra security.</p>
          </div>
        </div>

        <div class="terminal-container" id="terminalContainer">
          <iframe
            id="terminalFrame"
            src={TERMINAL_URL}
            class="terminal-frame"
            allow="clipboard-read; clipboard-write"
          ></iframe>
        </div>

        <div class="terminal-help">
          <h3>Quick Tips</h3>
          <ul>
            <li><strong>Scroll:</strong> Mouse wheel or Ctrl+Shift+Up/Down</li>
            <li><strong>Copy:</strong> Select text, then Ctrl+Shift+C</li>
            <li><strong>Paste:</strong> Ctrl+Shift+V</li>
            <li><strong>Claude Code:</strong> Type <code>claude</code> to start</li>
            <li><strong>tmux sessions:</strong> Type <code>tmux ls</code> to list</li>
          </ul>
        </div>
      </div>
    </section>
  </div>

  <div id="accessDenied" class="access-denied" style="display: none;">
    <div class="denied-content">
      <div class="denied-icon">🔐</div>
      <h2>Admin Access Required</h2>
      <p>You must be logged in as an admin to access the terminal.</p>
      <a href="/admin" class="btn btn-primary">Go to Admin Login</a>
    </div>
  </div>
</PreviewLayout>

<script is:inline>
  const SESSION_KEY = 'islandgoodes_admin_session';

  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  }

  // Check if admin is logged in
  const session = getSession();
  if (session) {
    document.getElementById('terminal-page').style.display = 'block';
  } else {
    document.getElementById('accessDenied').style.display = 'flex';
  }

  // Fullscreen toggle
  document.getElementById('fullscreenBtn')?.addEventListener('click', () => {
    const container = document.getElementById('terminalContainer');
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      container.requestFullscreen();
    }
  });
</script>

<style is:global>
  /* Hide share button and footer on terminal page - MUST be global to override layout */
  /* Use .terminal-page-active class added to body via script */
  body.terminal-page-active .share-buttons,
  body.terminal-page-active .site-footer,
  body.terminal-page-active .cookie-banner {
    display: none !important;
  }

  /* Minimize header to thin bar */
  body.terminal-page-active .site-header {
    background: #1a1a2e !important;
    border-bottom: 1px solid rgba(255,255,255,0.1) !important;
  }

  body.terminal-page-active .site-header .nav-container {
    padding: 0.5rem 1rem !important;
  }

  body.terminal-page-active .site-header .logo-text {
    font-size: 1.1rem !important;
    color: #fff !important;
  }

  body.terminal-page-active .site-header .permit-number,
  body.terminal-page-active .site-header .nav-links,
  body.terminal-page-active .site-header .mobile-menu-toggle {
    display: none !important;
  }
</style>

<script is:inline>
  // Add class to body immediately for CSS to work
  document.body.classList.add('terminal-page-active');
</script>

<style>
  /* Compact terminal hero */
  .terminal-hero {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    padding: 4rem 1rem 0.5rem;
  }

  .hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-header h1 {
    font-size: 2rem;
    margin: 0 0 0.25rem;
  }

  .hero-header p {
    margin: 0;
    opacity: 0.8;
  }

  .hero-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .terminal-section {
    background: #0d1117;
    padding: 0;
    min-height: calc(100vh - 200px);
  }

  .terminal-section .container {
    max-width: 100%;
    padding: 0;
  }

  .security-notice {
    display: flex;
    gap: 1rem;
    align-items: center;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 1rem 1.5rem;
    margin: 1rem;
    border-radius: 8px;
  }

  .notice-icon {
    font-size: 1.5rem;
  }

  .notice-content strong {
    color: #10B981;
    display: block;
    margin-bottom: 0.25rem;
  }

  .notice-content p {
    margin: 0;
    color: #9CA3AF;
    font-size: 0.875rem;
  }

  .terminal-container {
    width: 100%;
    height: calc(100vh - 180px);
    min-height: 500px;
    background: #0d1117;
  }

  .terminal-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: #0d1117;
  }

  .terminal-help {
    background: #161b22;
    padding: 1.5rem;
    margin: 1rem;
    border-radius: 8px;
  }

  .terminal-help h3 {
    color: #fff;
    margin: 0 0 1rem;
    font-size: 1rem;
  }

  .terminal-help ul {
    margin: 0;
    padding-left: 1.25rem;
    color: #9CA3AF;
    font-size: 0.875rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.5rem;
  }

  .terminal-help li {
    margin-bottom: 0.25rem;
  }

  .terminal-help strong {
    color: #fff;
  }

  .terminal-help code {
    background: rgba(255,255,255,0.1);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-family: monospace;
  }

  .access-denied {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
    padding: 2rem;
  }

  .denied-content {
    text-align: center;
    max-width: 400px;
  }

  .denied-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .denied-content h2 {
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .denied-content p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  /* Fullscreen styles */
  .terminal-container:fullscreen {
    background: #0d1117;
    padding: 0;
  }

  .terminal-container:fullscreen .terminal-frame {
    height: 100vh;
  }

  @media (max-width: 768px) {
    .terminal-hero {
      padding: 3.5rem 0.75rem 0.25rem;
    }

    .hero-header {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }

    .hero-header h1 {
      font-size: 1rem;
    }

    .hero-header p {
      display: none;
    }

    .security-notice {
      display: none;
    }

    .terminal-container {
      height: calc(100vh - 80px);
      min-height: 400px;
    }

    .terminal-help {
      display: none;
    }
  }

  /* Extra small screens - optimize for keyboard */
  @media (max-height: 500px) {
    .terminal-hero {
      padding: 3rem 0.5rem 0.25rem;
    }

    .terminal-container {
      height: calc(100vh - 50px);
      min-height: 200px;
    }
  }
</style>
