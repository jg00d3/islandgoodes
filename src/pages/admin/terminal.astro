---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "Secure Terminal";
const description = "Web-based terminal access";
const pageTitle = "Secure Terminal";
const pageTip = "Select: Shift+drag | Copy: Ctrl+C | Paste: Ctrl+Shift+V";

// Terminal server - Tailscale HTTPS with Duo MFA (not accessible from public internet)
const TERMINAL_URL = "https://dev.tail68ddf4.ts.net";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <div id="authCheck"></div>

  <div id="terminal-page" style="display: none;">
    <!-- Session Controls -->
    <div class="session-controls">
      <div class="session-selector">
        <label for="sessionSelect">tmux session:</label>
        <select id="sessionSelect">
          <option value="">New shell (no tmux)</option>
          <option value="islandgoodes" selected>islandgoodes (main)</option>
          <option value="dev">dev</option>
          <option value="claude">claude</option>
        </select>
        <button id="newTerminalBtn" class="btn btn-sm">Open New Window</button>
        <button id="refreshSessionsBtn" class="btn btn-sm btn-secondary">Refresh Sessions</button>
      </div>
      <div class="tailscale-badge">
        <span class="ts-icon">🔒</span> Tailscale + Duo MFA
      </div>
    </div>

    <div class="terminal-container" id="terminalContainer">
      <iframe
        id="terminalFrame"
        src={TERMINAL_URL}
        class="terminal-frame"
        allow="clipboard-read; clipboard-write"
      ></iframe>
    </div>
  </div>

  <div id="accessDenied" class="access-denied" style="display: none;">
    <div class="denied-content">
      <div class="denied-icon">🔐</div>
      <h2>Admin Access Required</h2>
      <p>You must be logged in as an admin to access the terminal.</p>
      <p class="tailscale-note">Note: Terminal requires Tailscale VPN + Duo MFA approval.</p>
      <a href="/admin" class="btn btn-primary">Go to Admin Login</a>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  const SESSION_KEY = 'islandgoodes_admin_session';
  const TERMINAL_BASE = 'https://dev.tail68ddf4.ts.net';

  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  }

  // Check if admin is logged in
  const session = getSession();
  if (session) {
    document.getElementById('terminal-page').style.display = 'block';
  } else {
    document.getElementById('accessDenied').style.display = 'flex';
  }

  // Open new terminal window with selected session
  document.getElementById('newTerminalBtn')?.addEventListener('click', () => {
    const sessionName = document.getElementById('sessionSelect').value;
    const url = TERMINAL_BASE;
    const windowName = sessionName ? `terminal-${sessionName}-${Date.now()}` : `terminal-shell-${Date.now()}`;
    const newWindow = window.open(url, windowName, 'width=1200,height=800');

    // After window opens, user can manually attach to tmux session
    if (sessionName && newWindow) {
      // Store session hint for the new window
      localStorage.setItem('pending_tmux_session', sessionName);
    }
  });

  // Session selector changes the iframe
  document.getElementById('sessionSelect')?.addEventListener('change', (e) => {
    const sessionName = e.target.value;
    const iframe = document.getElementById('terminalFrame');
    // Reload the iframe - user will need to manually attach to tmux
    iframe.src = TERMINAL_BASE;
  });

  // Refresh available sessions (placeholder - requires server endpoint)
  document.getElementById('refreshSessionsBtn')?.addEventListener('click', async () => {
    alert('To see available tmux sessions, run: tmux ls\nTo attach: tmux attach -t <session>\nTo create: tmux new -s <name>');
  });

  // Fullscreen toggle
  document.getElementById('fullscreenBtn')?.addEventListener('click', () => {
    const container = document.getElementById('terminalContainer');
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      container.requestFullscreen();
    }
  });
</script>

<style is:global>
  /* Session controls bar */
  .session-controls {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    height: 44px;
    background: #161b22;
    border-bottom: 1px solid #30363d;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    z-index: 10;
  }

  .session-selector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .session-selector label {
    color: #8b949e;
    font-size: 0.875rem;
  }

  .session-selector select {
    background: #0d1117;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }

  .session-selector .btn {
    padding: 0.375rem 0.75rem;
    font-size: 0.8rem;
  }

  .session-selector .btn-sm {
    background: #238636;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }

  .session-selector .btn-sm:hover {
    background: #2ea043;
  }

  .session-selector .btn-secondary {
    background: #21262d;
    border: 1px solid #30363d;
  }

  .session-selector .btn-secondary:hover {
    background: #30363d;
  }

  .tailscale-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #3fb950;
    font-size: 0.8rem;
    background: rgba(63, 185, 80, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    border: 1px solid rgba(63, 185, 80, 0.3);
  }

  .ts-icon {
    font-size: 0.9rem;
  }

  /* Terminal page specific styles */
  .terminal-container {
    position: fixed;
    top: 104px; /* AdminLayout header (60px) + session controls (44px) */
    left: 0;
    right: 0;
    bottom: 0;
    background: #0d1117;
  }

  .terminal-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: #0d1117;
  }

  .access-denied {
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f7f5f2;
    padding: 2rem;
  }

  .denied-content {
    text-align: center;
    max-width: 400px;
  }

  .denied-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .denied-content h2 {
    color: #2D3436;
    margin-bottom: 0.5rem;
  }

  .denied-content p {
    color: #636E72;
    margin-bottom: 1.5rem;
  }

  .tailscale-note {
    font-size: 0.9rem;
    color: #f0883e;
    background: rgba(240, 136, 62, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  /* Fullscreen styles */
  .terminal-container:fullscreen {
    top: 0;
  }

  .terminal-container:fullscreen .terminal-frame {
    height: 100vh;
  }
</style>
