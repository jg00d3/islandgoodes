---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "Secure Terminal";
const description = "Web-based terminal access";
const pageTitle = "Secure Terminal";
const pageTip = "Select: Shift+drag | Copy: Ctrl+C | Paste: Ctrl+Shift+V";

// Terminal server - Tailscale HTTPS with Duo MFA (not accessible from public internet)
const TERMINAL_URL = "https://dev.tail68ddf4.ts.net";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <div id="authCheck"></div>

  <div id="terminal-page" style="display: none;">
    <!-- Session Controls -->
    <div class="session-controls">
      <div class="session-buttons">
        <button id="popOutBtn" class="btn btn-sm" title="Pop out to separate window">
          <span class="btn-icon">↗</span> Pop Out
        </button>
        <button id="fullscreenBtn" class="btn btn-sm" title="Toggle fullscreen">
          <span class="btn-icon">⛶</span> Fullscreen
        </button>
        <button id="newTerminalBtn" class="btn btn-sm btn-primary" title="Open additional terminal">
          <span class="btn-icon">+</span> New Terminal
        </button>
      </div>
      <div class="tailscale-badge">
        <span class="ts-icon">🔒</span> Tailscale + Duo MFA
      </div>
    </div>

    <div class="terminal-container" id="terminalContainer">
      <div id="connectPrompt" class="connect-prompt">
        <div class="connect-content">
          <div class="connect-icon">🔐</div>
          <h2>Secure Terminal</h2>
          <p>Connect to your development server via Tailscale + Duo MFA</p>
          <button id="connectBtn" class="btn-connect">Connect</button>
        </div>
      </div>
      <iframe
        id="terminalFrame"
        class="terminal-frame"
        style="display: none;"
        allow="clipboard-read; clipboard-write"
      ></iframe>
    </div>
  </div>

  <div id="accessDenied" class="access-denied" style="display: none;">
    <div class="denied-content">
      <div class="denied-icon">🔐</div>
      <h2>Admin Access Required</h2>
      <p>You must be logged in as an admin to access the terminal.</p>
      <p class="tailscale-note">Note: Terminal requires Tailscale VPN + Duo MFA approval.</p>
      <a href="/admin" class="btn btn-primary">Go to Admin Login</a>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  const SESSION_KEY = 'islandgoodes_admin_session';
  const TERMINAL_URL = 'https://dev.tail68ddf4.ts.net';

  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  }

  // Check if admin is logged in
  const session = getSession();
  if (session) {
    document.getElementById('terminal-page').style.display = 'block';
  } else {
    document.getElementById('accessDenied').style.display = 'flex';
  }

  // Connect button - load terminal in iframe
  document.getElementById('connectBtn')?.addEventListener('click', () => {
    const iframe = document.getElementById('terminalFrame');
    const prompt = document.getElementById('connectPrompt');
    iframe.src = TERMINAL_URL;
    iframe.style.display = 'block';
    prompt.style.display = 'none';
  });

  // Pop out - open terminal in new window (note: requires new Duo auth)
  document.getElementById('popOutBtn')?.addEventListener('click', () => {
    const win = window.open(TERMINAL_URL, `terminal-popout-${Date.now()}`, 'width=1200,height=800');
    if (win) {
      // Optionally hide the iframe after pop-out
      const iframe = document.getElementById('terminalFrame');
      iframe.style.display = 'none';
      iframe.insertAdjacentHTML('afterend',
        '<div class="popped-out-msg">Terminal popped out to separate window.<br><button onclick="location.reload()" class="btn btn-sm">Reload Embedded Terminal</button></div>'
      );
    }
  });

  // Fullscreen toggle
  document.getElementById('fullscreenBtn')?.addEventListener('click', () => {
    const container = document.getElementById('terminalContainer');
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      container.requestFullscreen();
    }
  });

  // Open new terminal window
  document.getElementById('newTerminalBtn')?.addEventListener('click', () => {
    window.open(TERMINAL_URL, `terminal-${Date.now()}`, 'width=1200,height=800');
  });
</script>

<style is:global>
  /* Session controls bar */
  .session-controls {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    height: 44px;
    background: #161b22;
    border-bottom: 1px solid #30363d;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    z-index: 10;
  }

  .session-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .session-buttons .btn-sm {
    background: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    cursor: pointer;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .session-buttons .btn-sm:hover {
    background: #30363d;
  }

  .session-buttons .btn-primary {
    background: #238636;
    color: white;
    border: none;
  }

  .session-buttons .btn-primary:hover {
    background: #2ea043;
  }

  .btn-icon {
    font-size: 1rem;
  }

  .popped-out-msg {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #8b949e;
    text-align: center;
    gap: 1rem;
  }

  .popped-out-msg .btn-sm {
    background: #238636;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    padding: 0.5rem 1rem;
  }

  .connect-prompt {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
  }

  .connect-content {
    text-align: center;
    color: #c9d1d9;
  }

  .connect-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .connect-content h2 {
    color: #fff;
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
  }

  .connect-content p {
    color: #8b949e;
    margin-bottom: 1.5rem;
  }

  .btn-connect {
    background: linear-gradient(135deg, #238636 0%, #2ea043 100%);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.75rem 2rem;
    font-size: 1.1rem;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 12px rgba(35, 134, 54, 0.3);
  }

  .btn-connect:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(35, 134, 54, 0.4);
  }

  .tailscale-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #3fb950;
    font-size: 0.8rem;
    background: rgba(63, 185, 80, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    border: 1px solid rgba(63, 185, 80, 0.3);
  }

  .ts-icon {
    font-size: 0.9rem;
  }

  /* Terminal page specific styles */
  .terminal-container {
    position: fixed;
    top: 104px; /* AdminLayout header (60px) + session controls (44px) */
    left: 0;
    right: 0;
    bottom: 0;
    background: #0d1117;
  }

  .terminal-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: #0d1117;
  }

  .access-denied {
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f7f5f2;
    padding: 2rem;
  }

  .denied-content {
    text-align: center;
    max-width: 400px;
  }

  .denied-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .denied-content h2 {
    color: #2D3436;
    margin-bottom: 0.5rem;
  }

  .denied-content p {
    color: #636E72;
    margin-bottom: 1.5rem;
  }

  .tailscale-note {
    font-size: 0.9rem;
    color: #f0883e;
    background: rgba(240, 136, 62, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  /* Fullscreen styles */
  .terminal-container:fullscreen {
    top: 0;
  }

  .terminal-container:fullscreen .terminal-frame {
    height: 100vh;
  }
</style>
