---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "Secure Terminal";
const description = "Web-based terminal access";
const pageTitle = "Secure Terminal";
const pageTip = "Select: Shift+drag | Copy: Ctrl+C | Paste: Ctrl+Shift+V";

// Terminal server - Tailscale HTTPS with Duo MFA (not accessible from public internet)
const TERMINAL_BASE = "https://dev.tail68ddf4.ts.net";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <div id="authCheck"></div>

  <div id="terminal-page" style="display: none;">
    <!-- Session Controls -->
    <div class="session-controls">
      <div class="session-selector">
        <label for="sessionSelect">tmux session:</label>
        <select id="sessionSelect">
          <option value="">Loading sessions...</option>
        </select>
        <button id="connectBtn" class="btn btn-sm btn-primary">Connect</button>
        <button id="newTerminalBtn" class="btn btn-sm">New Window</button>
        <button id="refreshSessionsBtn" class="btn btn-sm btn-secondary">Refresh</button>
      </div>
      <div class="tailscale-badge">
        <span class="ts-icon">🔒</span> Tailscale + Duo MFA
      </div>
    </div>

    <div class="terminal-container" id="terminalContainer">
      <div id="terminalPlaceholder" class="terminal-placeholder">
        <p>Select a tmux session and click <strong>Connect</strong></p>
        <p class="hint">Or click <strong>New Window</strong> to open in a popup</p>
      </div>
      <iframe
        id="terminalFrame"
        class="terminal-frame"
        style="display: none;"
        allow="clipboard-read; clipboard-write"
      ></iframe>
    </div>
  </div>

  <div id="accessDenied" class="access-denied" style="display: none;">
    <div class="denied-content">
      <div class="denied-icon">🔐</div>
      <h2>Admin Access Required</h2>
      <p>You must be logged in as an admin to access the terminal.</p>
      <p class="tailscale-note">Note: Terminal requires Tailscale VPN + Duo MFA approval.</p>
      <a href="/admin" class="btn btn-primary">Go to Admin Login</a>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  const SESSION_KEY = 'islandgoodes_admin_session';
  const TERMINAL_BASE = 'https://dev.tail68ddf4.ts.net';
  const SESSIONS_API = 'https://dev.tail68ddf4.ts.net/api/sessions';

  function getTerminalUrl(sessionName) {
    if (sessionName) {
      return `${TERMINAL_BASE}/?arg=${encodeURIComponent(sessionName)}`;
    }
    return TERMINAL_BASE;
  }

  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  }

  // Fetch and populate tmux sessions
  async function loadSessions() {
    const select = document.getElementById('sessionSelect');
    try {
      const response = await fetch(SESSIONS_API);
      const data = await response.json();

      select.innerHTML = '<option value="">-- Select Session --</option>';
      select.innerHTML += '<option value="__new__">+ Create New Session</option>';

      if (data.sessions && data.sessions.length > 0) {
        data.sessions.forEach(s => {
          const status = s.status === 'attached' ? ' (attached)' : '';
          const opt = document.createElement('option');
          opt.value = s.name;
          opt.textContent = `${s.name} - ${s.windows} window${s.windows > 1 ? 's' : ''}${status}`;
          select.appendChild(opt);
        });
      }
    } catch (err) {
      select.innerHTML = '<option value="">Failed to load sessions</option>';
      console.error('Failed to load sessions:', err);
    }
  }

  // Check if admin is logged in
  const session = getSession();
  if (session) {
    document.getElementById('terminal-page').style.display = 'block';
    loadSessions();
  } else {
    document.getElementById('accessDenied').style.display = 'flex';
  }

  // Connect button - load selected session in iframe
  document.getElementById('connectBtn')?.addEventListener('click', () => {
    const sessionName = document.getElementById('sessionSelect').value;
    if (!sessionName) {
      alert('Please select a session first');
      return;
    }

    const iframe = document.getElementById('terminalFrame');
    const placeholder = document.getElementById('terminalPlaceholder');

    // Handle "create new" option
    const url = sessionName === '__new__' ? TERMINAL_BASE : getTerminalUrl(sessionName);

    iframe.src = url;
    iframe.style.display = 'block';
    placeholder.style.display = 'none';
  });

  // Open new terminal window with selected session
  document.getElementById('newTerminalBtn')?.addEventListener('click', () => {
    const sessionName = document.getElementById('sessionSelect').value;
    const url = sessionName === '__new__' || !sessionName ? TERMINAL_BASE : getTerminalUrl(sessionName);
    const windowName = sessionName ? `terminal-${sessionName}-${Date.now()}` : `terminal-shell-${Date.now()}`;
    window.open(url, windowName, 'width=1200,height=800');
  });

  // Refresh sessions list
  document.getElementById('refreshSessionsBtn')?.addEventListener('click', () => {
    loadSessions();
  });

  // Fullscreen toggle
  document.getElementById('fullscreenBtn')?.addEventListener('click', () => {
    const container = document.getElementById('terminalContainer');
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      container.requestFullscreen();
    }
  });
</script>

<style is:global>
  /* Session controls bar */
  .session-controls {
    position: fixed;
    top: 60px;
    left: 0;
    right: 0;
    height: 44px;
    background: #161b22;
    border-bottom: 1px solid #30363d;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    z-index: 10;
  }

  .session-selector {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .session-selector label {
    color: #8b949e;
    font-size: 0.875rem;
  }

  .session-selector select {
    background: #0d1117;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }

  .session-selector .btn {
    padding: 0.375rem 0.75rem;
    font-size: 0.8rem;
  }

  .session-selector .btn-sm {
    background: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    cursor: pointer;
  }

  .session-selector .btn-sm:hover {
    background: #30363d;
  }

  .session-selector .btn-primary {
    background: #238636;
    color: white;
    border: none;
  }

  .session-selector .btn-primary:hover {
    background: #2ea043;
  }

  .session-selector .btn-secondary {
    background: #21262d;
    border: 1px solid #30363d;
  }

  .session-selector .btn-secondary:hover {
    background: #30363d;
  }

  .terminal-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #8b949e;
    text-align: center;
  }

  .terminal-placeholder p {
    margin: 0.5rem 0;
  }

  .terminal-placeholder .hint {
    font-size: 0.85rem;
    color: #6e7681;
  }

  .tailscale-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #3fb950;
    font-size: 0.8rem;
    background: rgba(63, 185, 80, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    border: 1px solid rgba(63, 185, 80, 0.3);
  }

  .ts-icon {
    font-size: 0.9rem;
  }

  /* Terminal page specific styles */
  .terminal-container {
    position: fixed;
    top: 104px; /* AdminLayout header (60px) + session controls (44px) */
    left: 0;
    right: 0;
    bottom: 0;
    background: #0d1117;
  }

  .terminal-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: #0d1117;
  }

  .access-denied {
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f7f5f2;
    padding: 2rem;
  }

  .denied-content {
    text-align: center;
    max-width: 400px;
  }

  .denied-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .denied-content h2 {
    color: #2D3436;
    margin-bottom: 0.5rem;
  }

  .denied-content p {
    color: #636E72;
    margin-bottom: 1.5rem;
  }

  .tailscale-note {
    font-size: 0.9rem;
    color: #f0883e;
    background: rgba(240, 136, 62, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  /* Fullscreen styles */
  .terminal-container:fullscreen {
    top: 0;
  }

  .terminal-container:fullscreen .terminal-frame {
    height: 100vh;
  }
</style>
