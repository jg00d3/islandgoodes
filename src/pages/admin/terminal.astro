---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "Secure Terminal";
const description = "Web-based terminal access";
const pageTitle = "Secure Terminal";
const pageTip = "Select: Shift+drag | Copy: Ctrl+C | Paste: Ctrl+Shift+V";

// Terminal server - Tailscale HTTPS with Duo MFA (not accessible from public internet)
const TERMINAL_URL = "https://dev.tail68ddf4.ts.net";
const API_URL = "https://dev.tail68ddf4.ts.net/api";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <div id="authCheck"></div>

  <div id="terminal-page" style="display: none;">
    <div class="terminal-dashboard">
      <!-- Header -->
      <div class="dash-header">
        <div class="dash-title">
          <h1>Terminal Sessions</h1>
          <p>Connect to your development server via Tailscale + Duo MFA</p>
        </div>
        <div class="dash-actions">
          <button id="refreshBtn" class="btn btn-sm" title="Refresh sessions">
            <span class="btn-icon">↻</span> Refresh
          </button>
          <button id="newSessionBtn" class="btn btn-sm btn-primary" title="Create new session">
            <span class="btn-icon">+</span> New Session
          </button>
        </div>
      </div>

      <!-- Sessions Grid -->
      <div class="sessions-container">
        <div id="sessionsGrid" class="sessions-grid">
          <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading sessions...</p>
          </div>
        </div>
      </div>

      <!-- Security Badge -->
      <div class="security-footer">
        <div class="tailscale-badge">
          <span class="ts-icon">🔒</span> Tailscale VPN + Duo MFA Required
        </div>
      </div>
    </div>
  </div>

  <div id="accessDenied" class="access-denied" style="display: none;">
    <div class="denied-content">
      <div class="denied-icon">🔐</div>
      <h2>Admin Access Required</h2>
      <p>You must be logged in as an admin to access the terminal.</p>
      <p class="tailscale-note">Note: Terminal requires Tailscale VPN + Duo MFA approval.</p>
      <a href="/admin" class="btn btn-primary">Go to Admin Login</a>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  const SESSION_KEY = 'islandgoodes_admin_session';
  const TERMINAL_URL = 'https://dev.tail68ddf4.ts.net';
  const API_URL = 'https://dev.tail68ddf4.ts.net/api';

  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  }

  // Check if admin is logged in
  const session = getSession();
  if (session) {
    document.getElementById('terminal-page').style.display = 'block';
    loadSessions();
  } else {
    document.getElementById('accessDenied').style.display = 'flex';
  }

  async function loadSessions() {
    const grid = document.getElementById('sessionsGrid');

    try {
      const response = await fetch(`${API_URL}/sessions`);
      const data = await response.json();

      if (data.sessions && data.sessions.length > 0) {
        grid.innerHTML = data.sessions.map(s => `
          <div class="session-card ${s.status === 'attached' ? 'attached' : ''}">
            <div class="session-icon">
              ${s.status === 'attached' ? '🟢' : '⚫'}
            </div>
            <div class="session-info">
              <h3>${escapeHtml(s.name)}</h3>
              <p>${s.windows} window${s.windows !== 1 ? 's' : ''} • ${s.status}</p>
            </div>
            <button class="btn btn-open" onclick="openSession('${escapeHtml(s.name)}')">
              Open
            </button>
          </div>
        `).join('');
      } else {
        grid.innerHTML = `
          <div class="empty-state">
            <div class="empty-icon">📺</div>
            <h3>No Active Sessions</h3>
            <p>Create a new session to get started</p>
            <button class="btn btn-primary" onclick="createNewSession()">
              <span class="btn-icon">+</span> Create Session
            </button>
          </div>
        `;
      }
    } catch (error) {
      grid.innerHTML = `
        <div class="error-state">
          <div class="error-icon">⚠️</div>
          <h3>Cannot Connect to Server</h3>
          <p>Make sure you're connected to Tailscale VPN</p>
          <button class="btn btn-sm" onclick="loadSessions()">Try Again</button>
        </div>
      `;
    }
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  async function openSession(sessionName) {
    try {
      // Tell API which session to connect to
      await fetch(`${API_URL}/connect/${encodeURIComponent(sessionName)}`, {
        method: 'POST'
      });
      // Open terminal in new window
      window.open(TERMINAL_URL, `terminal-${sessionName}-${Date.now()}`, 'width=1200,height=800');
    } catch (error) {
      alert('Failed to initiate connection. Make sure Tailscale is connected.');
    }
  }

  async function createNewSession() {
    const name = prompt('Enter session name (or leave blank for auto-generated):');
    if (name === null) return; // Cancelled

    const sessionName = name.trim() || `session-${Date.now().toString(36)}`;

    try {
      await fetch(`${API_URL}/connect/${encodeURIComponent(sessionName)}`, {
        method: 'POST'
      });
      window.open(TERMINAL_URL, `terminal-${sessionName}-${Date.now()}`, 'width=1200,height=800');
      // Refresh list after a delay
      setTimeout(loadSessions, 2000);
    } catch (error) {
      alert('Failed to create session. Make sure Tailscale is connected.');
    }
  }

  // Event listeners
  document.getElementById('refreshBtn')?.addEventListener('click', loadSessions);
  document.getElementById('newSessionBtn')?.addEventListener('click', createNewSession);

  // Make functions available globally for onclick handlers
  window.openSession = openSession;
  window.createNewSession = createNewSession;
  window.loadSessions = loadSessions;
</script>

<style is:global>
  .terminal-dashboard {
    min-height: calc(100vh - 60px);
    background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
    padding: 2rem;
  }

  .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .dash-title h1 {
    color: #fff;
    font-size: 1.75rem;
    margin: 0 0 0.25rem 0;
  }

  .dash-title p {
    color: #8b949e;
    margin: 0;
    font-size: 0.95rem;
  }

  .dash-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.9rem;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }

  .btn-sm {
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    background: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
  }

  .btn-sm:hover {
    background: #30363d;
  }

  .btn-primary {
    background: #238636;
    color: white;
  }

  .btn-primary:hover {
    background: #2ea043;
  }

  .btn-icon {
    font-size: 1rem;
  }

  .sessions-container {
    max-width: 900px;
  }

  .sessions-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .session-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #21262d;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    transition: all 0.2s;
  }

  .session-card:hover {
    border-color: #8b949e;
    background: #282e36;
  }

  .session-card.attached {
    border-color: #238636;
  }

  .session-icon {
    font-size: 1.25rem;
  }

  .session-info {
    flex: 1;
  }

  .session-info h3 {
    color: #fff;
    font-size: 1.1rem;
    margin: 0 0 0.15rem 0;
    font-weight: 500;
  }

  .session-info p {
    color: #8b949e;
    margin: 0;
    font-size: 0.85rem;
  }

  .btn-open {
    background: #238636;
    color: white;
    padding: 0.5rem 1.25rem;
    font-weight: 500;
  }

  .btn-open:hover {
    background: #2ea043;
    transform: translateY(-1px);
  }

  .loading-state,
  .empty-state,
  .error-state {
    text-align: center;
    padding: 3rem 2rem;
    color: #8b949e;
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid #30363d;
    border-top-color: #238636;
    border-radius: 50%;
    margin: 0 auto 1rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .empty-icon,
  .error-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .empty-state h3,
  .error-state h3 {
    color: #c9d1d9;
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
  }

  .empty-state p,
  .error-state p {
    margin: 0 0 1.5rem 0;
  }

  .security-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #21262d;
  }

  .tailscale-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #3fb950;
    font-size: 0.85rem;
    background: rgba(63, 185, 80, 0.1);
    padding: 0.4rem 0.85rem;
    border-radius: 20px;
    border: 1px solid rgba(63, 185, 80, 0.3);
  }

  .ts-icon {
    font-size: 0.9rem;
  }

  .access-denied {
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f7f5f2;
    padding: 2rem;
  }

  .denied-content {
    text-align: center;
    max-width: 400px;
  }

  .denied-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .denied-content h2 {
    color: #2D3436;
    margin-bottom: 0.5rem;
  }

  .denied-content p {
    color: #636E72;
    margin-bottom: 1.5rem;
  }

  .tailscale-note {
    font-size: 0.9rem;
    color: #f0883e;
    background: rgba(240, 136, 62, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }
</style>
