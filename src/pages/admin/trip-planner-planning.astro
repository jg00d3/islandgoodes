---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "Feature Planning";
const description = "Collaborative planning for Virtual Trip Planner and Guest Check-in System";
const pageTitle = "Feature Planning";
const pageTip = "Plan Virtual Trip Planner and Guest Check-in features";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <div class="planning-page">

    <div class="planning-wrapper">
      <div class="intro-card">
        <h2>What is this page?</h2>
        <p>This is where we plan and track two upcoming features:</p>
        <ul>
          <li><strong>Virtual Trip Planner</strong> - Help guests plan their perfect Big Island adventure</li>
          <li><strong>Guest Check-in System</strong> - Automate pre-arrival emails and check-in packets</li>
        </ul>
        <div class="instructions">Check off items as we discuss and approve them. Add notes to capture decisions.</div>
      </div>

      <!-- FEATURE 1: Virtual Trip Planner -->
      <div class="feature-card">
        <div class="feature-title">
          <span class="feature-icon purple">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
          </span>
          <div>
            <h2>Virtual Trip Planner</h2>
            <span class="feature-desc">Help guests create personalized itineraries based on their interests</span>
          </div>
          <span class="feature-percent" id="vtp-progress">0%</span>
        </div>

        <div class="category-box">
          <h3>Guest Input Fields</h3>
          <p class="cat-question">What information do we collect from guests?</p>
          <div class="checklist">
            <label><input type="checkbox" data-id="vtp-001"><span>Trip dates (arrival & departure)</span></label>
            <label><input type="checkbox" data-id="vtp-002"><span>Where they're visiting from</span></label>
            <label><input type="checkbox" data-id="vtp-003"><span>Flight information (optional)</span></label>
            <label><input type="checkbox" data-id="vtp-004"><span>Number of travelers</span></label>
            <label><input type="checkbox" data-id="vtp-005"><span>Interest categories (beaches, hiking, food, culture)</span></label>
            <label><input type="checkbox" data-id="vtp-006"><span>Mobility/accessibility needs</span></label>
            <label><input type="checkbox" data-id="vtp-007"><span>Budget preference</span></label>
            <label><input type="checkbox" data-id="vtp-008"><span>Pace preference (relaxed vs packed)</span></label>
            <label><input type="checkbox" data-id="vtp-009"><span>Need rental car?</span></label>
          </div>
          <div class="notes-area">
            <label>Notes & Decisions:</label>
            <textarea data-notes="vtp-inputs" placeholder="Add notes about what inputs we need..."></textarea>
          </div>
        </div>

        <div class="category-box">
          <h3>Itinerary Generation</h3>
          <p class="cat-question">What does the generated itinerary include?</p>
          <div class="checklist">
            <label><input type="checkbox" data-id="vtp-010"><span>Day-by-day activity suggestions</span></label>
            <label><input type="checkbox" data-id="vtp-011"><span>Drive times between locations</span></label>
            <label><input type="checkbox" data-id="vtp-012"><span>Insider tips for each activity</span></label>
            <label><input type="checkbox" data-id="vtp-013"><span>Weather considerations</span></label>
            <label><input type="checkbox" data-id="vtp-014"><span>Restaurant recommendations</span></label>
            <label><input type="checkbox" data-id="vtp-015"><span>Alternative suggestions if plans change</span></label>
          </div>
          <div class="notes-area">
            <label>Notes & Decisions:</label>
            <textarea data-notes="vtp-itinerary" placeholder="Add notes about itinerary features..."></textarea>
          </div>
        </div>

        <div class="category-box">
          <h3>Output & Sharing</h3>
          <p class="cat-question">How do guests receive their itinerary?</p>
          <div class="checklist">
            <label><input type="checkbox" data-id="vtp-016"><span>Interactive web view</span></label>
            <label><input type="checkbox" data-id="vtp-017"><span>Printable PDF version</span></label>
            <label><input type="checkbox" data-id="vtp-018"><span>Email to guest</span></label>
            <label><input type="checkbox" data-id="vtp-019"><span>Save/bookmark for later</span></label>
          </div>
          <div class="notes-area">
            <label>Notes & Decisions:</label>
            <textarea data-notes="vtp-output" placeholder="Add notes about output options..."></textarea>
          </div>
        </div>
      </div>

      <!-- FEATURE 2: Guest Check-in System -->
      <div class="feature-card">
        <div class="feature-title">
          <span class="feature-icon green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
          </span>
          <div>
            <h2>Guest Check-in System</h2>
            <span class="feature-desc">Automate pre-arrival communications and check-in packets</span>
          </div>
          <span class="feature-percent" id="gci-progress">0%</span>
        </div>

        <div class="category-box">
          <h3>Booking Management</h3>
          <p class="cat-question">How does Dad enter guest booking info?</p>
          <div class="checklist">
            <label><input type="checkbox" data-id="gci-001"><span>Manual entry form in admin</span></label>
            <label><input type="checkbox" data-id="gci-002"><span>Import from ReservationKey API</span></label>
            <label><input type="checkbox" data-id="gci-003"><span>CSV/spreadsheet upload</span></label>
            <label><input type="checkbox" data-id="gci-004"><span>Calendar sync integration</span></label>
          </div>
          <div class="notes-area">
            <label>Notes & Decisions:</label>
            <textarea data-notes="gci-booking" placeholder="How should Dad enter booking data?"></textarea>
          </div>
        </div>

        <div class="category-box">
          <h3>Check-in Packet Contents</h3>
          <p class="cat-question">What info goes in the guest welcome packet?</p>
          <div class="checklist">
            <label><input type="checkbox" data-id="gci-005"><span>Room details and photos</span></label>
            <label><input type="checkbox" data-id="gci-006"><span>Check-in/check-out times</span></label>
            <label><input type="checkbox" data-id="gci-007"><span>Access codes & instructions</span></label>
            <label><input type="checkbox" data-id="gci-008"><span>House rules summary</span></label>
            <label><input type="checkbox" data-id="gci-009"><span>WiFi password</span></label>
            <label><input type="checkbox" data-id="gci-010"><span>Emergency contacts</span></label>
            <label><input type="checkbox" data-id="gci-011"><span>Directions from airport</span></label>
            <label><input type="checkbox" data-id="gci-012"><span>First-day activity suggestions</span></label>
            <label><input type="checkbox" data-id="gci-013"><span>Link to Trip Planner</span></label>
          </div>
          <div class="notes-area">
            <label>Notes & Decisions:</label>
            <textarea data-notes="gci-packet" placeholder="What should the welcome packet include?"></textarea>
          </div>
        </div>

        <div class="category-box">
          <h3>Email Automation</h3>
          <p class="cat-question">When do automated emails go out?</p>
          <div class="checklist">
            <label><input type="checkbox" data-id="gci-014"><span>Booking confirmation email</span></label>
            <label><input type="checkbox" data-id="gci-015"><span>Pre-arrival email (7 days before)</span></label>
            <label><input type="checkbox" data-id="gci-016"><span>Day-of arrival reminder</span></label>
            <label><input type="checkbox" data-id="gci-017"><span>Post-checkout thank you</span></label>
            <label><input type="checkbox" data-id="gci-018"><span>Review request email</span></label>
          </div>
          <div class="notes-area">
            <label>Notes & Decisions:</label>
            <textarea data-notes="gci-email" placeholder="What automated emails do we need?"></textarea>
          </div>
        </div>
      </div>

      <div class="save-indicator" id="saveStatus">Changes auto-save to your browser</div>
    </div>
  </div>
</AdminLayout>

<style>
  .planning-page {
    min-height: 100vh;
    background: #f5f7fa;
  }

  .planning-wrapper {
    max-width: 800px;
    margin: 0 auto;
    padding: 24px;
  }

  .intro-card {
    background: white;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .intro-card h2 {
    font-size: 18px;
    color: #1e3a5f;
    margin: 0 0 12px;
  }

  .intro-card p {
    color: #4a5568;
    margin: 0 0 12px;
    line-height: 1.5;
  }

  .intro-card ul {
    margin: 0 0 16px;
    padding-left: 20px;
    color: #4a5568;
  }

  .intro-card ul li {
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .instructions {
    background: #e8f4f8;
    color: #1e3a5f;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
  }

  .feature-card {
    background: white;
    border-radius: 16px;
    margin-bottom: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    overflow: hidden;
  }

  .feature-title {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    background: #fafbfc;
    border-bottom: 1px solid #e9ecef;
  }

  .feature-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
  }

  .feature-icon.purple {
    background: #8B5CF6;
  }

  .feature-icon.green {
    background: #10B981;
  }

  .feature-title h2 {
    font-size: 20px;
    color: #1a202c;
    margin: 0 0 4px;
  }

  .feature-desc {
    font-size: 14px;
    color: #718096;
  }

  .feature-percent {
    margin-left: auto;
    font-size: 24px;
    font-weight: 700;
    color: #10B981;
  }

  .category-box {
    padding: 24px;
    border-bottom: 1px solid #e9ecef;
  }

  .category-box:last-child {
    border-bottom: none;
  }

  .category-box h3 {
    font-size: 16px;
    color: #2d3748;
    margin: 0 0 8px;
    font-weight: 600;
  }

  .cat-question {
    font-size: 14px;
    color: #718096;
    margin: 0 0 16px;
  }

  .checklist {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }

  .checklist label {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
    font-size: 15px;
    color: #4a5568;
  }

  .checklist label:hover {
    background: #f1f5f9;
    border-color: #cbd5e0;
  }

  .checklist label:has(input:checked) {
    background: #ecfdf5;
    border-color: #86efac;
    color: #166534;
  }

  .checklist input[type="checkbox"] {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: #10B981;
    flex-shrink: 0;
  }

  .checklist label span {
    flex: 1;
  }

  .notes-area {
    padding-top: 16px;
    border-top: 1px solid #e9ecef;
  }

  .notes-area label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #4a5568;
    margin-bottom: 8px;
  }

  .notes-area textarea {
    width: 100%;
    min-height: 100px;
    padding: 12px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-family: inherit;
    font-size: 14px;
    color: #2d3748;
    resize: vertical;
    background: #fafbfc;
    box-sizing: border-box;
  }

  .notes-area textarea:focus {
    outline: none;
    border-color: #8B5CF6;
    background: white;
  }

  .notes-area textarea::placeholder {
    color: #a0aec0;
  }

  .save-indicator {
    text-align: center;
    padding: 16px;
    font-size: 14px;
    color: #718096;
  }

  @media (max-width: 600px) {
    .planning-wrapper {
      padding: 16px;
    }

    .feature-title {
      flex-wrap: wrap;
      gap: 12px;
    }

    .feature-percent {
      width: 100%;
      text-align: left;
      margin: 0;
    }

    .checklist label {
      padding: 10px 12px;
      font-size: 14px;
    }
  }

  /* Dark mode styles */
  :global([data-theme="dark"]) .planning-page {
    background: var(--color-bg);
  }

  :global([data-theme="dark"]) .intro-card {
    background: var(--color-bg-alt);
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }

  :global([data-theme="dark"]) .intro-card h2 {
    color: var(--color-text);
  }

  :global([data-theme="dark"]) .intro-card p,
  :global([data-theme="dark"]) .intro-card ul {
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .instructions {
    background: rgba(139, 92, 246, 0.15);
    color: var(--color-text);
  }

  :global([data-theme="dark"]) .feature-card {
    background: var(--color-bg-alt);
    box-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }

  :global([data-theme="dark"]) .feature-title {
    background: var(--color-bg);
    border-bottom-color: var(--color-border);
  }

  :global([data-theme="dark"]) .feature-title h2 {
    color: var(--color-text);
  }

  :global([data-theme="dark"]) .feature-desc {
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .category-box {
    border-bottom-color: var(--color-border);
  }

  :global([data-theme="dark"]) .category-box h3 {
    color: var(--color-text);
  }

  :global([data-theme="dark"]) .cat-question {
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .checklist label {
    background: var(--color-bg);
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .checklist label:hover {
    background: rgba(255,255,255,0.05);
    border-color: var(--color-border);
  }

  :global([data-theme="dark"]) .checklist label:has(input:checked) {
    background: rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.4);
    color: #34d399;
  }

  :global([data-theme="dark"]) .notes-area {
    border-top-color: var(--color-border);
  }

  :global([data-theme="dark"]) .notes-area label {
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .notes-area textarea {
    background: var(--color-bg);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  :global([data-theme="dark"]) .notes-area textarea:focus {
    background: var(--color-bg-alt);
    border-color: #8B5CF6;
  }

  :global([data-theme="dark"]) .notes-area textarea::placeholder {
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .save-indicator {
    color: var(--color-text-muted);
  }
</style>

<script>
  let planningData = { checked: {}, notes: {} };

  function loadData() {
    try {
      const saved = localStorage.getItem('islandgoodes_planning');
      if (saved) {
        planningData = JSON.parse(saved);
        applyData();
      }
    } catch (e) {}
  }

  function applyData() {
    Object.keys(planningData.checked).forEach(id => {
      const cb = document.querySelector('input[data-id="' + id + '"]');
      if (cb) cb.checked = planningData.checked[id];
    });
    Object.keys(planningData.notes).forEach(key => {
      const ta = document.querySelector('textarea[data-notes="' + key + '"]');
      if (ta) ta.value = planningData.notes[key];
    });
    updateProgress();
  }

  function saveData() {
    try {
      localStorage.setItem('islandgoodes_planning', JSON.stringify(planningData));
      document.getElementById('saveStatus').textContent = 'Saved!';
      setTimeout(() => {
        document.getElementById('saveStatus').textContent = 'Changes auto-save to your browser';
      }, 2000);
    } catch (e) {}
  }

  function updateProgress() {
    // Virtual Trip Planner
    const vtpAll = document.querySelectorAll('input[data-id^="vtp-"]');
    const vtpChecked = document.querySelectorAll('input[data-id^="vtp-"]:checked');
    const vtpPct = vtpAll.length > 0 ? Math.round((vtpChecked.length / vtpAll.length) * 100) : 0;
    document.getElementById('vtp-progress').textContent = vtpPct + '%';

    // Guest Check-in
    const gciAll = document.querySelectorAll('input[data-id^="gci-"]');
    const gciChecked = document.querySelectorAll('input[data-id^="gci-"]:checked');
    const gciPct = gciAll.length > 0 ? Math.round((gciChecked.length / gciAll.length) * 100) : 0;
    document.getElementById('gci-progress').textContent = gciPct + '%';
  }

  // Checkbox listeners
  document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
    cb.addEventListener('change', function() {
      planningData.checked[this.dataset.id] = this.checked;
      updateProgress();
      saveData();
    });
  });

  // Textarea listeners
  document.querySelectorAll('textarea').forEach(ta => {
    let timeout;
    ta.addEventListener('input', function() {
      planningData.notes[this.dataset.notes] = this.value;
      clearTimeout(timeout);
      document.getElementById('saveStatus').textContent = 'Saving...';
      timeout = setTimeout(saveData, 1000);
    });
  });

  loadData();
  updateProgress();
</script>
