---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = "AI Chat Assistant";
const description = "Configure and test the AI chat assistant for visitor interactions";
const pageTitle = "AI Chat Assistant";
const pageTip = "Configure and test the AI chatbot";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <div id="authCheck"></div>

  <div id="dashboard" class="dashboard" style="display: none;">
    <section class="dashboard-hero">
      <div class="container">
        <div class="hero-header">
          <div>
            <h1>AI Chat Assistant</h1>
            <p>Intelligent visitor support powered by AI</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Status & Toggle -->
    <section class="status-section">
      <div class="container">
        <div class="status-card">
          <div class="status-header">
            <div class="status-info">
              <h2>Chat Status</h2>
              <p id="statusText" class="status-text">AI Chat is currently disabled on the website</p>
            </div>
            <div class="status-toggle">
              <label class="toggle-switch large">
                <input type="checkbox" id="toggleAIChat" />
                <span class="toggle-slider"></span>
              </label>
              <span id="toggleLabel" class="toggle-label">Disabled</span>
            </div>
          </div>
          <div class="status-note">
            <span class="note-icon">i</span>
            <span>When enabled, visitors will see a chat bubble in the bottom-right corner of the website.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Usage Analytics -->
    <section class="usage-section">
      <div class="container">
        <div class="usage-card">
          <div class="usage-header">
            <h2>Usage Analytics</h2>
            <p>Monitor AI chat activity and estimated costs</p>
          </div>

          <div class="usage-stats" id="usageStats">
            <div class="stat-card">
              <div class="stat-value" id="statToday">--</div>
              <div class="stat-label">Today</div>
            </div>
            <div class="stat-card">
              <div class="stat-value" id="statWeek">--</div>
              <div class="stat-label">This Week</div>
            </div>
            <div class="stat-card">
              <div class="stat-value" id="statMonth">--</div>
              <div class="stat-label">This Month</div>
            </div>
            <div class="stat-card">
              <div class="stat-value" id="statCost">--</div>
              <div class="stat-label">Est. Cost (Month)</div>
            </div>
          </div>

          <div class="usage-table-wrapper">
            <table class="usage-table" id="usageTable">
              <thead>
                <tr>
                  <th>Date/Time</th>
                  <th>Visitor</th>
                  <th>Conversation</th>
                  <th>Tokens (In/Out)</th>
                  <th>Est. Cost</th>
                </tr>
              </thead>
              <tbody id="usageTableBody">
                <tr>
                  <td colspan="5" class="empty-state">Loading usage data...</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="usage-footer">
            <div class="pagination" id="pagination"></div>
            <button id="clearUsageBtn" class="btn btn-outline btn-small">Clear Usage Data</button>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="info-section">
      <div class="container">
        <div class="info-card">
          <h2>How It Works</h2>

          <div class="info-grid">
            <div class="info-item">
              <div class="info-icon">1</div>
              <div class="info-content">
                <h3>Visitor Asks a Question</h3>
                <p>A visitor clicks the chat bubble and types a question like "What's included in the rate?" or "How far is the beach?"</p>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">2</div>
              <div class="info-content">
                <h3>AI Processes the Question</h3>
                <p>The question is sent to our AI assistant (powered by Claude) along with your custom training data about Island Goodes.</p>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">3</div>
              <div class="info-content">
                <h3>Personalized Response</h3>
                <p>The AI generates a helpful, accurate response based on your property information, policies, and local knowledge.</p>
              </div>
            </div>

            <div class="info-item">
              <div class="info-icon">4</div>
              <div class="info-content">
                <h3>Escalation Option</h3>
                <p>If the AI can't help, visitors can easily contact you directly via phone or the contact form.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Training Data -->
    <section class="training-section">
      <div class="container">
        <div class="training-card">
          <div class="training-header">
            <h2>Training Data</h2>
            <p>This information teaches the AI about Island Goodes. Edit to customize responses.</p>
          </div>

          <div class="training-form">
            <div class="form-group">
              <label for="propertyInfo">Property Information</label>
              <textarea id="propertyInfo" rows="6" placeholder="Describe your property, rooms, amenities..."></textarea>
              <span class="field-hint">Include: room types, rates, amenities, check-in/out times, policies</span>
            </div>

            <div class="form-group">
              <label for="locationInfo">Location & Attractions</label>
              <textarea id="locationInfo" rows="6" placeholder="Describe your location, nearby attractions..."></textarea>
              <span class="field-hint">Include: distance to airport, beaches, restaurants, Hawaii Volcanoes National Park</span>
            </div>

            <div class="form-group">
              <label for="faqInfo">Common Questions & Answers</label>
              <textarea id="faqInfo" rows="6" placeholder="Q: Is Island Goodes adults only?&#10;A: Yes, all guests must be 18 or older..."></textarea>
              <span class="field-hint">Format: Q: Question here\nA: Answer here (one per line pair)</span>
            </div>

            <div class="form-group">
              <label for="toneInfo">Personality & Tone</label>
              <textarea id="toneInfo" rows="3" placeholder="Friendly, warm, Hawaiian hospitality..."></textarea>
              <span class="field-hint">How should the AI sound? Casual, professional, use Hawaiian words?</span>
            </div>

            <div class="training-actions">
              <button id="saveTraining" class="btn btn-primary">Save Training Data</button>
              <button id="loadDefaults" class="btn btn-outline">Load Defaults</button>
            </div>
            <p id="trainingSaved" class="success-message"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Test Chat -->
    <section class="test-section">
      <div class="container">
        <div class="test-card">
          <div class="test-header">
            <h2>Test Chat</h2>
            <p>Try the AI assistant before enabling it on the website. This works even when the chat is disabled.</p>
          </div>

          <div class="chat-container">
            <div id="chatMessages" class="chat-messages">
              <div class="chat-message assistant">
                <div class="message-avatar">AI</div>
                <div class="message-content">
                  <p>Aloha! I'm the Island Goodes assistant. Ask me anything about the property, rates, local attractions, or your upcoming stay!</p>
                </div>
              </div>
            </div>

            <form id="chatForm" class="chat-input-form">
              <input type="text" id="chatInput" placeholder="Type a question..." autocomplete="off" />
              <button type="submit" class="btn btn-primary" id="sendBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="22" y1="2" x2="11" y2="13"/>
                  <polygon points="22,2 15,22 11,13 2,9 22,2"/>
                </svg>
              </button>
            </form>
          </div>

          <div class="test-suggestions">
            <span>Try asking:</span>
            <button class="suggestion-btn" data-question="What's included in the rate?">What's included?</button>
            <button class="suggestion-btn" data-question="Is Island Goodes adults only?">Adults only?</button>
            <button class="suggestion-btn" data-question="How far is the beach?">Beach distance?</button>
            <button class="suggestion-btn" data-question="What's nearby?">Nearby attractions?</button>
          </div>
        </div>
      </div>
    </section>

    <!-- AI Providers -->
    <section class="setup-section">
      <div class="container">
        <div class="setup-card">
          <div class="providers-header">
            <div>
              <h2>AI Providers</h2>
              <p>Configure AI backends with automatic failover. The system tries providers in priority order.</p>
            </div>
            <button id="addProviderBtn" class="btn btn-primary">Add Provider</button>
          </div>

          <div id="providerList" class="provider-list">
            <div class="provider-loading">Loading providers...</div>
          </div>

          <!-- Add/Edit Provider Modal -->
          <div id="providerModal" class="provider-modal" style="display:none;">
            <div class="modal-overlay"></div>
            <div class="modal-content">
              <div class="modal-header">
                <h3 id="modalTitle">Add Provider</h3>
                <button class="modal-close" id="modalClose">&times;</button>
              </div>
              <form id="providerForm" class="provider-form">
                <input type="hidden" id="providerId" />

                <div class="form-group">
                  <label for="providerName">Provider Name</label>
                  <input type="text" id="providerName" placeholder="e.g. vLLM (GPU Server)" required />
                </div>

                <div class="form-group">
                  <label for="providerType">Type</label>
                  <select id="providerType" required>
                    <option value="openai">OpenAI-Compatible (vLLM, OpenAI, Ollama, etc.)</option>
                    <option value="anthropic">Anthropic (Claude)</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="providerUrl">API URL</label>
                  <input type="url" id="providerUrl" placeholder="https://api.example.com/v1/chat/completions" required />
                </div>

                <div class="form-group">
                  <label for="providerModel">Model Name</label>
                  <input type="text" id="providerModel" placeholder="e.g. gpt-oss-20b" required />
                </div>

                <div class="form-group">
                  <label for="providerKey">API Key</label>
                  <input type="password" id="providerKey" placeholder="Leave blank if not required" />
                </div>

                <div class="form-group">
                  <label>Extra Headers <span class="field-hint-inline">(optional, e.g. CF-Access credentials)</span></label>
                  <div id="extraHeadersContainer">
                    <div class="extra-header-row">
                      <input type="text" class="header-key" placeholder="Header name" />
                      <input type="password" class="header-value" placeholder="Header value" />
                      <button type="button" class="btn-icon remove-header" title="Remove">&times;</button>
                    </div>
                  </div>
                  <button type="button" id="addHeaderBtn" class="btn btn-outline btn-small">Add Header</button>
                </div>

                <div class="modal-actions">
                  <button type="button" class="btn btn-outline" id="cancelProvider">Cancel</button>
                  <button type="submit" class="btn btn-primary" id="saveProviderBtn">Save Provider</button>
                </div>
              </form>
            </div>
          </div>

          <div class="provider-fallback-note">
            <span class="note-icon">i</span>
            <span>If no providers are configured, the system falls back to the <code>ANTHROPIC_API_KEY</code> environment variable.</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>

<style>
  .dashboard-hero {
    background: var(--gradient-primary);
    color: #fff;
    padding: 8rem 2rem 2rem;
  }

  .hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .dashboard-hero h1 {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .dashboard-hero p {
    opacity: 0.9;
  }

  /* Status Section */
  .status-section {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .status-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .status-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .status-info h2 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .status-text {
    color: var(--color-text-light);
  }

  .status-text.enabled {
    color: #059669;
    font-weight: 600;
  }

  .status-toggle {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .toggle-label {
    font-weight: 600;
    color: var(--color-text-light);
  }

  .toggle-label.enabled {
    color: #059669;
  }

  .toggle-switch.large {
    width: 64px;
    height: 34px;
  }

  .toggle-switch.large .toggle-slider:before {
    height: 28px;
    width: 28px;
  }

  .toggle-switch.large input:checked + .toggle-slider:before {
    transform: translateX(30px);
  }

  .status-note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: #F0F9FF;
    border-radius: 8px;
    color: #0369A1;
    font-size: 0.9375rem;
  }

  .note-icon {
    width: 24px;
    height: 24px;
    background: #0369A1;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  /* Info Section */
  .info-section {
    padding: 2rem;
  }

  .info-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .info-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .info-item {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
  }

  .info-icon {
    width: 40px;
    height: 40px;
    background: var(--color-primary);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    flex-shrink: 0;
  }

  .info-content h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-body);
  }

  .info-content p {
    font-size: 0.9375rem;
    color: var(--color-text-light);
    margin: 0;
    line-height: 1.6;
  }

  /* Training Section */
  .training-section {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .training-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .training-header {
    margin-bottom: 2rem;
  }

  .training-header h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .training-header p {
    color: var(--color-text-light);
  }

  .training-form .form-group {
    margin-bottom: 1.5rem;
  }

  .training-form label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .training-form textarea {
    width: 100%;
    padding: 1rem;
    border: 2px solid var(--color-bg-alt);
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.9375rem;
    resize: vertical;
    transition: border-color 0.2s;
  }

  .training-form textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .field-hint {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text-light);
    margin-top: 0.5rem;
  }

  .training-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .success-message {
    color: #059669;
    margin-top: 1rem;
  }

  /* Test Section */
  .test-section {
    padding: 2rem;
  }

  .test-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .test-header {
    margin-bottom: 1.5rem;
  }

  .test-header h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .test-header p {
    color: var(--color-text-light);
  }

  .chat-container {
    border: 2px solid var(--color-bg-alt);
    border-radius: 12px;
    overflow: hidden;
  }

  .chat-messages {
    height: 350px;
    overflow-y: auto;
    padding: 1.5rem;
    background: #FAFAFA;
  }

  .chat-message {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .chat-message.user {
    flex-direction: row-reverse;
  }

  .message-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .chat-message.assistant .message-avatar {
    background: var(--color-primary);
    color: #fff;
  }

  .chat-message.user .message-avatar {
    background: var(--color-secondary);
    color: #1a1a1a;
  }

  .message-content {
    max-width: 80%;
    padding: 0.875rem 1.25rem;
    border-radius: 16px;
    line-height: 1.5;
  }

  .chat-message.assistant .message-content {
    background: #fff;
    border: 1px solid #e5e5e5;
  }

  .chat-message.user .message-content {
    background: var(--color-primary);
    color: #fff;
  }

  .message-content p {
    margin: 0;
  }

  .chat-input-form {
    display: flex;
    gap: 0.5rem;
    padding: 1rem;
    background: #fff;
    border-top: 1px solid var(--color-bg-alt);
  }

  .chat-input-form input {
    flex: 1;
    padding: 0.875rem 1rem;
    border: 2px solid var(--color-bg-alt);
    border-radius: 50px;
    font-size: 1rem;
  }

  .chat-input-form input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .chat-input-form button {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .test-suggestions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .test-suggestions span {
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  .suggestion-btn {
    padding: 0.5rem 1rem;
    background: var(--color-bg-alt);
    border: none;
    border-radius: 50px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .suggestion-btn:hover {
    background: var(--color-primary-subtle);
    color: var(--color-primary);
  }

  /* Setup Section */
  .setup-section {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .setup-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .setup-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .setup-card > p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  /* Provider Management */
  .providers-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .providers-header p {
    color: var(--color-text-light);
    margin-top: 0.25rem;
  }

  .provider-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .provider-loading {
    text-align: center;
    color: var(--color-text-light);
    padding: 2rem;
  }

  .provider-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
    border: 2px solid transparent;
    transition: border-color 0.2s;
  }

  .provider-card.disabled {
    opacity: 0.55;
  }

  .provider-priority {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    flex-shrink: 0;
  }

  .priority-num {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .priority-arrows {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .priority-arrows button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: 0.875rem;
    color: var(--color-text-light);
    line-height: 1;
  }

  .priority-arrows button:hover {
    color: var(--color-primary);
  }

  .provider-info {
    flex: 1;
    min-width: 0;
  }

  .provider-name-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .provider-name {
    font-weight: 600;
    font-size: 1rem;
  }

  .provider-type-badge {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: 50px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .provider-type-badge.anthropic {
    background: #DDD6FE;
    color: #5B21B6;
  }

  .provider-type-badge.openai {
    background: #D1FAE5;
    color: #065F46;
  }

  .provider-meta {
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  .provider-meta code {
    background: rgba(0,0,0,0.06);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .provider-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .provider-actions .btn-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid #e5e5e5;
    background: #fff;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.2s, border-color 0.2s;
  }

  .provider-actions .btn-icon:hover {
    background: var(--color-bg-alt);
    border-color: var(--color-primary);
  }

  .provider-actions .btn-icon.delete:hover {
    background: #FEE2E2;
    border-color: #EF4444;
    color: #EF4444;
  }

  .test-result {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  .test-result.success {
    background: #D1FAE5;
    color: #065F46;
  }

  .test-result.failure {
    background: #FEE2E2;
    color: #991B1B;
  }

  .test-result.testing {
    background: #FEF3C7;
    color: #92400E;
  }

  /* Provider Modal */
  .provider-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
  }

  .modal-content {
    position: relative;
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    max-width: 540px;
    width: 90%;
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .modal-header h3 {
    font-size: 1.25rem;
