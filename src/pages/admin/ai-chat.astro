  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-header {
      flex-direction: column;
      text-align: center;
    }

    .status-header {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }

    .training-actions {
      flex-direction: column;
    }

    .usage-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Dark mode */
  :global([data-theme="dark"]) .status-card,
  :global([data-theme="dark"]) .info-card,
  :global([data-theme="dark"]) .training-card,
  :global([data-theme="dark"]) .test-card,
  :global([data-theme="dark"]) .setup-card {
