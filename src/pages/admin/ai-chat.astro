</style>

<script is:inline src="/js/shared-data.js"></script>
<script>
  const SESSION_KEY = 'islandgoodes_admin_session';

  // Check authentication
  function getSession() {
    try {
      return sessionStorage.getItem(SESSION_KEY) ? JSON.parse(sessionStorage.getItem(SESSION_KEY)!) : null;
    } catch {
      return null;
    }
  }

  const session = getSession();
  if (!session) {
    window.location.href = '/admin';
  } else {
    document.getElementById('dashboard')!.style.display = 'block';
  }

  // Settings management (using SharedData API)
  async function getSettings() {
    try {
      return await window.SharedData.getSettings() || {};
    } catch {
      return {};
    }
  }

  async function saveSettings(settings: any) {
    await window.SharedData.saveSettings(settings);
  }

  // Training data management (using SharedData API)
  async function getTrainingData() {
    try {
      return await window.SharedData.getAITraining() || {};
    } catch {
      return {};
    }
  }

  async function saveTrainingData(data: any) {
    await window.SharedData.saveAITraining(data);
  }

  // Default training data
  const defaultTraining = {
    propertyInfo: `Island Goodes is an adults-only (18+) vacation rental located in Papaikou, Hawaii, just 7 miles from Hilo International Airport (about 12 minutes).

We offer comfortable oceanview accommodations with the following amenities:
- Free WiFi
- Free parking
- Hot tub (shared)
- BBQ grill
- Beautiful tropical garden

Check-in: 3:00 PM
Check-out: 11:00 AM
Minimum stay: 2 nights

Our rates vary by season:
- Low season (Nov-Mar): Starting at $149/night
- High season (Apr-Oct): Starting at $179/night
- Extended stay discounts available (10-55% off for longer stays)`,

    locationInfo: `Location: 27-2365 Hawaii Belt Rd, Papaikou, HI 96781

Nearby attractions:
- Hawaii Volcanoes National Park: 45 minutes
- Rainbow Falls: 15 minutes
- Akaka Falls: 20 minutes
- Downtown Hilo: 10 minutes
- Richardson Beach: 20 minutes
- Honoli'i Beach (surfing): 10 minutes
- Mauna Kea summit: 1 hour

Local restaurants we recommend:
- Cafe Pesto (Hilo)
- Moon & Turtle
- Hilo Bay Cafe
- Ken's House of Pancakes (24hr)

We're located on the beautiful Hamakua Coast, known for lush tropical rainforests and stunning ocean views.`,

    faqInfo: `Q: Is Island Goodes adults only?
A: Yes, all guests must be 18 years or older. This allows us to maintain a peaceful, quiet atmosphere.

Q: Is there a pool?
A: We have a relaxing hot tub rather than a pool. It's perfect for unwinding after a day of exploring!

Q: What's the cancellation policy?
A: All bookings are non-refundable, but we offer a 1-year voucher to rebook if you need to cancel.

Q: Are pets allowed?
A: We don't allow guest pets, but we have friendly resident cats - Miss Kitty and Coconut Jake!

Q: Is breakfast included?
A: Breakfast is not included, but you have access to a kitchenette and we're close to great local restaurants.

Q: How do I book?
A: You can book directly on our website at islandgoodes.com/book or call us at 808-964-2291.`,

    toneInfo: `Friendly, warm Hawaiian hospitality. Use "Aloha" as a greeting. Be helpful and informative. Occasionally use Hawaiian words like "Mahalo" (thank you). Keep responses concise but complete. Always be encouraging about visiting the Big Island.`
  };

  // Initialize toggle state
  const toggle = document.getElementById('toggleAIChat') as HTMLInputElement;
  const toggleLabel = document.getElementById('toggleLabel');
  const statusText = document.getElementById('statusText');

  async function initToggle() {
    const settings = await getSettings();

    if (toggle) {
      toggle.checked = settings.aiChatEnabled || false;
      updateToggleUI();

      toggle.addEventListener('change', async () => {
        const current = await getSettings();
        current.aiChatEnabled = toggle.checked;
        await saveSettings(current);
        updateToggleUI();
      });
    }
  }

  initToggle();

  function updateToggleUI() {
    if (toggle?.checked) {
      if (toggleLabel) {
        toggleLabel.textContent = 'Enabled';
        toggleLabel.classList.add('enabled');
      }
      if (statusText) {
        statusText.textContent = 'AI Chat is enabled on the website';
        statusText.classList.add('enabled');
      }
    } else {
      if (toggleLabel) {
        toggleLabel.textContent = 'Disabled';
        toggleLabel.classList.remove('enabled');
      }
      if (statusText) {
        statusText.textContent = 'AI Chat is currently disabled on the website';
        statusText.classList.remove('enabled');
      }
    }
  }

  // Load training data
  const propertyInfo = document.getElementById('propertyInfo') as HTMLTextAreaElement;
  const locationInfo = document.getElementById('locationInfo') as HTMLTextAreaElement;
  const faqInfo = document.getElementById('faqInfo') as HTMLTextAreaElement;
  const toneInfo = document.getElementById('toneInfo') as HTMLTextAreaElement;

  async function initTrainingData() {
    const training = await getTrainingData();

    if (propertyInfo) propertyInfo.value = training.propertyInfo || '';
    if (locationInfo) locationInfo.value = training.locationInfo || '';
    if (faqInfo) faqInfo.value = training.faqInfo || '';
    if (toneInfo) toneInfo.value = training.toneInfo || '';
  }

  initTrainingData();

  // Save training data
  document.getElementById('saveTraining')?.addEventListener('click', async () => {
    const data = {
      propertyInfo: propertyInfo?.value || '',
      locationInfo: locationInfo?.value || '',
      faqInfo: faqInfo?.value || '',
      toneInfo: toneInfo?.value || ''
    };
    await saveTrainingData(data);

    const saved = document.getElementById('trainingSaved');
    if (saved) {
      saved.textContent = 'Training data saved successfully!';
      setTimeout(() => { saved.textContent = ''; }, 3000);
    }
  });

  // Load defaults
  document.getElementById('loadDefaults')?.addEventListener('click', async () => {
    if (confirm('This will replace all training data with defaults. Continue?')) {
      if (propertyInfo) propertyInfo.value = defaultTraining.propertyInfo;
      if (locationInfo) locationInfo.value = defaultTraining.locationInfo;
      if (faqInfo) faqInfo.value = defaultTraining.faqInfo;
      if (toneInfo) toneInfo.value = defaultTraining.toneInfo;

      await saveTrainingData(defaultTraining);

      const saved = document.getElementById('trainingSaved');
      if (saved) {
        saved.textContent = 'Default training data loaded!';
        setTimeout(() => { saved.textContent = ''; }, 3000);
      }
    }
  });

  // Test chat functionality
  const chatForm = document.getElementById('chatForm');
  const chatInput = document.getElementById('chatInput') as HTMLInputElement;
  const chatMessages = document.getElementById('chatMessages');
  const sendBtn = document.getElementById('sendBtn') as HTMLButtonElement;

  function addMessage(content: string, isUser: boolean) {
    const messageDiv = document.createElement('div');
    messageDiv.className = `chat-message ${isUser ? 'user' : 'assistant'}`;
    messageDiv.innerHTML = `
      <div class="message-avatar">${isUser ? 'You' : 'AI'}</div>
      <div class="message-content">
        <p>${content}</p>
      </div>
    `;
    chatMessages?.appendChild(messageDiv);
    chatMessages?.scrollTo(0, chatMessages.scrollHeight);
  }

  async function sendMessage(message: string) {
    if (!message.trim()) return;

    addMessage(message, true);
    chatInput.value = '';

    if (sendBtn) {
      sendBtn.disabled = true;
      sendBtn.innerHTML = '<span class="loading-spinner"></span>';
    }

    try {
      const training = await getTrainingData();
      const response = await fetch('/.netlify/functions/ai-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message,
          training
        })
      });

      const data = await response.json();

      if (response.ok && data.response) {
        const providerTag = data.provider ? ` [${data.provider}]` : '';
        addMessage(data.response + providerTag, false);
      } else {
        addMessage(data.error || 'Sorry, I encountered an error. Please try again.', false);
      }
    } catch (error) {
      console.error('Chat error:', error);
      addMessage('Sorry, I couldn\'t connect to the AI service. Please check that the API is configured.', false);
    }

    if (sendBtn) {
      sendBtn.disabled = false;
      sendBtn.innerHTML = `
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22,2 15,22 11,13 2,9 22,2"/>
        </svg>
      `;
    }
  }

  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    sendMessage(chatInput?.value || '');
  });

  // Suggestion buttons
  document.querySelectorAll('.suggestion-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const question = (btn as HTMLElement).dataset.question;
      if (question) sendMessage(question);
    });
  });

  // ===== Provider Management =====
  let providers: any[] = [];
  const providerListEl = document.getElementById('providerList')!;
  const providerModal = document.getElementById('providerModal')!;
  const providerForm = document.getElementById('providerForm')!;
  const providerTypeSelect = document.getElementById('providerType') as HTMLSelectElement;
  const providerUrlInput = document.getElementById('providerUrl') as HTMLInputElement;

  function escapeAttr(str: string) {
    return str.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Auto-fill URL when type changes
  providerTypeSelect?.addEventListener('change', () => {
    const idField = document.getElementById('providerId') as HTMLInputElement;
    if (idField?.value) return; // Don't auto-fill when editing
    if (providerTypeSelect.value === 'anthropic') {
      providerUrlInput.value = 'https://api.anthropic.com/v1/messages';
    } else {
      providerUrlInput.value = '';
    }
  });

  function renderProviders() {
    if (providers.length === 0) {
      providerListEl.innerHTML = '<div class="empty-providers">No providers configured. AI will use the ANTHROPIC_API_KEY environment variable if set.</div>';
      return;
    }

    const sorted = [...providers].sort((a, b) => (a.priority || 99) - (b.priority || 99));

    providerListEl.innerHTML = sorted.map((p, _i) => `
      <div class="provider-card ${p.enabled ? '' : 'disabled'}" data-id="${escapeAttr(p.id)}">
        <div class="provider-priority">
          <span class="priority-num">${p.priority || '?'}</span>
          <div class="priority-arrows">
            <button class="move-up" data-id="${escapeAttr(p.id)}" title="Move up">&#9650;</button>
            <button class="move-down" data-id="${escapeAttr(p.id)}" title="Move down">&#9660;</button>
          </div>
        </div>
        <div class="provider-info">
          <div class="provider-name-row">
            <span class="provider-name">${escapeAttr(p.name)}</span>
            <span class="provider-type-badge ${p.type}">${p.type === 'anthropic' ? 'Anthropic' : 'OpenAI'}</span>
            ${!p.enabled ? '<span class="provider-type-badge" style="background:#FEE2E2;color:#991B1B;">Disabled</span>' : ''}
          </div>
          <div class="provider-meta">
            Model: <code>${escapeAttr(p.model)}</code>
            &middot; Key: ${p.apiKey || 'none'}
          </div>
        </div>
        <div class="provider-actions">
          <span class="test-result" id="test-${escapeAttr(p.id)}" style="display:none;"></span>
          <button class="btn-icon test-provider" data-id="${escapeAttr(p.id)}" title="Test connection">&#9889;</button>
          <button class="btn-icon toggle-provider" data-id="${escapeAttr(p.id)}" title="${p.enabled ? 'Disable' : 'Enable'}">
            ${p.enabled ? '&#10003;' : '&#10007;'}
          </button>
          <button class="btn-icon edit-provider" data-id="${escapeAttr(p.id)}" title="Edit">&#9998;</button>
          <button class="btn-icon delete delete-provider" data-id="${escapeAttr(p.id)}" title="Delete">&#128465;</button>
        </div>
      </div>
    `).join('');

    // Bind event listeners
    providerListEl.querySelectorAll('.move-up').forEach(btn => {
      btn.addEventListener('click', () => moveProvider((btn as HTMLElement).dataset.id!, -1));
    });
    providerListEl.querySelectorAll('.move-down').forEach(btn => {
      btn.addEventListener('click', () => moveProvider((btn as HTMLElement).dataset.id!, 1));
    });
    providerListEl.querySelectorAll('.test-provider').forEach(btn => {
      btn.addEventListener('click', () => testProvider((btn as HTMLElement).dataset.id!));
    });
    providerListEl.querySelectorAll('.toggle-provider').forEach(btn => {
      btn.addEventListener('click', () => toggleProvider((btn as HTMLElement).dataset.id!));
    });
    providerListEl.querySelectorAll('.edit-provider').forEach(btn => {
      btn.addEventListener('click', () => editProvider((btn as HTMLElement).dataset.id!));
    });
    providerListEl.querySelectorAll('.delete-provider').forEach(btn => {
      btn.addEventListener('click', () => deleteProvider((btn as HTMLElement).dataset.id!));
    });
  }

  async function loadProviders() {
    try {
      providers = await window.SharedData.getAIProviders();
      renderProviders();
    } catch (err) {
      console.error('Failed to load providers:', err);
      providerListEl.innerHTML = '<div class="empty-providers">Failed to load providers</div>';
    }
  }

  async function moveProvider(id: string, direction: number) {
    const sorted = [...providers].sort((a, b) => (a.priority || 99) - (b.priority || 99));
    const idx = sorted.findIndex(p => p.id === id);
    const newIdx = idx + direction;
    if (newIdx < 0 || newIdx >= sorted.length) return;

    // Swap
    [sorted[idx], sorted[newIdx]] = [sorted[newIdx], sorted[idx]];

    const orderedIds = sorted.map(p => p.id);
    await window.SharedData.reorderAIProviders(orderedIds);

    // Update local priorities
    sorted.forEach((p, i) => { p.priority = i + 1; });
    providers = sorted;
    renderProviders();
  }

  async function testProvider(id: string) {
    const p = providers.find(p => p.id === id);
    if (!p) return;

    const resultEl = document.getElementById(`test-${id}`);
    if (resultEl) {
      resultEl.style.display = 'inline-block';
      resultEl.className = 'test-result testing';
      resultEl.textContent = 'Testing...';
    }

    try {
      const result = await window.SharedData.testAIProvider(p);
      if (resultEl) {
        if (result.success) {
          resultEl.className = 'test-result success';
          resultEl.textContent = `OK (${result.elapsed}ms)`;
        } else {
          resultEl.className = 'test-result failure';
          resultEl.textContent = result.error?.slice(0, 40) || 'Failed';
        }
      }
    } catch (err) {
      if (resultEl) {
        resultEl.className = 'test-result failure';
        resultEl.textContent = 'Error';
      }
    }
  }

  async function toggleProvider(id: string) {
    const p = providers.find(p => p.id === id);
    if (!p) return;

    p.enabled = !p.enabled;
    await window.SharedData.saveAIProvider({ id: p.id, enabled: p.enabled, name: p.name, type: p.type, url: p.url, model: p.model, apiKey: p.apiKey, extraHeaders: p.extraHeaders });
    renderProviders();
  }

  function editProvider(id: string) {
    const p = providers.find(p => p.id === id);
    if (!p) return;

    (document.getElementById('modalTitle') as HTMLElement).textContent = 'Edit Provider';
    (document.getElementById('providerId') as HTMLInputElement).value = p.id;
    (document.getElementById('providerName') as HTMLInputElement).value = p.name;
    (document.getElementById('providerType') as HTMLSelectElement).value = p.type;
    (document.getElementById('providerUrl') as HTMLInputElement).value = p.url;
    (document.getElementById('providerModel') as HTMLInputElement).value = p.model;
    (document.getElementById('providerKey') as HTMLInputElement).value = '';
    (document.getElementById('providerKey') as HTMLInputElement).placeholder = p.apiKey ? `Current: ${p.apiKey}` : 'Leave blank if not required';

    // Populate extra headers
    const container = document.getElementById('extraHeadersContainer')!;
    container.innerHTML = '';
    if (p.extraHeaders && Object.keys(p.extraHeaders).length > 0) {
      for (const [key, val] of Object.entries(p.extraHeaders)) {
        addHeaderRow(key, '', `Current: ${val as string}`);
      }
    } else {
      addHeaderRow();
    }

    providerModal.style.display = 'flex';
  }

  async function deleteProvider(id: string) {
    const p = providers.find(p => p.id === id);
    if (!p) return;
    if (!confirm(`Delete provider "${p.name}"? This cannot be undone.`)) return;

    await window.SharedData.deleteAIProvider(id);
    providers = providers.filter(p => p.id !== id);
    renderProviders();
  }

  // Modal controls
  document.getElementById('addProviderBtn')?.addEventListener('click', () => {
    (document.getElementById('modalTitle') as HTMLElement).textContent = 'Add Provider';
    providerForm.reset();
    (document.getElementById('providerId') as HTMLInputElement).value = '';
    (document.getElementById('providerKey') as HTMLInputElement).placeholder = 'Leave blank if not required';
    const container = document.getElementById('extraHeadersContainer')!;
    container.innerHTML = '';
    addHeaderRow();
    providerModal.style.display = 'flex';
  });

  function closeModal() {
    providerModal.style.display = 'none';
  }

  document.getElementById('modalClose')?.addEventListener('click', closeModal);
  document.getElementById('cancelProvider')?.addEventListener('click', closeModal);
  providerModal.querySelector('.modal-overlay')?.addEventListener('click', closeModal);

  // Extra header rows
  function addHeaderRow(key = '', value = '', placeholder = 'Header value') {
    const container = document.getElementById('extraHeadersContainer')!;
    const row = document.createElement('div');
    row.className = 'extra-header-row';
    row.innerHTML = `
      <input type="text" class="header-key" placeholder="Header name" value="${escapeAttr(key)}" />
      <input type="password" class="header-value" placeholder="${escapeAttr(placeholder)}" value="${escapeAttr(value)}" />
      <button type="button" class="btn-icon remove-header" title="Remove">&times;</button>
    `;
    row.querySelector('.remove-header')?.addEventListener('click', () => row.remove());
    container.appendChild(row);
  }

  document.getElementById('addHeaderBtn')?.addEventListener('click', () => addHeaderRow());

  // Save provider
  providerForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const id = (document.getElementById('providerId') as HTMLInputElement).value;
    const name = (document.getElementById('providerName') as HTMLInputElement).value.trim();
    const type = (document.getElementById('providerType') as HTMLSelectElement).value;
    const url = (document.getElementById('providerUrl') as HTMLInputElement).value.trim();
    const model = (document.getElementById('providerModel') as HTMLInputElement).value.trim();
    const apiKey = (document.getElementById('providerKey') as HTMLInputElement).value;

    // Collect extra headers
    const extraHeaders: Record<string, string> = {};
    document.querySelectorAll('#extraHeadersContainer .extra-header-row').forEach(row => {
      const k = (row.querySelector('.header-key') as HTMLInputElement)?.value.trim();
      const v = (row.querySelector('.header-value') as HTMLInputElement)?.value;
      if (k) {
        // If value is empty and we're editing, keep the masked value (server will resolve it)
        if (id && !v) {
          const existing = providers.find(p => p.id === id);
          if (existing?.extraHeaders?.[k]) {
            extraHeaders[k] = existing.extraHeaders[k];
          }
        } else if (v) {
          extraHeaders[k] = v;
        }
      }
    });

    const provider: any = { name, type, url, model, extraHeaders };
    if (id) provider.id = id;

    // For apiKey: if editing and left blank, keep existing masked value
    if (id && !apiKey) {
      const existing = providers.find(p => p.id === id);
      if (existing) provider.apiKey = existing.apiKey;
    } else {
      provider.apiKey = apiKey;
    }

    const saveBtn = document.getElementById('saveProviderBtn') as HTMLButtonElement;
    if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'Saving...'; }

    try {
      await window.SharedData.saveAIProvider(provider);
      closeModal();
      await loadProviders();
    } catch (err) {
      alert('Failed to save provider: ' + (err as Error).message);
    }

    if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'Save Provider'; }
  });

  loadProviders();

  // Usage Analytics
  const PAGE_SIZE = 50;
  let currentPage = 1;
  let sortedEntries: any[] = [];

  function escapeHtml(str: string) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function renderPage() {
    const tableBody = document.getElementById('usageTableBody');
    if (!tableBody) return;

    const totalPages = Math.max(1, Math.ceil(sortedEntries.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;

    const start = (currentPage - 1) * PAGE_SIZE;
    const pageItems = sortedEntries.slice(start, start + PAGE_SIZE);

    tableBody.innerHTML = pageItems.map(e => {
      const dt = new Date(e.timestamp);
      const dateStr = dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      const timeStr = dt.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
      const inTok = e.inputTokens || 0;
      const outTok = e.outputTokens || 0;
      const cost = (inTok / 1_000_000) * 0.25 + (outTok / 1_000_000) * 1.25;
      const question = e.question ? escapeHtml(e.question) : '';
      const answer = e.answer ? escapeHtml(e.answer) : '';
      return `<tr>
        <td>${dateStr} ${timeStr}</td>
        <td>${escapeHtml(e.ip || 'unknown')}</td>
        <td class="conversation-cell">
          ${question ? `<p class="conversation-question"><span class="conversation-label">Q:</span>${question}</p>` : ''}
          ${answer ? `<p class="conversation-answer"><span class="conversation-label">A:</span>${answer}</p>` : `<span style="color:var(--color-text-light)">${e.messageCount || 0} msg</span>`}
        </td>
        <td>${inTok.toLocaleString()} / ${outTok.toLocaleString()}</td>
        <td>$${cost.toFixed(4)}</td>
      </tr>`;
    }).join('');

    // Render pagination
    const paginationEl = document.getElementById('pagination');
    if (paginationEl) {
      if (sortedEntries.length <= PAGE_SIZE) {
        paginationEl.innerHTML = '';
      } else {
        paginationEl.innerHTML = `
          <button id="prevPage" ${currentPage <= 1 ? 'disabled' : ''}>Prev</button>
          <span class="page-info">Page ${currentPage} of ${totalPages}</span>
          <button id="nextPage" ${currentPage >= totalPages ? 'disabled' : ''}>Next</button>
        `;
        document.getElementById('prevPage')?.addEventListener('click', () => {
          if (currentPage > 1) { currentPage--; renderPage(); }
        });
        document.getElementById('nextPage')?.addEventListener('click', () => {
          if (currentPage < totalPages) { currentPage++; renderPage(); }
        });
      }
    }
  }

  async function loadUsageData() {
    const tableBody = document.getElementById('usageTableBody');
    try {
      const usage = await window.SharedData.getChatUsage();
      const entries: any[] = Array.isArray(usage) ? usage : [];

      if (entries.length === 0) {
        if (tableBody) {
          tableBody.innerHTML = '<tr><td colspan="5" class="empty-state">No chat activity yet</td></tr>';
        }
        document.getElementById('statToday')!.textContent = '0';
        document.getElementById('statWeek')!.textContent = '0';
        document.getElementById('statMonth')!.textContent = '0';
        document.getElementById('statCost')!.textContent = '$0.00';
        document.getElementById('pagination')!.innerHTML = '';
        return;
      }

      const now = new Date();
      const todayStr = now.toISOString().slice(0, 10);
      const weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
      const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);

      let todayCount = 0;
      let weekCount = 0;
      let monthCount = 0;
      let monthInputTokens = 0;
      let monthOutputTokens = 0;

      for (const e of entries) {
        const ts = new Date(e.timestamp);
        const dateStr = e.timestamp.slice(0, 10);

        if (dateStr === todayStr) todayCount++;
        if (ts >= weekAgo) weekCount++;
        if (ts >= monthStart) {
          monthCount++;
          monthInputTokens += e.inputTokens || 0;
          monthOutputTokens += e.outputTokens || 0;
        }
      }

      // Claude 3 Haiku pricing: $0.25/MTok input, $1.25/MTok output
      const estimatedCost = (monthInputTokens / 1_000_000) * 0.25 + (monthOutputTokens / 1_000_000) * 1.25;

      document.getElementById('statToday')!.textContent = String(todayCount);
      document.getElementById('statWeek')!.textContent = String(weekCount);
      document.getElementById('statMonth')!.textContent = String(monthCount);
      document.getElementById('statCost')!.textContent = '$' + estimatedCost.toFixed(2);

      sortedEntries = [...entries].reverse();
      currentPage = 1;
      renderPage();
    } catch (err) {
      console.error('Failed to load usage data:', err);
      if (tableBody) {
        tableBody.innerHTML = '<tr><td colspan="5" class="empty-state">Failed to load usage data</td></tr>';
      }
    }
  }

  // Clear usage data
  document.getElementById('clearUsageBtn')?.addEventListener('click', async () => {
    if (!confirm('Clear all chat usage data? This cannot be undone.')) return;
    await window.SharedData.saveChatUsage([]);
    sortedEntries = [];
    currentPage = 1;
    document.getElementById('statToday')!.textContent = '0';
    document.getElementById('statWeek')!.textContent = '0';
    document.getElementById('statMonth')!.textContent = '0';
    document.getElementById('statCost')!.textContent = '$0.00';
    document.getElementById('usageTableBody')!.innerHTML = '<tr><td colspan="5" class="empty-state">No chat activity yet</td></tr>';
    document.getElementById('pagination')!.innerHTML = '';
  });

  loadUsageData();
</script>
