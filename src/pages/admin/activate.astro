---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Activate Admin Account | Island Goodes";
const description = "Set up your Island Goodes admin account";
---

<PreviewLayout title={title} description={description}>
  <div class="activate-page">
    <div class="activate-card">
      <!-- Invalid/Expired Token -->
      <div id="invalidToken" class="activate-step" style="display: none;">
        <div class="activate-icon error">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
        </div>
        <h1>Invalid or Expired Link</h1>
        <p>This activation link is invalid or has already been used.</p>
        <p>Please contact your administrator for a new invitation.</p>
        <a href="/admin" class="btn btn-primary">Go to Admin Login</a>
      </div>

      <!-- Setup Form -->
      <div id="setupForm" class="activate-step">
        <div class="activate-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <h1>Welcome to Island Goodes!</h1>
        <p>Complete your admin account setup</p>

        <form id="activateForm">
          <div class="form-group">
            <label for="fullName">Full Name</label>
            <input type="text" id="fullName" placeholder="Your full name" required />
          </div>

          <div class="form-group">
            <label for="loginEmail">Login Email</label>
            <input type="email" id="loginEmail" readonly />
            <span class="field-note">This is your login email (cannot be changed)</span>
          </div>

          <div class="form-group">
            <label for="twoFAEmail">2FA Email (optional)</label>
            <input type="email" id="twoFAEmail" placeholder="Same as login email if left blank" />
            <span class="field-note">Verification codes will be sent here</span>
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" placeholder="Min 8 characters" required minlength="8" />
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <input type="password" id="confirmPassword" placeholder="Confirm your password" required />
          </div>

          <button type="submit" class="btn btn-primary btn-large">Create My Account</button>
        </form>
        <p id="formError" class="error-message"></p>
      </div>

      <!-- Success -->
      <div id="successStep" class="activate-step" style="display: none;">
        <div class="activate-icon success">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22,4 12,14.01 9,11.01"/>
          </svg>
        </div>
        <h1>Account Created!</h1>
        <p>Your admin account has been set up successfully.</p>
        <p>You can now login with your email and password.</p>
        <a href="/admin" class="btn btn-primary btn-large">Login Now</a>
      </div>
    </div>
  </div>
</PreviewLayout>

<style>
  .activate-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1B6B5A 0%, #0F4A3E 100%);
    padding: 2rem;
  }

  .activate-card {
    background: #fff;
    padding: 3rem;
    border-radius: 20px;
    max-width: 480px;
    width: 100%;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }

  .activate-step {
    text-align: center;
  }

  .activate-icon {
    width: 80px;
    height: 80px;
    background: var(--color-bg-alt);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: var(--color-primary);
  }

  .activate-icon.success {
    background: #ECFDF5;
    color: #059669;
  }

  .activate-icon.error {
    background: #FEE2E2;
    color: #DC2626;
  }

  .activate-card h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .activate-card > .activate-step > p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  #activateForm {
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .form-group input {
    padding: 0.875rem 1rem;
    border: 2px solid var(--color-bg-alt);
    border-radius: 10px;
    font-size: 1rem;
    transition: border-color 0.2s;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .form-group input[readonly] {
    background: var(--color-bg-alt);
    color: var(--color-text-light);
  }

  .field-note {
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  .btn-large {
    padding: 1rem 2rem;
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  .error-message {
    color: #EF4444;
    font-size: 0.875rem;
    margin-top: 0.5rem;
    text-align: center;
  }

  @media (max-width: 480px) {
    .activate-card {
      padding: 2rem;
    }
  }
</style>

<script is:inline src="/js/shared-data.js"></script>
<script>
  // Get invite data from URL
  const urlParams = new URLSearchParams(window.location.search);
  const inviteParam = urlParams.get('invite');

  const invalidToken = document.getElementById('invalidToken');
  const setupForm = document.getElementById('setupForm');
  const successStep = document.getElementById('successStep');
  const formError = document.getElementById('formError');

  // Decode invitation from URL
  interface InviteData {
    email: string;
    expires: number;
    invitedBy: string;
  }

  let inviteData: InviteData | null = null;

  function decodeInvite(encoded: string): InviteData | null {
    try {
      const decoded = JSON.parse(atob(encoded));
      if (decoded.email && decoded.expires && decoded.expires > Date.now()) {
        return decoded;
      }
      return null;
    } catch {
      return null;
    }
  }

  // Validate invitation on load (async IIFE)
  (async function initActivation() {
    if (!inviteParam) {
      if (setupForm) setupForm.style.display = 'none';
      if (invalidToken) invalidToken.style.display = 'block';
    } else {
      inviteData = decodeInvite(inviteParam);

      if (!inviteData) {
        if (setupForm) setupForm.style.display = 'none';
        if (invalidToken) invalidToken.style.display = 'block';
      } else {
        // Check if email already registered
        const admins = await window.SharedData.getAdmins();
        if (admins.some((a: any) => a.email.toLowerCase() === inviteData!.email.toLowerCase())) {
          if (setupForm) setupForm.style.display = 'none';
          if (invalidToken) {
            invalidToken.style.display = 'block';
            invalidToken.querySelector('h1')!.textContent = 'Already Registered';
            invalidToken.querySelector('p')!.textContent = 'This email is already registered as an admin. Please log in instead.';
          }
        } else {
          // Pre-fill the email
          const loginEmailInput = document.getElementById('loginEmail') as HTMLInputElement;
          if (loginEmailInput) loginEmailInput.value = inviteData.email;
        }
      }
    }
  })();

  // Handle form submission
  document.getElementById('activateForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (formError) formError.textContent = '';

    if (!inviteData) {
      if (formError) formError.textContent = 'Invalid or expired activation link';
      return;
    }

    const fullName = (document.getElementById('fullName') as HTMLInputElement)?.value.trim();
    const loginEmail = inviteData.email;
    const twoFAEmail = (document.getElementById('twoFAEmail') as HTMLInputElement)?.value.trim() || loginEmail;
    const password = (document.getElementById('password') as HTMLInputElement)?.value;
    const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement)?.value;

    // Validation
    if (!fullName) {
      if (formError) formError.textContent = 'Please enter your full name';
      return;
    }

    if (password.length < 8) {
      if (formError) formError.textContent = 'Password must be at least 8 characters';
      return;
    }

    if (password !== confirmPassword) {
      if (formError) formError.textContent = 'Passwords do not match';
      return;
    }

    // Validate 2FA email if provided
    if (twoFAEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(twoFAEmail)) {
      if (formError) formError.textContent = 'Please enter a valid 2FA email address';
      return;
    }

    // Check if email already exists in admins
    const admins = await window.SharedData.getAdmins();
    if (admins.some((a: any) => a.email.toLowerCase() === loginEmail.toLowerCase())) {
      if (formError) formError.textContent = 'An account with this email already exists';
      return;
    }

    // Create the admin account
    const newAdmin = {
      id: Date.now(),
      username: loginEmail.split('@')[0].toLowerCase().replace(/[^a-z0-9]/g, ''),
      fullName: fullName,
      email: loginEmail,
      twoFAEmail: twoFAEmail,
      passwordHash: btoa(password),
      role: 'admin',
      created: new Date().toISOString(),
      invitedBy: inviteData.invitedBy
    };

    admins.push(newAdmin);
    await window.SharedData.saveAdmins(admins);

    // Show success
    if (setupForm) setupForm.style.display = 'none';
    if (successStep) successStep.style.display = 'block';
  });
</script>
