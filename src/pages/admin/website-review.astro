---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Website Review Report | Island Goodes Admin";
const description = "Expert website audit and recommendations";
---

<PreviewLayout title={title} description={description}>
  <section class="review-hero">
    <div class="container">
      <div class="hero-content">
        <a href="/admin" class="back-link">&larr; Back to Admin</a>
        <h1>Website Expert Review</h1>
        <p>Comprehensive audit by Code, Design/UX, and Image experts</p>
        <div class="review-date">January 2026</div>
      </div>
    </div>
  </section>

  <section class="summary-section">
    <div class="container">
      <div class="summary-card">
        <h2>Executive Summary</h2>
        <p>Three experts evaluated the Island Goodes website across code quality, design/UX, and visual assets.</p>
        <div class="summary-stats">
          <div class="stat critical">
            <span class="stat-value">4</span>
            <span class="stat-label">Critical Issues</span>
          </div>
          <div class="stat high">
            <span class="stat-value">4</span>
            <span class="stat-label">High Priority</span>
          </div>
          <div class="stat medium">
            <span class="stat-value">5</span>
            <span class="stat-label">Medium Priority</span>
          </div>
          <div class="stat info">
            <span class="stat-value">97</span>
            <span class="stat-label">Images Reviewed</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="findings-section">
    <div class="container">
      <!-- Code Expert -->
      <div class="expert-card">
        <div class="expert-header">
          <div class="expert-icon code">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16,18 22,12 16,6"/>
              <polyline points="8,6 2,12 8,18"/>
            </svg>
          </div>
          <h3>Code Expert Findings</h3>
        </div>

        <div class="findings-group">
          <h4 class="findings-title critical">Critical Security Concerns</h4>
          <ul class="findings-list">
            <li>Hardcoded admin credentials embedded in client-side JavaScript at <code>admin.astro:841</code></li>
            <li>XSS vulnerabilities present in six locations using innerHTML with external data</li>
            <li>Broken navigation with empty href attributes in breadcrumbs</li>
          </ul>
        </div>

        <div class="findings-group">
          <h4 class="findings-title success">Strengths Identified</h4>
          <ul class="findings-list positive">
            <li>Excellent SEO meta tags and JSON-LD structured data</li>
            <li>Proper implementation of performance attributes like <code>fetchpriority</code> and lazy loading</li>
          </ul>
        </div>

        <div class="findings-group">
          <h4 class="findings-title">Recommendations</h4>
          <ul class="findings-list">
            <li>Move authentication to serverless functions with environment variables</li>
            <li>Add keyboard navigation skip-links</li>
            <li>Include ARIA labels throughout</li>
            <li>Remove 15+ obsolete files cluttering the pages directory</li>
          </ul>
        </div>
      </div>

      <!-- Design/UX Expert -->
      <div class="expert-card">
        <div class="expert-header">
          <div class="expert-icon design">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
          </div>
          <h3>Design/UX Expert Findings</h3>
        </div>

        <div class="findings-group">
          <h4 class="findings-title warning">Layout System Problems</h4>
          <ul class="findings-list">
            <li>Two distinct layout systems (BaseLayout and PreviewLayout) create inconsistent experiences</li>
            <li>Varying colors, fonts, and navigation patterns across different pages</li>
          </ul>
        </div>

        <div class="findings-group">
          <h4 class="findings-title warning">Color Inconsistencies</h4>
          <div class="color-comparison">
            <div class="color-item">
              <span class="color-swatch" style="background: #1a5f4a;"></span>
              <span>Primary: #1a5f4a</span>
            </div>
            <span class="vs">vs</span>
            <div class="color-item">
              <span class="color-swatch" style="background: #1B6B5A;"></span>
              <span>Primary: #1B6B5A</span>
            </div>
          </div>
          <div class="color-comparison">
            <div class="color-item">
              <span class="color-swatch" style="background: #d4a853;"></span>
              <span>Gold: #d4a853</span>
            </div>
            <span class="vs">vs</span>
            <div class="color-item">
              <span class="color-swatch" style="background: #C5A572;"></span>
              <span>Gold: #C5A572</span>
            </div>
          </div>
        </div>

        <div class="findings-group">
          <h4 class="findings-title success">Positive Elements</h4>
          <ul class="findings-list positive">
            <li>"Green/gold color palette evokes tropical luxury effectively"</li>
            <li>Playfair Display font pairing delivers elegance</li>
            <li>Unique features like weather widgets and live camera feeds add engagement</li>
          </ul>
        </div>
      </div>

      <!-- Image Expert -->
      <div class="expert-card">
        <div class="expert-header">
          <div class="expert-icon image">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21,15 16,10 5,21"/>
            </svg>
          </div>
          <h3>Image/Graphic Expert Findings</h3>
        </div>

        <div class="findings-group">
          <h4 class="findings-title warning">Missing Assets</h4>
          <ul class="findings-list">
            <li><code>logo.png</code> referenced in structured data but absent</li>
            <li><code>island-goodes-ocean-view.jpg</code> unavailable</li>
            <li>Modern format conversion needed (no WebP/AVIF formats)</li>
          </ul>
        </div>

        <div class="findings-group">
          <h4 class="findings-title">Image Inventory</h4>
          <div class="image-stats">
            <div class="img-stat">
              <span class="img-count">97</span>
              <span class="img-label">Total Images</span>
            </div>
            <div class="img-stat">
              <span class="img-count">16</span>
              <span class="img-label">Hilo Bay</span>
            </div>
            <div class="img-stat">
              <span class="img-count">18</span>
              <span class="img-label">Orchid</span>
            </div>
            <div class="img-stat">
              <span class="img-count">17</span>
              <span class="img-label">Mauna Kea</span>
            </div>
          </div>
          <p class="note">Ginger Room has incomplete documentation</p>
        </div>

        <div class="findings-group">
          <h4 class="findings-title success">Optimization Opportunity</h4>
          <p>Converting to WebP format could reduce file sizes by <strong>30-80%</strong></p>
        </div>
      </div>
    </div>
  </section>

  <section class="action-section">
    <div class="container">
      <h2>Prioritized Action Items</h2>

      <div class="action-category">
        <h3 class="category-title critical">Critical (Do First)</h3>
        <div class="action-grid">
          <div class="action-item">
            <span class="action-num">1</span>
            <div class="action-content">
              <strong>Secure admin authentication system</strong>
              <p>Move credentials to environment variables</p>
            </div>
          </div>
          <div class="action-item">
            <span class="action-num">2</span>
            <div class="action-content">
              <strong>Create missing logo.png</strong>
              <p>Required for structured data</p>
            </div>
          </div>
          <div class="action-item">
            <span class="action-num">3</span>
            <div class="action-content">
              <strong>Fix broken image references</strong>
              <p>Replace missing image files</p>
            </div>
          </div>
          <div class="action-item">
            <span class="action-num">4</span>
            <div class="action-content">
              <strong>Correct empty breadcrumb hrefs</strong>
              <p>Fix navigation accessibility</p>
            </div>
          </div>
        </div>
      </div>

      <div class="action-category">
        <h3 class="category-title high">High Priority</h3>
        <div class="action-grid">
          <div class="action-item">
            <span class="action-num">5</span>
            <div class="action-content">
              <strong>Unify layout systems</strong>
              <p>Consolidate to single consistent layout</p>
            </div>
          </div>
          <div class="action-item">
            <span class="action-num">6</span>
            <div class="action-content">
              <strong>Standardize navigation</strong>
              <p>Consistent nav across all pages</p>
            </div>
          </div>
          <div class="action-item">
            <span class="action-num">7</span>
            <div class="action-content">
              <strong>Implement WebP optimization</strong>
              <p>30-80% smaller image files</p>
            </div>
          </div>
          <div class="action-item">
            <span class="action-num">8</span>
            <div class="action-content">
              <strong>Complete Ginger Room photos</strong>
              <p>Full room documentation</p>
            </div>
          </div>
        </div>
      </div>

      <div class="action-category">
        <h3 class="category-title medium">Medium Priority</h3>
        <div class="action-grid small">
          <div class="action-item small">
            <span class="action-num">9</span>
            <span>Enhance accessibility features</span>
          </div>
          <div class="action-item small">
            <span class="action-num">10</span>
            <span>Add navigation active states</span>
          </div>
          <div class="action-item small">
            <span class="action-num">11</span>
            <span>Improve image alt text</span>
          </div>
          <div class="action-item small">
            <span class="action-num">12</span>
            <span>Remove obsolete files</span>
          </div>
          <div class="action-item small">
            <span class="action-num">13</span>
            <span>Fix XSS vulnerabilities</span>
          </div>
        </div>
      </div>

      <div class="action-category">
        <h3 class="category-title low">Nice-to-Have</h3>
        <div class="action-grid small">
          <div class="action-item small">
            <span class="action-num">14</span>
            <span>Add sitemap.xml & robots.txt</span>
          </div>
          <div class="action-item small">
            <span class="action-num">15</span>
            <span>Room comparison feature</span>
          </div>
          <div class="action-item small">
            <span class="action-num">16</span>
            <span>Utilize unused property images</span>
          </div>
          <div class="action-item small">
            <span class="action-num">17</span>
            <span>Add video tour integration</span>
          </div>
        </div>
      </div>

      <div class="cta-box">
        <p>View and manage these items in the roadmap:</p>
        <a href="/admin/roadmap" class="btn btn-primary">Open Roadmap</a>
      </div>
    </div>
  </section>
</PreviewLayout>

<style>
  .review-hero {
    background: var(--gradient-primary);
    color: #fff;
    padding: 8rem 2rem 3rem;
  }

  .back-link {
    display: inline-block;
    color: rgba(255,255,255,0.7);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #fff;
  }

  .review-hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .hero-content > p {
    opacity: 0.9;
    margin-bottom: 0.5rem;
  }

  .review-date {
    opacity: 0.7;
    font-size: 0.9375rem;
  }

  .summary-section {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .summary-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }

  .summary-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .summary-card > p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  .summary-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .stat {
    text-align: center;
    padding: 1.25rem;
    border-radius: 12px;
  }

  .stat.critical { background: #FEE2E2; }
  .stat.high { background: #FEF3C7; }
  .stat.medium { background: #E0F2FE; }
  .stat.info { background: var(--color-bg-alt); }

  .stat-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    font-family: var(--font-heading);
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .stat.critical .stat-value { color: #DC2626; }
  .stat.high .stat-value { color: #D97706; }
  .stat.medium .stat-value { color: #0369A1; }
  .stat.info .stat-value { color: var(--color-text); }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  .findings-section {
    padding: 2rem;
  }

  .expert-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }

  .expert-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .expert-icon {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .expert-icon.code { background: #6366F1; }
  .expert-icon.design { background: #EC4899; }
  .expert-icon.image { background: #10B981; }

  .expert-header h3 {
    font-size: 1.25rem;
    margin: 0;
  }

  .findings-group {
    margin-bottom: 1.5rem;
  }

  .findings-group:last-child {
    margin-bottom: 0;
  }

  .findings-title {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--color-bg-alt);
  }

  .findings-title.critical { border-color: #DC2626; color: #DC2626; }
  .findings-title.warning { border-color: #D97706; color: #D97706; }
  .findings-title.success { border-color: #059669; color: #059669; }

  .findings-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .findings-list li {
    padding: 0.5rem 0 0.5rem 1.5rem;
    position: relative;
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .findings-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.875rem;
    width: 6px;
    height: 6px;
    background: #DC2626;
    border-radius: 50%;
  }

  .findings-list.positive li::before {
    background: #059669;
  }

  .findings-list code {
    background: var(--color-bg-alt);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.8125rem;
  }

  .color-comparison {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .color-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .color-swatch {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    border: 1px solid rgba(0,0,0,0.1);
  }

  .vs {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .image-stats {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .img-stat {
    text-align: center;
  }

  .img-count {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .img-label {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  .note {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    font-style: italic;
  }

  .action-section {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .action-section h2 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .action-category {
    margin-bottom: 2rem;
  }

  .category-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    color: #fff;
  }

  .category-title.critical { background: #DC2626; }
  .category-title.high { background: #D97706; }
  .category-title.medium { background: #0369A1; }
  .category-title.low { background: #6B7280; }

  .action-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .action-grid.small {
    grid-template-columns: repeat(3, 1fr);
  }

  .action-item {
    display: flex;
    gap: 1rem;
    background: #fff;
    padding: 1rem;
    border-radius: 10px;
    align-items: flex-start;
  }

  .action-item.small {
    padding: 0.75rem 1rem;
    align-items: center;
    font-size: 0.875rem;
  }

  .action-num {
    width: 28px;
    height: 28px;
    background: var(--color-primary);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .action-content strong {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--color-text);
  }

  .action-content p {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .cta-box {
    text-align: center;
    padding: 2rem;
    background: #fff;
    border-radius: 12px;
    margin-top: 2rem;
  }

  .cta-box p {
    margin-bottom: 1rem;
    color: var(--color-text-light);
  }

  @media (max-width: 768px) {
    .summary-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .action-grid {
      grid-template-columns: 1fr;
    }
    .action-grid.small {
      grid-template-columns: 1fr;
    }
    .review-hero {
      padding: 6rem 1.5rem 2rem;
    }
  }
</style>
