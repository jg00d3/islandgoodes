---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Image Manager | Island Goodes Admin";
const description = "Manage room and gallery images";

// Room image configurations
const rooms = [
  {
    id: 'hilo-bay',
    name: 'Hilo Bay Room',
    path: '/images/rooms/hilo-bay/',
    images: ['bed.jpg', 'room.jpg', 'room2.jpg', 'room3.jpg', 'room4.jpg', 'room5.jpg', 'room6.jpg', 'view.jpg', 'view2.jpg', 'view3.jpg', 'view4.jpg', 'view5.jpg', 'view6.jpg', 'bathroom.jpg', 'bathroom2.jpg', 'bathroom3.jpg']
  },
  {
    id: 'orchid',
    name: 'Orchid Room',
    path: '/images/rooms/orchid/',
    images: ['bed.jpg', 'room.jpg', 'room2.jpg', 'living.jpg', 'living2.jpg', 'living3.jpg', 'view1.jpg', 'view2.jpg', 'view3.jpg', 'view4.jpg', 'view5.jpg', 'view6.jpg', 'view7.jpg', 'view8.jpg', 'view9.jpg', 'bathroom.jpg', 'bathroom2.jpg', 'bathroom3.jpg']
  },
  {
    id: 'mauna-kea',
    name: 'Mauna Kea Room',
    path: '/images/rooms/mauna-kea/',
    images: ['bed.jpg', 'room.jpg', 'room2.jpg', 'room3.jpg', 'room4.jpg', 'room5.jpg', 'room6.jpg', 'view.jpg', 'view2.jpg', 'view3.jpg', 'view4.jpg', 'view5.jpg', 'view6.jpg', 'bathroom.jpg', 'bathroom2.jpg', 'bathroom3.jpg', 'bathroom4.jpg']
  },
  {
    id: 'ginger',
    name: 'Ginger Room',
    path: '/images/rooms/ginger/',
    images: ['room.jpg', 'room2.jpg', 'room3.jpg', 'view.jpg', 'bathroom.jpg']
  }
];
---

<PreviewLayout title={title} description={description}>
  <section class="manager-hero">
    <div class="container">
      <div class="hero-content">
        <a href="/admin" class="back-link">&larr; Back to Admin</a>
        <h1>Image Manager</h1>
        <p>View and manage room photos and gallery images</p>
      </div>
    </div>
  </section>

  <section class="info-section">
    <div class="container">
      <div class="info-card">
        <div class="info-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
        </div>
        <div class="info-content">
          <h3>How to Update Images</h3>
          <p>Since this is a static website, image updates require file changes:</p>
          <ol>
            <li><strong>Prepare your images:</strong> Optimize for web (max 2000px width, 85% quality JPEG)</li>
            <li><strong>Place in the correct folder:</strong> <code>public/images/rooms/[room-name]/</code></li>
            <li><strong>Use consistent naming:</strong> bed.jpg, room.jpg, view.jpg, bathroom.jpg, etc.</li>
            <li><strong>Ask Claude to rotate/crop:</strong> Mention the file path and desired changes</li>
            <li><strong>Deploy:</strong> Changes will be live after the next build</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="rooms-section">
    <div class="container">
      <div class="tabs">
        {rooms.map((room, index) => (
          <button class={`tab ${index === 0 ? 'active' : ''}`} data-room={room.id}>
            {room.name}
            <span class="count">{room.images.length}</span>
          </button>
        ))}
      </div>

      {rooms.map((room, index) => (
        <div class={`room-panel ${index === 0 ? 'active' : ''}`} data-room={room.id}>
          <div class="panel-header">
            <h2>{room.name}</h2>
            <span class="path">{room.path}</span>
          </div>
          <div class="image-grid">
            {room.images.map(img => (
              <div class="image-card" data-src={`${room.path}${img}`}>
                <img src={`${room.path}${img}`} alt={`${room.name} - ${img}`} loading="lazy" />
                <div class="image-overlay">
                  <span class="image-name">{img}</span>
                  <div class="image-actions">
                    <button class="action-btn view" title="View Full Size">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                      </svg>
                    </button>
                    <button class="action-btn copy" title="Copy Path">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="quick-actions">
    <div class="container">
      <h2>Quick Actions</h2>
      <div class="actions-grid">
        <div class="action-card">
          <div class="action-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 4 23 10 17 10"/>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
            </svg>
          </div>
          <h3>Rotate Images</h3>
          <p>Ask Claude: "Rotate [image path] 90 degrees clockwise"</p>
        </div>
        <div class="action-card">
          <div class="action-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="9" y1="3" x2="9" y2="21"/>
              <line x1="15" y1="3" x2="15" y2="21"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="3" y1="15" x2="21" y2="15"/>
            </svg>
          </div>
          <h3>Crop Images</h3>
          <p>Ask Claude: "Crop [image path] to 4:3 aspect ratio"</p>
        </div>
        <div class="action-card">
          <div class="action-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              <line x1="11" y1="8" x2="11" y2="14"/>
              <line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
          </div>
          <h3>Zoom/Resize</h3>
          <p>Ask Claude: "Resize [image path] to max 1200px wide"</p>
        </div>
        <div class="action-card">
          <div class="action-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
          </div>
          <h3>Add New Image</h3>
          <p>Upload to the appropriate folder, then ask Claude to process it</p>
        </div>
      </div>
    </div>
  </section>
</PreviewLayout>

<style>
  .manager-hero {
    background: var(--gradient-primary);
    color: #fff;
    padding: 8rem 2rem 3rem;
  }

  .back-link {
    display: inline-block;
    color: rgba(255,255,255,0.7);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #fff;
  }

  .manager-hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .hero-content > p {
    opacity: 0.9;
  }

  .info-section {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .info-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    gap: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    border-left: 4px solid var(--color-primary);
  }

  .info-icon {
    width: 50px;
    height: 50px;
    background: var(--color-primary-subtle);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .info-content h3 {
    font-family: var(--font-body);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .info-content p {
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
  }

  .info-content ol {
    margin: 0;
    padding-left: 1.25rem;
  }

  .info-content li {
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .info-content code {
    background: var(--color-bg-alt);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.8125rem;
  }

  .rooms-section {
    padding: 2rem;
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .tab {
    padding: 0.75rem 1.25rem;
    background: #fff;
    border: 2px solid var(--color-bg-alt);
    border-radius: 50px;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tab:hover {
    border-color: var(--color-primary);
  }

  .tab.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .tab .count {
    background: rgba(0,0,0,0.1);
    padding: 0.125rem 0.5rem;
    border-radius: 50px;
    font-size: 0.75rem;
  }

  .tab.active .count {
    background: rgba(255,255,255,0.2);
  }

  .room-panel {
    display: none;
  }

  .room-panel.active {
    display: block;
  }

  .panel-header {
    margin-bottom: 1.5rem;
  }

  .panel-header h2 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .panel-header .path {
    font-size: 0.875rem;
    color: var(--color-text-light);
    font-family: monospace;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  .image-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg-alt);
    cursor: pointer;
  }

  .image-card img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .image-card:hover img {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 50%, rgba(0,0,0,0.8));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.75rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .image-card:hover .image-overlay {
    opacity: 1;
  }

  .image-name {
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .image-actions {
    display: flex;
    gap: 0.5rem;
  }

  .action-btn {
    width: 32px;
    height: 32px;
    background: rgba(255,255,255,0.2);
    border: none;
    border-radius: 8px;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .action-btn:hover {
    background: rgba(255,255,255,0.3);
  }

  .quick-actions {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .quick-actions h2 {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .actions-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .action-card {
    background: #fff;
    padding: 1.5rem;
    border-radius: 12px;
    text-align: center;
  }

  .action-icon {
    width: 50px;
    height: 50px;
    background: var(--color-primary-subtle);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    color: var(--color-primary);
  }

  .action-card h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .action-card p {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .actions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .info-card {
      flex-direction: column;
    }
    .actions-grid {
      grid-template-columns: 1fr;
    }
    .manager-hero {
      padding: 6rem 1.5rem 2rem;
    }
  }
</style>

<script>
  // Tab switching
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const roomId = tab.dataset.room;

      // Update active tab
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      // Update active panel
      document.querySelectorAll('.room-panel').forEach(p => p.classList.remove('active'));
      document.querySelector(`.room-panel[data-room="${roomId}"]`)?.classList.add('active');
    });
  });

  // View full size
  document.querySelectorAll('.action-btn.view').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = btn.closest('.image-card');
      const src = card?.dataset.src;
      if (src) {
        window.open(src, '_blank');
      }
    });
  });

  // Copy path
  document.querySelectorAll('.action-btn.copy').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = btn.closest('.image-card');
      const src = card?.dataset.src;
      if (src) {
        navigator.clipboard.writeText(src).then(() => {
          alert('Path copied: ' + src);
        });
      }
    });
  });
</script>
