</style>

<script is:inline src="/js/shared-data.js"></script>
<script>
  // ============================================
  // IMAGE MANAGER - Full client-side editing
  // ============================================

  const SESSION_KEY = 'islandgoodes_admin_session';

  // Check session
  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  }

  // Redirect if not logged in
  if (!getSession()) {
    window.location.href = '/admin';
  }

  async function logActivity(type: string, action: string, details?: string) {
    try {
      await window.SharedData.logActivity(type, action, details);
    } catch (e) { console.error('Failed to log activity:', e); }
  }

  // Editor state
  let originalImage: HTMLImageElement | null = null;
  let currentRotation = 0;
  let flipH = false;
  let flipV = false;
  let brightness = 0;
  let contrast = 0;
  let cropMode = false;
  let cropRatio: string | null = null;
  let cropStart = { x: 0, y: 0 };
  let cropEnd = { x: 0, y: 0 };
  let currentImageName = '';
  let currentImagePath = '';

  const modal = document.getElementById('editorModal');
  const canvas = document.getElementById('editorCanvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');

  // Tab switching for rooms
  document.querySelectorAll('.tab[data-room]').forEach(tab => {
    tab.addEventListener('click', () => {
      const roomId = (tab as HTMLElement).dataset.room;
      document.querySelectorAll('.tab[data-room]').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      document.querySelectorAll('.room-panel').forEach(p => p.classList.remove('active'));
      document.querySelector(`.room-panel[data-room="${roomId}"]`)?.classList.add('active');
    });
  });

  // Tab switching for gallery
  document.querySelectorAll('.tab[data-gallery]').forEach(tab => {
    tab.addEventListener('click', () => {
      const galleryId = (tab as HTMLElement).dataset.gallery;
      document.querySelectorAll('.tab[data-gallery]').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      document.querySelectorAll('.gallery-panel').forEach(p => p.classList.remove('active'));
      document.querySelector(`.gallery-panel[data-gallery="${galleryId}"]`)?.classList.add('active');
    });
  });

  // ============================================
  // SELECTION MODE & BULK ACTIONS
  // ============================================
  let selectMode = false;

  const selectModeToggle = document.getElementById('selectModeToggle') as HTMLInputElement;
  const bulkToolbar = document.getElementById('bulkToolbar');
  const selectedCountEl = document.getElementById('selectedCount');

  // Load marked-for-deletion from shared storage
  async function getMarkedImages(): Promise<string[]> {
    try {
      return await window.SharedData.getDeletedImages();
    } catch { return []; }
  }

  async function saveMarkedImages(images: string[]) {
    await window.SharedData.saveDeletedImages(images);
  }

  // Apply marked-delete styling on load
  async function applyMarkedDeleteStyling() {
    const marked = await getMarkedImages();
    document.querySelectorAll('.image-card').forEach(card => {
      const src = (card as HTMLElement).dataset.src || '';
      if (marked.includes(src)) {
        card.classList.add('marked-delete');
      }
    });
  }
  applyMarkedDeleteStyling();

  // Apply edited images on load
  async function applyEditedImages() {
    try {
      const edited = await window.SharedData.getEditedImages();
      document.querySelectorAll('.image-card').forEach(card => {
        const src = (card as HTMLElement).dataset.src || '';
        if (edited[src]) {
          const img = card.querySelector('img');
          if (img) {
            img.src = edited[src].dataUrl;
            // Add edited badge
            if (!card.querySelector('.edited-badge')) {
              const badge = document.createElement('span');
              badge.className = 'edited-badge';
              badge.textContent = 'Edited';
              card.appendChild(badge);
            }
          }
        }
      });
    } catch (err) {
      console.error('Error loading edited images:', err);
    }
  }
  applyEditedImages();

  // Toggle selection mode
  selectModeToggle?.addEventListener('change', () => {
    selectMode = selectModeToggle.checked;
    document.querySelectorAll('.rooms-section, .gallery-section').forEach(section => {
      section.classList.toggle('select-mode', selectMode);
    });
    if (bulkToolbar) {
      bulkToolbar.style.display = selectMode ? 'block' : 'none';
    }
    updateSelectedCount();
  });

  // Checkbox change handler
  document.querySelectorAll('.image-checkbox').forEach(checkbox => {
    checkbox.addEventListener('change', (e) => {
      e.stopPropagation();
      const card = (checkbox as HTMLElement).closest('.image-card');
      if ((checkbox as HTMLInputElement).checked) {
        card?.classList.add('selected');
      } else {
        card?.classList.remove('selected');
      }
      updateSelectedCount();
    });

    // Prevent card click when clicking checkbox
    checkbox.addEventListener('click', (e) => e.stopPropagation());
  });

  function updateSelectedCount() {
    const count = document.querySelectorAll('.image-checkbox:checked').length;
    if (selectedCountEl) {
      selectedCountEl.textContent = `${count} image${count !== 1 ? 's' : ''} selected`;
    }
  }

  // Select All
  document.getElementById('selectAllBtn')?.addEventListener('click', () => {
    document.querySelectorAll('.image-checkbox').forEach(checkbox => {
      (checkbox as HTMLInputElement).checked = true;
      (checkbox as HTMLElement).closest('.image-card')?.classList.add('selected');
    });
    updateSelectedCount();
  });

  // Deselect All
  document.getElementById('deselectAllBtn')?.addEventListener('click', () => {
    document.querySelectorAll('.image-checkbox').forEach(checkbox => {
      (checkbox as HTMLInputElement).checked = false;
      (checkbox as HTMLElement).closest('.image-card')?.classList.remove('selected');
    });
    updateSelectedCount();
  });

  // Delete Selected - immediately hides from site
  document.getElementById('deleteSelectedBtn')?.addEventListener('click', async () => {
    const selected = document.querySelectorAll('.image-checkbox:checked');
    if (selected.length === 0) {
      alert('No images selected');
      return;
    }

    const confirmMsg = `Delete ${selected.length} image(s)?\n\nThese images will be immediately hidden from the public site.`;
    if (!confirm(confirmMsg)) return;

    const marked = await getMarkedImages();
    const newlyMarked: string[] = [];

    selected.forEach(checkbox => {
      const card = (checkbox as HTMLElement).closest('.image-card') as HTMLElement;
      const src = card?.dataset.src;
      if (src && !marked.includes(src)) {
        marked.push(src);
        newlyMarked.push(src);
      }
      card?.classList.add('marked-delete');
      (checkbox as HTMLInputElement).checked = false;
      card?.classList.remove('selected');
    });

    await saveMarkedImages(marked);
    updateSelectedCount();
    await logActivity('image', `Deleted ${newlyMarked.length} images`, newlyMarked.join(', '));

    alert(`${newlyMarked.length} image(s) deleted!\n\nThey are now hidden from the public site. You can restore them anytime from this page.`);
  });

  // Restore Selected - brings back deleted images
  document.getElementById('restoreSelectedBtn')?.addEventListener('click', async () => {
    const selected = document.querySelectorAll('.image-checkbox:checked');
    if (selected.length === 0) {
      alert('No images selected');
      return;
    }

    let marked = await getMarkedImages();
    let restoredCount = 0;

    selected.forEach(checkbox => {
      const card = (checkbox as HTMLElement).closest('.image-card') as HTMLElement;
      const src = card?.dataset.src;
      if (src && marked.includes(src)) {
        marked = marked.filter(m => m !== src);
        card?.classList.remove('marked-delete');
        restoredCount++;
      }
      (checkbox as HTMLInputElement).checked = false;
      card?.classList.remove('selected');
    });

    if (restoredCount > 0) {
      await saveMarkedImages(marked);
      await logActivity('image', `Restored ${restoredCount} images`, 'Images are now visible on the site again');
      alert(`${restoredCount} image(s) restored!\n\nThey are now visible on the public site again.`);
    } else {
      alert('No deleted images were selected to restore.');
    }
    updateSelectedCount();
  });

  // Open editor for existing images
  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = (btn as HTMLElement).closest('.image-card') as HTMLElement;
      const src = card?.dataset.src;
      const name = card?.dataset.name || 'image.jpg';
      if (src) openEditor(src, name);
    });
  });

  // Also open on card click (but not in selection mode)
  document.querySelectorAll('.image-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if (selectMode) {
        // In selection mode, toggle the checkbox
        const checkbox = card.querySelector('.image-checkbox') as HTMLInputElement;
        if (checkbox) {
          checkbox.checked = !checkbox.checked;
          card.classList.toggle('selected', checkbox.checked);
          updateSelectedCount();
        }
        return;
      }
      const src = (card as HTMLElement).dataset.src;
      const name = (card as HTMLElement).dataset.name || 'image.jpg';
      if (src) openEditor(src, name);
    });
  });

  // Copy path
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = (btn as HTMLElement).closest('.image-card') as HTMLElement;
      const src = card?.dataset.src;
      if (src) {
        navigator.clipboard.writeText(src);
        alert('Path copied: ' + src);
      }
    });
  });

  // Open editor
  function openEditor(src: string, name: string) {
    currentImageName = name;
    currentImagePath = src;
    currentRotation = 0;
    flipH = false;
    flipV = false;
    brightness = 0;
    contrast = 0;
    cropMode = false;

    // Reset sliders
    (document.getElementById('brightness') as HTMLInputElement).value = '0';
    (document.getElementById('contrast') as HTMLInputElement).value = '0';

    // Update title
    document.getElementById('editorTitle')!.textContent = `Edit: ${name}`;

    // Load image
    originalImage = new Image();
    originalImage.crossOrigin = 'anonymous';
    originalImage.onload = () => {
      renderCanvas();
      modal?.classList.add('active');
    };
    originalImage.onerror = () => {
      alert('Failed to load image. The image may not allow cross-origin access.');
    };
    originalImage.src = src;
  }

  // Render canvas with current transformations
  function renderCanvas() {
    if (!originalImage || !ctx || !canvas) return;

    // Calculate dimensions based on rotation
    const isRotated = currentRotation % 180 !== 0;
    const width = isRotated ? originalImage.height : originalImage.width;
    const height = isRotated ? originalImage.width : originalImage.height;

    // Scale down if too large
    const maxSize = 800;
    let scale = 1;
    if (width > maxSize || height > maxSize) {
      scale = maxSize / Math.max(width, height);
    }

    canvas.width = width * scale;
    canvas.height = height * scale;

    ctx.save();

    // Move to center
    ctx.translate(canvas.width / 2, canvas.height / 2);

    // Apply rotation
    ctx.rotate((currentRotation * Math.PI) / 180);

    // Apply flips
    ctx.scale(flipH ? -1 : 1, flipV ? -1 : 1);

    // Draw image centered
    const drawWidth = originalImage.width * scale;
    const drawHeight = originalImage.height * scale;
    ctx.drawImage(originalImage, -drawWidth / 2, -drawHeight / 2, drawWidth, drawHeight);

    ctx.restore();

    // Apply filters
    if (brightness !== 0 || contrast !== 0) {
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const data = imageData.data;

      const brightnessOffset = brightness * 2.55;
      const contrastFactor = (259 * (contrast + 255)) / (255 * (259 - contrast));

      for (let i = 0; i < data.length; i += 4) {
        // Brightness
        data[i] = Math.min(255, Math.max(0, data[i] + brightnessOffset));
        data[i + 1] = Math.min(255, Math.max(0, data[i + 1] + brightnessOffset));
        data[i + 2] = Math.min(255, Math.max(0, data[i + 2] + brightnessOffset));

        // Contrast
        data[i] = Math.min(255, Math.max(0, contrastFactor * (data[i] - 128) + 128));
        data[i + 1] = Math.min(255, Math.max(0, contrastFactor * (data[i + 1] - 128) + 128));
        data[i + 2] = Math.min(255, Math.max(0, contrastFactor * (data[i + 2] - 128) + 128));
      }

      ctx.putImageData(imageData, 0, 0);
    }
  }

  // Rotate left
  document.getElementById('rotateLeft')?.addEventListener('click', () => {
    currentRotation = (currentRotation - 90) % 360;
    renderCanvas();
  });

  // Rotate right
  document.getElementById('rotateRight')?.addEventListener('click', () => {
    currentRotation = (currentRotation + 90) % 360;
    renderCanvas();
  });

  // Flip horizontal
  document.getElementById('flipH')?.addEventListener('click', () => {
    flipH = !flipH;
    renderCanvas();
  });

  // Flip vertical
  document.getElementById('flipV')?.addEventListener('click', () => {
    flipV = !flipV;
    renderCanvas();
  });

  // Brightness
  document.getElementById('brightness')?.addEventListener('input', (e) => {
    brightness = parseInt((e.target as HTMLInputElement).value);
    renderCanvas();
  });

  // Contrast
  document.getElementById('contrast')?.addEventListener('input', (e) => {
    contrast = parseInt((e.target as HTMLInputElement).value);
    renderCanvas();
  });

  // Reset
  document.getElementById('resetImage')?.addEventListener('click', () => {
    currentRotation = 0;
    flipH = false;
    flipV = false;
    brightness = 0;
    contrast = 0;
    (document.getElementById('brightness') as HTMLInputElement).value = '0';
    (document.getElementById('contrast') as HTMLInputElement).value = '0';
    renderCanvas();
  });

  // Download
  document.getElementById('downloadImage')?.addEventListener('click', async () => {
    if (!canvas) return;

    // Create download link
    const link = document.createElement('a');
    link.download = `edited-${currentImageName}`;
    link.href = canvas.toDataURL('image/jpeg', 0.9);
    link.click();

    await logActivity('image', 'Image edited and downloaded', currentImageName);
  });

  // Save to Gallery (stores in shared storage)
  async function saveEditedImage(path: string, dataUrl: string) {
    const edited = await window.SharedData.getEditedImages();
    edited[path] = {
      dataUrl: dataUrl,
      editedAt: new Date().toISOString()
    };
    await window.SharedData.saveEditedImages(edited);
  }

  document.getElementById('saveToGallery')?.addEventListener('click', async () => {
    if (!canvas || !currentImagePath) return;

    try {
      // Save the edited image to shared storage
      const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
      await saveEditedImage(currentImagePath, dataUrl);

      await logActivity('image', 'Image edited and saved', currentImageName);

      // Update the image in place without reloading
      const card = document.querySelector(`.image-card[data-src="${currentImagePath}"]`);
      if (card) {
        const img = card.querySelector('img');
        if (img) {
          img.src = dataUrl;
          // Add edited badge if not already there
          if (!card.querySelector('.edited-badge')) {
            const badge = document.createElement('span');
            badge.className = 'edited-badge';
            badge.textContent = 'Edited';
            card.appendChild(badge);
          }
        }
      }

      // Close modal
      modal?.classList.remove('active');

      // Show success message
      alert('Image saved! The edited version will now show in the gallery.');
    } catch (err) {
      console.error('Save error:', err);
      alert('Could not save image. The image may be too large for browser storage. Try downloading instead.');
    }
  });

  // Delete image from editor
  document.getElementById('deleteFromEditor')?.addEventListener('click', async () => {
    if (!currentImagePath) return;

    if (!confirm(`Are you sure you want to delete this image?\n\n${currentImageName}\n\nThis will hide it from the live site.`)) {
      return;
    }

    try {
      const marked = await getMarkedImages();
      if (!marked.includes(currentImagePath)) {
        marked.push(currentImagePath);
        await saveMarkedImages(marked);
      }

      await logActivity('image', 'Image deleted', currentImageName);

      // Mark the image card as deleted (same as bulk delete)
      const card = document.querySelector(`.image-card[data-src="${currentImagePath}"]`);
      if (card) {
        card.classList.add('marked-delete');
      }

      // Close modal
      modal?.classList.remove('active');

      alert('Image deleted! It will no longer show on the live site.');
    } catch (err) {
      console.error('Delete error:', err);
      alert('Could not delete image. Please try again.');
    }
  });

  // Close editor
  document.getElementById('closeEditor')?.addEventListener('click', () => {
    modal?.classList.remove('active');
  });

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) {
      modal.classList.remove('active');
    }
  });

  // ============================================
  // FILE UPLOAD
  // ============================================

  const dropZone = document.getElementById('dropZone');
  const fileInput = document.getElementById('fileInput') as HTMLInputElement;
  const uploadQueue = document.getElementById('uploadQueue');

  dropZone?.addEventListener('click', () => fileInput?.click());

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
  });

  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('dragover');
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    const files = e.dataTransfer?.files;
    if (files) handleFiles(files);
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files) handleFiles(fileInput.files);
  });

  async function handleFiles(files: FileList) {
    if (!uploadQueue) return;

    uploadQueue.classList.add('has-items');

    Array.from(files).forEach(file => {
      if (!file.type.startsWith('image/')) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const item = document.createElement('div');
        item.className = 'upload-item';
        item.innerHTML = `
          <img src="${e.target?.result}" alt="${file.name}" />
          <div class="upload-item-info">
            <div class="upload-item-name">${file.name}</div>
            <div class="upload-item-size">${(file.size / 1024).toFixed(1)} KB</div>
          </div>
          <button class="btn btn-small edit-upload">Edit</button>
          <button class="btn btn-small btn-outline download-upload">Download</button>
        `;

        // Edit button
        item.querySelector('.edit-upload')?.addEventListener('click', () => {
          openEditor(e.target?.result as string, file.name);
        });

        // Download button (direct download)
        item.querySelector('.download-upload')?.addEventListener('click', () => {
          const link = document.createElement('a');
          link.download = file.name;
          link.href = e.target?.result as string;
          link.click();
        });

        uploadQueue.appendChild(item);
      };
      reader.readAsDataURL(file);
    });

    await logActivity('image', 'Images uploaded for editing', `${files.length} file(s)`);
  }

  // ============================================
  // IMAGE REORDERING (DRAG & DROP)
  // ============================================
  let reorderMode = false;
  let hasUnsavedOrder = false;
  let draggedElement: HTMLElement | null = null;

  const reorderModeToggle = document.getElementById('reorderModeToggle') as HTMLInputElement;
  const saveOrderBtn = document.getElementById('saveOrderBtn');

  // Toggle reorder mode
  reorderModeToggle?.addEventListener('change', () => {
    reorderMode = reorderModeToggle.checked;

    // Disable selection mode if reorder mode is enabled
    if (reorderMode && selectModeToggle?.checked) {
      selectModeToggle.checked = false;
      selectMode = false;
      document.querySelectorAll('.rooms-section, .gallery-section').forEach(section => {
        section.classList.remove('select-mode');
      });
      if (bulkToolbar) bulkToolbar.style.display = 'none';
    }

    // Toggle reorder mode classes
    document.querySelectorAll('.rooms-section, .gallery-section').forEach(section => {
      section.classList.toggle('reorder-mode', reorderMode);
    });

    // Enable/disable draggable on image cards
    document.querySelectorAll('.image-card').forEach(card => {
      (card as HTMLElement).draggable = reorderMode;
    });

    // Show/hide save button
    if (saveOrderBtn) {
      saveOrderBtn.classList.toggle('visible', reorderMode && hasUnsavedOrder);
    }
  });

  // Update order badges after reordering
  function updateOrderBadges(grid: HTMLElement) {
    const cards = grid.querySelectorAll('.image-card');
    cards.forEach((card, idx) => {
      const badge = card.querySelector('.reorder-badge');
      if (badge) badge.textContent = String(idx + 1);
    });
  }

  // Get current order for a grid
  function getGridOrder(grid: HTMLElement): string[] {
    return Array.from(grid.querySelectorAll('.image-card'))
      .map(card => (card as HTMLElement).dataset.src || '');
  }

  // Drag and drop handlers for image cards
  document.querySelectorAll('.image-card').forEach(card => {
    card.addEventListener('dragstart', (e) => {
      if (!reorderMode) return;
      draggedElement = card as HTMLElement;
      (card as HTMLElement).classList.add('dragging');
      (e as DragEvent).dataTransfer?.setData('text/plain', (card as HTMLElement).dataset.src || '');
    });

    card.addEventListener('dragend', () => {
      if (!reorderMode) return;
      (card as HTMLElement).classList.remove('dragging');
      document.querySelectorAll('.image-card').forEach(c => c.classList.remove('drag-over'));
      draggedElement = null;
    });

    card.addEventListener('dragover', (e) => {
      if (!reorderMode || !draggedElement) return;
      e.preventDefault();
      (card as HTMLElement).classList.add('drag-over');
    });

    card.addEventListener('dragleave', () => {
      if (!reorderMode) return;
      (card as HTMLElement).classList.remove('drag-over');
    });

    card.addEventListener('drop', (e) => {
      if (!reorderMode || !draggedElement) return;
      e.preventDefault();
      (card as HTMLElement).classList.remove('drag-over');

      const targetCard = card as HTMLElement;
      const grid = targetCard.closest('.image-grid');

      if (grid && draggedElement !== targetCard) {
        // Get positions
        const allCards = Array.from(grid.querySelectorAll('.image-card'));
        const draggedIndex = allCards.indexOf(draggedElement);
        const targetIndex = allCards.indexOf(targetCard);

        // Reorder DOM
        if (draggedIndex < targetIndex) {
          targetCard.parentNode?.insertBefore(draggedElement, targetCard.nextSibling);
        } else {
          targetCard.parentNode?.insertBefore(draggedElement, targetCard);
        }

        // Update badges
        updateOrderBadges(grid as HTMLElement);

        // Mark as having unsaved changes
        hasUnsavedOrder = true;
        if (saveOrderBtn) saveOrderBtn.classList.add('visible');
      }
    });
  });

  // Save order button
  saveOrderBtn?.addEventListener('click', async () => {
    try {
      const imageOrder = await window.SharedData.getImageOrder() || {};

      // Save order for each room grid
      document.querySelectorAll('.image-grid[data-room-id]').forEach(grid => {
        const roomId = (grid as HTMLElement).dataset.roomId;
        if (roomId) {
          imageOrder[roomId] = getGridOrder(grid as HTMLElement);
        }
      });

      // Save order for each gallery grid
      document.querySelectorAll('.image-grid[data-gallery-id]').forEach(grid => {
        const galleryId = (grid as HTMLElement).dataset.galleryId;
        if (galleryId) {
          imageOrder[`gallery-${galleryId}`] = getGridOrder(grid as HTMLElement);
        }
      });

      await window.SharedData.saveImageOrder(imageOrder);
      await logActivity('image', 'Image order updated', 'Custom image order saved');

      hasUnsavedOrder = false;
      saveOrderBtn.classList.remove('visible');
      alert('Image order saved! The new order will appear on the live site.');
    } catch (err) {
      console.error('Failed to save image order:', err);
      alert('Failed to save image order. Please try again.');
    }
  });

  // Load saved order on page load
  async function applySavedOrder() {
    try {
      const imageOrder = await window.SharedData.getImageOrder();
      if (!imageOrder || Object.keys(imageOrder).length === 0) return;

      // Apply order to room grids
      document.querySelectorAll('.image-grid[data-room-id]').forEach(grid => {
        const roomId = (grid as HTMLElement).dataset.roomId;
        if (roomId && imageOrder[roomId]) {
          reorderGrid(grid as HTMLElement, imageOrder[roomId]);
        }
      });

      // Apply order to gallery grids
      document.querySelectorAll('.image-grid[data-gallery-id]').forEach(grid => {
        const galleryId = (grid as HTMLElement).dataset.galleryId;
        if (galleryId && imageOrder[`gallery-${galleryId}`]) {
          reorderGrid(grid as HTMLElement, imageOrder[`gallery-${galleryId}`]);
        }
      });
    } catch (err) {
      console.error('Failed to load saved image order:', err);
    }
  }

  function reorderGrid(grid: HTMLElement, order: string[]) {
    const cards = Array.from(grid.querySelectorAll('.image-card')) as HTMLElement[];
    const cardMap = new Map(cards.map(card => [card.dataset.src, card]));

    // Reorder based on saved order
    order.forEach(src => {
      const card = cardMap.get(src);
      if (card) {
        grid.appendChild(card);
      }
    });

    // Append any cards not in the saved order (new images)
    cards.forEach(card => {
      if (!order.includes(card.dataset.src || '')) {
        grid.appendChild(card);
      }
    });

    updateOrderBadges(grid);
  }

  // Apply saved order on load
  applySavedOrder();
</script>
