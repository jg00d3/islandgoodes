---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Image Manager | Island Goodes Admin";
const description = "Manage room and gallery images";

// Room image configurations - ACTUAL images that exist in each folder
const rooms = [
  {
    id: 'hilo-bay',
    name: 'Hilo Bay Room',
    path: '/images/rooms/hilo-bay/',
    images: ['bed.jpg', 'room.jpg', 'room2.jpg', 'room3.jpg', 'lanai.jpg', 'lanai2.jpg', 'bathroom.jpg', 'bathroom2.jpg', 'bathroom3.jpg', 'bathroom4.jpg', 'bathroom5.jpg', 'bathroom6.jpg', 'bathroom7.jpg', 'closet.jpg', 'coffee.jpg', 'dresser-tv.jpg', 'entrance.jpg', 'fridge.jpg', 'recliner.jpg', 'table.jpg']
  },
  {
    id: 'orchid',
    name: 'Orchid Room',
    path: '/images/rooms/orchid/',
    images: ['bed.jpg', 'room.jpg', 'room2.jpg', 'living.jpg', 'living2.jpg', 'living3.jpg', 'lanai.jpg', 'kitchen.jpg', 'kitchen2.jpg', 'kitchen3.jpg', 'kitchen4.jpg', 'kitchen5.jpg', 'bathroom.jpg', 'bathroom2.jpg', 'bathroom3.jpg', 'bathroom4.jpg', 'closet.jpg', 'closet2.jpg', 'entrance.jpg', 'entrance2.jpg', 'unit.jpg', 'view1.jpg', 'view2.jpg', 'view3.jpg', 'view4.jpg', 'view5.jpg', 'view6.jpg', 'view7.jpg', 'view8.jpg', 'view9.jpg', 'view10.jpg', 'view11.jpg', 'view12.jpg']
  },
  {
    id: 'mauna-kea',
    name: 'Mauna Kea Room',
    path: '/images/rooms/mauna-kea/',
    images: ['bed.jpg', 'room.jpg', 'room2.jpg', 'room3.jpg', 'lanai.jpg', 'lanai2.jpg', 'lanai3.jpg', 'bathroom.jpg', 'bathroom2.jpg', 'bathroom3.jpg', 'bathroom4.jpg', 'bathroom5.jpg', 'bathroom6.jpg', 'bathroom7.jpg', 'closet.jpg', 'closet2.jpg', 'closet3.jpg', 'coffee.jpg', 'entrance.jpg', 'fridge.jpg', 'table.jpg']
  },
  {
    id: 'ginger',
    name: 'Ginger Room',
    path: '/images/rooms/ginger/',
    images: ['room.jpg', 'room2.jpg', 'sitting.jpg', 'bathroom.jpg', 'closet.jpg', 'closet2.jpg', 'coffee.jpg', 'ac.jpg', 'ornament.jpg']
  }
];

// Gallery image configurations
// Note: Property/site images (pool, hot-tub, pets, etc.) are now in /images/site/ and protected from deletion
const galleryCategories = [
  {
    id: 'scenery',
    name: 'Views & Scenery',
    path: '/images/scenery/',
    images: ['hilo-bay.jpg', 'hilo-bay2.jpg', 'ocean-view.jpg', 'ocean-view2.jpg', 'island-goodes-view.jpg', 'turtles.jpg']
  },
  {
    id: 'attractions',
    name: 'Attractions',
    path: '/images/attractions/',
    images: ['akaka-falls.jpg', 'akaka-falls2.jpg', 'akaka-falls3.jpg', 'rainbow-falls.jpg', 'volcano.jpg', 'volcano-lava.jpg', 'volcano-looming.jpg', 'waipio-valley.jpg', 'liliuokalani-gardens.jpg', 'panaewa-zoo.jpg', 'tsunami-museum.jpg', 'lyman-museum.jpg', 'donkey.jpg', 'horse.jpg', 'helicopter.jpg', 'kayaking.jpg', 'zipline.jpg']
  },
  {
    id: 'beaches',
    name: 'Beaches',
    path: '/images/beaches/',
    images: ['richardsons.jpg', 'carlsmith.jpg']
  }
];
---

<PreviewLayout title={title} description={description}>
  <section class="manager-hero">
    <div class="container">
      <div class="hero-content">
        <a href="/admin" class="back-link">&larr; Back to Admin</a>
        <h1>Image Manager</h1>
        <p>Edit, rotate, crop, and manage room photos</p>
      </div>
    </div>
  </section>

  <!-- Image Editor Modal -->
  <div id="editorModal" class="editor-modal">
    <div class="editor-container">
      <div class="editor-header">
        <h2 id="editorTitle">Edit Image</h2>
        <button id="closeEditor" class="close-btn">&times;</button>
      </div>
      <div class="editor-body">
        <div class="editor-canvas-wrapper">
          <canvas id="editorCanvas"></canvas>
        </div>
        <div class="editor-tools">
          <div class="tool-group">
            <label>Rotate</label>
            <div class="tool-buttons">
              <button id="rotateLeft" class="tool-btn" title="Rotate Left 90°">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2.5 2v6h6M2.66 15.57a10 10 0 1 0 .57-8.38"/>
                </svg>
              </button>
              <button id="rotateRight" class="tool-btn" title="Rotate Right 90°">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="tool-group">
            <label>Flip</label>
            <div class="tool-buttons">
              <button id="flipH" class="tool-btn" title="Flip Horizontal">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 3v18M16 7l5 5-5 5M8 7l-5 5 5 5"/>
                </svg>
              </button>
              <button id="flipV" class="tool-btn" title="Flip Vertical">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 12h18M7 8l5-5 5 5M7 16l5 5 5-5"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="tool-group">
            <label>Crop Preset</label>
            <div class="tool-buttons crop-buttons">
              <button class="tool-btn crop-btn" data-ratio="free">Free</button>
              <button class="tool-btn crop-btn" data-ratio="1:1">1:1</button>
              <button class="tool-btn crop-btn" data-ratio="4:3">4:3</button>
              <button class="tool-btn crop-btn" data-ratio="16:9">16:9</button>
            </div>
          </div>
          <div class="tool-group crop-controls" style="display:none;">
            <label>Crop Area</label>
            <p class="crop-instructions">Click and drag on the image to select crop area</p>
            <button id="applyCrop" class="btn btn-small">Apply Crop</button>
            <button id="cancelCrop" class="btn btn-small btn-outline">Cancel</button>
          </div>
          <div class="tool-group">
            <label>Brightness</label>
            <input type="range" id="brightness" min="-100" max="100" value="0" />
          </div>
          <div class="tool-group">
            <label>Contrast</label>
            <input type="range" id="contrast" min="-100" max="100" value="0" />
          </div>
        </div>
      </div>
      <div class="editor-footer">
        <div class="editor-left-actions">
          <button id="resetImage" class="btn btn-outline">Reset</button>
          <button id="deleteFromEditor" class="btn btn-danger">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3,6 5,6 21,6"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
            Delete Image
          </button>
        </div>
        <div class="editor-actions">
          <button id="saveToGallery" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
              <polyline points="17 21 17 13 7 13 7 21"/>
              <polyline points="7 3 7 8 15 8"/>
            </svg>
            Save Changes
          </button>
          <button id="downloadImage" class="btn btn-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Upload Section -->
  <section class="upload-section">
    <div class="container">
      <div class="upload-card">
        <div class="upload-header">
          <h2>Upload New Images</h2>
          <p>Drag & drop images or click to browse. Images will be processed and downloaded for you to add to the repository.</p>
        </div>
        <div id="dropZone" class="drop-zone">
          <div class="drop-content">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <p>Drop images here or <span class="browse-link">browse</span></p>
            <span class="formats">JPG, PNG, WebP (max 10MB)</span>
          </div>
          <input type="file" id="fileInput" accept="image/*" multiple hidden />
        </div>
        <div id="uploadQueue" class="upload-queue"></div>
      </div>
    </div>
  </section>

  <!-- Bulk Action Toolbar (sticky) -->
  <div id="bulkToolbar" class="bulk-toolbar" style="display: none;">
    <div class="container">
      <div class="bulk-content">
        <span id="selectedCount">0 images selected</span>
        <div class="bulk-actions">
          <button id="selectAllBtn" class="bulk-btn">Select All</button>
          <button id="deselectAllBtn" class="bulk-btn">Deselect All</button>
          <button id="restoreSelectedBtn" class="bulk-btn restore">Restore Selected</button>
          <button id="deleteSelectedBtn" class="bulk-btn danger">Delete Selected</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Room Images -->
  <section class="rooms-section">
    <div class="container">
      <div class="section-header-row">
        <h2>Room Images</h2>
        <div style="display: flex; align-items: center;">
          <label class="select-mode-toggle">
            <input type="checkbox" id="selectModeToggle" />
            <span>Selection Mode</span>
          </label>
          <label class="select-mode-toggle reorder-mode-toggle">
            <input type="checkbox" id="reorderModeToggle" />
            <span>Reorder Mode</span>
          </label>
          <button id="saveOrderBtn" class="save-order-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
              <polyline points="17 21 17 13 7 13 7 21"/>
              <polyline points="7 3 7 8 15 8"/>
            </svg>
            Save Order
          </button>
        </div>
      </div>
      <div class="tabs">
        {rooms.map((room, index) => (
          <button class={`tab ${index === 0 ? 'active' : ''}`} data-room={room.id}>
            {room.name}
            <span class="count">{room.images.length}</span>
          </button>
        ))}
      </div>

      {rooms.map((room, index) => (
        <div class={`room-panel ${index === 0 ? 'active' : ''}`} data-room={room.id}>
          <div class="panel-header">
            <h3>{room.name}</h3>
            <span class="path">{room.path}</span>
          </div>
          <div class="image-grid" data-room-id={room.id}>
            {room.images.map((img, idx) => (
              <div class="image-card" data-src={`${room.path}${img}`} data-name={img} draggable="false">
                <input type="checkbox" class="image-checkbox" />
                <span class="reorder-badge">{idx + 1}</span>
                <img src={`${room.path}${img}`} alt={`${room.name} - ${img}`} loading="lazy" />
                <div class="image-overlay">
                  <span class="image-name">{img}</span>
                  <div class="image-actions">
                    <button class="action-btn edit-btn" title="Edit Image">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                      </svg>
                    </button>
                    <button class="action-btn copy-btn" title="Copy Path">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Gallery Images -->
  <section class="gallery-section">
    <div class="container">
      <h2>Gallery & Property Images</h2>
      <div class="tabs gallery-tabs">
        {galleryCategories.map((cat, index) => (
          <button class={`tab ${index === 0 ? 'active' : ''}`} data-gallery={cat.id}>
            {cat.name}
            <span class="count">{cat.images.length}</span>
          </button>
        ))}
      </div>

      {galleryCategories.map((cat, index) => (
        <div class={`gallery-panel ${index === 0 ? 'active' : ''}`} data-gallery={cat.id}>
          <div class="panel-header">
            <h3>{cat.name}</h3>
            <span class="path">{cat.path}</span>
          </div>
          <div class="image-grid" data-gallery-id={cat.id}>
            {cat.images.map((img, idx) => (
              <div class="image-card" data-src={`${cat.path}${img}`} data-name={img} draggable="false">
                <input type="checkbox" class="image-checkbox" />
                <span class="reorder-badge">{idx + 1}</span>
                <img src={`${cat.path}${img}`} alt={`${cat.name} - ${img}`} loading="lazy" />
                <div class="image-overlay">
                  <span class="image-name">{img}</span>
                  <div class="image-actions">
                    <button class="action-btn edit-btn" title="Edit Image">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                      </svg>
                    </button>
                    <button class="action-btn copy-btn" title="Copy Path">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Instructions -->
  <section class="instructions-section">
    <div class="container">
      <div class="instructions-card">
        <h2>How It Works</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Edit or Upload</h3>
              <p>Click any existing image to edit it, or drag new images to the upload area above.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Make Your Changes</h3>
              <p>Rotate, flip, crop, or adjust brightness/contrast using the editing tools.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Download & Replace</h3>
              <p>Download the edited image and replace the file in the repository (or ask Claude to do it).</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PreviewLayout>

<style>
  .manager-hero {
    background: var(--gradient-primary);
    color: #fff;
    padding: 8rem 2rem 3rem;
  }

  .back-link {
    display: inline-block;
    color: rgba(255,255,255,0.7);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  /* Bulk Action Toolbar */
  .bulk-toolbar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #1a1a1a;
    color: #fff;
    padding: 1rem 0;
    z-index: 1000;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.3);
  }

  .bulk-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .bulk-actions {
    display: flex;
    gap: 0.75rem;
  }

  .bulk-btn {
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 6px;
    background: transparent;
    color: #fff;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.2s;
  }

  .bulk-btn:hover {
    background: rgba(255,255,255,0.1);
  }

  .bulk-btn.danger {
    background: #DC2626;
    border-color: #DC2626;
  }

  .bulk-btn.danger:hover {
    background: #B91C1C;
  }

  .bulk-btn.restore {
    background: #059669;
    border-color: #059669;
  }

  .bulk-btn.restore:hover {
    background: #047857;
  }

  /* Selection Mode */
  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .select-mode-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  .select-mode-toggle input {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .image-checkbox {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    width: 22px;
    height: 22px;
    cursor: pointer;
    z-index: 10;
    display: none;
    accent-color: var(--color-primary);
  }

  .select-mode .image-checkbox {
    display: block;
  }

  .image-card.selected {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }

  .image-card.marked-delete {
    opacity: 0.5;
    outline: 3px solid #DC2626;
    outline-offset: 2px;
  }

  .edited-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #10B981;
    color: #fff;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    z-index: 10;
  }

  .image-card.marked-delete::after {
    content: "MARKED FOR DELETION";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(220, 38, 38, 0.8);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* Reorder Mode */
  .reorder-mode .image-card {
    cursor: grab;
  }

  .reorder-mode .image-card:active {
    cursor: grabbing;
  }

  .reorder-mode .image-card.dragging {
    opacity: 0.5;
    transform: scale(1.05);
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
  }

  .reorder-mode .image-card.drag-over {
    border: 3px dashed var(--color-primary);
    background: var(--color-primary-subtle);
  }

  .reorder-mode .image-overlay {
    display: none !important;
  }

  .reorder-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--color-primary);
    color: #fff;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    z-index: 10;
  }

  .reorder-mode .reorder-badge {
    display: flex;
  }

  .save-order-btn {
    display: none;
    margin-left: 1rem;
    background: #10B981;
    color: #fff;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
  }

  .save-order-btn:hover {
    background: #059669;
  }

  .save-order-btn.visible {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .reorder-mode-toggle {
    margin-left: 1rem;
  }

  /* Gallery Section */
  .gallery-section {
    padding: 2rem;
    background: #fff;
  }

  .gallery-section h2 {
    margin-bottom: 1.5rem;
  }

  .gallery-tabs {
    margin-bottom: 1.5rem;
  }

  .gallery-panel {
    display: none;
  }

  .gallery-panel.active {
    display: block;
  }

  .back-link:hover { color: #fff; }

  .manager-hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .hero-content > p { opacity: 0.9; }

  /* Editor Modal */
  .editor-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.9);
    z-index: 1000;
    overflow-y: auto;
    padding: 2rem;
  }

  .editor-modal.active { display: flex; justify-content: center; align-items: flex-start; }

  .editor-container {
    background: #fff;
    border-radius: 16px;
    width: 100%;
    max-width: 1200px;
    margin: auto;
    overflow: hidden;
  }

  .editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid #eee;
  }

  .editor-header h2 { margin: 0; font-size: 1.25rem; }

  .close-btn {
    width: 40px;
    height: 40px;
    border: none;
    background: var(--color-bg-alt);
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .editor-body {
    display: grid;
    grid-template-columns: 1fr 280px;
    min-height: 500px;
  }

  .editor-canvas-wrapper {
    background: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  #editorCanvas {
    max-width: 100%;
    max-height: 600px;
    background: #fff;
  }

  .editor-tools {
    padding: 1.5rem;
    background: var(--color-bg-alt);
    overflow-y: auto;
  }

  .tool-group {
    margin-bottom: 1.5rem;
