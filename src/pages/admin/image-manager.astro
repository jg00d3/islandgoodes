---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Image Manager | Island Goodes Admin";
const description = "Manage room and gallery images";

// Room image configurations
const rooms = [
  {
    id: 'hilo-bay',
    name: 'Hilo Bay Room',
    path: '/images/rooms/hilo-bay/',
    images: ['bed.jpg', 'room.jpg', 'room2.jpg', 'room3.jpg', 'room4.jpg', 'room5.jpg', 'room6.jpg', 'view.jpg', 'view2.jpg', 'view3.jpg', 'view4.jpg', 'view5.jpg', 'view6.jpg', 'bathroom.jpg', 'bathroom2.jpg', 'bathroom3.jpg']
  },
  {
    id: 'orchid',
    name: 'Orchid Room',
    path: '/images/rooms/orchid/',
    images: ['bed.jpg', 'room.jpg', 'room2.jpg', 'living.jpg', 'living2.jpg', 'living3.jpg', 'view1.jpg', 'view2.jpg', 'view3.jpg', 'view4.jpg', 'view5.jpg', 'view6.jpg', 'view7.jpg', 'view8.jpg', 'view9.jpg', 'bathroom.jpg', 'bathroom2.jpg', 'bathroom3.jpg']
  },
  {
    id: 'mauna-kea',
    name: 'Mauna Kea Room',
    path: '/images/rooms/mauna-kea/',
    images: ['bed.jpg', 'room.jpg', 'room2.jpg', 'room3.jpg', 'room4.jpg', 'room5.jpg', 'room6.jpg', 'view.jpg', 'view2.jpg', 'view3.jpg', 'view4.jpg', 'view5.jpg', 'view6.jpg', 'bathroom.jpg', 'bathroom2.jpg', 'bathroom3.jpg', 'bathroom4.jpg']
  },
  {
    id: 'ginger',
    name: 'Ginger Room',
    path: '/images/rooms/ginger/',
    images: ['room.jpg', 'room2.jpg', 'room3.jpg', 'view.jpg', 'bathroom.jpg']
  }
];
---

<PreviewLayout title={title} description={description}>
  <section class="manager-hero">
    <div class="container">
      <div class="hero-content">
        <a href="/admin" class="back-link">&larr; Back to Admin</a>
        <h1>Image Manager</h1>
        <p>Edit, rotate, crop, and manage room photos</p>
      </div>
    </div>
  </section>

  <!-- Image Editor Modal -->
  <div id="editorModal" class="editor-modal">
    <div class="editor-container">
      <div class="editor-header">
        <h2 id="editorTitle">Edit Image</h2>
        <button id="closeEditor" class="close-btn">&times;</button>
      </div>
      <div class="editor-body">
        <div class="editor-canvas-wrapper">
          <canvas id="editorCanvas"></canvas>
        </div>
        <div class="editor-tools">
          <div class="tool-group">
            <label>Rotate</label>
            <div class="tool-buttons">
              <button id="rotateLeft" class="tool-btn" title="Rotate Left 90°">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M2.5 2v6h6M2.66 15.57a10 10 0 1 0 .57-8.38"/>
                </svg>
              </button>
              <button id="rotateRight" class="tool-btn" title="Rotate Right 90°">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="tool-group">
            <label>Flip</label>
            <div class="tool-buttons">
              <button id="flipH" class="tool-btn" title="Flip Horizontal">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 3v18M16 7l5 5-5 5M8 7l-5 5 5 5"/>
                </svg>
              </button>
              <button id="flipV" class="tool-btn" title="Flip Vertical">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 12h18M7 8l5-5 5 5M7 16l5 5 5-5"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="tool-group">
            <label>Crop Preset</label>
            <div class="tool-buttons crop-buttons">
              <button class="tool-btn crop-btn" data-ratio="free">Free</button>
              <button class="tool-btn crop-btn" data-ratio="1:1">1:1</button>
              <button class="tool-btn crop-btn" data-ratio="4:3">4:3</button>
              <button class="tool-btn crop-btn" data-ratio="16:9">16:9</button>
            </div>
          </div>
          <div class="tool-group crop-controls" style="display:none;">
            <label>Crop Area</label>
            <p class="crop-instructions">Click and drag on the image to select crop area</p>
            <button id="applyCrop" class="btn btn-small">Apply Crop</button>
            <button id="cancelCrop" class="btn btn-small btn-outline">Cancel</button>
          </div>
          <div class="tool-group">
            <label>Brightness</label>
            <input type="range" id="brightness" min="-100" max="100" value="0" />
          </div>
          <div class="tool-group">
            <label>Contrast</label>
            <input type="range" id="contrast" min="-100" max="100" value="0" />
          </div>
        </div>
      </div>
      <div class="editor-footer">
        <button id="resetImage" class="btn btn-outline">Reset</button>
        <div class="editor-actions">
          <button id="downloadImage" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download Edited Image
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Upload Section -->
  <section class="upload-section">
    <div class="container">
      <div class="upload-card">
        <div class="upload-header">
          <h2>Upload New Images</h2>
          <p>Drag & drop images or click to browse. Images will be processed and downloaded for you to add to the repository.</p>
        </div>
        <div id="dropZone" class="drop-zone">
          <div class="drop-content">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <p>Drop images here or <span class="browse-link">browse</span></p>
            <span class="formats">JPG, PNG, WebP (max 10MB)</span>
          </div>
          <input type="file" id="fileInput" accept="image/*" multiple hidden />
        </div>
        <div id="uploadQueue" class="upload-queue"></div>
      </div>
    </div>
  </section>

  <!-- Room Images -->
  <section class="rooms-section">
    <div class="container">
      <h2>Room Images</h2>
      <div class="tabs">
        {rooms.map((room, index) => (
          <button class={`tab ${index === 0 ? 'active' : ''}`} data-room={room.id}>
            {room.name}
            <span class="count">{room.images.length}</span>
          </button>
        ))}
      </div>

      {rooms.map((room, index) => (
        <div class={`room-panel ${index === 0 ? 'active' : ''}`} data-room={room.id}>
          <div class="panel-header">
            <h3>{room.name}</h3>
            <span class="path">{room.path}</span>
          </div>
          <div class="image-grid">
            {room.images.map(img => (
              <div class="image-card" data-src={`${room.path}${img}`} data-name={img}>
                <img src={`${room.path}${img}`} alt={`${room.name} - ${img}`} loading="lazy" />
                <div class="image-overlay">
                  <span class="image-name">{img}</span>
                  <div class="image-actions">
                    <button class="action-btn edit-btn" title="Edit Image">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                      </svg>
                    </button>
                    <button class="action-btn copy-btn" title="Copy Path">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Instructions -->
  <section class="instructions-section">
    <div class="container">
      <div class="instructions-card">
        <h2>How It Works</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Edit or Upload</h3>
              <p>Click any existing image to edit it, or drag new images to the upload area above.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Make Your Changes</h3>
              <p>Rotate, flip, crop, or adjust brightness/contrast using the editing tools.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Download & Replace</h3>
              <p>Download the edited image and replace the file in the repository (or ask Claude to do it).</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PreviewLayout>

<style>
  .manager-hero {
    background: var(--gradient-primary);
    color: #fff;
    padding: 8rem 2rem 3rem;
  }

  .back-link {
    display: inline-block;
    color: rgba(255,255,255,0.7);
    font-size: 0.875rem;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .back-link:hover { color: #fff; }

  .manager-hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .hero-content > p { opacity: 0.9; }

  /* Editor Modal */
  .editor-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.9);
    z-index: 1000;
    overflow-y: auto;
    padding: 2rem;
  }

  .editor-modal.active { display: flex; justify-content: center; align-items: flex-start; }

  .editor-container {
    background: #fff;
    border-radius: 16px;
    width: 100%;
    max-width: 1200px;
    margin: auto;
    overflow: hidden;
  }

  .editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid #eee;
  }

  .editor-header h2 { margin: 0; font-size: 1.25rem; }

  .close-btn {
    width: 40px;
    height: 40px;
    border: none;
    background: var(--color-bg-alt);
    border-radius: 50%;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .editor-body {
    display: grid;
    grid-template-columns: 1fr 280px;
    min-height: 500px;
  }

  .editor-canvas-wrapper {
    background: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  #editorCanvas {
    max-width: 100%;
    max-height: 600px;
    background: #fff;
  }

  .editor-tools {
    padding: 1.5rem;
    background: var(--color-bg-alt);
    overflow-y: auto;
  }

  .tool-group {
    margin-bottom: 1.5rem;
  }

  .tool-group label {
    display: block;
    font-weight: 600;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .tool-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tool-btn {
    width: 44px;
    height: 44px;
    border: 2px solid #ddd;
    background: #fff;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .tool-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .tool-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .crop-buttons .tool-btn {
    width: auto;
    padding: 0 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .crop-instructions {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    margin-bottom: 0.75rem;
  }

  .crop-controls .btn {
    margin-right: 0.5rem;
  }

  input[type="range"] {
    width: 100%;
    accent-color: var(--color-primary);
  }

  .editor-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-top: 1px solid #eee;
    background: #fff;
  }

  .editor-actions { display: flex; gap: 1rem; }

  .btn svg { margin-right: 0.5rem; vertical-align: middle; }

  /* Upload Section */
  .upload-section {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .upload-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }

  .upload-header { margin-bottom: 1.5rem; }
  .upload-header h2 { margin-bottom: 0.5rem; }
  .upload-header p { color: var(--color-text-light); }

  .drop-zone {
    border: 3px dashed #ddd;
    border-radius: 16px;
    padding: 3rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
  }

  .drop-zone:hover, .drop-zone.dragover {
    border-color: var(--color-primary);
    background: var(--color-primary-subtle);
  }

  .drop-content svg {
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }

  .drop-content p { margin-bottom: 0.5rem; color: var(--color-text); }
  .browse-link { color: var(--color-primary); font-weight: 600; }
  .formats { font-size: 0.8125rem; color: var(--color-text-light); }

  .upload-queue {
    margin-top: 1.5rem;
    display: none;
  }

  .upload-queue.has-items { display: block; }

  .upload-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--color-bg-alt);
    border-radius: 10px;
    margin-bottom: 0.75rem;
  }

  .upload-item img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
  }

  .upload-item-info { flex: 1; }
  .upload-item-name { font-weight: 600; font-size: 0.9375rem; }
  .upload-item-size { font-size: 0.8125rem; color: var(--color-text-light); }

  /* Rooms Section */
  .rooms-section {
    padding: 2rem;
  }

  .rooms-section h2 { margin-bottom: 1.5rem; }

  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .tab {
    padding: 0.75rem 1.25rem;
    background: #fff;
    border: 2px solid var(--color-bg-alt);
    border-radius: 50px;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tab:hover { border-color: var(--color-primary); }

  .tab.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .tab .count {
    background: rgba(0,0,0,0.1);
    padding: 0.125rem 0.5rem;
    border-radius: 50px;
    font-size: 0.75rem;
  }

  .tab.active .count { background: rgba(255,255,255,0.2); }

  .room-panel { display: none; }
  .room-panel.active { display: block; }

  .panel-header {
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .panel-header h3 { margin: 0; }
  .panel-header .path {
    font-size: 0.875rem;
    color: var(--color-text-light);
    font-family: monospace;
    background: var(--color-bg-alt);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  .image-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg-alt);
    cursor: pointer;
  }

  .image-card img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .image-card:hover img { transform: scale(1.05); }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 50%, rgba(0,0,0,0.8));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.75rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .image-card:hover .image-overlay { opacity: 1; }

  .image-name {
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .image-actions { display: flex; gap: 0.5rem; }

  .action-btn {
    width: 32px;
    height: 32px;
    background: rgba(255,255,255,0.2);
    border: none;
    border-radius: 8px;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .action-btn:hover { background: var(--color-primary); }

  /* Instructions */
  .instructions-section {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .instructions-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
  }

  .instructions-card h2 { margin-bottom: 1.5rem; text-align: center; }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .step {
    text-align: center;
  }

  .step-number {
    width: 50px;
    height: 50px;
    background: var(--color-primary);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 auto 1rem;
  }

  .step h3 { margin-bottom: 0.5rem; }
  .step p { color: var(--color-text-light); font-size: 0.9375rem; }

  @media (max-width: 1024px) {
    .editor-body { grid-template-columns: 1fr; }
    .editor-tools { border-top: 1px solid #eee; }
  }

  @media (max-width: 768px) {
    .manager-hero { padding: 6rem 1.5rem 2rem; }
    .steps { grid-template-columns: 1fr; gap: 1.5rem; }
    .panel-header { flex-direction: column; gap: 0.5rem; align-items: flex-start; }
  }
</style>

<script>
  // ============================================
  // IMAGE MANAGER - Full client-side editing
  // ============================================

  const SESSION_KEY = 'islandgoodes_admin_session';
  const ACTIVITY_LOG_KEY = 'islandgoodes_activity_log';

  // Check session
  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch { return null; }
  }

  // Redirect if not logged in
  if (!getSession()) {
    window.location.href = '/admin';
  }

  function logActivity(type: string, action: string, details?: string) {
    try {
      const session = getSession();
      const adminName = session?.fullName || session?.username || 'Unknown';
      const log = JSON.parse(localStorage.getItem(ACTIVITY_LOG_KEY) || '[]');
      log.push({ type, action, details, admin: adminName, timestamp: new Date().toISOString() });
      if (log.length > 500) log.shift();
      localStorage.setItem(ACTIVITY_LOG_KEY, JSON.stringify(log));
    } catch (e) { console.error('Failed to log activity:', e); }
  }

  // Editor state
  let originalImage: HTMLImageElement | null = null;
  let currentRotation = 0;
  let flipH = false;
  let flipV = false;
  let brightness = 0;
  let contrast = 0;
  let cropMode = false;
  let cropRatio: string | null = null;
  let cropStart = { x: 0, y: 0 };
  let cropEnd = { x: 0, y: 0 };
  let currentImageName = '';

  const modal = document.getElementById('editorModal');
  const canvas = document.getElementById('editorCanvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');

  // Tab switching
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const roomId = (tab as HTMLElement).dataset.room;
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      document.querySelectorAll('.room-panel').forEach(p => p.classList.remove('active'));
      document.querySelector(`.room-panel[data-room="${roomId}"]`)?.classList.add('active');
    });
  });

  // Open editor for existing images
  document.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = (btn as HTMLElement).closest('.image-card') as HTMLElement;
      const src = card?.dataset.src;
      const name = card?.dataset.name || 'image.jpg';
      if (src) openEditor(src, name);
    });
  });

  // Also open on card click
  document.querySelectorAll('.image-card').forEach(card => {
    card.addEventListener('click', () => {
      const src = (card as HTMLElement).dataset.src;
      const name = (card as HTMLElement).dataset.name || 'image.jpg';
      if (src) openEditor(src, name);
    });
  });

  // Copy path
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const card = (btn as HTMLElement).closest('.image-card') as HTMLElement;
      const src = card?.dataset.src;
      if (src) {
        navigator.clipboard.writeText(src);
        alert('Path copied: ' + src);
      }
    });
  });

  // Open editor
  function openEditor(src: string, name: string) {
    currentImageName = name;
    currentRotation = 0;
    flipH = false;
    flipV = false;
    brightness = 0;
    contrast = 0;
    cropMode = false;

    // Reset sliders
    (document.getElementById('brightness') as HTMLInputElement).value = '0';
    (document.getElementById('contrast') as HTMLInputElement).value = '0';

    // Update title
    document.getElementById('editorTitle')!.textContent = `Edit: ${name}`;

    // Load image
    originalImage = new Image();
    originalImage.crossOrigin = 'anonymous';
    originalImage.onload = () => {
      renderCanvas();
      modal?.classList.add('active');
    };
    originalImage.onerror = () => {
      alert('Failed to load image. The image may not allow cross-origin access.');
    };
    originalImage.src = src;
  }

  // Render canvas with current transformations
  function renderCanvas() {
    if (!originalImage || !ctx || !canvas) return;

    // Calculate dimensions based on rotation
    const isRotated = currentRotation % 180 !== 0;
    const width = isRotated ? originalImage.height : originalImage.width;
    const height = isRotated ? originalImage.width : originalImage.height;

    // Scale down if too large
    const maxSize = 800;
    let scale = 1;
    if (width > maxSize || height > maxSize) {
      scale = maxSize / Math.max(width, height);
    }

    canvas.width = width * scale;
    canvas.height = height * scale;

    ctx.save();

    // Move to center
    ctx.translate(canvas.width / 2, canvas.height / 2);

    // Apply rotation
    ctx.rotate((currentRotation * Math.PI) / 180);

    // Apply flips
    ctx.scale(flipH ? -1 : 1, flipV ? -1 : 1);

    // Draw image centered
    const drawWidth = originalImage.width * scale;
    const drawHeight = originalImage.height * scale;
    ctx.drawImage(originalImage, -drawWidth / 2, -drawHeight / 2, drawWidth, drawHeight);

    ctx.restore();

    // Apply filters
    if (brightness !== 0 || contrast !== 0) {
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const data = imageData.data;

      const brightnessOffset = brightness * 2.55;
      const contrastFactor = (259 * (contrast + 255)) / (255 * (259 - contrast));

      for (let i = 0; i < data.length; i += 4) {
        // Brightness
        data[i] = Math.min(255, Math.max(0, data[i] + brightnessOffset));
        data[i + 1] = Math.min(255, Math.max(0, data[i + 1] + brightnessOffset));
        data[i + 2] = Math.min(255, Math.max(0, data[i + 2] + brightnessOffset));

        // Contrast
        data[i] = Math.min(255, Math.max(0, contrastFactor * (data[i] - 128) + 128));
        data[i + 1] = Math.min(255, Math.max(0, contrastFactor * (data[i + 1] - 128) + 128));
        data[i + 2] = Math.min(255, Math.max(0, contrastFactor * (data[i + 2] - 128) + 128));
      }

      ctx.putImageData(imageData, 0, 0);
    }
  }

  // Rotate left
  document.getElementById('rotateLeft')?.addEventListener('click', () => {
    currentRotation = (currentRotation - 90) % 360;
    renderCanvas();
  });

  // Rotate right
  document.getElementById('rotateRight')?.addEventListener('click', () => {
    currentRotation = (currentRotation + 90) % 360;
    renderCanvas();
  });

  // Flip horizontal
  document.getElementById('flipH')?.addEventListener('click', () => {
    flipH = !flipH;
    renderCanvas();
  });

  // Flip vertical
  document.getElementById('flipV')?.addEventListener('click', () => {
    flipV = !flipV;
    renderCanvas();
  });

  // Brightness
  document.getElementById('brightness')?.addEventListener('input', (e) => {
    brightness = parseInt((e.target as HTMLInputElement).value);
    renderCanvas();
  });

  // Contrast
  document.getElementById('contrast')?.addEventListener('input', (e) => {
    contrast = parseInt((e.target as HTMLInputElement).value);
    renderCanvas();
  });

  // Reset
  document.getElementById('resetImage')?.addEventListener('click', () => {
    currentRotation = 0;
    flipH = false;
    flipV = false;
    brightness = 0;
    contrast = 0;
    (document.getElementById('brightness') as HTMLInputElement).value = '0';
    (document.getElementById('contrast') as HTMLInputElement).value = '0';
    renderCanvas();
  });

  // Download
  document.getElementById('downloadImage')?.addEventListener('click', () => {
    if (!canvas) return;

    // Create download link
    const link = document.createElement('a');
    link.download = `edited-${currentImageName}`;
    link.href = canvas.toDataURL('image/jpeg', 0.9);
    link.click();

    logActivity('image', 'Image edited and downloaded', currentImageName);
  });

  // Close editor
  document.getElementById('closeEditor')?.addEventListener('click', () => {
    modal?.classList.remove('active');
  });

  // Close on escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) {
      modal.classList.remove('active');
    }
  });

  // ============================================
  // FILE UPLOAD
  // ============================================

  const dropZone = document.getElementById('dropZone');
  const fileInput = document.getElementById('fileInput') as HTMLInputElement;
  const uploadQueue = document.getElementById('uploadQueue');

  dropZone?.addEventListener('click', () => fileInput?.click());

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
  });

  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('dragover');
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    const files = e.dataTransfer?.files;
    if (files) handleFiles(files);
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files) handleFiles(fileInput.files);
  });

  function handleFiles(files: FileList) {
    if (!uploadQueue) return;

    uploadQueue.classList.add('has-items');

    Array.from(files).forEach(file => {
      if (!file.type.startsWith('image/')) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const item = document.createElement('div');
        item.className = 'upload-item';
        item.innerHTML = `
          <img src="${e.target?.result}" alt="${file.name}" />
          <div class="upload-item-info">
            <div class="upload-item-name">${file.name}</div>
            <div class="upload-item-size">${(file.size / 1024).toFixed(1)} KB</div>
          </div>
          <button class="btn btn-small edit-upload">Edit</button>
          <button class="btn btn-small btn-outline download-upload">Download</button>
        `;

        // Edit button
        item.querySelector('.edit-upload')?.addEventListener('click', () => {
          openEditor(e.target?.result as string, file.name);
        });

        // Download button (direct download)
        item.querySelector('.download-upload')?.addEventListener('click', () => {
          const link = document.createElement('a');
          link.download = file.name;
          link.href = e.target?.result as string;
          link.click();
        });

        uploadQueue.appendChild(item);
      };
      reader.readAsDataURL(file);
    });

    logActivity('image', 'Images uploaded for editing', `${files.length} file(s)`);
  }
</script>
