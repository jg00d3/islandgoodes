---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Our Pets - Property Inhabitants | Island Goodes";
const description = "Meet the friendly animal residents at Island Goodes. Our property pets add to the tropical Hawaiian charm of your stay.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="hero-content">
      <h1>Property Inhabitants</h1>
      <p>Meet our friendly animal residents</p>
    </div>
  </section>

  <section class="pets-section">
    <div class="container">
      <p class="intro">
        Island Goodes is home to some friendly animal residents who help make our property feel like a true Hawaiian retreat.
        While they live on the property, they respect guest privacy and add to the tropical charm of your stay.
      </p>

      <div class="pets-grid">
        <div class="pet-card">
          <div class="pet-image">
            <img src="/images/property/cat.jpg" alt="Property cat" loading="lazy" />
          </div>
          <div class="pet-info">
            <h2>Our Friendly Cats</h2>
            <p>
              You may spot our resident cats lounging in sunny spots around the property.
              They're friendly but independent, and love to greet guests from a distance.
              They help keep the property free of geckos and other small critters.
            </p>
          </div>
        </div>

        <div class="pet-card reverse">
          <div class="pet-image">
            <img src="/images/property/birds.jpg" alt="Tropical birds" loading="lazy" />
          </div>
          <div class="pet-info">
            <h2>Tropical Birds</h2>
            <p>
              Wake up to the songs of tropical birds in our gardens. Hawaii is home to
              many unique bird species, and our lush landscaping attracts a variety of
              colorful visitors throughout the day.
            </p>
          </div>
        </div>
      </div>

      <div class="note-box">
        <h3>A Note About Pets</h3>
        <p>
          While we have animal residents on the property, we are unable to accommodate guest pets
          at this time. Service animals are welcome with advance notice.
        </p>
        <p>
          If you have any concerns about animal allergies, please contact us before booking.
        </p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Book Your Stay</h2>
      <p>Experience the peaceful, tropical atmosphere of Island Goodes</p>
      <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary btn-large" target="_blank" rel="noopener">Check Availability</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/property/garden.jpg') center/cover no-repeat;
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 8rem 2rem 4rem;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .pets-section {
    padding: 4rem 0;
  }

  .intro {
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: 3rem;
    line-height: 1.8;
  }

  .pets-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .pet-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .pet-card.reverse {
    direction: rtl;
  }

  .pet-card.reverse > * {
    direction: ltr;
  }

  .pet-image img {
    width: 100%;
    height: 300px;
    object-fit: cover;
  }

  .pet-info {
    padding: 2rem;
  }

  .pet-info h2 {
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .pet-info p {
    line-height: 1.8;
    color: var(--color-text-light);
  }

  .note-box {
    background: var(--color-bg-alt);
    padding: 2rem;
    border-radius: 8px;
    border-left: 4px solid var(--color-secondary);
  }

  .note-box h3 {
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .note-box p {
    margin-bottom: 0.75rem;
    line-height: 1.7;
  }

  .cta-section {
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
    padding: 4rem 2rem;
  }

  .cta-section h2 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .cta-section p {
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-primary {
    background: var(--color-secondary);
    color: #fff;
  }

  .btn-primary:hover {
    background: #c49943;
    color: #fff;
  }

  .btn-large {
    padding: 1rem 3rem;
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .pet-card {
      grid-template-columns: 1fr;
    }

    .pet-card.reverse {
      direction: ltr;
    }
  }
</style>
