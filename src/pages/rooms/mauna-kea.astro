---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Mauna Kea Room - Mountain View Suite";
const description = "Mountain view room with views toward Hawaii's highest peak. Perfect for stargazers visiting Mauna Kea observatories. Sleep Number bed, private lanai. Adults-only accommodation near Hilo.";

const images = [
  { src: "/images/rooms/mauna-kea/bed.jpg", alt: "Sleep Number bed in Mauna Kea Room" },
  { src: "/images/rooms/mauna-kea/room.jpg", alt: "Mauna Kea Room overview" },
  { src: "/images/rooms/mauna-kea/room2.jpg", alt: "Mauna Kea Room alternate view" },
  { src: "/images/rooms/mauna-kea/room3.jpg", alt: "Mauna Kea Room sitting area" },
  { src: "/images/rooms/mauna-kea/lanai.jpg", alt: "Private lanai" },
  { src: "/images/rooms/mauna-kea/lanai2.jpg", alt: "Lanai seating area" },
  { src: "/images/rooms/mauna-kea/lanai3.jpg", alt: "Lanai view" },
  { src: "/images/rooms/mauna-kea/bathroom.jpg", alt: "Private bathroom" },
  { src: "/images/rooms/mauna-kea/bathroom2.jpg", alt: "Bathroom vanity" },
  { src: "/images/rooms/mauna-kea/bathroom3.jpg", alt: "Bathroom shower" },
  { src: "/images/rooms/mauna-kea/bathroom4.jpg", alt: "Bathroom amenities" },
  { src: "/images/rooms/mauna-kea/bathroom5.jpg", alt: "Bathroom detail" },
  { src: "/images/rooms/mauna-kea/bathroom6.jpg", alt: "Bathroom fixtures" },
  { src: "/images/rooms/mauna-kea/bathroom7.jpg", alt: "Bathroom mirror" },
  { src: "/images/rooms/mauna-kea/coffee.jpg", alt: "Coffee station" },
  { src: "/images/rooms/mauna-kea/table.jpg", alt: "Table area" },
  { src: "/images/rooms/mauna-kea/closet.jpg", alt: "Closet" },
  { src: "/images/rooms/mauna-kea/closet2.jpg", alt: "Additional closet space" },
  { src: "/images/rooms/mauna-kea/closet3.jpg", alt: "Closet storage" },
  { src: "/images/rooms/mauna-kea/fridge.jpg", alt: "Refrigerator" },
  { src: "/images/rooms/mauna-kea/entrance.jpg", alt: "Private entrance" },
];

const amenities = [
  "527 square feet",
  "Mountain view",
  "View of Mauna Kea",
  "Private entrance",
  "Private bathroom",
  "Private lanai",
  "Sleep Number King Bed",
  "Premium linens",
  "Free WiFi",
  "Mid-size refrigerator/freezer",
  "Microwave",
  "Coffee maker with our own house blend of strong coffee",
  "Coffee press",
  "Electric hot water kettle",
  "Toaster",
  "Silverware, plates, cups, wine glasses, wine decorker",
  "Other appliances upon request",
  "Air conditioning",
  "Two adjustable ceiling fans",
  "Floor fan",
  "32\" HDTV - access apps by using your own account"
];

const bathroomAmenities = [
  "Shower only",
  "Fresh hand and full-size towels",
  "Hair dryer",
  "Soap",
  "Body wash",
  "Shampoo",
  "Conditioner",
  "Beach towels"
];
---

<PreviewLayout title={title} description={description}>
  <section class="room-hero">
    <div class="room-hero-bg">
      <img src="/images/rooms/mauna-kea/lanai.jpg" alt="View from Mauna Kea Room" />
    </div>
    <div class="room-hero-overlay"></div>
    <div class="room-hero-content">
      <nav class="breadcrumb">
        <a href="/">Home</a> / <a href="/rooms">Rooms</a> / Mauna Kea Room
      </nav>
      <span class="room-badge">Stargazer's Choice</span>
      <h1>Mauna Kea Room</h1>
      <p class="tagline">Mountain Views Toward Hawaii's Highest Peak</p>
    </div>
  </section>

  <section class="room-content">
    <div class="container">
      <div class="room-grid">
        <div class="room-gallery">
          <div class="main-image">
            <img src={images[0].src} alt={images[0].alt} id="featured-image" />
          </div>
          <div class="thumbnail-grid">
            {images.map((img, index) => (
              <button class="thumbnail" data-index={index} data-src={img.src} data-alt={img.alt}>
                <img src={img.src} alt={img.alt} loading="lazy" />
              </button>
            ))}
          </div>
        </div>

        <div class="room-details">
          <div class="quick-info">
            <div class="info-item">
              <span class="info-label">Size</span>
              <span class="info-value">527 sq ft</span>
            </div>
            <div class="info-item">
              <span class="info-label">View</span>
              <span class="info-value">Mountain</span>
            </div>
            <div class="info-item">
              <span class="info-label">Bed</span>
              <span class="info-value">Sleep Number King</span>
            </div>
            <div class="info-item">
              <span class="info-label">Bath</span>
              <span class="info-value">Private</span>
            </div>
            <div class="info-item">
              <span class="info-label">Lanai</span>
              <span class="info-value">Yes</span>
            </div>
          </div>

          <div class="price-card">
            <div class="price-header">
              <span class="price-label">From</span>
              <span class="price-amount">$195</span>
              <span class="price-period">/night</span>
            </div>
            <p class="price-note">Plus 17.97% Hawaii tax</p>
            <a href="/book" class="btn btn-primary btn-large btn-block">Book This Room</a>
            <a href="/tour?room=mauna-kea" class="btn btn-outline btn-large btn-block">View 3D Tour</a>
            <p class="call-option">Or call: <a href="tel:+18089642291">808-964-2291</a></p>
          </div>

          <div class="description">
            <h2>About This Room</h2>
            <p>
              Named for the majestic mountain visible in the distance, the Mauna Kea Room with 527 sq ft
              offers views toward Hawaii's tallest peak at 13,796 feet.
            </p>
            <p>
              This room is perfect for stargazing enthusiasts planning a trip to the world-renowned Mauna Kea
              observatories. After your sunset stargazing adventure, return to the comfort of your Sleep Number
              King Bed for the perfect night's rest.
            </p>
            <p>
              Like all our rooms, the Mauna Kea Room features a private entrance, bathroom, and lanai, giving
              you complete privacy during your Hawaiian getaway.
            </p>
          </div>

          <div class="highlights">
            <h3>Room Highlights</h3>
            <div class="highlights-grid">
              <div class="highlight-item">
                <span class="highlight-icon">🏔️</span>
                <div>
                  <strong>Mountain Views</strong>
                  <p>Views toward Mauna Kea, Hawaii's highest peak</p>
                </div>
              </div>
              <div class="highlight-item">
                <span class="highlight-icon">🌟</span>
                <div>
                  <strong>Perfect for Stargazers</strong>
                  <p>Ideal base for visiting Mauna Kea observatories</p>
                </div>
              </div>
              <div class="highlight-item">
                <span class="highlight-icon">🛏️</span>
                <div>
                  <strong>Sleep Number Bed</strong>
                  <p>Customize your comfort for the perfect sleep</p>
                </div>
              </div>
              <div class="highlight-item">
                <span class="highlight-icon">🚪</span>
                <div>
                  <strong>Complete Privacy</strong>
                  <p>Private entrance, bathroom, and outdoor lanai</p>
                </div>
              </div>
            </div>
          </div>

          <div class="amenities">
            <h3>Room Amenities</h3>
            <ul class="amenities-grid">
              {amenities.map((amenity) => (
                <li>{amenity}</li>
              ))}
            </ul>
          </div>

          <div class="amenities bathroom-amenities">
            <h3>Bathroom Amenities</h3>
            <ul class="amenities-grid">
              {bathroomAmenities.map((amenity) => (
                <li>{amenity}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="other-rooms">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Explore More</span>
        <h2>Other Rooms</h2>
      </div>
      <div class="rooms-grid">
        <a href="/rooms/hilo-bay" class="room-card">
          <img src="/images/rooms/hilo-bay/bed.jpg" alt="Hilo Bay Room" loading="lazy" />
          <div class="room-card-content">
            <h3>Hilo Bay Room</h3>
            <p>488 sq ft premier oceanview</p>
          </div>
        </a>
        <a href="/rooms/orchid" class="room-card">
          <img src="/images/rooms/orchid/bed.jpg" alt="Orchid Room" loading="lazy" />
          <div class="room-card-content">
            <h3>Orchid Room</h3>
            <p>645 sq ft with kitchenette</p>
          </div>
        </a>
        <a href="/rooms/ginger" class="room-card">
          <img src="/images/rooms/ginger/room.jpg" alt="Ginger Room" loading="lazy" />
          <div class="room-card-content">
            <h3>Ginger Room</h3>
            <p>400 sq ft garden retreat</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Lightbox with Slideshow -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose">&times;</button>
    <button class="lightbox-prev" id="lightboxPrev">&#10094;</button>
    <button class="lightbox-next" id="lightboxNext">&#10095;</button>
    <div class="lightbox-controls">
      <button class="slideshow-btn" id="slideshowToggle" title="Play slideshow">
        <svg class="play-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        <svg class="pause-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none">
          <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
        </svg>
      </button>
      <select class="speed-select" id="speedSelect" title="Slideshow speed">
        <option value="5000">Slow</option>
        <option value="3000" selected>Medium</option>
        <option value="1500">Fast</option>
      </select>
    </div>
    <div class="lightbox-content">
      <img src="" alt="" id="lightboxImg" />
      <p class="lightbox-caption" id="lightboxCaption"></p>
      <p class="lightbox-counter" id="lightboxCounter"></p>
    </div>
  </div>
</PreviewLayout>

<style>
  .room-hero { position: relative; min-height: 50vh; display: flex; align-items: center; justify-content: center; text-align: center; color: #fff; padding: 10rem 2rem 4rem; }
  .room-hero-bg { position: absolute; inset: 0; z-index: -2; }
  .room-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .room-hero-overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.6) 100%); }
  .room-hero-content { max-width: 800px; }
  .room-badge { display: inline-block; background: var(--color-secondary); color: #1a1a1a; padding: 0.375rem 1rem; border-radius: 50px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem; }
  .room-hero h1 { font-size: clamp(2.5rem, 6vw, 4rem); margin-bottom: 0.5rem; }
  .tagline { font-size: 1.25rem; opacity: 0.9; }

  .room-content { padding: var(--section-padding) 0; }
  .room-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }

  .main-image { border-radius: 16px; overflow: hidden; margin-bottom: 1rem; scroll-margin-top: 100px; }
  .main-image img { width: 100%; height: auto; cursor: pointer; transition: opacity 0.2s; }
  .main-image img:hover { opacity: 0.9; }
  .thumbnail-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  .thumbnail { border: none; padding: 0; border-radius: 8px; overflow: hidden; cursor: pointer; opacity: 0.7; transition: var(--transition-base); }
  .thumbnail:hover, .thumbnail.active { opacity: 1; }
  .thumbnail img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .thumbnail.deleted {
    display: none !important;
  }

  .quick-info { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; padding: 1.5rem; background: var(--color-bg-alt); border-radius: 12px; }
  .info-item { text-align: center; }
  .info-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-light); margin-bottom: 0.25rem; }
  .info-value { font-size: 1.125rem; font-weight: 600; color: var(--color-text); }

  .price-card { background: var(--gradient-primary); color: #fff; padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .price-header { display: flex; align-items: baseline; gap: 0.25rem; margin-bottom: 0.25rem; }
  .price-label { font-size: 1rem; }
  .price-amount { font-size: 3rem; font-weight: 700; font-family: var(--font-heading); }
  .price-period { font-size: 1rem; opacity: 0.8; }
  .price-note { font-size: 0.875rem; opacity: 0.8; margin-bottom: 1.5rem; }
  .btn-block { display: block; width: 100%; text-align: center; }
  .call-option { text-align: center; margin-top: 1rem; font-size: 0.9375rem; }
  .call-option a { color: var(--color-secondary-light); }

  .description { margin-bottom: 2rem; }
  .description h2 { font-size: 1.5rem; margin-bottom: 1rem; color: var(--color-text); }
  .description p { color: var(--color-text-light); line-height: 1.8; margin-bottom: 1rem; }

  .highlights { background: var(--color-bg-alt); padding: 2rem; border-radius: 16px; margin-bottom: 2rem; }
  .highlights h3 { font-size: 1.25rem; margin-bottom: 1.5rem; }
  .highlights-grid { display: grid; gap: 1.5rem; }
  .highlight-item { display: flex; gap: 1rem; }
  .highlight-icon { font-size: 1.5rem; flex-shrink: 0; }
  .highlight-item strong { display: block; color: var(--color-text); margin-bottom: 0.25rem; }
  .highlight-item p { font-size: 0.9375rem; color: var(--color-text-light); margin: 0; }

  .amenities { margin-bottom: 2rem; }
  .amenities h3 { font-size: 1.25rem; margin-bottom: 1rem; }
  .bathroom-amenities { margin-top: 2.5rem; }
  .amenities-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; list-style: none; }
  .amenities-grid li { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; color: var(--color-text-light); }
  .amenities-grid li::before { content: "✓"; color: var(--color-primary); font-weight: 600; }

  .other-rooms { padding: var(--section-padding) 0; background: var(--color-bg-alt); }
  .rooms-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .room-card { background: #fff; border-radius: 16px; overflow: hidden; transition: var(--transition-base); }
  .room-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(0,0,0,0.1); }
  .room-card img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .room-card-content { padding: 1.25rem; }
  .room-card-content h3 { font-size: 1.125rem; margin-bottom: 0.25rem; }
  .room-card-content p { font-size: 0.875rem; color: var(--color-text-light); }

  @media (max-width: 1024px) { .room-grid, .rooms-grid { grid-template-columns: 1fr; } }
  @media (max-width: 768px) { .quick-info { grid-template-columns: repeat(2, 1fr); } .thumbnail-grid { grid-template-columns: repeat(3, 1fr); } .amenities-grid { grid-template-columns: 1fr; } }

  /* Lightbox with Slideshow */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-content {
    max-width: 90vw;
    max-height: 90vh;
    text-align: center;
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 8px;
  }

  .lightbox-caption {
    color: #fff;
    margin-top: 1rem;
    font-size: 1rem;
  }

  .lightbox-counter {
    color: rgba(255,255,255,0.7);
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 3rem;
    cursor: pointer;
    z-index: 10001;
    line-height: 1;
  }

  .lightbox-close:hover {
    color: var(--color-secondary);
  }

  .lightbox-prev,
  .lightbox-next {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    font-size: 2.5rem;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 50%;
    transition: all 0.3s;
    z-index: 10001;
  }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(0, 0, 0, 0.8);
    border-color: #fff;
  }

  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }

  .lightbox-controls {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.6);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    z-index: 10001;
  }

  .slideshow-btn {
    background: var(--color-primary);
    border: none;
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s, transform 0.2s;
  }

  .slideshow-btn:hover {
    background: var(--color-primary-dark);
    transform: scale(1.1);
  }

  .slideshow-btn.playing {
    background: var(--color-secondary);
    color: #1a1a1a;
  }

  .speed-select {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .speed-select option {
    background: #333;
    color: #fff;
  }

  @media (max-width: 768px) {
    .lightbox-prev,
    .lightbox-next {
      padding: 0.5rem;
      font-size: 1.5rem;
    }

    .lightbox-controls {
      bottom: 1rem;
      padding: 0.5rem 1rem;
    }

    .slideshow-btn {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  // ============================================
  // SIMPLE LIGHTBOX WITH EDITED IMAGE SUPPORT
  // ============================================

  // Get all elements
  const featuredImage = document.getElementById('featured-image') as HTMLImageElement;
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightboxCaption');
  const lightboxCounter = document.getElementById('lightboxCounter');
  const lightboxClose = document.getElementById('lightboxClose');
  const lightboxPrev = document.getElementById('lightboxPrev');
  const lightboxNext = document.getElementById('lightboxNext');

  // Build image array directly from thumbnails in DOM order
  const allThumbnails = Array.from(document.querySelectorAll('.thumbnail-grid .thumbnail')) as HTMLElement[];
  const imageData = allThumbnails.map((thumb, i) => ({
    src: thumb.getAttribute('data-src') || '',
    alt: thumb.getAttribute('data-alt') || '',
    index: i
  }));

  let currentIndex = 0;
  const totalImages = imageData.length;

  // Mark first thumbnail as active
  if (allThumbnails[0]) {
    allThumbnails[0].classList.add('active');
  }

  // Wait for SharedData to load, then apply edited/deleted images
  function waitForSharedData(callback: () => void, maxWait = 5000) {
    const start = Date.now();
    const check = () => {
      if (typeof window !== 'undefined' && (window as any).SharedData) {
        callback();
      } else if (Date.now() - start < maxWait) {
        setTimeout(check, 100);
      }
    };
    check();
  }

  waitForSharedData(async () => {
    try {
      const SharedData = (window as any).SharedData;

      // Load deleted images and hide them
      const deletedImages = await SharedData.getDeletedImages() || [];
      const deletedPaths = Array.isArray(deletedImages)
        ? deletedImages.map((d: any) => d.path || d)
        : [];

      // Load edited images (rotated, cropped)
      const editedImages = await SharedData.getEditedImages() || {};

      // Process each thumbnail
      allThumbnails.forEach((thumb, index) => {
        const originalSrc = thumb.getAttribute('data-src');

        // Hide deleted images
        if (originalSrc && deletedPaths.includes(originalSrc)) {
          thumb.style.display = 'none';
          thumb.classList.add('deleted');
          return;
        }

        // Apply edited images
        if (originalSrc && editedImages[originalSrc]) {
          const editedSrc = editedImages[originalSrc].dataUrl;
          const img = thumb.querySelector('img') as HTMLImageElement;
          if (img) img.src = editedSrc;
          imageData[index].src = editedSrc;
          thumb.setAttribute('data-edited', editedSrc);
        }
      });

      // Update featured image with first visible image
      const firstVisible = allThumbnails.find(t => !t.classList.contains('deleted'));
      if (firstVisible && featuredImage) {
        const editedSrc = firstVisible.getAttribute('data-edited');
        const originalSrc = firstVisible.getAttribute('data-src');
        featuredImage.src = editedSrc || originalSrc || '';
      }
    } catch (e) {
      console.log('Could not load image data:', e);
    }
  });

  // Update lightbox display
  function showImage(index: number) {
    if (index < 0 || index >= totalImages) return;
    currentIndex = index;

    const img = imageData[index];
    if (lightboxImg) {
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
    }
    if (lightboxCaption) {
      lightboxCaption.textContent = img.alt;
    }
    if (lightboxCounter) {
      lightboxCounter.textContent = `${index + 1} / ${totalImages}`;
    }
  }

  // Open lightbox at specific index
  function openLightbox(index: number) {
    showImage(index);
    lightbox?.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  // Close lightbox
  function closeLightbox() {
    lightbox?.classList.remove('active');
    document.body.style.overflow = '';
  }

  // Navigation
  function prevImage() {
    showImage((currentIndex - 1 + totalImages) % totalImages);
  }

  function nextImage() {
    showImage((currentIndex + 1) % totalImages);
  }

  // Thumbnail click handler - use data-index directly
  allThumbnails.forEach((thumb, index) => {
    thumb.addEventListener('click', () => {
      // Update featured image
      const src = thumb.getAttribute('data-src') || '';
      const alt = thumb.getAttribute('data-alt') || '';
      if (featuredImage) {
        featuredImage.src = src;
        featuredImage.alt = alt;
      }

      // Update active state
      allThumbnails.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');

      // Open lightbox at THIS index
      openLightbox(index);
    });
  });

  // Lightbox controls
  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxPrev?.addEventListener('click', prevImage);
  lightboxNext?.addEventListener('click', nextImage);

  // Close on background click
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevImage();
    if (e.key === 'ArrowRight') nextImage();
  });

  // Hide slideshow controls (not used in simple version)
  const slideshowControls = document.querySelector('.lightbox-controls');
  if (slideshowControls) slideshowControls.style.display = 'none';
</script>
