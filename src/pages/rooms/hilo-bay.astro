---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Hilo Bay Room - Oceanview Suite";
const description = "A large and very popular room at 488 sq ft with stunning panoramic views of Hilo Bay. Ground floor, private lanai, Sleep Number King Bed, private bathroom. Adults-only accommodation near Hilo, Hawaii.";

const images = [
  { src: "/images/rooms/hilo-bay/bed.jpg", alt: "Sleep Number king bed in Hilo Bay Room" },
  { src: "/images/rooms/hilo-bay/room.jpg", alt: "Hilo Bay Room overview with ocean view" },
  { src: "/images/rooms/hilo-bay/room2.jpg", alt: "Hilo Bay Room alternate view" },
  { src: "/images/rooms/hilo-bay/room3.jpg", alt: "Hilo Bay Room with bed view" },
  { src: "/images/rooms/hilo-bay/lanai.jpg", alt: "Private lanai with ocean views" },
  { src: "/images/rooms/hilo-bay/lanai2.jpg", alt: "Lanai seating" },
  { src: "/images/rooms/hilo-bay/bathroom.jpg", alt: "Private bathroom" },
  { src: "/images/rooms/hilo-bay/bathroom2.jpg", alt: "Bathroom vanity" },
  { src: "/images/rooms/hilo-bay/bathroom3.jpg", alt: "Bathroom shower" },
  { src: "/images/rooms/hilo-bay/bathroom4.jpg", alt: "Bathroom amenities" },
  { src: "/images/rooms/hilo-bay/bathroom5.jpg", alt: "Bathroom detail" },
  { src: "/images/rooms/hilo-bay/bathroom6.jpg", alt: "Bathroom shower view" },
  { src: "/images/rooms/hilo-bay/bathroom7.jpg", alt: "Bathroom vanity detail" },
  { src: "/images/rooms/hilo-bay/table.jpg", alt: "Dining table and seating area" },
  { src: "/images/rooms/hilo-bay/coffee.jpg", alt: "Coffee station" },
  { src: "/images/rooms/hilo-bay/recliner.jpg", alt: "Comfortable recliner for relaxing" },
  { src: "/images/rooms/hilo-bay/closet.jpg", alt: "Spacious closet" },
  { src: "/images/rooms/hilo-bay/dresser-tv.jpg", alt: "Dresser and TV area" },
  { src: "/images/rooms/hilo-bay/fridge.jpg", alt: "Refrigerator and utensils" },
  { src: "/images/rooms/hilo-bay/entrance.jpg", alt: "Private entrance" },
];

const amenities = [
  "488 square feet",
  "Panoramic ocean view",
  "Ground floor (no steps)",
  "Private entrance",
  "Private bathroom",
  "Private lanai",
  "Sleep Number King Bed",
  "Premium linens",
  "Free WiFi",
  "Mid-size refrigerator/freezer",
  "Microwave",
  "Coffee maker with our own house blend of strong coffee",
  "Coffee press",
  "Electric hot water kettle",
  "Toaster",
  "Silverware, plates, cups, wine glasses, wine decorker",
  "Other appliances upon request",
  "Air conditioning",
  "Two adjustable ceiling fans",
  "Floor fan",
  "32\" HDTV - access apps by using your own account"
];

const bathroomAmenities = [
  "Shower only",
  "Bathroom grab bars",
  "Fresh hand and full-size towels",
  "Hair dryer",
  "Soap",
  "Body wash",
  "Shampoo",
  "Conditioner",
  "Beach towels"
];
---

<PreviewLayout title={title} description={description}>
  <section class="room-hero">
    <div class="room-hero-bg">
      <img src="/images/rooms/hilo-bay/lanai.jpg" alt="View from Hilo Bay Room" />
    </div>
    <div class="room-hero-overlay"></div>
    <div class="room-hero-content">
      <nav class="breadcrumb">
        <a href="/">Home</a> / <a href="/rooms">Rooms</a> / Hilo Bay Room
      </nav>
      <span class="room-badge">Featured Room</span>
      <h1>Hilo Bay Room</h1>
      <p class="tagline">Our Premier Oceanview Suite</p>
    </div>
  </section>

  <section class="room-content">
    <div class="container">
      <div class="room-grid">
        <!-- Gallery -->
        <div class="room-gallery">
          <div class="main-image">
            <img src={images[0].src} alt={images[0].alt} id="featured-image" />
          </div>
          <div class="thumbnail-grid">
            {images.map((img) => (
              <button class="thumbnail" data-src={img.src} data-alt={img.alt}>
                <img src={img.src} alt={img.alt} loading="lazy" />
              </button>
            ))}
          </div>
        </div>

        <!-- Details -->
        <div class="room-details">
          <div class="quick-info">
            <div class="info-item">
              <span class="info-label">Size</span>
              <span class="info-value">488 sq ft</span>
            </div>
            <div class="info-item">
              <span class="info-label">View</span>
              <span class="info-value">Ocean</span>
            </div>
            <div class="info-item">
              <span class="info-label">Bed</span>
              <span class="info-value">Sleep Number King</span>
            </div>
            <div class="info-item">
              <span class="info-label">Floor</span>
              <span class="info-value">Ground</span>
            </div>
          </div>

          <div class="price-card">
            <div class="price-header">
              <span class="price-label">From</span>
              <span class="price-amount">$225</span>
              <span class="price-period">/night</span>
            </div>
            <p class="price-note">Plus 17.97% Hawaii tax</p>
            <a href="/book" class="btn btn-primary btn-large btn-block">Book This Room</a>
            <a href="https://my.matterport.com/show/?m=zrMG54r6RUx&sr=-2.86,.92&ss=13" class="btn btn-outline btn-large btn-block" target="_blank" rel="noopener">View 3D Tour</a>
            <p class="call-option">Or call: <a href="tel:+18089642291">808-964-2291</a></p>
          </div>

          <div class="description">
            <h2>About This Room</h2>
            <p>
              The Hilo Bay Room is a large room and very popular with guests, offering 488 square feet of
              comfortable living space with stunning ocean views on the property.
            </p>
            <p>
              Located on the ground floor with no steps to climb, this suite is perfect for guests who prefer
              easy access. Step out onto your private lanai and watch the sun rise over Hilo Bay, spot whales
              breaching during winter months, or simply relax with a self-made cup of our own house blend of strong coffee.
            </p>
            <p>
              The room features a luxurious Sleep Number King Bed that lets you customize your comfort
              level for the perfect night's sleep.
            </p>
          </div>

          <div class="highlights">
            <h3>Room Highlights</h3>
            <div class="highlights-grid">
              <div class="highlight-item">
                <span class="highlight-icon">🌊</span>
                <div>
                  <strong>Best Views</strong>
                  <p>Panoramic ocean views of Hilo Bay from the room and lanai</p>
                </div>
              </div>
              <div class="highlight-item">
                <span class="highlight-icon">🐋</span>
                <div>
                  <strong>Whale Watching</strong>
                  <p>Watch humpback whales breach from your private lanai (Dec-Apr)</p>
                </div>
              </div>
              <div class="highlight-item">
                <span class="highlight-icon">📐</span>
                <div>
                  <strong>Spacious</strong>
                  <p>A large room at 488 square feet</p>
                </div>
              </div>
              <div class="highlight-item">
                <span class="highlight-icon">🧭</span>
                <div>
                  <strong>Easy to Get Around</strong>
                  <p>Ground floor with no steps and bathroom grab bars</p>
                </div>
              </div>
            </div>
          </div>

          <div class="amenities">
            <h3>Room Amenities</h3>
            <ul class="amenities-grid">
              {amenities.map((amenity) => (
                <li>{amenity}</li>
              ))}
            </ul>
          </div>

          <div class="amenities bathroom-amenities">
            <h3>Bathroom Amenities</h3>
            <ul class="amenities-grid">
              {bathroomAmenities.map((amenity) => (
                <li>{amenity}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Rooms -->
  <section class="other-rooms">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Explore More</span>
        <h2>Other Rooms</h2>
      </div>
      <div class="rooms-grid">
        <a href="/rooms/orchid" class="room-card">
          <img src="/images/rooms/orchid/bed.jpg" alt="Orchid Room" loading="lazy" />
          <div class="room-card-content">
            <h3>Orchid Room</h3>
            <p>645 sq ft with kitchenette</p>
          </div>
        </a>
        <a href="/rooms/mauna-kea" class="room-card">
          <img src="/images/rooms/mauna-kea/bed.jpg" alt="Mauna Kea Room" loading="lazy" />
          <div class="room-card-content">
            <h3>Mauna Kea Room</h3>
            <p>527 sq ft mountain views</p>
          </div>
        </a>
        <a href="/rooms/ginger" class="room-card">
          <img src="/images/rooms/ginger/room.jpg" alt="Ginger Room" loading="lazy" />
          <div class="room-card-content">
            <h3>Ginger Room</h3>
            <p>400 sq ft garden retreat</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Lightbox with Slideshow -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose">&times;</button>
    <button class="lightbox-prev" id="lightboxPrev">&#10094;</button>
    <button class="lightbox-next" id="lightboxNext">&#10095;</button>
    <div class="lightbox-controls">
      <button class="slideshow-btn" id="slideshowToggle" title="Play slideshow">
        <svg class="play-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        <svg class="pause-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none">
          <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
        </svg>
      </button>
      <select class="speed-select" id="speedSelect" title="Slideshow speed">
        <option value="5000">Slow</option>
        <option value="3000" selected>Medium</option>
        <option value="1500">Fast</option>
      </select>
    </div>
    <div class="lightbox-content">
      <img src="" alt="" id="lightboxImg" />
      <p class="lightbox-caption" id="lightboxCaption"></p>
      <p class="lightbox-counter" id="lightboxCounter"></p>
    </div>
  </div>
</PreviewLayout>

<style>
  .room-hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 10rem 2rem 4rem;
  }

  .room-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .room-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .room-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.6) 100%);
  }

  .room-hero-content {
    max-width: 800px;
  }

  .room-badge {
    display: inline-block;
    background: var(--color-secondary);
    color: #1a1a1a;
    padding: 0.375rem 1rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .room-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.25rem;
    opacity: 0.9;
  }

  .room-content {
    padding: var(--section-padding) 0;
  }

  .room-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .main-image {
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1rem;
    scroll-margin-top: 100px;
  }

  .main-image img {
    width: 100%;
    height: auto;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .main-image img:hover {
    opacity: 0.9;
  }

  .thumbnail-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .thumbnail {
    border: none;
    padding: 0;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.7;
    transition: var(--transition-base);
  }

  .thumbnail:hover,
  .thumbnail.active {
    opacity: 1;
  }

  .thumbnail img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .thumbnail.deleted {
    display: none !important;
  }

  .quick-info {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
  }

  .info-item {
    text-align: center;
  }

  .info-label {
    display: block;
    font-size: 0.75rem;
