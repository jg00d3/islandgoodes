---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Oceanview Rooms & Suites";
const description = "Four private oceanview rooms at Island Goodes near Hilo, Hawaii. Adults-only accommodation with private entrance, bathroom, lanai, and Sleep Number bed.";
---

<PreviewLayout title={title} description={description}>
  <section class="page-hero">
    <h1>Our Rooms</h1>
    <p>Four uniquely decorated rooms—each with private entrance, bath, and lanai</p>
  </section>

  <section class="rooms-intro">
    <div class="container">
      <p class="lead">
        Each of our four rooms offers complete privacy with your own entrance, bathroom, and outdoor space.
        All rooms feature luxurious <strong>Sleep Number King Beds</strong>, premium linens, free WiFi, and
        your own private lanai. <strong>Guests must be 18 or older.</strong> This is a traditional accommodation, not a clothing-optional property.
      </p>
      <div class="compare-link">
        <a href="/rooms/compare" class="btn btn-outline">Compare All Rooms</a>
      </div>
    </div>
  </section>

  <!-- HILO BAY ROOM -->
  <section class="room-detail" id="hilo-bay">
    <div class="container">
      <div class="room-layout">
        <div class="room-gallery">
          <a href="/rooms/hilo-bay" class="room-main-image-link">
            <img src="/images/rooms/hilo-bay/bed.webp" alt="Sleep Number bed in Hilo Bay Room" class="room-main-image" />
            <span class="view-room-badge">View Room</span>
          </a>
        </div>
        <div class="room-info">
          <span class="room-label">Featured Room</span>
          <h2>Hilo Bay Room</h2>
          <p class="room-tagline">Our premier oceanview suite</p>
          <p class="room-description">
            The Hilo Bay Room is a large room and very popular with guests. At 488 square feet, it is located on the ground floor
            with no steps to climb, offering stunning panoramic views of Hilo Bay from your private lanai.
            Watch whales breach during winter months or simply enjoy your morning coffee as the sun rises over the Pacific.
          </p>
          <div class="room-features">
            <div class="feature"><span class="feature-icon">📐</span> 488 sq ft</div>
            <div class="feature"><span class="feature-icon">🌊</span> Ocean View</div>
            <div class="feature"><span class="feature-icon">🚪</span> Private Entrance</div>
            <div class="feature"><span class="feature-icon">🛁</span> Private Bath</div>
            <div class="feature"><span class="feature-icon">🛏️</span> Sleep Number King Bed</div>
            <div class="feature"><span class="feature-icon">🧭</span> Ground Floor</div>
          </div>
          <div class="room-price-info">
            <span class="price">From $225<span>/night</span></span>
          </div>
          <div class="room-actions">
            <a href="/rooms/hilo-bay" class="btn btn-outline">View Details</a>
            <a href="/book" class="btn btn-primary">Book Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ORCHID ROOM -->
  <section class="room-detail alt" id="orchid">
    <div class="container">
      <div class="room-layout reverse">
        <div class="room-gallery">
          <a href="/rooms/orchid" class="room-main-image-link">
            <img src="/images/rooms/orchid/bed.webp" alt="Sleep Number bed in Orchid Room" class="room-main-image" />
            <span class="view-room-badge">View Room</span>
          </a>
        </div>
        <div class="room-info">
          <span class="room-label">Kitchenette</span>
          <h2>Orchid Room</h2>
          <p class="room-tagline">Elegant oceanview suite with kitchenette</p>
          <p class="room-description">
            At 645 square feet, the Orchid Room is perfect for extended stays. Named for the beautiful orchids
            that bloom throughout our property, this suite combines elegant decor with stunning ocean views
            and a kitchenette with mid-size refrigerator/freezer and all the essentials.
          </p>
          <div class="room-features">
            <div class="feature"><span class="feature-icon">📐</span> 645 sq ft</div>
            <div class="feature"><span class="feature-icon">🌊</span> Ocean View</div>
            <div class="feature"><span class="feature-icon">🍳</span> Kitchenette</div>
            <div class="feature"><span class="feature-icon">🚪</span> Private Entrance</div>
            <div class="feature"><span class="feature-icon">🛏️</span> Sleep Number King Bed</div>
            <div class="feature"><span class="feature-icon">🌺</span> Private Lanai</div>
          </div>
          <div class="room-price-info">
            <span class="price">From $225<span>/night</span></span>
          </div>
          <div class="room-actions">
            <a href="/rooms/orchid" class="btn btn-outline">View Details</a>
            <a href="/book" class="btn btn-primary">Book Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAUNA KEA ROOM -->
  <section class="room-detail" id="mauna-kea">
    <div class="container">
      <div class="room-layout">
        <div class="room-gallery">
          <a href="/rooms/mauna-kea" class="room-main-image-link">
            <img src="/images/rooms/mauna-kea/bed.webp" alt="Sleep Number bed in Mauna Kea Room" class="room-main-image" />
            <span class="view-room-badge">View Room</span>
          </a>
        </div>
        <div class="room-info">
          <span class="room-label">Stargazer's Choice</span>
          <h2>Mauna Kea Room</h2>
          <p class="room-tagline">Mountain views toward Hawaii's highest peak</p>
          <p class="room-description">
            Named for the majestic mountain visible in the distance, the Mauna Kea Room with 527 sq ft
            offers views toward Hawaii's tallest peak. Perfect for stargazing enthusiasts planning
            a trip to the Mauna Kea observatories.
          </p>
          <div class="room-features">
            <div class="feature"><span class="feature-icon">📐</span> 527 sq ft</div>
            <div class="feature"><span class="feature-icon">🏔️</span> Mountain View</div>
            <div class="feature"><span class="feature-icon">🌟</span> Great for Stargazing</div>
            <div class="feature"><span class="feature-icon">🚪</span> Private Entrance</div>
            <div class="feature"><span class="feature-icon">🛁</span> Private Bath</div>
            <div class="feature"><span class="feature-icon">🛏️</span> Sleep Number King Bed</div>
            <div class="feature"><span class="feature-icon">🌺</span> Private Lanai</div>
          </div>
          <div class="room-price-info">
            <span class="price">From $195<span>/night</span></span>
          </div>
          <div class="room-actions">
            <a href="/rooms/mauna-kea" class="btn btn-outline">View Details</a>
            <a href="/book" class="btn btn-primary">Book Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GINGER ROOM -->
  <section class="room-detail alt" id="ginger">
    <div class="container">
      <div class="room-layout reverse">
        <div class="room-gallery">
          <a href="/rooms/ginger" class="room-main-image-link">
            <img src="/images/rooms/ginger/room.webp" alt="Ginger Room with Sleep Number bed" class="room-main-image" />
            <span class="view-room-badge">View Room</span>
          </a>
        </div>
        <div class="room-info">
          <span class="room-label">Easy to Get Around</span>
          <h2>Ginger Room</h2>
          <p class="room-tagline">A peaceful garden retreat</p>
          <p class="room-description">
            The Ginger Room offers 400 square feet of comfort surrounded by our lush tropical gardens.
            Located on the ground floor with no steps to climb, this room is named for the fragrant
            ginger plants that bloom just outside your private lanai.
          </p>
          <div class="room-features">
            <div class="feature"><span class="feature-icon">📐</span> 400 sq ft</div>
            <div class="feature"><span class="feature-icon">🌿</span> Garden View</div>
            <div class="feature"><span class="feature-icon">🧭</span> Ground Floor</div>
            <div class="feature"><span class="feature-icon">🚪</span> Private Entrance</div>
            <div class="feature"><span class="feature-icon">🛏️</span> Sleep Number King Bed</div>
            <div class="feature"><span class="feature-icon">🌺</span> Private Lanai</div>
          </div>
          <div class="room-price-info">
            <span class="price">From $195<span>/night</span></span>
          </div>
          <div class="room-actions">
            <a href="/rooms/ginger" class="btn btn-outline">View Details</a>
            <a href="/book" class="btn btn-primary">Book Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- POLICIES QUICK INFO -->
  <section class="policies-section">
    <div class="container">
      <div class="section-header">
        <span class="section-subtitle">Good to Know</span>
        <h2>Rates & Policies</h2>
      </div>
      <div class="policies-grid">
        <div class="policy-card">
          <div class="policy-icon">💰</div>
          <h3>Rates</h3>
          <p>Starting from <strong>$195/night</strong></p>
          <p class="policy-note">Plus 18.72% Hawaii tax</p>
        </div>
        <div class="policy-card">
          <div class="policy-icon">📅</div>
          <h3>Minimum Stay</h3>
          <p><strong>2-night minimum</strong></p>
          <p class="policy-note">Extended stay discounts available</p>
        </div>
        <div class="policy-card">
          <div class="policy-icon">🔞</div>
          <h3>Adults Only</h3>
          <p><strong>18+ only</strong></p>
          <p class="policy-note">Traditional accommodation, not clothing-optional</p>
        </div>
        <div class="policy-card">
          <div class="policy-icon">🕐</div>
          <h3>Check-in/out</h3>
          <p><strong>3PM / 11AM</strong></p>
          <p class="policy-note">Standard times apply</p>
        </div>
      </div>
      <div class="section-cta">
        <a href="/policies" class="btn btn-outline">View All Policies</a>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="cta-section">
    <div class="cta-content">
      <h2>Ready to Book Your Stay?</h2>
      <p>Book direct for the best rates and personal service</p>
      <a href="/book" class="btn btn-primary btn-large">Check Availability</a>
      <p class="cta-phone">Or call us: <a href="tel:+18089642291">808-964-2291</a></p>
    </div>
  </section>
</PreviewLayout>

<style>
  .rooms-intro {
    padding: 4rem 0 2rem;
    text-align: center;
  }

  .compare-link {
    margin-top: 1.5rem;
  }

  .lead {
    font-size: 1.15rem;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    color: var(--color-text-light);
    line-height: 1.8;
  }

  .room-detail {
    padding: var(--section-padding) 0;
  }

  .room-detail.alt {
    background: var(--color-bg-alt);
  }

  .room-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .room-layout.reverse {
    direction: rtl;
  }

  .room-layout.reverse > * {
    direction: ltr;
  }

  .room-main-image-link {
    display: block;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
  }

  .room-main-image {
    width: 100%;
    height: auto;
    transition: var(--transition-slow);
  }

  .room-main-image-link:hover .room-main-image {
    transform: scale(1.05);
  }

  .view-room-badge {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: rgba(255,255,255,0.95);
    color: var(--color-primary);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(10px);
    transition: var(--transition-base);
  }

  .room-main-image-link:hover .view-room-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .room-label {
    display: inline-block;
    background: var(--color-primary-subtle);
    color: var(--color-primary);
    padding: 0.375rem 0.875rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .room-info h2 {
    font-size: 2rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .room-tagline {
    color: var(--color-secondary);
    font-style: italic;
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .room-description {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .room-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .feature-icon {
    font-size: 1rem;
  }

  .room-price-info {
    margin-bottom: 1.5rem;
  }

  .price {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .price span {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text-light);
  }

  .room-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Policies */
  .policies-section {
    padding: var(--section-padding) 0;
    background: var(--color-bg-warm);
  }

  .policies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .policy-card {
    background: #fff;
    padding: 2rem;
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
  }

  .policy-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .policy-card h3 {
    font-size: 1.125rem;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .policy-card p {
    color: var(--color-text-light);
    font-size: 0.9375rem;
  }

  .policy-note {
    font-size: 0.8125rem !important;
    margin-top: 0.25rem;
  }

  /* CTA */
  .cta-section {
    position: relative;
    padding: var(--section-padding) 2rem;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--gradient-primary);
  }

  .cta-content {
    text-align: center;
    color: #fff;
  }

  .cta-content h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .cta-content p {
    font-size: 1.125rem;
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .cta-phone {
    margin-top: 1.5rem;
    font-size: 1rem;
  }

  .cta-phone a {
    color: var(--color-secondary-light);
    font-size: 1.25rem;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .room-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .room-layout.reverse {
      direction: ltr;
    }

    .room-features {
      grid-template-columns: 1fr;
    }
  }
</style>
