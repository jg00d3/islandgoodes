---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Guest Reviews | Island Goodes";
const description = "Read reviews from guests who have stayed at Island Goodes adults-only accommodation in Hilo, Hawaii. See what visitors say about our oceanview rooms.";
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="hero-content">
      <h1>Guest Reviews</h1>
      <p>What our guests are saying</p>
    </div>
  </section>

  <section class="reviews-section">
    <div class="container">
      <div class="review-links">
        <h2>Read Our Reviews</h2>
        <p>We're proud of the experiences we create for our guests. Read authentic reviews on these platforms:</p>

        <div class="review-platforms">
          <a href="https://www.tripadvisor.com/Hotel_Review-g60605-d635399-Reviews-Island_Goode_s-Papaikou_Island_of_Hawaii_Hawaii.html" target="_blank" rel="noopener" class="platform-card">
            <div class="platform-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
                <circle cx="8.5" cy="11" r="2"/>
                <circle cx="15.5" cy="11" r="2"/>
                <path d="M12 2 C12 2 9 5 6 5 M12 2 C12 2 15 5 18 5" fill="none" stroke="currentColor" stroke-width="2"/>
              </svg>
            </div>
            <h3>TripAdvisor</h3>
            <p>Read reviews from travelers worldwide</p>
            <span class="btn btn-outline">View Reviews →</span>
          </a>

          <a href="https://www.google.com/search?q=Island+Goodes+Papaikou+Hawaii+reviews" target="_blank" rel="noopener" class="platform-card">
            <div class="platform-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
              </svg>
            </div>
            <h3>Google Reviews</h3>
            <p>See ratings and reviews on Google</p>
            <span class="btn btn-outline">View Reviews →</span>
          </a>
        </div>
      </div>

      <div class="testimonials">
        <h2>Featured Guest Experiences</h2>

        <div class="testimonial-grid">
          <div class="testimonial-card">
            <div class="stars">★★★★★</div>
            <p class="quote">"The view from our lanai was absolutely breathtaking. Waking up to see Hilo Bay every morning made our trip unforgettable. The room was spotless and the hosts were so welcoming."</p>
            <p class="author">— Recent Guest, Hilo Bay Room</p>
          </div>

          <div class="testimonial-card">
            <div class="stars">★★★★★</div>
            <p class="quote">"Perfect location for exploring the Big Island's east side. We loved visiting the waterfalls and volcanoes, then coming back to this peaceful retreat. The adults-only policy made it so quiet and relaxing."</p>
            <p class="author">— Recent Guest, Mauna Kea Room</p>
          </div>

          <div class="testimonial-card">
            <div class="stars">★★★★★</div>
            <p class="quote">"The Sleep Number bed was incredibly comfortable. We appreciated all the little touches - the coffee station, the private lanai, and the helpful recommendations from our hosts."</p>
            <p class="author">— Recent Guest, Ginger Room</p>
          </div>

          <div class="testimonial-card">
            <div class="stars">★★★★★</div>
            <p class="quote">"Spacious, clean, and beautiful views. The Orchid Room was perfect for our anniversary trip. We loved having our own private entrance and outdoor space. Will definitely return!"</p>
            <p class="author">— Recent Guest, Orchid Room</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Experience It Yourself</h2>
      <p>Join our happy guests and create your own Island Goodes memories</p>
      <a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary btn-large" target="_blank" rel="noopener">Book Your Stay</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/property/view.jpg') center/cover no-repeat;
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 8rem 2rem 4rem;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .reviews-section {
    padding: 4rem 0;
  }

  .review-links {
    text-align: center;
    margin-bottom: 4rem;
  }

  .review-links h2 {
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .review-links > p {
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }

  .review-platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .platform-card {
    background: #fff;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    text-align: center;
    text-decoration: none;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .platform-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
  }

  .platform-icon {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .platform-card h3 {
    color: var(--color-primary-dark);
    margin-bottom: 0.5rem;
  }

  .platform-card p {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .testimonials h2 {
    color: var(--color-primary-dark);
    text-align: center;
    margin-bottom: 2rem;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .testimonial-card {
    background: var(--color-bg-alt);
    padding: 2rem;
    border-radius: 8px;
  }

  .stars {
    color: var(--color-secondary);
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .quote {
    font-style: italic;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .author {
    color: var(--color-text-light);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
  }

  .btn-outline {
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    background: transparent;
  }

  .btn-outline:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .cta-section {
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
    padding: 4rem 2rem;
  }

  .cta-section h2 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .cta-section p {
    margin-bottom: 1.5rem;
  }

  .btn-primary {
    background: var(--color-secondary);
    color: #fff;
  }

  .btn-primary:hover {
    background: #c49943;
    color: #fff;
  }

  .btn-large {
    padding: 1rem 3rem;
    font-size: 1.1rem;
  }
</style>
