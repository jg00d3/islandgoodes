---
import AdminLayout from '../layouts/AdminLayout.astro';

const title = "Admin Dashboard";
const description = "Analytics dashboard for Island Goodes.";
const pageTitle = "Admin Dashboard";
const pageTip = "Website analytics and admin tools";
---

<AdminLayout title={title} description={description} pageTitle={pageTitle} pageTip={pageTip}>
  <!-- Login Gate -->
  <div id="loginGate" class="login-gate">
    <div class="login-card">
      <!-- Step 1: Username/Password -->
      <div id="loginStep1" class="login-step">
        <div class="login-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h1>Admin Dashboard</h1>
        <p>Sign in with your admin credentials</p>
        <form id="loginForm">
          <input type="email" id="loginEmail" placeholder="Email" autocomplete="email" required />
          <input type="password" id="password" placeholder="Password" autocomplete="current-password" required />
          <button type="submit" class="btn btn-primary">Continue</button>
        </form>
        <p id="loginError" class="error-message"></p>
      </div>

      <!-- Step 2: Email 2FA -->
      <div id="loginStep2" class="login-step" style="display: none;">
        <div class="login-icon success">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <h1>Check Your Email</h1>
        <p>Enter the 6-digit code sent to <strong id="emailDisplay"></strong></p>
        <form id="codeForm">
          <div class="code-inputs">
            <input type="text" maxlength="1" class="code-input" data-index="0" inputmode="numeric" />
            <input type="text" maxlength="1" class="code-input" data-index="1" inputmode="numeric" />
            <input type="text" maxlength="1" class="code-input" data-index="2" inputmode="numeric" />
            <input type="text" maxlength="1" class="code-input" data-index="3" inputmode="numeric" />
            <input type="text" maxlength="1" class="code-input" data-index="4" inputmode="numeric" />
            <input type="text" maxlength="1" class="code-input" data-index="5" inputmode="numeric" />
          </div>
          <label class="remember-device">
            <input type="checkbox" id="rememberDevice" />
            <span>Remember this device for 7 days</span>
          </label>
          <button type="submit" class="btn btn-primary">Verify & Login</button>
        </form>
        <p id="codeError" class="error-message"></p>
        <button id="resendCode" class="resend-btn">Resend Code</button>
        <button id="backToLogin" class="back-btn">← Back to Login</button>
      </div>
    </div>
  </div>

  <!-- Dashboard (hidden until login) -->
  <div id="dashboard" class="dashboard" style="display: none;">
    <!-- Dashboard Controls -->
    <div class="dashboard-controls">
      <div class="container">
        <div class="controls-inner">
          <span class="welcome-text">Welcome back, <span id="adminName">Admin</span></span>
          <div class="controls-actions">
            <button id="refreshData" class="btn btn-small btn-outline">Refresh Data</button>
            <button id="logout" class="btn btn-small btn-secondary">Logout</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Real-time Banner -->
    <section class="realtime-banner">
      <div class="container">
        <div class="realtime-content">
          <span class="pulse"></span>
          <span class="realtime-label">Active Now:</span>
          <span id="realtimeUsers" class="realtime-count">-</span>
          <span class="realtime-text">visitors on the site</span>
        </div>
      </div>
    </section>

    <!-- Stats Overview -->
    <section class="stats-section">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-period">Today</div>
            <div class="stat-row">
              <div class="stat-item">
                <span class="stat-value" id="todayUsers">-</span>
                <span class="stat-label">Visitors</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="todaySessions">-</span>
                <span class="stat-label">Sessions</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="todayPageViews">-</span>
                <span class="stat-label">Page Views</span>
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-period">This Week</div>
            <div class="stat-row">
              <div class="stat-item">
                <span class="stat-value" id="weekUsers">-</span>
                <span class="stat-label">Visitors</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="weekSessions">-</span>
                <span class="stat-label">Sessions</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="weekPageViews">-</span>
                <span class="stat-label">Page Views</span>
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-period">This Month</div>
            <div class="stat-row">
              <div class="stat-item">
                <span class="stat-value" id="monthUsers">-</span>
                <span class="stat-label">Visitors</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="monthSessions">-</span>
                <span class="stat-label">Sessions</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="monthPageViews">-</span>
                <span class="stat-label">Page Views</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Dashboard Grid -->
    <section class="dashboard-main">
      <div class="container">
        <div class="dashboard-grid">
          <!-- Traffic Trend Chart -->
          <div class="dashboard-card wide">
            <h3>Visitor Trend (Last 30 Days)</h3>
            <div class="chart-container">
              <canvas id="trendChart"></canvas>
            </div>
          </div>

          <!-- World Map -->
          <div class="dashboard-card wide">
            <h3>Visitors by Country</h3>
            <div id="worldMap" class="world-map">
              <div class="map-loading">Loading map data...</div>
            </div>
            <div id="countryList" class="country-list"></div>
          </div>

          <!-- Top Pages -->
          <div class="dashboard-card">
            <h3>Top Pages</h3>
            <div id="topPages" class="data-list">
              <div class="loading">Loading...</div>
            </div>
          </div>

          <!-- Traffic Sources -->
          <div class="dashboard-card">
            <h3>Traffic Sources</h3>
            <div class="chart-container-small">
              <canvas id="sourcesChart"></canvas>
            </div>
            <div id="sourcesList" class="data-list"></div>
          </div>

          <!-- Top Cities -->
          <div class="dashboard-card">
            <h3>Top Cities</h3>
            <div id="topCities" class="data-list">
              <div class="loading">Loading...</div>
            </div>
          </div>

          <!-- Devices -->
          <div class="dashboard-card">
            <h3>Devices</h3>
            <div class="chart-container-small">
              <canvas id="devicesChart"></canvas>
            </div>
            <div id="devicesList" class="data-list"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Admin Tools -->
    <section class="tools-section">
      <div class="container">
        <div class="tools-card">
          <h2>Admin Tools</h2>
          <p>Quick access to site management and audit tools.</p>
          <div class="tools-grid">
            <a href="/admin/image-audit" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21,15 16,10 5,21"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Copyright Audit</strong>
                <p>Review images & text for copyright compliance</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/user-management" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Admin Users</strong>
                <p>Manage admin accounts and 2FA settings</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/website-review" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14,2 14,8 20,8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10,9 9,9 8,9"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Website Review</strong>
                <p>Full site audit and recommendations report</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/changelog" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 8v4l3 3"/>
                  <circle cx="12" cy="12" r="10"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Changelog</strong>
                <p>Version history and release notes</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/roadmap" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12,2 2,7 12,12 22,7 12,2"/>
                  <polyline points="2,17 12,22 22,17"/>
                  <polyline points="2,12 12,17 22,12"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Future Roadmap</strong>
                <p>Planned features and improvements</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/trip-planner-planning" class="tool-item">
              <div class="tool-icon" style="background: #8B5CF6;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="9" y1="15" x2="15" y2="15"/>
                  <line x1="9" y1="11" x2="13" y2="11"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Feature Planning</strong>
                <p>Trip Planner & Check-in System</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/image-manager" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21,15 16,10 5,21"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Image Manager</strong>
                <p>Add, remove, crop & rotate room photos</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/unused-images" class="tool-item">
              <div class="tool-icon" style="background: #f59e0b;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21,15 16,10 5,21"/>
                  <line x1="4" y1="4" x2="20" y2="20" stroke-width="2.5"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Unused Images</strong>
                <p>Review 20 images not used on site</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/ai-chat" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  <circle cx="9" cy="10" r="1" fill="currentColor"/>
                  <circle cx="12" cy="10" r="1" fill="currentColor"/>
                  <circle cx="15" cy="10" r="1" fill="currentColor"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>AI Chat Assistant</strong>
                <p>Configure & test AI visitor support</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/change-requests" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 11l3 3L22 4"/>
                  <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Change Requests</strong>
                <p>Track content updates & fixes needed</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/activity-log" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14,2 14,8 20,8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10,9 9,9 8,9"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Activity Log</strong>
                <p>Track admin changes and activities</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/contact-inquiries" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Contact Inquiries</strong>
                <p>Manage contact form messages</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/newsletter-subscribers" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Newsletter Subscribers</strong>
                <p>Manage email list & export CSV</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/photo-contributors" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21,15 16,10 5,21"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Photo Contributors</strong>
                <p>Review community photo submissions</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/blog-contributors" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 19l7-7 3 3-7 7-3-3z"/>
                  <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
                  <path d="M2 2l7.586 7.586"/>
                  <circle cx="11" cy="11" r="2"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Blog Contributors</strong>
                <p>Review guest article pitches</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/terminal" class="tool-item owner-only" id="terminalLink" style="display: none;">
              <div class="tool-icon" style="background: #1a1a2e;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2">
                  <polyline points="4 17 10 11 4 5"/>
                  <line x1="12" y1="19" x2="20" y2="19"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Dev Terminal</strong>
                <p>Secure web terminal access</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Site Settings -->
    <section class="settings-section">
      <div class="container">
        <div class="settings-card">
          <h2>Site Settings</h2>
          <p>Toggle site features on or off. Changes take effect immediately.</p>

          <div class="settings-grid">
            <div class="setting-item">
              <div class="setting-info">
                <strong>Live Chat Widget</strong>
                <p>Tawk.to chat widget in bottom-right corner</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleChat" />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Image Lightbox</strong>
                <p>Click room photos to view full-size in lightbox</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleLightbox" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Weather Widget</strong>
                <p>Current weather and time display on homepage</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleWeather" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Live Cameras</strong>
                <p>Volcano and mountain camera feeds on homepage</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleCameras" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Social Share Buttons</strong>
                <p>Floating share button on all pages</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleShare" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Language Selector</strong>
                <p>Google Translate integration for international guests</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleLanguage" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <div class="settings-status" id="settingsStatus"></div>
        </div>
      </div>
    </section>

    <!-- Known Limitations / Incomplete Features -->
    <section class="limitations-section">
      <div class="container">
        <div class="limitations-card">
          <h2>Known Limitations</h2>
          <p>These features need external services to be fully functional.</p>
          <div class="limitations-grid">
            <div class="limitation-item info">
              <span class="limitation-status">Working</span>
              <strong>Email 2FA</strong>
              <p>Real email verification codes are sent via Resend when logging in.</p>
            </div>
            <div class="limitation-item info">
