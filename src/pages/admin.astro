<script is:inline src="/js/shared-data.js"></script>
<script>
  // ============================================
  // ADMIN AUTHENTICATION SYSTEM
  // Uses stored admin users with email 2FA
  // Data is stored in Netlify Blobs (shared across all admins)
  // ============================================

  const API_BASE = '/.netlify/functions/analytics';
  const SESSION_KEY = 'islandgoodes_admin_session';
  const TRUSTED_DEVICE_KEY = 'islandgoodes_trusted_device';
  const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;

  // 2FA via Resend (Netlify Functions)
  const SEND_2FA_URL = '/.netlify/functions/send-2fa';
  const VERIFY_2FA_URL = '/.netlify/functions/verify-2fa';

  // State
  let currentAdmin: any = null;
  let verificationToken: string = '';  // Token from server for verification
  let adminsCache: any[] = [];  // Cached admins for sync access after load

  // Get admins from shared storage (async)
  async function getAdmins() {
    try {
      const admins = await window.SharedData.getAdmins();
      adminsCache = admins;
      return admins;
    } catch (error) {
      console.error('Failed to get admins:', error);
      return adminsCache.length > 0 ? adminsCache : [];
    }
  }

  // Sync version for places that can't be async (uses cache)
  function getAdminsSync() {
    return adminsCache;
  }

  // Get security settings from shared storage (async)
  async function getSecuritySettings() {
    try {
      const settings = await window.SharedData.getSecuritySettings();
      return settings && Object.keys(settings).length > 0
        ? settings
        : { require2FA: true, sessionTimeout: 30 };
    } catch {
      return { require2FA: true, sessionTimeout: 30 };
    }
  }

  // Check if this device is trusted (2FA verified within 7 days)
  function isDeviceTrusted(email: string): boolean {
    try {
      const stored = localStorage.getItem(TRUSTED_DEVICE_KEY);
      if (!stored) return false;
      const trusted = JSON.parse(stored);
      // Check if this email has a valid trust token
      if (trusted.email === email && trusted.expires > Date.now()) {
        return true;
      }
      return false;
    } catch {
      return false;
    }
  }

  // Set device as trusted for 7 days
  function setDeviceTrusted(email: string) {
    localStorage.setItem(TRUSTED_DEVICE_KEY, JSON.stringify({
      email: email,
      expires: Date.now() + SEVEN_DAYS_MS,
      created: new Date().toISOString()
    }));
  }

  // Get current session
  function getSession() {
    try {
      const stored = sessionStorage.getItem(SESSION_KEY);
      return stored ? JSON.parse(stored) : null;
    } catch {
      return null;
    }
  }

  // Set session
  function setSession(admin: any) {
    sessionStorage.setItem(SESSION_KEY, JSON.stringify({
      id: admin.id,
      username: admin.username,
      fullName: admin.fullName || admin.username,
      role: admin.role,
      loginTime: new Date().toISOString()
    }));
  }

  // Mask email for display
  function maskEmail(email: string): string {
    const [user, domain] = email.split('@');
    return user.charAt(0) + '***' + user.charAt(user.length - 1) + '@' + domain;
  }

  // Send 2FA code via Resend (Netlify Function)
  async function send2FACode(email: string): Promise<{success: boolean, token?: string, error?: string}> {
    console.log(`[2FA] Sending code to ${email}`);

    try {
      const response = await fetch(SEND_2FA_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });

      const data = await response.json();

      if (!response.ok) {
        return { success: false, error: data.error || 'Failed to send code' };
      }

      return { success: true, token: data.token };
    } catch (error) {
      console.error('Send 2FA error:', error);
      return { success: false, error: 'Network error. Please try again.' };
    }
  }

  // Verify 2FA code via Netlify Function
  async function verify2FACode(email: string, code: string, token: string): Promise<{success: boolean, error?: string}> {
    try {
      const response = await fetch(VERIFY_2FA_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, code, token })
      });

      const data = await response.json();

      if (!response.ok) {
        return { success: false, error: data.error || 'Invalid code' };
      }

      return { success: true };
    } catch (error) {
      console.error('Verify 2FA error:', error);
      return { success: false, error: 'Network error. Please try again.' };
    }
  }

  // DOM Elements
  const loginGate = document.getElementById('loginGate');
  const dashboard = document.getElementById('dashboard');
  const loginStep1 = document.getElementById('loginStep1');
  const loginStep2 = document.getElementById('loginStep2');
  const loginForm = document.getElementById('loginForm');
  const codeForm = document.getElementById('codeForm');
  const loginError = document.getElementById('loginError');
  const codeError = document.getElementById('codeError');
  const emailDisplay = document.getElementById('emailDisplay');

  // Check existing session - only show dashboard if logged in
  const existingSession = getSession();
  if (existingSession) {
    currentAdmin = existingSession;
    showDashboard();
  }
  // Otherwise stay on login page (loginGate visible by default)

  // Step 1: Email/Password login (server-side verification)
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('loginEmail') as HTMLInputElement)?.value.toLowerCase().trim();
    const password = (document.getElementById('password') as HTMLInputElement)?.value;
    const submitBtn = loginForm.querySelector('button[type="submit"]') as HTMLButtonElement;

    if (loginError) loginError.textContent = '';

    // Show loading state
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Checking...';
    }

    // Authenticate via server-side function (passwords never sent to client)
    try {
      const response = await fetch('/.netlify/functions/admin-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        if (loginError) loginError.textContent = result.error || 'Invalid credentials';
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Continue';
        }
        return;
      }

      // Store authenticated admin (no password hash included)
      currentAdmin = result.admin;
    } catch (err) {
      console.error('Login error:', err);
      if (loginError) loginError.textContent = 'Login failed. Please try again.';
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Continue';
      }
      return;
    }

    // Admin authenticated - store for step 2
    const admin = currentAdmin;

    // Check if 2FA is required
    const settings = await getSecuritySettings();
    if (settings.require2FA) {
      // Check if this device is already trusted (2FA verified within 7 days)
      if (isDeviceTrusted(admin.email)) {
        console.log('[2FA] Device is trusted, skipping 2FA');
        // Create server-side session for trusted device
        try {
          await fetch('/.netlify/functions/admin-create-session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: admin.email, trustedDevice: true })
          });
        } catch (e) {
          console.log('Failed to create server session, continuing anyway');
        }
        setSession(admin);
        showDashboard();
        return;
      }

      // Show loading state
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending code...';
      }

      // Send 2FA code via Resend
      const result = await send2FACode(admin.email);

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Continue';
      }

      if (!result.success) {
        if (loginError) loginError.textContent = result.error || 'Failed to send verification code';
        return;
      }

      // Store token for verification
      verificationToken = result.token || '';

      // Show step 2
      if (emailDisplay) emailDisplay.textContent = maskEmail(admin.email);
      if (loginStep1) loginStep1.style.display = 'none';
      if (loginStep2) loginStep2.style.display = 'block';

      // Focus first code input
      (document.querySelector('.code-input') as HTMLInputElement)?.focus();
    } else {
      // Skip 2FA
      setSession(admin);
      showDashboard();
    }
  });

  // Code input auto-advance
  document.querySelectorAll('.code-input').forEach((input, index) => {
    input.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value.length === 1 && index < 5) {
        const next = document.querySelector(`.code-input[data-index="${index + 1}"]`) as HTMLInputElement;
        next?.focus();
      }
    });

    input.addEventListener('keydown', (e) => {
      const target = e.target as HTMLInputElement;
      if (e.key === 'Backspace' && target.value === '' && index > 0) {
        const prev = document.querySelector(`.code-input[data-index="${index - 1}"]`) as HTMLInputElement;
        prev?.focus();
      }
    });
  });

  // Step 2: Verify 2FA code
  codeForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const inputs = document.querySelectorAll('.code-input');
    const enteredCode = Array.from(inputs).map((i: any) => i.value).join('');
    const submitBtn = codeForm.querySelector('button[type="submit"]') as HTMLButtonElement;

    if (codeError) codeError.textContent = '';

    if (enteredCode.length !== 6) {
      if (codeError) codeError.textContent = 'Please enter the complete 6-digit code';
      return;
    }

    // Show loading state
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Verifying...';
    }

    // Verify code via Netlify Function
    const result = await verify2FACode(currentAdmin.email, enteredCode, verificationToken);

    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Verify & Login';
    }

    if (result.success) {
      // Only trust device if checkbox is checked
      const rememberDevice = (document.getElementById('rememberDevice') as HTMLInputElement)?.checked;
      if (rememberDevice) {
        setDeviceTrusted(currentAdmin.email);
      }
      setSession(currentAdmin);
      showDashboard();
    } else {
      if (codeError) codeError.textContent = result.error || 'Invalid verification code';
    }
  });

  // Resend code
  document.getElementById('resendCode')?.addEventListener('click', async () => {
    if (!currentAdmin) return;

    const resendBtn = document.getElementById('resendCode') as HTMLButtonElement;
    if (resendBtn) {
      resendBtn.disabled = true;
      resendBtn.textContent = 'Sending...';
    }

    const result = await send2FACode(currentAdmin.email);

    if (resendBtn) {
      resendBtn.disabled = false;
      resendBtn.textContent = 'Resend Code';
    }

    if (result.success) {
      verificationToken = result.token || '';
      if (codeError) codeError.textContent = '';
      alert('A new verification code has been sent to your email.');
    } else {
      if (codeError) codeError.textContent = result.error || 'Failed to resend code';
    }
  });

  // Back to login
  document.getElementById('backToLogin')?.addEventListener('click', () => {
    currentAdmin = null;
    verificationToken = '';
    if (loginStep1) loginStep1.style.display = 'block';
    if (loginStep2) loginStep2.style.display = 'none';
    // Clear code inputs
    document.querySelectorAll('.code-input').forEach((i: any) => i.value = '');
    if (codeError) codeError.textContent = '';
  });

  // Logout handler - calls server to clear session cookie
  document.getElementById('logout')?.addEventListener('click', async () => {
    try {
      await fetch('/.netlify/functions/admin-logout', { method: 'POST' });
    } catch (e) {
      console.log('Logout request failed, continuing anyway');
    }
    sessionStorage.removeItem(SESSION_KEY);
    location.reload();
  });

  // Refresh handler
  document.getElementById('refreshData')?.addEventListener('click', () => {
    loadAllData();
  });

  function showDashboard() {
    if (loginGate) loginGate.style.display = 'none';
    if (dashboard) dashboard.style.display = 'block';

    // Get logged in admin name for activity log
    const session = getSession();
    const adminName = session?.fullName || session?.username || 'Unknown';

    // Log successful login
    logActivity('login', 'Admin dashboard accessed', `Logged in as ${adminName}`);
    loadAllData();
    // Refresh realtime every 30 seconds
    setInterval(loadRealtimeData, 30000);
  }

  async function fetchAnalytics(report) {
    try {
      const response = await fetch(`${API_BASE}?report=${report}`);
      const data = await response.json();
      if (data.error) {
        console.error('API Error:', data.error);
        return null;
      }
      return data;
    } catch (error) {
      console.error('Fetch error:', error);
      return null;
    }
  }

  async function loadAllData() {
    loadRealtimeData();
    loadOverviewData();
    loadTrendData();
    loadCountriesData();
    loadCitiesData();
    loadPagesData();
    loadSourcesData();
    loadDevicesData();
  }

  async function loadRealtimeData() {
    const data = await fetchAnalytics('realtime');
    const el = document.getElementById('realtimeUsers');
    if (el) el.textContent = data?.activeUsers || '0';
  }

  async function loadOverviewData() {
    const data = await fetchAnalytics('overview');
    if (!data) {
      document.getElementById('setupInstructions')!.style.display = 'block';
      return;
    }

    // Today
    setText('todayUsers', data.today?.users);
    setText('todaySessions', data.today?.sessions);
    setText('todayPageViews', data.today?.pageViews);

    // Week
    setText('weekUsers', data.week?.users);
    setText('weekSessions', data.week?.sessions);
    setText('weekPageViews', data.week?.pageViews);

    // Month
    setText('monthUsers', data.month?.users);
    setText('monthSessions', data.month?.sessions);
    setText('monthPageViews', data.month?.pageViews);
  }

  async function loadTrendData() {
    const data = await fetchAnalytics('trend');
    if (!data?.trend) return;

    const ctx = document.getElementById('trendChart') as HTMLCanvasElement;
    if (!ctx) return;

    const labels = data.trend.map((d: any) => {
      const date = d.date;
      return `${date.slice(4,6)}/${date.slice(6,8)}`;
    });
    const users = data.trend.map((d: any) => parseInt(d.users));
    const sessions = data.trend.map((d: any) => parseInt(d.sessions));

    new (window as any).Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [
          {
            label: 'Visitors',
            data: users,
            borderColor: '#1B6B5A',
            backgroundColor: 'rgba(27, 107, 90, 0.1)',
            fill: true,
            tension: 0.4
          },
          {
            label: 'Sessions',
            data: sessions,
            borderColor: '#C5A572',
            backgroundColor: 'rgba(197, 165, 114, 0.1)',
            fill: true,
            tension: 0.4
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } },
        scales: {
          y: { beginAtZero: true }
        }
      }
    });
  }

