  // Get coordinates for a city (fallback to country if city not found)
  function getCityCoords(city: string, countryCode: string): [number, number] | null {
    // Try exact city name
    if (cityCoords[city]) return cityCoords[city];
    // Try country fallback
    if (countryCoords[countryCode]) return countryCoords[countryCode];
    return null;
  }

  let worldMap: any = null;
  let currentTileLayer: any = null;

  // Tile layer URLs for light/dark mode
  const lightTileUrl = 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';
  const darkTileUrl = 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png';

  function getTileLayer(isDark: boolean) {
    return L.tileLayer(isDark ? darkTileUrl : lightTileUrl, {
      attribution: '&copy; OpenStreetMap &copy; CARTO',
      subdomains: 'abcd',
      maxZoom: 20
    });
  }

  function updateMapTheme() {
    if (!worldMap) return;
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (currentTileLayer) {
      worldMap.removeLayer(currentTileLayer);
    }
    currentTileLayer = getTileLayer(isDark);
    currentTileLayer.addTo(worldMap);
  }

  // Listen for theme changes
  const mapThemeObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'data-theme') {
        updateMapTheme();
      }
    });
  });
  mapThemeObserver.observe(document.documentElement, { attributes: true });

  async function loadCountriesData() {
    // Load both countries (for summary) and cities (for detailed map)
    const [countryData, cityData] = await Promise.all([
      fetchAnalytics('countries'),
      fetchAnalytics('cities')
    ]);

    const container = document.getElementById('countryList');
    const mapEl = document.getElementById('worldMap');
    if (!container) return;

    // Show cities in the list (more detailed than countries)
    if (cityData?.cities && cityData.cities.length > 0) {
      container.innerHTML = cityData.cities.slice(0, 15).map((city: any) => {
        const flag = getCountryFlag(city.countryCode);
        const location = city.city !== '(not set)'
          ? `${city.city}${city.region && city.region !== '(not set)' ? ', ' + city.region : ''}`
          : city.country;
        return `
          <div class="country-item">
            <span class="country-name">
              <span class="country-flag">${flag}</span>
              ${location}
            </span>
            <span class="country-users">${city.users}</span>
          </div>
        `;
      }).join('');
    } else if (countryData?.countries) {
      // Fallback to country data
      const total = countryData.countries.reduce((sum: number, c: any) => sum + parseInt(c.users), 0);
      container.innerHTML = countryData.countries.map((country: any) => {
        const percent = Math.round((parseInt(country.users) / total) * 100);
        const flag = getCountryFlag(country.countryCode);
        return `
          <div class="country-item">
            <span class="country-name">
              <span class="country-flag">${flag}</span>
              ${country.country}
            </span>
            <span class="country-users">${country.users} (${percent}%)</span>
          </div>
        `;
      }).join('');
    }

    // Create interactive Leaflet map with city markers
    if (mapEl && typeof L !== 'undefined') {
      mapEl.innerHTML = '<div id="leafletMap" style="height: 100%; width: 100%;"></div>';

      if (worldMap) {
        worldMap.remove();
      }

      worldMap = L.map('leafletMap', {
        center: [20, -155],
        zoom: 2,
        minZoom: 1,
        maxZoom: 10,
        scrollWheelZoom: true,
        zoomControl: true
      });

      // Add tile layer based on current theme
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      currentTileLayer = getTileLayer(isDark);
      currentTileLayer.addTo(worldMap);

      // Add marker for Island Goodes (Hilo, Hawaii)
      const hiloMarker = L.circleMarker([19.7297, -155.0900], {
        radius: 14,
        fillColor: '#C5A572',
        color: '#fff',
        weight: 3,
        opacity: 1,
        fillOpacity: 0.9
      }).addTo(worldMap);

      hiloMarker.bindPopup(`
        <div class="marker-popup">
          <strong>Island Goodes</strong><br>
          <span style="color: #666;">Hilo, Hawaii</span><br>
          <span style="font-size: 0.8rem; color: #C5A572;">Your Property</span>
        </div>
      `);

      const allCoords: [number, number][] = [[19.7297, -155.0900]];

      // Add city markers (more detailed)
      if (cityData?.cities) {
        cityData.cities.forEach((city: any) => {
          if (city.city === '(not set)') return;

          const coords = getCityCoords(city.city, city.countryCode);
          if (coords) {
            const users = parseInt(city.users);
            const radius = Math.min(20, Math.max(6, 6 + (users * 1.5)));

            const marker = L.circleMarker(coords, {
              radius: radius,
              fillColor: '#1B6B5A',
              color: '#fff',
              weight: 2,
              opacity: 1,
              fillOpacity: 0.8
            }).addTo(worldMap);

            const location = city.region && city.region !== '(not set)'
              ? `${city.city}, ${city.region}`
              : `${city.city}, ${city.country}`;

            marker.bindPopup(`
              <div class="marker-popup">
                <div style="font-size: 1.5rem;">${getCountryFlag(city.countryCode)}</div>
                <strong>${location}</strong><br>
                <span class="visitor-count">${city.users}</span> visitors<br>
                <span style="color: #666; font-size: 0.75rem;">${city.sessions} sessions</span>
              </div>
            `);

            allCoords.push(coords);
          }
        });
      }

      // Fit bounds to show all markers
      if (allCoords.length > 1) {
        const bounds = L.latLngBounds(allCoords);
        worldMap.fitBounds(bounds, { padding: [40, 40], maxZoom: 5 });
      }
    }
  }

  async function loadCitiesData() {
    const data = await fetchAnalytics('cities');
    const container = document.getElementById('topCities');
    if (!container || !data?.cities) return;

    container.innerHTML = data.cities.map((city: any) => `
      <div class="data-item">
        <span class="data-item-name">${city.city}, ${city.country}</span>
        <span class="data-item-value">${city.users}</span>
      </div>
    `).join('') || '<div class="loading">No data yet</div>';
  }

  async function loadPagesData() {
    const data = await fetchAnalytics('pages');
    const container = document.getElementById('topPages');
    if (!container || !data?.pages) return;

    container.innerHTML = data.pages.map((page: any) => `
      <div class="data-item">
        <span class="data-item-name" title="${page.title}">${page.path}</span>
        <span class="data-item-value">${page.views} views</span>
      </div>
    `).join('') || '<div class="loading">No data yet</div>';
  }

  async function loadSourcesData() {
    const data = await fetchAnalytics('sources');
    if (!data?.sources) return;

    const ctx = document.getElementById('sourcesChart') as HTMLCanvasElement;
    const container = document.getElementById('sourcesList');

    if (ctx && data.sources.length > 0) {
      const labels = data.sources.slice(0, 5).map((s: any) => s.source || 'direct');
      const values = data.sources.slice(0, 5).map((s: any) => parseInt(s.sessions));
      const colors = ['#1B6B5A', '#C5A572', '#238B76', '#A68B5B', '#0F4A3E'];

      new (window as any).Chart(ctx, {
        type: 'doughnut',
        data: {
          labels,
          datasets: [{
            data: values,
            backgroundColor: colors
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } }
        }
      });
    }

    if (container) {
      container.innerHTML = data.sources.map((source: any) => `
        <div class="data-item">
          <span class="data-item-name">${source.source || 'direct'} / ${source.medium}</span>
          <span class="data-item-value">${source.sessions}</span>
        </div>
      `).join('') || '<div class="loading">No data yet</div>';
    }
  }

  async function loadDevicesData() {
    const data = await fetchAnalytics('devices');
    if (!data?.devices) return;

    const ctx = document.getElementById('devicesChart') as HTMLCanvasElement;
    const container = document.getElementById('devicesList');

    if (ctx && data.devices.length > 0) {
      const labels = data.devices.map((d: any) => d.device);
      const values = data.devices.map((d: any) => parseInt(d.users));
      const colors = ['#1B6B5A', '#C5A572', '#238B76'];

      new (window as any).Chart(ctx, {
        type: 'doughnut',
        data: {
          labels,
          datasets: [{
            data: values,
            backgroundColor: colors
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } }
        }
      });
    }

    if (container) {
      const icons: Record<string, string> = { desktop: '🖥️', mobile: '📱', tablet: '📱' };
      container.innerHTML = data.devices.map((device: any) => `
        <div class="data-item">
          <span class="data-item-name">${icons[device.device] || '📱'} ${device.device}</span>
          <span class="data-item-value">${device.users} users</span>
        </div>
      `).join('') || '<div class="loading">No data yet</div>';
    }
  }

  function setText(id: string, value: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = value || '0';
  }

  function getCountryFlag(countryCode: string): string {
    if (!countryCode || countryCode.length !== 2) return '🌍';
    const codePoints = countryCode
      .toUpperCase()
      .split('')
      .map(char => 127397 + char.charCodeAt(0));
    return String.fromCodePoint(...codePoints);
  }

  // Activity Logging (uses shared storage)
  async function logActivity(type: string, action: string, details?: string) {
    try {
      await window.SharedData.logActivity(type, action, details);
    } catch (e) {
      console.error('Failed to log activity:', e);
    }
  }

  // Site Settings Management (uses shared storage with localStorage fallback)
  const SETTINGS_STORAGE_KEY = 'islandgoodes_settings';
  const settingsConfig = {
    toggleChat: { key: 'chatEnabled', default: false },  // OFF by default - not set up yet
    toggleLightbox: { key: 'lightboxEnabled', default: true },
    toggleWeather: { key: 'weatherEnabled', default: true },
    toggleCameras: { key: 'camerasEnabled', default: true },
    toggleShare: { key: 'shareEnabled', default: true },
    toggleLanguage: { key: 'languageEnabled', default: true }
  };

  let settingsCache: Record<string, boolean> = {};

  async function loadSettings() {
    // Try SharedData API first
    try {
      const settings = await window.SharedData.getSettings();
      if (settings && Object.keys(settings).length > 0) {
        settingsCache = settings;
        return settingsCache;
      }
    } catch {}

    // Fallback to localStorage
    try {
      const local = localStorage.getItem(SETTINGS_STORAGE_KEY);
      if (local) {
        settingsCache = JSON.parse(local);
        return settingsCache;
      }
    } catch {}

    return settingsCache;
  }

  function loadSettingsSync() {
    return settingsCache;
  }

  async function saveSettings(settings: Record<string, boolean>) {
    settingsCache = settings;

    // Save to localStorage first (always works)
    try {
      localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));
    } catch {}

    // Then try SharedData API
    try {
      await window.SharedData.saveSettings(settings);
    } catch {}
  }

  async function initSettingsToggles() {
    const settings = await loadSettings();

    // Initialize toggle states from saved settings
    Object.entries(settingsConfig).forEach(([toggleId, config]) => {
      const toggle = document.getElementById(toggleId) as HTMLInputElement;
      if (toggle) {
        // Use saved value if exists, otherwise use default
        const isEnabled = settings[config.key] !== undefined ? settings[config.key] : config.default;
        toggle.checked = isEnabled;

        // Add change listener
        toggle.addEventListener('change', async () => {
          const currentSettings = loadSettingsSync();
          currentSettings[config.key] = toggle.checked;
          await saveSettings(currentSettings);
          showSettingsStatus();
          // Log the change
          const settingName = config.key.replace('Enabled', '');
          await logActivity('settings', `${settingName} ${toggle.checked ? 'enabled' : 'disabled'}`, `Changed ${config.key} to ${toggle.checked}`);
        });
      }
    });
  }

  function showSettingsStatus() {
    const status = document.getElementById('settingsStatus');
    if (status) {
      status.textContent = 'Settings saved! Changes will apply on next page load.';
      status.className = 'settings-status success';
      setTimeout(() => {
        status.className = 'settings-status';
      }, 3000);
    }
  }

  // Initialize settings when dashboard is shown
  const originalShowDashboard = showDashboard;
  showDashboard = function() {
    originalShowDashboard();
    initSettingsToggles();
    showOwnerOnlyTools();
  };

  // If already logged in, init settings now
  if (getSession()) {
    initSettingsToggles();
  }

  // Show terminal link only for owner (sysadmroot@gmail.com)
  async function showOwnerOnlyTools() {
    const session = getSession();
    if (!session) return;

    // Get the logged-in admin's email from server
    try {
      const admins = await getAdmins();
      const currentAdmin = admins.find(a => a.id === session.id || a.username === session.username);
      if (currentAdmin && currentAdmin.email === 'sysadmroot@gmail.com') {
        const terminalLink = document.getElementById('terminalLink');
        if (terminalLink) terminalLink.style.display = 'flex';
      }
    } catch (e) {
      console.error('Failed to check owner status:', e);
    }
  }

  // Call after dashboard loads
  if (getSession()) {
    showOwnerOnlyTools();
  }

  // ============================================
  // SESSION TIMEOUT ENFORCEMENT
  // ============================================
  let activityTimeout: number | null = null;
  let cachedSessionTimeout = 30; // Default 30 minutes

  // Load security settings once on page load
  (async function loadSecurityTimeout() {
    try {
      const settings = await getSecuritySettings();
      cachedSessionTimeout = settings.sessionTimeout || 30;
    } catch {
      cachedSessionTimeout = 30;
    }
  })();

  function resetActivityTimer() {
    if (activityTimeout) clearTimeout(activityTimeout);

    const timeoutMs = cachedSessionTimeout * 60 * 1000;

    activityTimeout = setTimeout(() => {
      alert('Your session has expired due to inactivity. Please log in again.');
      sessionStorage.removeItem(SESSION_KEY);
      location.reload();
    }, timeoutMs) as unknown as number;
  }

  // Track activity
  ['mousedown', 'mousemove', 'keydown', 'scroll', 'touchstart'].forEach(event => {
    document.addEventListener(event, resetActivityTimer, { passive: true });
  });

  // Start timer if logged in
  if (getSession()) {
    resetActivityTimer();
  }
</script>
