---
import PreviewLayout from '../layouts/PreviewLayout.astro';

const title = "Admin Dashboard | Island Goodes";
const description = "Analytics dashboard for Island Goodes.";
---

<PreviewLayout title={title} description={description}>
  <!-- Password Gate -->
  <div id="loginGate" class="login-gate">
    <div class="login-card">
      <div class="login-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <h1>Admin Dashboard</h1>
      <p>Enter password to access analytics</p>
      <form id="loginForm">
        <input type="password" id="password" placeholder="Password" autocomplete="current-password" />
        <button type="submit" class="btn btn-primary">Login</button>
      </form>
      <p id="loginError" class="error-message"></p>
    </div>
  </div>

  <!-- Dashboard (hidden until login) -->
  <div id="dashboard" class="dashboard" style="display: none;">
    <section class="dashboard-hero">
      <div class="container">
        <div class="hero-header">
          <div>
            <h1>Analytics Dashboard</h1>
            <p>Island Goodes Website Performance</p>
          </div>
          <div class="hero-actions">
            <button id="refreshData" class="btn btn-outline">Refresh Data</button>
            <button id="logout" class="btn btn-secondary">Logout</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Real-time Banner -->
    <section class="realtime-banner">
      <div class="container">
        <div class="realtime-content">
          <span class="pulse"></span>
          <span class="realtime-label">Active Now:</span>
          <span id="realtimeUsers" class="realtime-count">-</span>
          <span class="realtime-text">visitors on the site</span>
        </div>
      </div>
    </section>

    <!-- Stats Overview -->
    <section class="stats-section">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-period">Today</div>
            <div class="stat-row">
              <div class="stat-item">
                <span class="stat-value" id="todayUsers">-</span>
                <span class="stat-label">Visitors</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="todaySessions">-</span>
                <span class="stat-label">Sessions</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="todayPageViews">-</span>
                <span class="stat-label">Page Views</span>
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-period">This Week</div>
            <div class="stat-row">
              <div class="stat-item">
                <span class="stat-value" id="weekUsers">-</span>
                <span class="stat-label">Visitors</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="weekSessions">-</span>
                <span class="stat-label">Sessions</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="weekPageViews">-</span>
                <span class="stat-label">Page Views</span>
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-period">This Month</div>
            <div class="stat-row">
              <div class="stat-item">
                <span class="stat-value" id="monthUsers">-</span>
                <span class="stat-label">Visitors</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="monthSessions">-</span>
                <span class="stat-label">Sessions</span>
              </div>
              <div class="stat-item">
                <span class="stat-value" id="monthPageViews">-</span>
                <span class="stat-label">Page Views</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Dashboard Grid -->
    <section class="dashboard-main">
      <div class="container">
        <div class="dashboard-grid">
          <!-- Traffic Trend Chart -->
          <div class="dashboard-card wide">
            <h3>Visitor Trend (Last 30 Days)</h3>
            <div class="chart-container">
              <canvas id="trendChart"></canvas>
            </div>
          </div>

          <!-- World Map -->
          <div class="dashboard-card wide">
            <h3>Visitors by Country</h3>
            <div id="worldMap" class="world-map">
              <div class="map-loading">Loading map data...</div>
            </div>
            <div id="countryList" class="country-list"></div>
          </div>

          <!-- Top Pages -->
          <div class="dashboard-card">
            <h3>Top Pages</h3>
            <div id="topPages" class="data-list">
              <div class="loading">Loading...</div>
            </div>
          </div>

          <!-- Traffic Sources -->
          <div class="dashboard-card">
            <h3>Traffic Sources</h3>
            <div class="chart-container-small">
              <canvas id="sourcesChart"></canvas>
            </div>
            <div id="sourcesList" class="data-list"></div>
          </div>

          <!-- Top Cities -->
          <div class="dashboard-card">
            <h3>Top Cities</h3>
            <div id="topCities" class="data-list">
              <div class="loading">Loading...</div>
            </div>
          </div>

          <!-- Devices -->
          <div class="dashboard-card">
            <h3>Devices</h3>
            <div class="chart-container-small">
              <canvas id="devicesChart"></canvas>
            </div>
            <div id="devicesList" class="data-list"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Admin Tools -->
    <section class="tools-section">
      <div class="container">
        <div class="tools-card">
          <h2>Admin Tools</h2>
          <p>Quick access to site management and audit tools.</p>
          <div class="tools-grid">
            <a href="/admin/image-audit" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21,15 16,10 5,21"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Copyright Audit</strong>
                <p>Review images & text for copyright compliance</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/user-management" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Admin Users</strong>
                <p>Manage admin accounts and 2FA settings</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/website-review" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14,2 14,8 20,8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10,9 9,9 8,9"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Website Review</strong>
                <p>Full site audit and recommendations report</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/changelog" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 8v4l3 3"/>
                  <circle cx="12" cy="12" r="10"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Changelog</strong>
                <p>Version history and release notes</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/roadmap" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12,2 2,7 12,12 22,7 12,2"/>
                  <polyline points="2,17 12,22 22,17"/>
                  <polyline points="2,12 12,17 22,12"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Future Roadmap</strong>
                <p>Planned features and improvements</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/image-manager" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21,15 16,10 5,21"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Image Manager</strong>
                <p>Add, remove, crop & rotate room photos</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
            <a href="/admin/activity-log" class="tool-item">
              <div class="tool-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14,2 14,8 20,8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10,9 9,9 8,9"/>
                </svg>
              </div>
              <div class="tool-info">
                <strong>Activity Log</strong>
                <p>Track admin changes and activities</p>
              </div>
              <svg class="tool-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Site Settings -->
    <section class="settings-section">
      <div class="container">
        <div class="settings-card">
          <h2>Site Settings</h2>
          <p>Toggle site features on or off. Changes take effect immediately.</p>

          <div class="settings-grid">
            <div class="setting-item">
              <div class="setting-info">
                <strong>Live Chat Widget</strong>
                <p>Tawk.to chat widget in bottom-right corner</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleChat" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Image Lightbox</strong>
                <p>Click room photos to view full-size in lightbox</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleLightbox" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Weather Widget</strong>
                <p>Current weather and time display on homepage</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleWeather" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Live Cameras</strong>
                <p>Volcano and mountain camera feeds on homepage</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleCameras" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Social Share Buttons</strong>
                <p>Floating share button on all pages</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleShare" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>

            <div class="setting-item">
              <div class="setting-info">
                <strong>Language Selector</strong>
                <p>Google Translate integration for international guests</p>
              </div>
              <label class="toggle-switch">
                <input type="checkbox" id="toggleLanguage" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <div class="settings-status" id="settingsStatus"></div>
        </div>
      </div>
    </section>

    <!-- Setup Instructions (shown if no data) -->
    <section id="setupInstructions" class="setup-section" style="display: none;">
      <div class="container">
        <div class="setup-card">
          <h2>Complete Setup Required</h2>
          <p>To see analytics data, you need to configure Google Cloud credentials.</p>
          <div class="setup-steps">
            <div class="step">
              <span class="step-num">1</span>
              <div>
                <strong>Create Google Cloud Project</strong>
                <p>Go to <a href="https://console.cloud.google.com" target="_blank">console.cloud.google.com</a> and create a new project</p>
              </div>
            </div>
            <div class="step">
              <span class="step-num">2</span>
              <div>
                <strong>Enable Analytics Data API</strong>
                <p>Search for "Google Analytics Data API" and enable it</p>
              </div>
            </div>
            <div class="step">
              <span class="step-num">3</span>
              <div>
                <strong>Create Service Account</strong>
                <p>Go to IAM & Admin > Service Accounts > Create Service Account</p>
              </div>
            </div>
            <div class="step">
              <span class="step-num">4</span>
              <div>
                <strong>Download JSON Key</strong>
                <p>Click on the service account > Keys > Add Key > Create new key (JSON)</p>
              </div>
            </div>
            <div class="step">
              <span class="step-num">5</span>
              <div>
                <strong>Add to Google Analytics</strong>
                <p>In GA4, go to Admin > Property Access Management > Add the service account email as Viewer</p>
              </div>
            </div>
            <div class="step">
              <span class="step-num">6</span>
              <div>
                <strong>Add to Netlify</strong>
                <p>In Netlify, go to Site Settings > Environment Variables and add:</p>
                <code>GA_CREDENTIALS</code> = (paste the entire JSON file contents)<br>
                <code>GA_PROPERTY_ID</code> = (your GA4 property ID, found in GA Admin)
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</PreviewLayout>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Leaflet.js for World Map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
  /* Login Gate */
  .login-gate {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1B6B5A 0%, #0F4A3E 100%);
    padding: 2rem;
  }

  .login-card {
    background: #fff;
    padding: 3rem;
    border-radius: 20px;
    text-align: center;
    max-width: 400px;
    width: 100%;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }

  .login-icon {
    width: 80px;
    height: 80px;
    background: var(--color-bg-alt);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    color: var(--color-primary);
  }

  .login-card h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .login-card > p {
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }

  #loginForm {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #loginForm input {
    padding: 1rem;
    border: 2px solid var(--color-bg-alt);
    border-radius: 10px;
    font-size: 1rem;
    text-align: center;
  }

  #loginForm input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .error-message {
    color: #EF4444;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  /* Dashboard */
  .dashboard-hero {
    background: var(--gradient-primary);
    color: #fff;
    padding: 8rem 2rem 2rem;
  }

  .hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .dashboard-hero h1 {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .dashboard-hero p {
    opacity: 0.9;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
  }

  /* Realtime Banner */
  .realtime-banner {
    background: #1a1a1a;
    color: #fff;
    padding: 1rem 2rem;
  }

  .realtime-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-content: center;
  }

  .pulse {
    width: 12px;
    height: 12px;
    background: #10B981;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .realtime-label {
    font-weight: 600;
  }

  .realtime-count {
    font-size: 1.5rem;
    font-weight: 700;
    color: #10B981;
  }

  /* Stats Section */
  .stats-section {
    padding: 2rem;
    background: var(--color-bg-alt);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .stat-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .stat-period {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    font-family: var(--font-heading);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-light);
    text-transform: uppercase;
  }

  /* Dashboard Main */
  .dashboard-main {
    padding: 2rem;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .dashboard-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .dashboard-card.wide {
    grid-column: span 2;
  }

  .dashboard-card h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .chart-container {
    height: 300px;
    position: relative;
  }

  .chart-container-small {
    height: 200px;
    position: relative;
    margin-bottom: 1rem;
  }

  /* World Map */
  .world-map {
    height: 350px;
    background: var(--color-bg-alt);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .world-map .leaflet-container {
    height: 100%;
    width: 100%;
    border-radius: 12px;
  }

  .map-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-light);
  }

  .visitor-marker {
    background: var(--color-primary);
    border: 3px solid #fff;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }

  .marker-popup {
    text-align: center;
    font-family: var(--font-body);
  }

  .marker-popup strong {
    font-size: 1.1rem;
    color: var(--color-primary);
  }

  .marker-popup .visitor-count {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .country-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
  }

  .country-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--color-bg-alt);
    border-radius: 8px;
    font-size: 0.875rem;
  }

  .country-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .country-flag {
    font-size: 1.25rem;
  }

  .country-users {
    font-weight: 600;
    color: var(--color-primary);
  }

  /* Data Lists */
  .data-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .data-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background: var(--color-bg-alt);
    border-radius: 8px;
  }

  .data-item-name {
    font-size: 0.875rem;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 70%;
  }

  .data-item-value {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.875rem;
  }

  .loading {
    text-align: center;
    color: var(--color-text-light);
    padding: 2rem;
  }

  /* Setup Section */
  .setup-section {
    padding: 2rem;
  }

  .setup-card {
    background: #FEF3C7;
    border-radius: 16px;
    padding: 2rem;
  }

  .setup-card h2 {
