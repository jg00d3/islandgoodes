---
import PreviewLayout from '../../layouts/PreviewLayout.astro';

const title = "Big Island Attractions | Island Goodes Destination Guide";
const description = "Discover the best attractions on Hawaii's Big Island. Volcanoes, waterfalls, gardens, museums and historic sites near Hilo.";

const attractions = [
  {
    name: "Hawaii Volcanoes National Park",
    category: "National Park",
    distance: "45 min from Island Goodes",
    description: "Home to two active volcanoes, Kilauea and Mauna Loa. Walk through lava tubes, hike across crater floors, and witness volcanic landscapes found nowhere else on Earth.",
    highlights: ["Kilauea Crater", "Thurston Lava Tube", "Chain of Craters Road", "Devastation Trail"],
    tip: "Go early to avoid crowds. The crater rim is spectacular at sunset.",
    image: "/images/blog/volcanoes.jpg"
  },
  {
    name: "Rainbow Falls (Waianuenue)",
    category: "Waterfall",
    distance: "10 min from Island Goodes",
    description: "An 80-foot waterfall that creates rainbows in its mist on sunny mornings. Easy access from a paved viewpoint.",
    highlights: ["Morning rainbows", "Lush tropical setting", "Free admission"],
    tip: "Visit between 8-10 AM for the best chance to see rainbows.",
    image: "/images/attractions/rainbow-falls.jpg"
  },
  {
    name: "Akaka Falls State Park",
    category: "Waterfall",
    distance: "25 min from Island Goodes",
    description: "Hawaii's most iconic waterfall at 442 feet. A short loop trail through lush rainforest also passes 100-foot Kahuna Falls.",
    highlights: ["442-foot main falls", "Easy 0.4-mile loop", "Tropical rainforest"],
    tip: "Early morning offers the best light for photos and fewer visitors.",
    image: "/images/attractions/akaka-falls.jpg"
  },
  {
    name: "Liliuokalani Gardens",
    category: "Garden",
    distance: "8 min from Island Goodes",
    description: "The largest authentic Japanese garden outside of Japan. Pagodas, stone lanterns, bridges, and koi ponds create a peaceful escape.",
    highlights: ["30 acres of gardens", "Ocean views", "Free admission"],
    tip: "Best visited in the early morning or late afternoon for beautiful lighting and peaceful strolls.",
    image: "/images/attractions/liliuokalani-gardens.jpg"
  },
  {
    name: "Waipio Valley Lookout",
    category: "Scenic Viewpoint",
    distance: "50 min from Island Goodes",
    description: "Stunning views of the sacred Valley of the Kings, with 2,000-foot cliffs and Hawaii's tallest waterfall, Hi'ilawe Falls.",
    highlights: ["2,000-foot cliffs", "Hi'ilawe Falls view", "Historic valley"],
    tip: "The road into the valley is now closed to non-residents. The only access is through tour guides. Here are two tours you can take to access the valley: Waipio By Horse Back and Waipio Valley Shuttle.",
    image: "/images/attractions/waipio-valley.jpg"
  },
  {
    name: "Pacific Tsunami Museum",
    category: "Museum",
    distance: "8 min from Island Goodes",
    description: "Learn about the tsunamis that shaped Hilo through survivor stories, historical photos, and interactive exhibits.",
    highlights: ["Survivor accounts", "Historic photos", "Beautiful building"],
    tip: "The museum now operates only on weekends, from 10:00 AM to 2:00 PM.",
    image: "/images/attractions/tsunami-museum.jpg"
  },
  {
    name: "Pana'ewa Rainforest Zoo",
    category: "Zoo",
    distance: "15 min from Island Goodes",
    description: "America's only tropical rainforest zoo with many Hawaiian native species. The previous white Bengal tiger, Namaste, passed away in 2014 due to health issues. They now have two Bengal tigers named Sriracha and Tzatziki, who have been there since 2016.",
    highlights: ["Bengal tigers Sriracha & Tzatziki", "Native Hawaiian animals", "Tropical rainforest setting"],
    tip: "The petting zoo is on Saturdays from 1:30 PM to 2:30 PM. The zoo is open daily from 10:00 AM to 4:00 PM, and admission fees vary for county residents and non-residents. The zoo is closed on the first Thursday of each month and on Christmas and New Year's Day.",
    image: "/images/attractions/panaewa-zoo.jpg"
  },
  {
    name: "Lyman Museum & Mission House",
    category: "Museum",
    distance: "8 min from Island Goodes",
    description: "Explore Hawaiian history and natural science. The adjacent 1839 Mission House offers a glimpse into early missionary life.",
    highlights: ["Hawaiian artifacts", "Natural history", "Historic Mission House"],
    tip: "Combined tickets available for museum and mission house tour.",
    image: "/images/attractions/lyman-museum.jpg"
  }
];
---

<PreviewLayout title={title} description={description}>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img src="/images/blog/volcanoes.jpg" alt="Hawaii Volcanoes National Park" />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
      <nav class="breadcrumb">
        <a href="">Home</a> / <a href="/guide">Guide</a> / Attractions
      </nav>
      <h1>Big Island Attractions</h1>
      <p class="tagline">Volcanoes, waterfalls, gardens & more</p>
    </div>
  </section>

  <section class="intro-section">
    <div class="container">
      <p class="lead">
        The Big Island offers an incredible variety of attractions, from active volcanoes to lush botanical gardens.
        Here are our favorite places to visit, all within easy driving distance of Island Goodes.
      </p>
    </div>
  </section>

  <section class="attractions-section">
    <div class="container">
      {attractions.map((attraction, index) => (
        <div class={`attraction-card ${index % 2 === 1 ? 'reverse' : ''}`}>
          <div class="attraction-image">
            <img src={attraction.image} alt={attraction.name} loading="lazy" />
            <span class="category-badge">{attraction.category}</span>
          </div>
          <div class="attraction-content">
            <span class="distance">{attraction.distance}</span>
            <h2>{attraction.name}</h2>
            <p>{attraction.description}</p>
            <div class="highlights">
              <strong>Highlights:</strong>
              <ul>
                {attraction.highlights.map(h => <li>{h}</li>)}
              </ul>
            </div>
            <div class="tip">
              <strong>Local Tip:</strong> {attraction.tip}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="more-section">
    <div class="container">
      <div class="section-header center">
        <span class="section-subtitle">Explore More</span>
        <h2>Other Guide Categories</h2>
      </div>
      <div class="more-grid">
        <a href="/guide/activities" class="more-card">
          <span class="more-icon">🤿</span>
          <h3>Activities</h3>
          <p>Adventures & experiences</p>
        </a>
        <a href="/guide/beaches" class="more-card">
          <span class="more-icon">🏖️</span>
          <h3>Beaches</h3>
          <p>Sand & swimming spots</p>
        </a>
        <a href="/guide/food" class="more-card">
          <span class="more-icon">🍍</span>
          <h3>Food & Dining</h3>
          <p>Local restaurants & markets</p>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Stay at Island Goodes</h2>
        <p>Your perfect base for exploring Big Island attractions</p>
        <a href="/book" class="btn btn-secondary btn-large">Book Your Stay</a>
      </div>
    </div>
  </section>
</PreviewLayout>

<style>
  .page-hero { position: relative; min-height: 50vh; display: flex; align-items: center; justify-content: center; text-align: center; color: #fff; padding: 10rem 2rem 4rem; }
  .page-hero-bg { position: absolute; inset: 0; z-index: -2; }
  .page-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .page-hero-overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.6) 100%); }
  .page-hero-content { max-width: 800px; }
  .page-hero h1 { font-size: clamp(2.5rem, 6vw, 4rem); margin-bottom: 0.5rem; }
  .tagline { font-size: 1.25rem; opacity: 0.9; }

  .intro-section { padding: 4rem 0 2rem; text-align: center; }
  .lead { font-size: 1.25rem; color: var(--color-text-light); line-height: 1.9; max-width: 800px; margin: 0 auto; }

  .attractions-section { padding: 2rem 0 var(--section-padding); }

  .attraction-card { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; margin-bottom: 4rem; padding-bottom: 4rem; border-bottom: 1px solid #eee; }
  .attraction-card:last-child { border-bottom: none; margin-bottom: 0; }
  .attraction-card.reverse { direction: rtl; }
  .attraction-card.reverse > * { direction: ltr; }

  .attraction-image { position: relative; border-radius: 16px; overflow: hidden; }
  .attraction-image img { width: 100%; height: 350px; object-fit: cover; }
  .category-badge { position: absolute; top: 1rem; left: 1rem; background: var(--color-secondary); color: #1a1a1a; padding: 0.375rem 1rem; border-radius: 50px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
  .attraction-card.reverse .category-badge { left: auto; right: 1rem; }

  .attraction-content .distance { display: inline-block; color: var(--color-primary); font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; }
  .attraction-content h2 { color: var(--color-text); font-size: 1.75rem; margin-bottom: 1rem; }
  .attraction-content > p { color: var(--color-text-light); line-height: 1.8; margin-bottom: 1.5rem; }

  .highlights { margin-bottom: 1.5rem; }
  .highlights strong { display: block; color: var(--color-text); margin-bottom: 0.5rem; font-size: 0.9375rem; }
  .highlights ul { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; }
  .highlights li { background: var(--color-bg-alt); padding: 0.375rem 0.875rem; border-radius: 50px; font-size: 0.8125rem; color: var(--color-text-light); }

  .tip { background: linear-gradient(135deg, var(--color-bg-alt) 0%, rgba(27, 107, 90, 0.08) 100%); padding: 1rem 1.25rem; border-radius: 12px; font-size: 0.9375rem; color: var(--color-text-light); line-height: 1.6; }
  .tip strong { color: var(--color-primary); }

  .more-section { padding: var(--section-padding) 0; background: var(--color-bg-alt); }
  .section-header { margin-bottom: 2rem; }
  .section-header.center { text-align: center; }
  .section-subtitle { display: inline-block; color: var(--color-primary); font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
  .section-header h2 { font-size: 2rem; color: var(--color-text); }

  .more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; max-width: 900px; margin: 0 auto; }
  .more-card { background: #fff; padding: 2rem; border-radius: 16px; text-align: center; text-decoration: none; transition: var(--transition-base); }
  .more-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
  .more-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
  .more-card h3 { color: var(--color-text); margin-bottom: 0.25rem; }
  .more-card p { color: var(--color-text-light); font-size: 0.875rem; }

  .cta-section { background: var(--gradient-primary); padding: 5rem 2rem; text-align: center; }
  .cta-content { max-width: 600px; margin: 0 auto; }
  .cta-section h2 { color: #fff; font-size: 2.25rem; margin-bottom: 0.75rem; }
  .cta-section p { color: rgba(255,255,255,0.9); font-size: 1.125rem; margin-bottom: 2rem; }

  @media (max-width: 768px) {
    .attraction-card { grid-template-columns: 1fr; gap: 1.5rem; }
    .attraction-card.reverse { direction: ltr; }
    .attraction-image img { height: 250px; }
    .more-grid { grid-template-columns: 1fr; }
  }
</style>
