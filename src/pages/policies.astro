---
import PreviewLayout from '../layouts/PreviewLayout.astro';

const title = "Policies | Island Goodes";
const description = "Booking policies, cancellation terms, tax information, and house rules for Island Goodes adults-only accommodation in Hilo, Hawaii.";
---

<PreviewLayout title={title} description={description}>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img src="/images/hero.jpg" alt="Island Goodes property" />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="page-hero-content">
      <nav class="breadcrumb">
        <a href="">Home</a> / Policies
      </nav>
      <h1>Policies</h1>
      <p class="tagline">Important information for your stay</p>
    </div>
  </section>

  <section class="policies-section">
    <div class="container">
      <div class="policies-intro">
        <p>Please review our policies before booking. If you have any questions, feel free to <a href="/contact">contact us</a>.</p>
      </div>

      <div class="policies-grid">
        <div class="policy-card">
          <div class="policy-icon">💳</div>
          <h2>Reservation & Payment</h2>
          <ul>
            <li>The total amount must be paid to reserve your stay</li>
            <li>We accept Visa and MasterCard</li>
            <li>Room rates may vary on special dates without notice</li>
          </ul>
        </div>

        <div class="policy-card highlight">
          <div class="policy-icon">📋</div>
          <h2>Special Non-Refundable Rate</h2>
          <p>All rooms are booked at our Special Non-Refundable Rate.</p>
          <p class="important">If you have to cancel, there are no refunds. However, we will give you a 1-year voucher to rebook.</p>
        </div>

        <div class="policy-card">
          <div class="policy-icon">🌙</div>
          <h2>Minimum Stay</h2>
          <p>A <strong>minimum 2-night stay</strong> is required for all rooms.</p>
        </div>

        <div class="policy-card">
          <div class="policy-icon">📊</div>
          <h2>Tax Information</h2>
          <p>All room rates are subject to Hawaii State Tax of <strong>17.97%</strong>, which includes:</p>
          <ul>
            <li>Transient Accommodation Tax (TAT): 13.25%</li>
            <li>General Excise Tax (GET): 4.72%</li>
          </ul>
        </div>

        <div class="policy-card">
          <div class="policy-icon">👥</div>
          <h2>Occupancy</h2>
          <p>Maximum occupancy: <strong>2 persons per room</strong></p>
        </div>

        <div class="policy-card highlight">
          <div class="policy-icon">🔞</div>
          <h2>Adults Only</h2>
          <p class="important">Guests must be 18 or older.</p>
          <p>This is a traditional accommodation, not a clothing-optional property. We provide a peaceful, relaxing environment for adult guests.</p>
        </div>

        <div class="policy-card">
          <div class="policy-icon">🕐</div>
          <h2>Check-In / Check-Out</h2>
          <ul>
            <li><strong>Check-in:</strong> 3:00 PM</li>
            <li><strong>Check-out:</strong> 11:00 AM</li>
          </ul>
        </div>

        <div class="policy-card promo">
          <div class="policy-icon">🏷️</div>
          <h2>Seasonal Discounts</h2>
          <p class="discount-highlight">SAVE UP TO 55%</p>
          <p>Discount codes available for longer stays (excluding special dates).</p>
        </div>

        <div class="policy-card full-width">
          <div class="policy-icon">🏠</div>
          <h2>House Rules</h2>
          <div class="rules-grid">
            <div class="rule-item">
              <span class="rule-icon">🚭</span>
              <span>No smoking in the room or outside - fines apply. Smoke only in the designated area by the main entrance.</span>
            </div>
            <div class="rule-item">
              <span class="rule-icon">🤫</span>
              <span>Quiet hours: 10:00 PM - 8:00 AM</span>
            </div>
            <div class="rule-item">
              <span class="rule-icon">🔒</span>
              <span>Please respect other guests' privacy</span>
            </div>
            <div class="rule-item">
              <span class="rule-icon">🚫</span>
              <span>No parties or events</span>
            </div>
            <div class="rule-item">
              <span class="rule-icon">👤</span>
              <span>Only registered guests allowed on the property</span>
            </div>
          </div>
        </div>
      </div>

      <div class="full-policy-section">
        <a href="/full-policy" class="btn btn-outline-dark btn-large">View Full Policy</a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2>Ready to Book Your Stay?</h2>
        <p>Check availability and reserve your room today</p>
        <div class="cta-buttons">
          <a href="/book" class="btn btn-secondary btn-large">Book Now</a>
          <a href="/contact" class="btn btn-outline btn-large">Contact Us</a>
        </div>
      </div>
    </div>
  </section>
</PreviewLayout>

<style>
  .page-hero {
    position: relative;
    min-height: 45vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    padding: 10rem 2rem 4rem;
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .page-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.6) 100%);
  }

  .page-hero-content {
    max-width: 800px;
  }

  .page-hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.25rem;
    opacity: 0.9;
  }

  .policies-section {
    padding: var(--section-padding) 0;
  }

  .policies-intro {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
    font-size: 1.125rem;
    color: var(--color-text-light);
  }

  .policies-intro a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .policies-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .policy-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    transition: var(--transition-base);
  }

  .policy-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.1);
  }

  .policy-card.highlight {
    background: linear-gradient(135deg, rgba(27, 107, 90, 0.05) 0%, rgba(27, 107, 90, 0.1) 100%);
    border: 1px solid rgba(27, 107, 90, 0.2);
  }

  .policy-card.promo {
    background: linear-gradient(135deg, rgba(197, 165, 114, 0.1) 0%, rgba(197, 165, 114, 0.2) 100%);
    border: 1px solid rgba(197, 165, 114, 0.3);
  }

  .policy-card.full-width {
    grid-column: 1 / -1;
  }

  .policy-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .policy-card h2 {
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .policy-card ul {
    margin-left: 1.25rem;
    color: var(--color-text-light);
  }

  .policy-card li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .policy-card p {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .policy-card p:last-child {
    margin-bottom: 0;
  }

  .policy-card .important {
    color: var(--color-primary);
    font-weight: 600;
  }

  .policy-card a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .discount-highlight {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-secondary-dark) !important;
    margin-bottom: 0.5rem !important;
  }

  .rules-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .rule-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-light);
  }

  .rule-icon {
    font-size: 1.25rem;
  }

  .cta-section {
    background: var(--gradient-primary);
    padding: 5rem 2rem;
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-section h2 {
    color: #fff;
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .cta-section p {
    color: rgba(255,255,255,0.9);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-outline {
    background: transparent;
    border: 2px solid #fff;
    color: #fff;
  }

  .btn-outline:hover {
    background: #fff;
    color: var(--color-primary);
  }

  .full-policy-section {
    text-align: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .btn-outline-dark {
    background: transparent;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
  }

  .btn-outline-dark:hover {
    background: var(--color-primary);
    color: #fff;
  }

  @media (max-width: 768px) {
    .policies-grid {
      grid-template-columns: 1fr;
    }

    .rules-grid {
      grid-template-columns: 1fr;
    }

    .policy-card {
      padding: 1.5rem;
    }
  }
</style>
