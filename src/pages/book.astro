---
import PreviewLayout from '../layouts/PreviewLayout.astro';

const title = "Book Your Stay - Island Goodes";
const description = "Book your stay at Island Goodes, an adults-only oceanview accommodation near Hilo, Hawaii. Check availability and reserve your room online.";
---

<PreviewLayout title={title} description={description}>
  <section class="booking-page">
    <div class="booking-bar">
      <div class="booking-bar-content">
        <span class="booking-title">Book Your Stay</span>
        <span class="booking-phone">Questions? <a href="tel:+18089642291">808-964-2291</a></span>
      </div>
    </div>

    <div class="language-notice" id="languageNotice">
      <span class="notice-icon">🌐</span>
      <span class="notice-text">
        <span lang="en">Use the language selector on the booking form below to translate.</span>
        <span lang="ja">下の予約フォームの言語セレクターをご利用ください。</span>
        <span lang="zh">请使用下方预订表格上的语言选择器进行翻译。</span>
        <span lang="ko">아래 예약 양식의 언어 선택기를 사용하세요.</span>
        <span lang="de">Verwenden Sie die Sprachauswahl im Buchungsformular unten.</span>
        <span lang="fr">Utilisez le sélecteur de langue sur le formulaire de réservation ci-dessous.</span>
        <span lang="es">Use el selector de idioma en el formulario de reserva a continuación.</span>
      </span>
      <button class="notice-close" id="noticeClose" aria-label="Close">&times;</button>
    </div>

    <div class="iframe-container">
      <div class="iframe-loading" id="iframeLoading">
        <div class="spinner"></div>
        <p>Loading booking system...</p>
      </div>
      <iframe
        id="bookingFrame"
        src="https://v2.reservationkey.com/3655/reserve/c"
        title="Island Goodes Reservation System"
        loading="eager"
        onload="document.getElementById('iframeLoading').style.display='none';"
      ></iframe>
    </div>
  </section>
</PreviewLayout>

<style>
  .booking-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: 70px; /* Account for fixed header */
  }

  .booking-bar {
    background: var(--gradient-primary);
    color: #fff;
    padding: 0.75rem 2rem;
    position: sticky;
    top: 70px;
    z-index: 50;
  }

  .booking-bar-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .booking-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .booking-phone {
    font-size: 0.9375rem;
  }

  .booking-phone a {
    color: var(--color-secondary-light);
    font-weight: 600;
  }

  .iframe-container {
    position: relative;
    flex: 1;
    width: 100%;
    background: #fff;
  }

  .iframe-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #fff;
    z-index: 10;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--color-bg-alt);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .iframe-loading p {
    margin-top: 1rem;
    color: var(--color-text-light);
  }

  #bookingFrame {
    width: 100%;
    height: calc(100vh - 120px);
    border: none;
    display: block;
  }

  /* Hide footer on book page */
  :global(.site-footer) {
    display: none;
  }

  @media (max-width: 768px) {
    .booking-bar {
      padding: 0.625rem 1rem;
    }

    .booking-bar-content {
      flex-direction: column;
      gap: 0.25rem;
      text-align: center;
    }

    .booking-title {
      font-size: 1rem;
    }

    .booking-phone {
      font-size: 0.875rem;
    }

    #bookingFrame {
      height: calc(100vh - 140px);
    }
  }

  /* Language Notice */
  .language-notice {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    border-bottom: 1px solid #bae6fd;
    padding: 0.75rem 2rem;
    font-size: 0.9375rem;
    color: #0369a1;
  }

  .language-notice.hidden {
    display: none;
  }

  .notice-icon {
    font-size: 1.25rem;
  }

  .notice-text {
    flex: 1;
  }

  .notice-text span {
    display: none;
  }

  .notice-text span:first-child {
    display: inline;
  }

  .notice-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    color: #0369a1;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    opacity: 0.7;
  }

  .notice-close:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .language-notice {
      padding: 0.625rem 1rem;
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // Show the appropriate language notice based on Google Translate selection
  (function() {
    const notice = document.getElementById('languageNotice');
    const closeBtn = document.getElementById('noticeClose');

    // Check if user dismissed the notice
    if (sessionStorage.getItem('langNoticeDismissed')) {
      notice?.classList.add('hidden');
      return;
    }

    // Close button
    closeBtn?.addEventListener('click', function() {
      notice?.classList.add('hidden');
      sessionStorage.setItem('langNoticeDismissed', 'true');
    });

    // Update shown language based on current page language
    function updateNoticeLanguage() {
      const htmlLang = document.documentElement.lang || 'en';
      const langMap: Record<string, string> = {
        'ja': 'ja', 'zh-CN': 'zh', 'zh-TW': 'zh', 'ko': 'ko',
        'de': 'de', 'fr': 'fr', 'es': 'es'
      };

      const targetLang = langMap[htmlLang] || 'en';
      const textContainer = document.querySelector('.notice-text');

      if (textContainer) {
        // Hide all spans
        textContainer.querySelectorAll('span').forEach(span => {
          span.style.display = 'none';
        });
        // Show the matching one
        const targetSpan = textContainer.querySelector(`span[lang="${targetLang}"]`);
        if (targetSpan) {
          (targetSpan as HTMLElement).style.display = 'inline';
        } else {
          // Fallback to English
          const enSpan = textContainer.querySelector('span[lang="en"]');
          if (enSpan) (enSpan as HTMLElement).style.display = 'inline';
        }
      }
    }

    // Initial check
    updateNoticeLanguage();

    // Watch for language changes
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.attributeName === 'lang' || mutation.attributeName === 'class') {
          updateNoticeLanguage();
        }
      });
    });

    observer.observe(document.documentElement, { attributes: true });
  })();
</script>
