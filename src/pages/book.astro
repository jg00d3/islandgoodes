---
import PreviewLayout from '../layouts/PreviewLayout.astro';

const title = "Book Your Stay - Island Goodes";
const description = "Book your stay at Island Goodes, an adults-only oceanview accommodation near Hilo, Hawaii. Check availability and reserve your room online.";
---

<PreviewLayout title={title} description={description}>
  <section class="booking-page">
    <div class="booking-bar">
      <div class="booking-bar-content">
        <span class="booking-title">Book Your Stay</span>
        <span class="booking-phone">Questions? <a href="tel:+18089642291">808-964-2291</a></span>
      </div>
    </div>

    <div class="iframe-container">
      <div class="iframe-loading" id="iframeLoading">
        <div class="spinner"></div>
        <p>Loading booking system...</p>
      </div>
      <iframe
        id="bookingFrame"
        src="https://v2.reservationkey.com/3655/reserve/c"
        title="Island Goodes Reservation System"
        loading="eager"
        onload="document.getElementById('iframeLoading').style.display='none';"
      ></iframe>
    </div>
  </section>
</PreviewLayout>

<style>
  .booking-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: 70px; /* Account for fixed header */
  }

  .booking-bar {
    background: var(--gradient-primary);
    color: #fff;
    padding: 0.75rem 2rem;
    position: sticky;
    top: 70px;
    z-index: 50;
  }

  .booking-bar-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .booking-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .booking-phone {
    font-size: 0.9375rem;
  }

  .booking-phone a {
    color: var(--color-secondary-light);
    font-weight: 600;
  }

  .iframe-container {
    position: relative;
    flex: 1;
    width: 100%;
    background: #fff;
  }

  .iframe-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #fff;
    z-index: 10;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--color-bg-alt);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .iframe-loading p {
    margin-top: 1rem;
    color: var(--color-text-light);
  }

  #bookingFrame {
    width: 100%;
    height: calc(100vh - 120px);
    border: none;
    display: block;
  }

  /* Hide footer on book page */
  :global(.site-footer) {
    display: none;
  }

  @media (max-width: 768px) {
    .booking-bar {
      padding: 0.625rem 1rem;
    }

    .booking-bar-content {
      flex-direction: column;
      gap: 0.25rem;
      text-align: center;
    }

    .booking-title {
      font-size: 1rem;
    }

    .booking-phone {
      font-size: 0.875rem;
    }

    #bookingFrame {
      height: calc(100vh - 140px);
    }
  }
</style>
