        <li><a href="/blog" class="nav-link">Blog</a></li>
        <li><a href="/contact" class="nav-link">Contact</a></li>
        <li><a href="https://v2.reservationkey.com/3655/reserve/c" class="btn btn-primary" target="_blank" rel="noopener">Book Now</a></li>
      </ul>
      <button class="mobile-menu-toggle" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </header>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="hero-background">
      <img src="/images/hero-ocean-view.webp" alt="Ocean view from Island Goodes" />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
