  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- NEW HEADER -->
  <header class="site-header">
    <nav class="nav-container">
      <a href="/" class="logo">
        <span class="logo-text">Island <span class="logo-accent">Goodes</span></span>
      </a>
      <ul class="nav-links">
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/rooms" class="nav-link">Rooms</a></li>
