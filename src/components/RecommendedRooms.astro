---
interface Room {
  slug: string;
  name: string;
  image: string;
  price: number;
  highlight: string;
}

interface Props {
  rooms?: Room[];
  title?: string;
  subtitle?: string;
}

const allRooms: Room[] = [
  { slug: "hilo-bay", name: "Hilo Bay Room", image: "/images/rooms/hilo-bay/bed.webp", price: 225, highlight: "Ocean views, whale watching" },
  { slug: "orchid", name: "Orchid Room", image: "/images/rooms/orchid/bed.webp", price: 225, highlight: "Largest room, kitchenette" },
  { slug: "mauna-kea", name: "Mauna Kea Room", image: "/images/rooms/mauna-kea/bed.webp", price: 195, highlight: "Mountain views, stargazing" },
  { slug: "ginger", name: "Ginger Room", image: "/images/rooms/ginger/room.webp", price: 195, highlight: "Garden retreat, cozy" }
];

const { rooms = allRooms, title = "Find Your Perfect Room", subtitle = "Stay with us" } = Astro.props;
---

<section class="recommended-rooms">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">{subtitle}</span>
      <h2>{title}</h2>
    </div>
    <div class="rooms-grid">
      {rooms.map(room => (
        <a href={`/rooms/${room.slug}`} class="room-preview-card">
          <div class="room-preview-image">
            <img src={room.image} alt={room.name} loading="lazy" />
            <span class="room-price">From ${room.price}/night</span>
          </div>
          <div class="room-preview-content">
            <h3>{room.name}</h3>
            <p>{room.highlight}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="rooms-cta">
      <a href="/rooms/compare" class="btn btn-outline">Compare All Rooms</a>
      <a href="/book" class="btn btn-primary">Book Now</a>
    </div>
  </div>
</section>

<style>
  .recommended-rooms {
    padding: var(--section-padding) 0;
    background: var(--color-bg-alt);
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-subtitle {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    font-size: 2rem;
    color: var(--color-text);
    margin: 0;
  }

  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .room-preview-card {
    display: block;
    text-decoration: none;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .room-preview-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.12);
  }

  .room-preview-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .room-preview-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .room-preview-card:hover .room-preview-image img {
    transform: scale(1.08);
  }

  .room-price {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: var(--color-primary);
    color: #fff;
    padding: 0.375rem 0.75rem;
    border-radius: 50px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .room-preview-content {
    padding: 1.25rem;
  }

  .room-preview-content h3 {
    font-size: 1.125rem;
    color: var(--color-text);
    margin: 0 0 0.375rem;
  }

  .room-preview-content p {
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .rooms-cta {
    text-align: center;
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn-outline {
    background: transparent;
    border: 2px solid var(--color-primary);
    color: var(--color-primary);
    padding: 0.875rem 1.75rem;
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s;
  }

  .btn-outline:hover {
    background: var(--color-primary);
    color: #fff;
  }

  @media (max-width: 1024px) {
    .rooms-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .rooms-grid {
      grid-template-columns: 1fr;
    }

    .section-header h2 {
      font-size: 1.75rem;
    }

    .rooms-cta {
      flex-direction: column;
    }
  }
</style>
