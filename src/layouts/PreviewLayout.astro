<!-- Hide deleted images from admin Image Manager (uses shared storage) -->
<script is:inline>
(async function() {
  try {
    // Wait for SharedData to be available
    if (typeof SharedData === 'undefined') return;

    const deletedImages = await SharedData.getDeletedImages() || [];
    // Extract paths from deleted images array
    const deleted = Array.isArray(deletedImages) ? deletedImages.map(img => img.path || img) : [];
    if (deleted.length === 0) return;

    // Hide any img elements with src matching deleted paths
    document.querySelectorAll('img').forEach(function(img) {
      const src = img.getAttribute('src');
      if (src && deleted.includes(src)) {
        // Hide the image and its parent container if it's a gallery item
        var parent = img.closest('.gallery-item, .image-card, .room-image, .slide');
        if (parent) {
          parent.style.display = 'none';
        } else {
          img.style.display = 'none';
        }
      }
    });

    // Also hide background images
    document.querySelectorAll('[style*="background"]').forEach(function(el) {
      var style = el.getAttribute('style') || '';
      deleted.forEach(function(path) {
        if (style.includes(path)) {
          el.style.display = 'none';
        }
      });
    });
  } catch (e) {
    console.log('Image filter error:', e);
  }
})();
</script>

<!-- DEV ONLY: Theme Toggle Script -->
<script is:inline>
(function() {
  const THEME_KEY = 'islandgoodes_theme';
  const toggleBtn = document.getElementById('themeToggle');
  if (!toggleBtn) return; // Not in dev mode

  function getTheme() {
    return localStorage.getItem(THEME_KEY) || 'light';
  }

  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem(THEME_KEY, theme);
  }

  function toggleTheme() {
    const current = getTheme();
    const next = current === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  }

  // Apply saved theme immediately
  applyTheme(getTheme());

  // Setup toggle
  toggleBtn.addEventListener('click', toggleTheme);
})();
</script>
