<!-- Google Translate -->
<div id="google_translate_element" style="display:none;"></div>
<script is:inline>
  function googleTranslateElementInit() {
    new google.translate.TranslateElement({
      pageLanguage: 'en',
      // Include all languages shown in the language modal
      includedLanguages: 'af,ar,az,be,bg,bn,bs,ca,ceb,cs,cy,da,de,el,en,eo,es,et,eu,fa,fi,fil,fr,ga,gd,gl,gu,haw,he,hi,hr,ht,hu,hy,id,is,it,ja,jv,ka,kk,km,kn,ko,ku,ky,la,lb,lo,lt,lv,mg,mi,mk,ml,mn,mr,ms,mt,my,ne,nl,no,pa,pl,ps,pt,ro,ru,sd,si,sk,sl,sm,sn,so,sq,sr,st,su,sv,sw,ta,te,tg,th,tr,uk,ur,uz,vi,xh,yi,yo,zh-CN,zh-TW,zu',
      autoDisplay: false
    }, 'google_translate_element');
  }

  // Language selector functionality - respects admin settings
  document.addEventListener('DOMContentLoaded', async function() {
    const SETTINGS_STORAGE_KEY = 'islandgoodes_settings';
    let settings = {};

    // Try SharedData API first
    try {
      if (window.SharedData) {
        settings = await window.SharedData.getSettings() || {};
      }
    } catch(e) {}

    // Fallback to localStorage
    if (!settings || Object.keys(settings).length === 0) {
      try {
        const local = localStorage.getItem(SETTINGS_STORAGE_KEY);
        if (local) settings = JSON.parse(local);
      } catch(e) {}
    }

    // Check if language selector is enabled
    if (settings.languageEnabled === false) {
      document.querySelector('.lang-selector')?.remove();
      return;
    }

    const langToggle = document.getElementById('langToggle');
    const langDropdown = document.getElementById('langDropdown');
    const langLabel = langToggle?.querySelector('.lang-label');

    // Toggle dropdown
    langToggle?.addEventListener('click', function(e) {
      e.stopPropagation();
      langDropdown.classList.toggle('show');
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', function() {
      langDropdown?.classList.remove('show');
    });

    // Handle language selection from dropdown
    document.querySelectorAll('.lang-option:not(.lang-more)').forEach(function(btn) {
      btn.addEventListener('click', function() {
        selectLanguage(this.dataset.lang);
        langDropdown?.classList.remove('show');
      });
    });

    // Language modal elements
    const langModal = document.getElementById('langModal');
    const langModalClose = document.getElementById('langModalClose');
    const langMoreBtn = document.getElementById('langMoreBtn');
    const langSearch = document.getElementById('langSearch');

    // Open modal on "More..." click
    langMoreBtn?.addEventListener('click', function() {
      langDropdown?.classList.remove('show');
      langModal?.classList.add('show');
      langSearch?.focus();
      document.body.style.overflow = 'hidden';
    });

    // Close modal
    function closeLangModal() {
      langModal?.classList.remove('show');
      document.body.style.overflow = '';
      if (langSearch) langSearch.value = '';
      // Reset search filter
      document.querySelectorAll('.lang-grid-option').forEach(function(btn) {
        btn.classList.remove('hidden');
      });
    }

    langModalClose?.addEventListener('click', closeLangModal);
    langModal?.addEventListener('click', function(e) {
      if (e.target === langModal) closeLangModal();
    });

    // Handle language selection from modal grid
    document.querySelectorAll('.lang-grid-option').forEach(function(btn) {
      btn.addEventListener('click', function() {
        selectLanguage(this.dataset.lang);
        closeLangModal();
      });
    });

    // Search functionality
    langSearch?.addEventListener('input', function() {
      const query = this.value.toLowerCase();
      document.querySelectorAll('.lang-grid-option').forEach(function(btn) {
        const text = btn.textContent.toLowerCase();
        const lang = btn.dataset.lang.toLowerCase();
        if (text.includes(query) || lang.includes(query)) {
          btn.classList.remove('hidden');
        } else {
          btn.classList.add('hidden');
        }
      });
    });

    // Shared function to select a language
    function selectLanguage(lang) {
      const select = document.querySelector('.goog-te-combo');
      if (select) {
        select.value = lang;
        select.dispatchEvent(new Event('change'));
      }

      // Update label with language code
      const labels = {
        'en': 'EN', 'ja': 'JP', 'zh-CN': '中', 'zh-TW': '繁', 'ko': '한',
        'de': 'DE', 'fr': 'FR', 'es': 'ES', 'it': 'IT', 'pt': 'PT',
        'ru': 'RU', 'ar': 'ع', 'hi': 'हि', 'th': 'ไท', 'vi': 'VI'
      };
      if (langLabel) langLabel.textContent = labels[lang] || lang.toUpperCase().slice(0,2);
    }

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && langModal?.classList.contains('show')) {
        closeLangModal();
      }
    });
  });
</script>
